<Application x:Class="Chmonos.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
      <ResourceDictionary>
        <!--
            色の表。鍵は明るい表と暗い表で同じで、起動時と設定を変えたときに AppTheme がこの1つ（Light.xaml）を差し替える。
            画面は色を直に書かず、DynamicResource で鍵を指す（docs/spec/ui-colors.md）
        -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Light.xaml" />
            <!-- 標準の部品（チェックボックス・プルダウン・メニュー・吹き出し・スクロールバーなど）を色の表の鍵で描く -->
            <ResourceDictionary Source="Themes/Controls.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!--
            商品カードの大きさ。起動時と一覧の右下のスライダーを動かしたときに CardMetrics が書き換える
            （ユーザ判断 2026-09-15）。ここの値は「中」＝前からの大きさ。カードは DynamicResource で読む
        -->
        <!--
            文章と入力が主の画面（設定・取り込み・改変の画面の右・未確定の右・要確認）の最大幅（ユーザ判断 2026-09-23）。
            行が長すぎると読みにくいので止め、余った幅は左右に分けて中央に寄せる（2560px の窓で右に大きな空きが出ていた）。
            960 は画面ごとにばらばらだった値（860〜1000）の間で、商品ページの左の列の既定（660）＋右の最小（320）とほぼ同じ幅
        -->
        <sys:Double x:Key="ReadingMaxWidth">960</sys:Double>
        <sys:Double x:Key="CardWidth">228</sys:Double>
        <sys:Double x:Key="CardHeight">336</sys:Double>
        <sys:Double x:Key="CardImageHeight">200</sys:Double>
        <sys:Double x:Key="CardSlotWidth">242</sys:Double>
        <sys:Double x:Key="CardShopIconSize">68</sys:Double>

        <!--
            表示の大きさ（設定・Ctrl＋＋／Ctrl＋－・ユーザ指示 2026-09-29）。起動時と変えたときに AppZoom が書き換える。
            主の窓の中身はこれで丸ごと縮尺する。吹き出しとメニューは別の窓（ポップアップ）で、
            主の窓の縮尺が届かないので、Themes/Controls.xaml の既定の見た目で同じ倍率を当てる。
            ComboBox の一覧・入力欄の候補・日付の選択のように、窓の中に置いたポップアップは置いた場所の縮尺を WPF が引き継ぐので当てない（当てると2重になる）
        -->
        <ScaleTransform x:Key="AppZoomTransform" ScaleX="1" ScaleY="1" />

        <!--
            畳む・開くの山形。検索の絞り込みパネルのつまみで使う（ナビは下のサイドバーの印に替えた。2026-10-02）。
            24×24の座標系。
        -->
        <PathGeometry x:Key="IconCollapse" Figures="M14,7 L9,12 L14,17" />
        <PathGeometry x:Key="IconExpand" Figures="M10,7 L15,12 L10,17" />

        <!--
            ナビを畳む・開くの印（ユーザ指摘 2026-10-02 メモ8）。左に縦の帯の付いた四角＝サイドバーの印。
            山形（上の IconCollapse／IconExpand）は左右の矢印に見え、畳んだナビで真上の「戻る ←」と並んで紛らわしかった。
            左右の矢印は画面の履歴（戻る・進む）だけに使う。
            今の状態を描く：開いているときは広い帯に項目の線、畳んでいるときは細い帯だけ（畳んだナビの姿と同じ）。
            24×24の座標系・線だけで描く（ナビのほかの印と同じ）
        -->
        <PathGeometry x:Key="IconSidebarOpen"
                      Figures="M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M10,4 V20 M5.8,8.5 H7.4 M5.8,12 H7.4" />
        <PathGeometry x:Key="IconSidebarClosed"
                      Figures="M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M7.5,4 V20" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--
            変わった行1つ（ChangedLineRow。メモ13-②）。要確認の札の行（商品ページは本文の上の帯で示す。メモ17）。
            色は商品ページの変わった所の印と同じ鍵（足した＝Good・消した＝Bad）で、色だけに頼らず札の文字も分ける
        -->
        <DataTemplate x:Key="ChangedLineTemplate" DataType="{x:Type vm:ChangedLineRow}">
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Face" BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,1,7,0" VerticalAlignment="Top"
                        Background="{DynamicResource GoodSoft}" BorderBrush="{DynamicResource GoodBorder}">
                    <TextBlock x:Name="Word" Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Good}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAdded}" Value="False">
                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource BadSoft}" />
                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource BadBorder}" />
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            何も無いときの文（空の表示）。欄の幅で折り返して中央に置く。折り返しを指定しない TextBlock は1行ぶんの幅を要求するので、
            窓が狭いと欄の外へ両側にはみ出して切れた（2026-10-02 メモ6-④：要確認で幅500のとき両端が切れた）。
            MaxWidth は広い窓で行が長くなりすぎないための上限で、欄が狭いときは欄の幅が先に効く
        -->
        <Style x:Key="EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style x:Key="EmptyNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>

        <!--
            操作の結果の知らせを、押した欄やボタンのすぐ下に出す1行（2026-10-03 のユーザの方針：画面の右上にぽつんと出る文は知らせに向かない。
            docs/feedback/notice-placement-2026-10-03.md）。**出ていない間も1行ぶんの高さを取る**——出る・消えるたびに下の物が押し下げられて
            画面が跳ねないように（ユーザ「画面が一瞬で大きくズレるような動作は避ける」）。長い文は1行で切り、全部は吹き出しで読む。
            FieldNotice は済んだこと（コピーしました など）、FieldWarning は打ち直しや別の操作が要ること（既にあります・入れてください など）
        -->
        <Style x:Key="FieldNotice" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldWarning" TargetType="TextBlock" BasedOn="{StaticResource FieldNotice}">
            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
        </Style>

        <!--
            AreaNotice（ViewModels/AreaNotice.cs）を DataContext に結んで出す1行。注意か済んだことかで FieldWarning／FieldNotice の色を切り替える。
            画面ごとに同じ作りの型を足さず、これを使う（<TextBlock DataContext="{Binding X}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" />）
        -->
        <Style x:Key="AreaNoticeText" TargetType="TextBlock" BasedOn="{StaticResource FieldNotice}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!--
            選択できる本文。見た目はTextBlockに寄せ、枠も背景も出さない。
            スクロールを内側で持たせない（Disabled）ことで、中身の高さに合わせて伸び、
            ページ全体のスクロールもそのまま効く。
        -->
        <Style x:Key="SelectableBody" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="-2,0,0,0" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="Cursor" Value="IBeam" />
            <!-- 本文なのでTabの行き先にはしない（選択とリンクはマウスで足りる） -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--
            文字リンクと同じ見た目のボタン。繰り返す行の中の文字リンクに使う（点検 2026-10-01）。
            Hyperlink は画面の部品ではなく文の一部なので、行の並び（ArrowGroup）が止まり先として数えられず、
            並びの外で行の数だけ Tab が止まっていた（見つからないファイルの「取り込みを開く」）。ボタンにすると並びの中の物になる
        -->
        <Style x:Key="HyperlinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource SmallFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 大きさは置き場所の FontSize に合わせる（書かないとアプリ全体の文字の既定が当たり、文の中の文字リンクより大きくなった） -->
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 角丸・枠線つきのカード -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <!--
                                ボタンの文字はボタンの Foreground に従わせる。アプリ全体の暗黙の TextBlock スタイル（色 Text）が
                                ボタンの作る文字にも効き、重要なボタンの白が濃い色に上書きされていた（ユーザ指摘 2026-09-14「青地に黒文字」）。
                                ContentPresenter の中に置くと、それが作る文字だけに効く
                            -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                            <!--
                                無効の表現は薄さだけに頼らない。0.45まで落とすと何のボタンか読めなくなる。
                                文字と枠の色を弱めたうえで、透過は控えめにする。
                            -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <!-- 白文字を色地に載せると細い字画が沈むので、少し太らせる -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!--
                乗せたときは青を濃くする。土台のボタンは乗せると地を薄い灰にするので、そのままだと青が消えて
                白い文字が読めなくなっていた（ユーザ指摘 2026-09-14）。文字の決まり・押せないときの見た目は土台と同じ
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHover}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            狭い場所に置く小さいボタン。
            既定のボタンは Padding 14,0 を ContentPresenter の Margin にしているので、
            幅を固定すると左右28px分だけ文字の使える幅が減って途中で切れる。
            こちらは余白を詰め、幅は内容任せ（固定しない）で使う。
        -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!--
            **取り返しのつかない操作のボタン**（ユーザ判断 2026-09-20・V4）。
            赤系にするのは改変の「削除」だけで、同じ強さの操作が普通の顔で並んでいた。
            色は「見つからない」と同じ異常の色（`Bad`）に揃える
        -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
        </Style>

        <!--
            キーボードで止まった所の印（札・行・小さな ×）。カードの印（ItemCardResources の CardFocusVisual）と同じく、選んだ色の枠を飾りの層に描く。
            既定の点線は、色の付いた札や薄い地の行の上で見分けにくい。枠の太さを部品の側で変えると中身がずれる
        -->
        <!--
            キーボードで止まったカードの印（商品のカード・ショップのカード・フォルダのカード）。既定の点線は角丸の白いカードの上で見分けにくいので、
            選んだ色の枠を出す（ItemCardResources から移した。ショップ一覧・フォルダのカードは商品のカードの資源を読まない）。
            枠はカードの内側に重ねる（メモ16-①）。外側に出す形（Margin -2）では、カードの上端・左端が段の端と同じ位置なので、
            段の枠で切られて右と下の辺しか見えず、Tab で入った先が分からなかった
        -->
        <Style x:Key="CardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="9" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="12" Margin="-2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 行は外へはみ出すと隣の行に掛かるので、内側に描く -->
        <Style x:Key="RowFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="4" Margin="-1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            乗せたときだけ出すボタン（札の ×）。**その札にキーボードのフォーカスがあるときにも出す**（ユーザ判断 2026-09-30）。
            前は乗せたときだけ Visibility を出していたので、キーボードからは届かず、読み上げ・自動操作の既定の見方にも出なかった。
            隠すのは見た目だけにする（透明にして、マウスを通す）。Hidden だとフォーカスを受けられず、Tab で × に止まれない。
            透明な間にマウスで押せると、見えないボタンで札が消えるので、出ているときだけマウスを受ける。
            条件の「札」は、いちばん近い Border（PressableBorder も含む）。中の × やボタンにフォーカスが移っても、札の中にある間は消えない
        -->
        <Style x:Key="RevealOnHoverOrFocusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SmallFocusVisual}" />
            <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右クリックの中の、取り返しのつかない項目（V4）。ボタンと同じ色にする -->
        <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
        </Style>

        <!--
            札の並び（BOOTHのタグ・対応アバター）に混ぜる札。商品ページと編集画面で同じ見た目にするのでここに置く。
            作った札は隠すだけで捨てない（ChipStrip・ユーザ判断 2026-09-12）ので、見えるかどうかは札の IsShown で決める
        -->
        <DataTemplate DataType="{x:Type vm:TagTile}">
            <Border BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1" CornerRadius="12"
                    Padding="10,3" Margin="0,0,6,6" Background="{DynamicResource ChipBack}"
                    Visibility="{Binding IsShown, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource ChipText}" />
            </Border>
        </DataTemplate>
        <!--
            「残り n を表示」⇔「最初の 40 だけにする」（ユーザ指示：可逆にする）。1枚のまま文字だけ変わる。
            札の並びは Tab で1回だけ入り中を矢印で移るが、これは札ではなく並びそのものの操作なので、並びとは別に Tab で止まる（ArrowGroup.IsOutside）
        -->
        <DataTemplate DataType="{x:Type vm:ChipToggle}">
            <Button Content="{Binding Text}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" controls:ArrowGroup.IsOutside="True"
                    Command="{Binding Command}" ToolTip="{Binding Hint}"
                    Visibility="{Binding IsShown, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </DataTemplate>
      </ResourceDictionary>
    </Application.Resources>
</Application>
