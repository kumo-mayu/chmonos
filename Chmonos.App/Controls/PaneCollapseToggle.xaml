<UserControl x:Class="Chmonos.App.Controls.PaneCollapseToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             x:Name="Self" Panel.ZIndex="3"
             Visibility="{Binding Pane.CanCollapse, RelativeSource={RelativeSource Self}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
    <!--
        左右に分かれた画面の、左の一覧を畳む・広げるつまみ（ユーザ指摘 2026-11-18・open.md 51）。検索の絞り込みのつまみと同じ見た目と置き場所：
        左の列の右上に置き、境の線に半分はみ出させる。開いても畳んでも同じ高さに残るので、押す場所が変わらない。
        使う画面は PaneGrid の左の列（Grid.Column="0"）に置き、左の中身の根を Pane.IsCollapsed で隠す。
        畳んだ姿は縦書きの見出しだけの細い帯（PaneColumn.StripWidth）。帯は地を持つので、隠した中身の代わりに列を塗る。
        開いている間は帯を出さず、地の無い Grid だけになるので、つまみの外を押すと下の一覧に届く
    -->
    <Grid>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                Visibility="{Binding Pane.IsCollapsed, ElementName=Self, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <!-- つまみ（上から 13〜39）の下から並べる。検索の畳んだ姿の「絞り込み」と同じ位置 -->
            <TextBlock Text="{Binding Label, ElementName=Self}" Style="{StaticResource Caption}" Margin="0,48,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90" />
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,-13,0"
                Width="26" Height="26" CornerRadius="13"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
            <Button x:Name="Toggle" Command="{Binding Pane.ToggleCollapseCommand, ElementName=Self}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FocusVisualStyle="{StaticResource PanelToggleFocusVisual}"
                    AutomationProperties.AutomationId="{Binding AutomationKey, ElementName=Self}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelToggle}">
                        <Setter Property="Content" Value="{StaticResource IconCollapse}" />
                        <Setter Property="ToolTip" Value="一覧を折りたたむ" />
                        <Setter Property="AutomationProperties.Name" Value="一覧を折りたたむ" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pane.IsCollapsed, ElementName=Self}" Value="True">
                                <Setter Property="Content" Value="{StaticResource IconExpand}" />
                                <Setter Property="ToolTip" Value="一覧を広げる" />
                                <Setter Property="AutomationProperties.Name" Value="一覧を広げる" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</UserControl>
