<UserControl x:Class="Chmonos.App.Controls.AreaNoticeLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        欄やボタンのすぐ下の知らせ1行。DataContext に AreaNotice を渡して使う（<controls:AreaNoticeLine DataContext="{Binding IdNotice}" />）。
        型は App.xaml の AreaNoticeText（FieldNotice／FieldWarning の色を IsWarning で切り替える）。
        渡す物が無い持ち主（改変の写真の欄など、同じ部品を使う別の画面）では、場所も取らない
    -->
    <TextBlock Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" />
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
