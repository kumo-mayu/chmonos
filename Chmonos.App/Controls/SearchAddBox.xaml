<UserControl x:Class="Chmonos.App.Controls.SearchAddBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        検索と追加を1本にした欄（ユーザ指示 2026-10-02：タグ・属性の管理の左）。
        形は共通素体を足す欄（アバターの画面）に合わせた：欄の右に「追加」ボタン（メモ21-① 2026-10-03）。
        候補は並べない。同じ名前があって足せなかったときの「既にあります」は、欄のすぐ下に出す。
        **その1行分の場所は常に取っておく**——出入りのたびに下の一覧が押し下げられて跳ねていた（ユーザ注意 2026-10-03）
    -->
    <StackPanel>
        <DockPanel>
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="追加" Style="{StaticResource SmallButton}"
                    Margin="6,0,0,0" Height="30" Click="OnAddClick" IsEnabled="False"
                    AutomationProperties.AutomationId="SearchAddBoxAdd" />
            <Grid>
                <TextBox x:Name="Input" Height="30" VerticalContentAlignment="Center" Padding="8,0" MaxLength="500"
                         BorderBrush="{DynamicResource BorderStrong}"
                         Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown" />
                <TextBlock x:Name="Watermark" IsHitTestVisible="False" VerticalAlignment="Center"
                           Margin="10,0,0,0" Foreground="{DynamicResource TextFaint}" FontSize="12.5" />
            </Grid>
        </DockPanel>

        <!-- 「既にあります」。空でも高さは残す（Collapsed にしない） -->
        <TextBlock x:Name="Notice" Height="16" Margin="2,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Warn}" />
    </StackPanel>
</UserControl>
