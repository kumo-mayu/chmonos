<UserControl x:Class="Chmonos.App.Controls.ExclusionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             x:Name="Root">
    <!--
        除外の一覧の共通部品（open.md 132・171）。DataContext に ExclusionListViewModel を渡す。
        設定の2つの欄と、未確定の「除外の解除…」の窓で同じ物を使う。並び・探す・選ぶ・解除の決まりは ViewModel のコメント。
        一覧の高さは使う側が ListMaxHeight で決める——外の流す枠の中で高さを決めないと、全行の部品を作ってしまい仮想化が効かない
        （除外は上限なく溜まる。5,000 件で設定を開くたびに 7 秒余り止まった。docs/research/large-files-2026-09-30.md）
    -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox AutomationProperties.AutomationId="ExclusionList.Filter" AutomationProperties.Name="除外したファイルを探す"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="9,5,26,5"
                     BorderBrush="{DynamicResource BorderStrong}" />
            <TextBlock Text="パス・ファイル名で探す" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Query}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                    Style="{StaticResource ClearFieldButton}" Command="{Binding ClearQueryCommand}"
                    ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                    Visibility="{Binding HasQuery, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="すべて選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}"
                    AutomationProperties.AutomationId="ExclusionList.SelectAll" />
            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0" Command="{Binding ClearChecksCommand}"
                    AutomationProperties.AutomationId="ExclusionList.ClearChecks" />
        </StackPanel>

        <!-- 下のボタンと結果の1行。ボタンの文字は選んだ件数で変わる（見えている行のうち選んだ物だけに効く） -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource SmallButton}"
                    Content="{Binding LiftCheckedText}" Command="{Binding LiftCheckedCommand}"
                    AutomationProperties.AutomationId="ExclusionList.LiftChecked" />
            <TextBlock Style="{StaticResource FieldNotice}" Margin="0,6,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ExclusionList.Note"
                       Text="{Binding Note}"
                       Visibility="{Binding Note, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
        </StackPanel>

        <Grid>
            <Border Padding="6,4,4,4" CornerRadius="6" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <controls:ContentItemsControl ItemsSource="{Binding Rows}"
                                              MaxHeight="{Binding ListMaxHeight, ElementName=Root}"
                                              AutomationProperties.AutomationId="ExclusionList.Rows"
                                              AutomationProperties.Name="{Binding ListName, ElementName=Root}"
                                              controls:ArrowGroup.IsEnabled="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExclusionRowViewModel}">
                            <Border Style="{StaticResource ButtonListRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 行を押しても選べるよう、チェックの中身にパスと2段目を入れる（行の右のボタンは別） -->
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ExclusionList.Check"
                                              AutomationProperties.Name="{Binding Path}">
                                        <StackPanel Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}"
                                                       Visibility="{Binding SubText, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource SmallButton}"
                                            AutomationProperties.AutomationId="ExclusionList.Lift"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding LiftCommand}" ToolTip="{Binding ActionTip}">
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}を{1}">
                                                <Binding Path="Path" />
                                                <Binding Path="ActionLabel" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
            </Border>
            <TextBlock Text="合うファイルはありません。探す言葉を変えてください。" Style="{StaticResource Caption}" Margin="12,10"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       AutomationProperties.AutomationId="ExclusionList.FilteredEmpty"
                       Visibility="{Binding IsFilteredEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Grid>
    </DockPanel>
</UserControl>
