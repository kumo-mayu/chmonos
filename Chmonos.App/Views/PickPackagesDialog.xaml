<Window x:Class="Chmonos.App.Views.PickPackagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PickPackagesDialogViewModel}"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        送る unitypackage を選ぶ（ユーザ指示 2026-09-13）。商品 → 横に添えるもの（種類、無ければ zip の名前）が同じ塊 → unitypackage。
        塊は見出しで畳める。最初はどれにもチェックを付けない
    -->
    <Window.Resources>
        <!-- 塊の見出し。畳む印と名前をまとめて1つの押せる所にする（小さな印だけを狙わせない） -->
        <Style x:Key="GroupHeader" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="2,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="18" Text="{Binding ExpandGlyph}" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="{Binding HeadingText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0" />
        <TextBlock Text="{Binding NoteText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <!--
            何十件の中から選べるように、名前で探して、見えている物をまとめて選ぶ・外す（ユーザ指示 2026-11-03）。
            「すべて選択」「選択を解除」は見えている物だけに効く
        -->
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="すべて選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}"
                        AutomationProperties.AutomationId="PickPackagesSelectAll" />
                <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Command="{Binding ClearSelectionCommand}"
                        AutomationProperties.AutomationId="PickPackagesClearSelection" />
            </StackPanel>
            <Grid>
                <TextBox x:Name="FilterBox" AutomationProperties.AutomationId="PickPackagesFilter"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="9,5,26,5"
                         BorderBrush="{DynamicResource BorderStrong}" AutomationProperties.Name="unitypackageを探す" />
                <TextBlock Text="名前・zipの名前で探す" Margin="12,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 打った文字を消す（検索画面と同じ ×） -->
                <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                        Style="{StaticResource ClearFieldButton}" Command="{Binding ClearFilterCommand}"
                        ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                        Visibility="{Binding HasFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </Grid>
        </DockPanel>

        <TextBlock Text="当たるunitypackageがありません。" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   Visibility="{Binding HasNoMatch, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                Margin="0,8,0,0" Padding="10,4,4,4"
                Visibility="{Binding HasNoMatch, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <controls:ContentItemsControl ItemsSource="{Binding Sections}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PackageChoiceSection}">
                            <StackPanel Margin="0,6"
                                        Visibility="{Binding IsVisible, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <controls:ContentItemsControl ItemsSource="{Binding Groups}" Margin="0,3,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PackageChoiceGroup}">
                                            <StackPanel Margin="0,1"
                                                        Visibility="{Binding IsVisible, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ToggleButton Style="{StaticResource GroupHeader}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding Label}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                                   Style="{StaticResource Caption}" Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                    </DockPanel>
                                                </ToggleButton>
                                                <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="20,1,0,3"
                                                              Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:PackageChoiceRow}">
                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3"
                                                                      Visibility="{Binding IsVisible, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                                      VerticalContentAlignment="Center"
                                                                      AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel Margin="4,0,0,0">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                               Foreground="{DynamicResource Text}"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                                               ToolTip="{Binding Name}" />
                                                                    <TextBlock Text="{Binding FolderText}" Style="{StaticResource Caption}"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                                               Visibility="{Binding HasFolder, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </controls:ContentItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding CommitText}" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="PickPackagesCommit"
                        IsDefault="True" IsEnabled="{Binding CanCommit}" Click="OnCommit"
                        ToolTip="{Binding CommitHint}" ToolTipService.ShowOnDisabled="True" />
                <Button Content="{Binding SkipText}" Margin="8,0,0,0" Click="OnSkip"
                        AutomationProperties.AutomationId="PickPackagesSkip"
                        Visibility="{Binding HasSkip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button Content="キャンセル" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            </StackPanel>
            <!-- 押せないときは理由を出す（E9） -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
