<UserControl x:Class="Chmonos.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShopViewModel}">
    <!--
        商品は検索画面と同じカードとリストで並べる（ユーザ指示 2026-09-15：ショップ画面の item 閲覧も検索同等に）。
        前はこの画面だけの小さなカードで、押して開く以外の操作（右クリック・星・リスト）が無かった
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemCardResources />
                <!-- バナーを畳む三角（TriangleExpander）。商品ページ・編集画面と同じ物を使う -->
                <ResourceDictionary Source="ManageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <!-- 戻るの見た目はどの画面でも同じ（枠なし・透明。V2）。ここだけ枠付きの小さいボタンだった -->
                <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                        BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{Binding ShowsBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RefreshStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRefreshStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 外部で更新を知ったときに、次の確認時期を待たずに取り直せるようにする -->
                    <Button Content="画像を取り直す" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshImagesCommand}"
                            ToolTip="このショップのアイコンとバナーを、普段と同じ手順で取り直します。" />
                    <!-- 絞り込みはショップ画面に作らず、検索の絞り込みをそのまま使う（#55） -->
                    <Button Content="このショップの商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding ShowInSearchCommand}"
                            ToolTip="このショップの商品で絞って、検索を開きます。" />
                    <Button Content="BOOTHのショップページを開く" Style="{StaticResource SmallButton}"
                            ToolTip="BOOTHのショップページをブラウザで開きます。アプリの外へ出ます。"
                            Command="{Binding OpenShopPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>


        <!-- 右下の大きさのスライダー（検索と同じ・ユーザ判断 2026-09-29）。下から積むので、まとめて操作の帯より先に書く -->
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSizeBar}" Focusable="False" />

        <!-- 選んでいる間と、Unity へ送っている間に出す、まとめて操作の帯（検索・フォルダビューと同じ。動線の点検 C1） -->
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSelectionBar}" Focusable="False"
                        Visibility="{Binding ShowsSelectionBar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            上の段（バナー・見出しと集計・メモ）と商品の一覧は1つのスクロール（ユーザ判断 2026-10-03、メモ24）。
            前は一覧だけが流れ、上の段は別に詰めていて、別々に動いて見えた。一番上の「← 検索に戻る」の帯は動かさない。
            名前の段が流れ去ったら1行の見出し（CompactBar）を上に重ね、「このショップの商品」の行（StickyRow）はその下で止める
        -->
        <Grid SizeChanged="OnShopAreaSizeChanged">
        <controls:InsetScrollViewer x:Name="ShopScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    CanContentScroll="False" ScrollChanged="OnShopScrollChanged">
        <StackPanel x:Name="ScrollBody" SizeChanged="OnScrollBodySizeChanged">
        <StackPanel x:Name="ShopHeader">
        <!--
            バナー。置いていないショップもあるので、無ければ帯ごと出さない。
            切り取らずに全体を出す（作者が作った絵なので、勝手に一部だけ見せない）。
            大きさはBOOTHの見せ方（960x320）に合わせ、縦横比が違うバナーは
            その枠に収まるところまで縮める。
            高さ320を取るので、見出しの三角で畳める（ユーザ指示 2026-09-29）。畳んだかは全部のショップで同じで、閉じても覚える。
            三角は商品ページ・編集画面と同じ物（TriangleExpander）
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowBannerArea, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Expander Style="{StaticResource TriangleExpander}" IsExpanded="{Binding IsBannerExpanded, Mode=TwoWay}"
                      Padding="0" Margin="20,6,20,6" AutomationProperties.Name="バナー">
                <Expander.Header>
                    <TextBlock Text="バナー" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </Expander.Header>
            <Grid Height="320" Margin="0,6,0,0">
                <!--
                    有無が分からない間は、同じ高さの場所を空けて待つ。
                    空けておかないと、後からバナーが差し込まれて中身が下へずれる。
                -->
                <Border Background="{DynamicResource SurfaceAlt}" Width="960"
                        Visibility="{Binding HasBanner, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding BannerPlaceholderText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Image Source="{Binding Banner}" Stretch="Uniform"
                       MaxWidth="960" MaxHeight="320" HorizontalAlignment="Center"
                       Visibility="{Binding HasBanner, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </Grid>
            </Expander>
        </Border>

        <!-- ショップの見出しと集計 -->
        <Border x:Name="NameBorder" DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource AccentSoft}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentSoftText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInitial, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <!--
                                お気に入りのショップ（ユーザ判断 2026-09-16）。キーボードと読み上げから押せるようボタンにし、
                                暗黙のボタンの枠と余白が付かないよう見た目は差し替える
                            -->
                            <Button Command="{Binding ToggleFavoriteCommand}" Margin="10,0,0,0" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{Binding FavoriteTip}"
                                    AutomationProperties.AutomationId="ShopFavorite">
                                <!-- どのショップの星かを名前に入れる（カードの星と同じ言い方） -->
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0}を{1}">
                                        <Binding Path="Name" />
                                        <Binding Path="FavoriteTip" />
                                    </MultiBinding>
                                </AutomationProperties.Name>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="2,0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding FavoriteGlyph}" FontSize="22">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Star}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding DomainText}" Style="{StaticResource Mono}" FontSize="12"
                                   Foreground="{DynamicResource TextFaint}" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding OwnedText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="購入総額" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SpentText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="容量" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最終購入" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LastAcquiredText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ショップのメモ（ユーザ判断 2026-09-16）。利用規約・問い合わせ先・作者の別名義など、ショップ単位でしか持てない知識。
            止まってから書く（打つたびには書かない）
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,10,24,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                <Grid>
                    <TextBox MaxLength="10000" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="40" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             FontSize="12.5" Padding="6,4" AutomationProperties.Name="ショップのメモ" />
                    <!-- 使い道を決めつけない（ユーザ指示 2026-09-16。メモ10-② 2026-10-02：用途の説明は無くし「メモ」だけにした） -->
                    <TextBlock Text="メモ"
                               Margin="10,6,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Memo}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
        </StackPanel>

        <!--
            件数（左）と「所持しているものだけ」・カード／リスト（右）。入り切らなければ右を次の行へ送る（検索の結果の上の帯と同じ部品）。
            切り替えは一覧の右下に浮かせていたが、狭い窓でカードの上に重なった（点検 2026-09-23）。
            流していくと上端（1行の見出しのすぐ下）で止まり、商品の上に重なって残る（ユーザ判断 2026-10-03）。止まっている間だけ下に細い線を引く
        -->
        <Border x:Name="StickyRow" Background="{DynamicResource Bg}" Panel.ZIndex="1"
                BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="24,14,24,8"
                controls:InsetScrollViewer.IsPinned="True" SizeChanged="OnStickyRowSizeChanged">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StickyShift" />
            </Border.RenderTransform>
            <controls:SplitRowPanel MinLeftWidth="240">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="このショップの商品" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11.5"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <!-- 全商品ではないことを書いておく。件数の意味が変わってしまう。狭いときは省略して縮む -->
                    <TextBlock Text="BOOTHの全商品ではなく、ローカルに情報があるものだけです。" TextTrimming="CharacterEllipsis"
                               ToolTip="BOOTHの全商品ではなく、ローカルに情報があるものだけです。"
                               Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="所持しているものだけ" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                              VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                    <!-- 「更新あり」の札の付いた商品だけ。札が1枚も無い店では出さない（押しても必ず0件になる） -->
                    <CheckBox Content="更新があるものだけ" IsChecked="{Binding UpdatedOnly, Mode=TwoWay}"
                              VerticalAlignment="Center" Foreground="{DynamicResource Text}" Margin="14,0,0,0"
                              Visibility="{Binding HasUpdatedItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                    Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SplitRowPanel>
        </Border>

        <!-- 商品の一覧（カード・リスト）。仮想化はしない（1つのショップの商品は多くない）。余りの高さは持たず、中身の高さで伸びる -->
        <Grid x:Name="ListHost">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="表示する商品がありません" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                <!-- なぜ無いのかと戻し方（動線の点検 D8）。空表示には次にやることを書く -->
                <TextBlock Text="{Binding EmptyReasonText}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,6,0,0" />
                <Button Content="設定を開く" Style="{StaticResource SmallButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Command="{Binding ShowSettingsCommand}"
                        Visibility="{Binding HasExcluded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>

            <!-- リスト。列の幅は見出しの境目をドラッグで変え、全部の行で共通（ショップ画面として覚える） -->
            <controls:ItemListView x:Name="ItemList" ItemsSource="{Binding ListItems}" View="{StaticResource ItemListGridView}"
                      ItemContainerStyle="{StaticResource ItemListRowStyle}"
                      BorderThickness="0" Background="Transparent" Margin="24,2,24,18"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" controls:ForwardWheel.IsEnabled="True"
                      VirtualizingPanel.IsVirtualizing="False"
                      Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!--
                行を仮想化の単位にする（検索画面と同じ）。列数はViewModel側で幅から決める。
                画面外の行のカードは作られないので、サムネイルの読み込みも走らない
            -->
            <!-- カードの行の一覧。Tab で1回だけ入り、中は矢印でカードからカードへ移る（CardRowsListBox が並び ArrowGroup になる。ユーザ判断 2026-10-01） -->
            <!-- 段は読み上げ・自動操作の木に出さず、カードを一覧の直下に出す（CardRowsListBox と CardRowItems。ユーザ判断 2026-09-30） -->
            <controls:CardRowsListBox x:Name="CardList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                     Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                     Padding="24,6,24,24" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" controls:ForwardWheel.IsEnabled="True"
                     VirtualizingPanel.IsVirtualizing="False">
                <controls:CardRowsListBox.ItemContainerStyle>
                    <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </controls:CardRowsListBox.ItemContainerStyle>
                <controls:CardRowsListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:CardRowItems ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ItemCardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </controls:CardRowItems>
                    </DataTemplate>
                </controls:CardRowsListBox.ItemTemplate>
            </controls:CardRowsListBox>
        </Grid>
        </StackPanel>
        </controls:InsetScrollViewer>

        <!--
            1行の見出し。名前の段が流れ去ったら、スクロールの上に重ねて出す（ユーザ判断 2026-10-03）。重ねるので、出入りで中身は動かない。
            高さは決め打ち（ShopViewModel.CompactHeaderHeight と揃える）——「このショップの商品」の行が、このすぐ下で止まる。
            右はスクロールバーの幅だけ空ける（バーを隠さない。ShopView.xaml.cs）
        -->
        <Border x:Name="CompactBar" Height="52" VerticalAlignment="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsHeaderCompact, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Margin="24,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" ClipToBounds="True"
                        Background="{DynamicResource AccentSoft}">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSoftText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowInitial, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                               Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>
                <!-- 名前が長いときは名前だけを詰め、星は名前のすぐ右に残す（左寄せの DockPanel は中身の幅までしか広がらない） -->
                <DockPanel Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,16,0" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleFavoriteCommand}" Margin="6,0,0,0" Cursor="Hand"
                            VerticalAlignment="Center" ToolTip="{Binding FavoriteTip}"
                            AutomationProperties.AutomationId="ShopCompactFavorite">
                        <AutomationProperties.Name>
                            <MultiBinding StringFormat="{}{0}を{1}">
                                <Binding Path="Name" />
                                <Binding Path="FavoriteTip" />
                            </MultiBinding>
                        </AutomationProperties.Name>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="2,0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding FavoriteGlyph}" FontSize="17">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Star}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </DockPanel>
                <!-- 集計は元の段と同じ4つを、見出しを小さくして1行に -->
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5">
                    <Run Text="所持" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                    <Run Text="{Binding OwnedText, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" /><Run Text="   " />
                    <Run Text="購入総額" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                    <Run Text="{Binding SpentText, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" /><Run Text="   " />
                    <Run Text="容量" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                    <Run Text="{Binding SizeText, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" /><Run Text="   " />
                    <Run Text="最終購入" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                    <Run Text="{Binding LastAcquiredText, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontWeight="Bold" />
                </TextBlock>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
