<Window x:Class="Chmonos.App.Views.SavedSearchNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SavedSearchNameDialogViewModel}"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <StackPanel Margin="22,20">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />

        <!-- 上書きの窓の本文（何が起きるか・戻せないこと） -->
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Text}"
                   AutomationProperties.AutomationId="SavedSearchMessage"
                   Visibility="{Binding HasMessage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <StackPanel Visibility="{Binding ShowsName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="名前" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
            <!-- 新しく名付ける欄なので候補は付けない。今ある名前と同じなら欄の下に「既にあります」 -->
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,4"
                     MaxLength="{x:Static vm:SavedSearchNameDialogViewModel.MaxNameLength}"
                     AutomationProperties.AutomationId="SavedSearchName" AutomationProperties.Name="名前" />
            <TextBlock Text="既にあります" Style="{StaticResource FieldWarning}" Margin="0,4,0,0"
                       Visibility="{Binding IsTaken, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

        <!--
            含める物（ユーザ判断 2026-11-27・案1）。検索文字列は打っている時だけ（無ければ同じ）。
            条件と「対象」「オプション」はいつも含める（保存した検索の中心）ので、選ばせずに下の注記で言う
        -->
        <StackPanel x:Name="PartsPanel" Visibility="{Binding ShowsParts, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="保存に含める" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
            <CheckBox IsChecked="{Binding IncludeText}" Margin="0,0,0,6"
                      AutomationProperties.AutomationId="SavedSearchIncludeText"
                      Visibility="{Binding ShowsTextPart, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="検索文字列" Foreground="{DynamicResource Text}" />
            </CheckBox>
            <CheckBox IsChecked="{Binding IncludeSort}" Margin="0,0,0,6"
                      AutomationProperties.AutomationId="SavedSearchIncludeSort">
                <TextBlock Text="表示順" Foreground="{DynamicResource Text}" />
            </CheckBox>
            <CheckBox IsChecked="{Binding IncludeView}"
                      AutomationProperties.AutomationId="SavedSearchIncludeView">
                <TextBlock Text="カードかリストか" Foreground="{DynamicResource Text}" />
            </CheckBox>
        </StackPanel>

        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding CommitText}" Style="{StaticResource PrimaryButton}" Click="OnCommit"
                    IsDefault="{Binding CommitIsDefault}" IsEnabled="{Binding CanCommit}"
                    AutomationProperties.AutomationId="SavedSearchCommit" />
            <Button x:Name="CancelButton" Content="キャンセル" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
