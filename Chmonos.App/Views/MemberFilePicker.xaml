<UserControl x:Class="Chmonos.App.Views.MemberFilePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MemberFilePickViewModel}">
    <!--
        手で改変に足すときの「使ったファイル」（メモ26-②）。商品ごとに1行（名前と選ぶ欄）。
        改変を選ぶ窓と、改変の詳細で名前で足すときの窓の両方に置く。数が多いときは中で縦に送る
    -->
    <StackPanel>
        <TextBlock Text="使ったファイル" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <controls:ContentItemsControl ItemsSource="{Binding Choices}" Margin="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MemberFileChoice}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding DataContext.ShowsNames, RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                      DisplayMemberPath="Text"
                                      AutomationProperties.AutomationId="MemberFilePick"
                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0}の使ったファイル}" />
                            <!-- 選び直しの窓だけ：同じ商品から2つ入れたとき（依存物と本体）に、2つ目を選ぶと行を2つに分けて記録する -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding AllowsSecond, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="同じ商品から2つ入れたときは、2つ目も選びます。" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Second, Mode=TwoWay}"
                                          DisplayMemberPath="Text"
                                          AutomationProperties.AutomationId="MemberFilePickSecond"
                                          AutomationProperties.Name="{Binding Name, StringFormat={}{0}の2つ目の使ったファイル}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </controls:ContentItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
