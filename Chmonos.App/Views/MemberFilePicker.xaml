<UserControl x:Class="Chmonos.App.Views.MemberFilePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MemberFilePickViewModel}">
    <!--
        手で改変に足すときの「使ったファイル」（メモ26-②）。商品ごとに1行（名前と選ぶ欄）。
        改変を選ぶ窓と、改変の詳細で名前で足すときの窓の両方に置く。数が多いときは中で縦に送る
    -->
    <StackPanel>
        <TextBlock Text="使ったファイル" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <controls:ContentItemsControl ItemsSource="{Binding Choices}" Margin="0,0,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MemberFileChoice}">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding DataContext.ShowsNames, RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <!--
                                欄は人が足したり削除したりできる（ユーザ指示 2026-11-12「二つまでしか選べないのは変」）。1つの欄が記録の1行になる。
                                ほかの欄で選んだ物は押せない（同じファイルの行が2つになると見分けられない）
                            -->
                            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MemberFileSlot}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="×" ContentTemplate="{StaticResource CrossGlyph}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                    ToolTip="この欄を削除します。"
                                                    AutomationProperties.AutomationId="MemberFilePickRemove"
                                                    AutomationProperties.Name="{Binding Owner.Name, StringFormat={}{0}の使ったファイルの欄を削除}"
                                                    Visibility="{Binding CanRemove, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                    Command="{Binding Owner.RemoveSlotCommand}" CommandParameter="{Binding}" />
                                            <ComboBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                                      DisplayMemberPath="Text"
                                                      AutomationProperties.AutomationId="MemberFilePick"
                                                      AutomationProperties.Name="{Binding Owner.Name, StringFormat={}{0}の使ったファイル}">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 選べる物が2つ以上のときだけ。選べる物の数まで足せる -->
                            <Button Content="＋ ファイルを追加" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    ToolTip="同じ商品から2つ以上入れたときに、欄を追加します。"
                                    AutomationProperties.AutomationId="MemberFilePickAdd"
                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0}の使ったファイルの欄を追加}"
                                    Visibility="{Binding AllowsMore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    IsEnabled="{Binding CanAddSlot}"
                                    Command="{Binding AddSlotCommand}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </controls:ContentItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
