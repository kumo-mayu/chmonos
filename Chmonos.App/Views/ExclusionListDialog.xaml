<Window x:Class="Chmonos.App.Views.ExclusionListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        Title="除外の解除" Width="720" Height="560" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        未確定の「除外の解除…」の窓（open.md 132・ユーザ判断 2026-11-19）。中身は設定の欄と同じ共通部品（Controls/ExclusionList）。
        解除は押した所でその場で書く（窓の「OK」は無い）ので、閉じるボタンは「閉じる」だけ。
        一覧は窓に合わせて伸ばす（窓の高さが決まっているので、中だけが流れ、見える分だけ行を作る）
    -->
    <DockPanel Margin="22,20">
        <TextBlock DockPanel.Dock="Top" Text="除外の解除" FontWeight="Bold" FontSize="14" />
        <TextBlock DockPanel.Dock="Top" Text="解除すると、未確定の一覧に戻ります。新しく除外したファイルが上です。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,14" />
        <Button DockPanel.Dock="Bottom" Content="閉じる" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"
                AutomationProperties.AutomationId="ExclusionDialog.Close" Click="OnClose" />
        <controls:ExclusionList x:Name="List" ListName="管理対象から除外したファイル"
                                AutomationProperties.AutomationId="ExclusionDialog.List" />
    </DockPanel>
</Window>
