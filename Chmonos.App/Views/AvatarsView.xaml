<UserControl x:Class="Chmonos.App.Views.AvatarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AvatarsViewModel}">
    <!-- 変換を見ているときの「確認済みにして次へ」。一覧に止まっていても効くよう画面に置く（変換を見ていないときは押せない） -->
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding DecideSuggestedCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 一覧の行の右クリックは、カードと同じメニュー（ユーザ指示 2026-09-20・M2） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
            <!-- 繋がったボタン（タグ・属性の管理と同じ部品・M4） -->
            <ResourceDictionary Source="ManageResources.xaml" />
            <ResourceDictionary Source="RightPaneItemResources.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- 行の右クリック。アバターは商品でもあるので、カードと同じ操作ができる -->
        <Style x:Key="AvatarRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
            <!-- 中クリックで BOOTH の商品ページ（検索のカード・管理の一覧の行と同じ近道・open.md 136）。ID の無い行では何も開かない -->
            <Setter Property="controls:MiddleClick.Command" Value="{Binding DataContext.OpenBoothCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="controls:MiddleClick.CommandParameter" Value="{Binding}" />
            <!-- 付けないと、行の型の名前が読まれる（読み上げ・自動操作）。アバターの名前を読ませる -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.AutomationId" Value="AvatarRow" />
            <Style.Triggers>
                <!--
                    リストの時だけ、行の高さを検索のリストと同じスライダーの値にする（ListRowBase と同じ）。
                    カードの時はカードの大きさで決まるので掛けない。名前・素体・何で当たったかの3段の行は、この下限より伸びる
                -->
                <DataTrigger Binding="{Binding DataContext.IsListMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter Property="MinHeight" Value="{Binding ListRowHeight, Source={x:Static vm:ItemViewSize.Current}}" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            共通素体の一覧の行の右クリック（メモ9-⑦ 2026-10-02）。右の欄の「削除」と同じ道で、同じ確認の窓
            （何件が書き換わるかと、元に戻せないこと）を出してから消す。開くのは一度に1つなので、1つを全行で使い回す
        -->
        <ContextMenu x:Key="AvatarBaseRowMenu">
            <MenuItem Header="削除" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="AvatarBaseRowMenu.Delete" Style="{StaticResource DangerMenuItem}"
                      ToolTip="この共通素体を削除します。元に戻せません。" />
        </ContextMenu>
        <!--
            素体の詳細の「この素体を使っているアバター」の行の右クリック（メモ46）。名前から推した仲間も外せる（印を立てる）ので、
            どの行でも押せる。メニューは画面の木の外にあるので、画面の命令は行の Tag（画面の DataContext）から引く
        -->
        <ContextMenu x:Key="AvatarBaseMemberMenu">
            <MenuItem Header="この素体から外す" Style="{StaticResource DangerMenuItem}" AutomationProperties.AutomationId="AvatarBaseMemberMenu.Remove"
                      Command="{Binding PlacementTarget.Tag.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      ToolTip="外しても、上の欄からまた追加できます。" />
        </ContextMenu>
        <!-- 共通素体の一覧の行。見た目は既定の行のまま、名前と ID と右クリックだけ足す -->
        <Style x:Key="AvatarBaseRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource AvatarBaseRowMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.AutomationId" Value="AvatarBaseRow" />
        </Style>
        <!-- 「変換」の追加した組の行。見た目はプロファイルの商品の行と同じ既定の行で、読み上げの名前は「元 → 先」（右クリックの項目は無い） -->
        <Style x:Key="ConversionPairRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="AutomationProperties.AutomationId" Value="AvatarsConversionPairRow" />
            <Style.Triggers>
                <!--
                    元のまとまりの見出し（ユーザ判断 2026-11-20・④）。選ぶ行にしないので、行の入れ物は止まらず、地も選んだ色も持たない。
                    押す・止まるのは中の三角（見出し全体）だけ。名前と ID は三角が持つ
                -->
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="AutomationProperties.AutomationId" Value="AvatarsConversionPairGroupRow" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 組の右の欄の元・先。押せる（移れる）時はリンクの色、登録簿から消えた物は普通の字で押せない -->
        <!--
            変換の組の端の頭の絵。アバターの行・共通素体の行と同じ升（絵が無ければ頭の字）で、一辺は一覧の右下のスライダーに結ぶ。
            左の組の一覧と右の組の欄で同じ物を出す（2026-11-20・ユーザ「変換画面の右側ビューにもアイコンを出しましょう。」）
            乗せると大きな絵を出す（ユーザ判断 2026-11-20・①。吹き出しの形は ManageResources.xaml の HoverImageTip）
        -->
        <DataTemplate DataType="{x:Type vm:ConversionEndIcon}">
            <Border CornerRadius="8" VerticalAlignment="Center"
                    ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                    Width="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                    Height="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                    Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource AccentSoftText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                           Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="ConversionPairEndLink" TargetType="Button" BasedOn="{StaticResource HubLink}">
            <Setter Property="Foreground" Value="{DynamicResource Link}" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 一覧の1行。選ぶと右に詳細が出る -->
        <DataTemplate x:Key="AvatarRow" DataType="{x:Type vm:AvatarRowViewModel}">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    頭に絵を出す（U18）。まだ取れていないアバターは頭文字のまま。
                    一辺は一覧の右下のスライダー（全画面で共有）に結ぶ。決め打ちの 30 だと、つまみを動かしてもこの一覧だけ変わらなかった（2026-11-18 のメモ）
                    乗せると大きな絵を出す（ユーザ判断 2026-11-20・①）
                -->
                <Border Grid.Column="0" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                        Width="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                        Height="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                        Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource AccentSoftText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                               Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Opacity="{Binding IsExcluded, Converter={x:Static vm:ExcludedOpacityConverter.Instance}}" />
                    <TextBlock Text="{Binding BaseText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding HasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 名前から推した素体は、手で決めた素体と見分けて薄く出す -->
                    <TextBlock Text="{Binding InferredBaseText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="AvatarRowInferredBase"
                               Visibility="{Binding HasInferredBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 呼び方・正式名で当たった行だけ、何で当たったかを添える -->
                    <TextBlock Text="{Binding MatchNote}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentSoftText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasMatchNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Mono}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!--
            一覧の1件のカードの見た目。リスト（詰まった行・AvatarRow）とカード（検索と同じ）を選べる（ユーザ指示 2026-09-20・M4）。
            **見せ分けは一覧に渡す型そのものを替える**（下の一覧の Style。メモ9-① 2026-10-02）。前は1つの型にリストとカードの両方を持ち、
            先祖の画面をたどって片方を隠していた。使い回した行や、まだ画面の木に付いていない行では先祖をたどれず、
            リストにしてもカードの出たままの行が混ざった。型を替えると一覧は行を全部作り直すので、前の見せ方の行は残らない。

            カードでも、リストに出ている情報を落とさない（ユーザ指摘 2026-09-20）。
            対応数は右上の札に、素体名はその札のツールチップに（素体名は長く、カードの幅に収まらない）。
            「アバターとして扱わない」印は、リストと同じ薄さで示す
        -->
        <DataTemplate x:Key="AvatarCard" DataType="{x:Type vm:AvatarRowViewModel}">
            <Grid HorizontalAlignment="Left" Opacity="{Binding IsExcluded, Converter={x:Static vm:ExcludedOpacityConverter.Instance}}">
                <!-- 持っていない物の札（下）は左に付くので、ContentControl も左に付ける。そのままだと伸びてカードが中央に寄った（メモ69） -->
                <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding HasCard, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!--
                    名前が挙がっただけで手元に商品が無いアバターの札。商品のカードを当てると、
                    中の結び付け先が全部外れて札が全部出てしまう（「所持」と「未所持」が同時に出ていた）。
                    出せる情報（絵か頭文字・名前・素体）だけをカードと同じ大きさで並べる
                -->
                <Border Style="{StaticResource Card}" Width="{DynamicResource CardWidth}" Height="{DynamicResource CardHeight}"
                        Margin="0,0,14,14" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding HasCard, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="11,0,11,11">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BaseText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding InferredBaseText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasInferredBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <!-- 検索が商品を読み終えるまでは添えない。持っているアバターまで手元に無いと言っていた（2026-10-02） -->
                            <TextBlock Text="この名前の商品は手元にありません" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsMissingNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                        <Grid Background="{DynamicResource ImageBack}">
                            <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource PlaceholderGlyph}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,21,0"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,1"
                        ToolTip="{Binding BaseText}" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 見る物の切り替えボタン（U16）。今見ている方を太字と色で示す -->
        <!-- 改変の行の見た目は改変の画面と同じ（ユーザ指示 2026-09-17：アバターの管理の改変を改変の画面のアバターの項目に揃える） -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- 名前の欄の確定。窓の確定と同じ色で、横の「キャンセル」と同じ高さにする -->
        <Style x:Key="InlinePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- 共通素体1つの管理。素体を見ているときに、右に選んだ1つだけを出す -->
        <DataTemplate x:Key="BaseCard" DataType="{x:Type vm:AvatarBaseRowViewModel}">
            <Border Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <DockPanel SizeChanged="BaseCardBody_SizeChanged">
                    <!--
                        素体の画像（ユーザ判断 2026-11-20・152 の案A）。付けた画像 → 素体の商品の1枚目 → 頭の字。
                        付ける・外すは絵のすぐ下に置く（ほかの欄と同じく、触る物のそばに操作を置く）。「外す」は付けた画像があるときだけ。
                        絵の分（132）だけ右が狭くなり、窓の幅 900 では名前が「削除」の下に潜り、欄が切れた。狭いときは絵を上に置き（BaseCardBody_SizeChanged）、右の行も折り返す（WrapPanel）。
                        名前の行の右の 56 は「削除」の幅
                    -->
                    <StackPanel DockPanel.Dock="Left" Width="112" Margin="0,0,20,0">
                        <Border Width="112" Height="112" CornerRadius="8" Background="{DynamicResource AccentSoft}" ClipToBounds="True"
                                ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                                AutomationProperties.AutomationId="AvatarBaseImage">
                            <Grid>
                                <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource AccentSoftText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Picture}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            </Grid>
                        </Border>
                        <Button AutomationProperties.AutomationId="AvatarBasePickImage" Content="{Binding PickImageText}" Style="{StaticResource SmallButton}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding PickImageCommand}"
                                ToolTip="一覧とこの欄に表示する画像を選びます。" />
                        <Button AutomationProperties.AutomationId="AvatarBaseRemoveImage" Content="画像を外す" Style="{StaticResource DangerButton}"
                                Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding RemoveImageCommand}"
                                ToolTip="素体の商品の画像に戻します。"
                                Visibility="{Binding HasOwnImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock DataContext="{Binding ImageNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="AvatarBaseImageNote" />
                    </StackPanel>
                    <StackPanel>
                        <!--
                            名前は普段は文字で出し、「名前を変更」で欄にする（ユーザ判断 2026-09-29。アバターの名前と同じ形）。
                            枠の無い欄を常に出していたら、名前を変えられることが分からなかった。
                            言い方と作法はタグの管理の「名前を変更」の窓に揃える：Enter で確定・Esc で取り消し
                        -->
                        <WrapPanel Margin="0,0,56,0"
                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Margin="6,3"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                            <Button AutomationProperties.AutomationId="AvatarBaseRename" Content="名前を変更" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding StartRenameCommand}" Click="StartRename_Click"
                                    ToolTip="この素体の名前を使っている商品も一緒に書き換えます。" />
                        </WrapPanel>
                        <WrapPanel
                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBox AutomationProperties.AutomationId="AvatarBaseNameInput" MaxLength="60" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="19" FontWeight="Bold" MinWidth="240" MaxWidth="460"
                                     Padding="6,3" VerticalAlignment="Center"
                                     AutomationProperties.Name="新しい名前"
                                     IsVisibleChanged="NameEditor_IsVisibleChanged">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button AutomationProperties.AutomationId="AvatarBaseRenameCommit" Content="変更" AutomationProperties.Name="名前を変える" Style="{StaticResource InlinePrimaryButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding RenameCommand}"
                                    IsEnabled="{Binding HasNameChange}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="今と違う名前を入れると押せます。" />
                            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding CancelRenameCommand}" />
                        </WrapPanel>
                        <TextBlock DataContext="{Binding NameNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0" />
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding MemberText}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding ItemText}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding ItemIdText}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                        </WrapPanel>
                        <!-- 素体そのものの商品の候補。自動では結ばず、押したら結ぶ（ユーザ指摘 2026-09-17：素体単体の配布を検知できていなかった） -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding ShowsItemCandidates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="素体の名前を含む商品" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:ContentItemsControl ItemsSource="{Binding ItemCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                            <Button AutomationProperties.AutomationId="AvatarBaseCandidateUse" AutomationProperties.Name="{Binding Label, StringFormat={}{0}を素体の商品に設定}" Content="素体の商品に設定" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                    Command="{Binding UseCommand}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </StackPanel>
                        <!--
                            配布されている素体は商品に結べる。
                            結ぶと素体のページへ行けるようになり、所有の判定にも使える。
                        -->
                        <WrapPanel Margin="0,12,0,0">
                            <!-- 空のままだと何を入れる欄か分からないので、内側に案内を出す（ユーザ指示 2026-09-17） -->
                            <Grid Width="230" VerticalAlignment="Center" Margin="0,0,8,4">
                                <TextBox AutomationProperties.AutomationId="AvatarBaseItemId" AutomationProperties.Name="素体の商品のIDかURL" Padding="7,4"
                                         Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="商品IDかURLを入れます。空にすると紐付けが外れます。">
                                    <!-- Enter で決められるように揃える（I12） -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SetItemIdCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="素体の商品のIDかURL" Margin="10,0,0,0" Style="{StaticResource InputPlaceholder}"
                                           Visibility="{Binding ItemIdInput, Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                            </Grid>
                            <Button AutomationProperties.AutomationId="AvatarBaseSetItemId" Content="素体の商品を設定" Style="{StaticResource SmallButton}" Margin="0,0,0,4"
                                    VerticalAlignment="Center" Command="{Binding SetItemIdCommand}" />
                        </WrapPanel>
                        <TextBlock DataContext="{Binding ItemIdNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0" />
                        <!-- 説明が無く何のことか分からず、実例も無いので隠す（ユーザ判断 2026-09-17）。仕組み（inferClothing）は残す -->
                        <CheckBox Content="衣装の互換を広げる" IsChecked="{Binding InferClothing, Mode=OneWay}" Visibility="Collapsed"
                                  Command="{Binding ToggleInferCommand}" Margin="0,12,0,0"
                                  Foreground="{DynamicResource Text}"
                                  ToolTip="衣装が合わない組だけ外してください。外すと素体経由の衣装が表示されなくなります。" />
                    </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <!-- 取り返しがつかないので、そうと分かる顔にする（V4） -->
                        <Button AutomationProperties.AutomationId="AvatarBaseDelete" AutomationProperties.Name="この共通素体を削除" Content="削除" Style="{StaticResource DangerButton}"
                                ToolTip="この共通素体を削除します。元に戻せません。"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
      </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <!--
                左は残りの幅だけを使い、説明は入り切らなければ「…」で切る。横の StackPanel だと幅を測らずに伸び、
                幅900で説明が右の「対応アバターを検出する」の下に潜っていた（2026-11-20。統計の見出しと同じ省き方）
            -->
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- 戻る（U23）。商品ページの札から来たときに、元の商品へ戻れるように -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                Visibility="{Binding CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding BackText}" Command="{Binding BackCommand}" BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="アバターの管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock Text="対応アバターの名前と共通素体、変換ツールのプロファイルを管理します"
                               Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!--
                        普通のボタンの見た目にする（2026-11-18 のメモ・ユーザ判断）。検出は取り込み・未確定の登録・起動時の間隔で自動で走るので、
                        この画面の主の操作ではない。青にすると押すべき物に見える
                    -->
                    <Button Content="{Binding DetectButtonText}"
                            Command="{Binding DetectCommand}"
                            ToolTip="{Binding DetectHint}" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            検出の途中経過と結果、素体を削除した結果（画面全体の状態と、押した所ごと消える操作の結果）。上の段の右に出していたときは
            幅520で「…」に切れ、検出の結果の長い文が読めなかった（2026-10-03 のユーザ判断：切らずに折り返して全部見せる）。
            出ていない間は場所を取らない。出るのは検出を押したときなど、人が押した直後の1回だけ
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,7"
                Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AvatarsStatus" />
        </Border>

        <Grid>
            <TextBlock Text="読み込んでいます…" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />


            <controls:PaneGrid Visibility="{Binding IsLoading, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}"
                  Pane="{Binding ListPane}" OppositeWidth="{Binding DetailWidthWanted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                      MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
                <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                       ResetCommand="{Binding ListPane.ResetCommand}"
                                       Visibility="{Binding ListPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!--
                    左の一覧を畳む・広げるつまみ（open.md 51。検索の絞り込みと同じ）。畳んでいる間は境目を出さない。
                    帯の名前は今の見方の名前（アバター・共通素体・変換。2026-11-20：決め打ちの「アバター」だと、共通素体・変換を見ていても「アバター」と出ていた）
                -->
                <controls:PaneCollapseToggle Grid.Column="0" Pane="{Binding ListPane}" Label="{Binding ListPaneLabel}" AutomationKey="AvatarsToggleList" />

                <!-- 左：アバターの一覧。所有しているものを先に出す -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                        Visibility="{Binding ListPane.IsCollapsed, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <DockPanel>
                        <!--
                            見る物の切り替え（U16）。以前は共通素体の管理がどのアバターの詳細の下にも付いて回り、
                            今どちらの話をしているのかが分からなかった
                        -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,14,14,0">
                            <Button Content="{Binding AvatarModeText}" Command="{Binding ShowAvatarModeCommand}"
                                    ToolTip="アバターを1体ずつ見て、名前・所有・共通素体を設定します。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvatarMode}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding BaseModeText}" Command="{Binding ShowBaseModeCommand}" Margin="6,0,0,0"
                                    ToolTip="複数のアバターが使っている共通の体（素体）を見て、名前や配布商品を設定します。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBaseMode}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 変換ツールのプロファイルの変換扱いを、未確定のように順に決める（docs/spec/conversion.md・ユーザ判断 2026-11-06） -->
                            <Button Content="{Binding ConversionModeText}" Command="{Binding ShowConversionModeCommand}" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="AvatarsConversionMode"
                                    ToolTip="変換ツールのプロファイルが、どのアバター・共通素体の物かを決めます。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConversionMode}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!--
                            追加した組を探す欄（2026-11-20・ユーザ「元と先、両方を指定できる形の文字列(他のアバター検索UIと同じ形)検索」）。
                            欄の見た目・案内の文・当てる語は「アバター」の見方の探す欄と同じ（共通素体は名前）。探す所は、つながったボタンで両方・元・先（既定は両方）。
                            追加した組と、下のプロファイルの商品の一覧の両方を絞る（ユーザ判断 2026-11-20・②）。商品は、つなぎ先を向きで元（逆方向）と先（順方向）に分けて当て、
                            商品名は「両方」の時だけ当てる（ConversionItemSearch）
                        -->
                        <StackPanel DockPanel.Dock="Top" Margin="14,12,14,0" DataContext="{Binding ConversionPairs}"
                                    Visibility="{Binding DataContext.IsConversionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Grid>
                                <TextBox x:Name="ConversionPairSearchBox" Padding="8,6" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         AutomationProperties.Name="名前・ID・呼び方で探す" AutomationProperties.AutomationId="AvatarsConversionPairSearch"
                                         ToolTip="追加した組とプロファイルの商品を、名前・ID・呼び方で絞り込みます。" />
                                <!-- 案内は欄そのものの字で出し分ける。Query は打ってから 200ms 遅れて入るので、それで決めると打った字と重なった（ユーザ判断 2026-11-20・①） -->
                                <TextBlock Text="名前・ID・呼び方で探す" Margin="11,0,0,0" Style="{StaticResource InputPlaceholder}"
                                           Visibility="{Binding Text.IsEmpty, ElementName=ConversionPairSearchBox, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="探す所" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,8,0" />
                                <controls:CommandRadioButton Content="両方" GroupName="ConversionPairSearchScope" Style="{StaticResource SegmentFirst}"
                                                             Command="{Binding SetScopeCommand}" CommandParameter="both"
                                                             IsChecked="{Binding IsScopeBoth, Mode=OneWay}"
                                                             AutomationProperties.AutomationId="AvatarsConversionPairSearchBoth"
                                                             ToolTip="元と先のどちらかに当たる組と商品を表示します。" />
                                <controls:CommandRadioButton Content="元" GroupName="ConversionPairSearchScope" Style="{StaticResource SegmentMiddle}"
                                                             Command="{Binding SetScopeCommand}" CommandParameter="from"
                                                             IsChecked="{Binding IsScopeFrom, Mode=OneWay}"
                                                             AutomationProperties.AutomationId="AvatarsConversionPairSearchFrom"
                                                             ToolTip="元に当たる組と商品だけを表示します。" />
                                <controls:CommandRadioButton Content="先" GroupName="ConversionPairSearchScope" Style="{StaticResource SegmentLast}"
                                                             Command="{Binding SetScopeCommand}" CommandParameter="to"
                                                             IsChecked="{Binding IsScopeTo, Mode=OneWay}"
                                                             AutomationProperties.AutomationId="AvatarsConversionPairSearchTo"
                                                             ToolTip="先に当たる組と商品だけを表示します。" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            まとめて確認済みにして書けなかった時の1行。ボタンはプロファイルの商品の群の見出しにある（ユーザ判断 2026-11-20・④）。
                            見出しは書いた後に作り直されるので、知らせは一覧の上に残す
                        -->
                        <StackPanel DockPanel.Dock="Top" Margin="14,4,14,0"
                                    Visibility="{Binding IsConversionMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <controls:AreaNoticeLine DataContext="{Binding BulkNotice}" />
                        </StackPanel>

                        <!--
                            人が足す変換の組（ユーザ判断 2026-11-20・avatar2avatar）。プロファイルの無いツールでも、元と先の両方にアバターか共通素体を選んで足す。
                            行はプロファイルの商品と同じ形（字だけ・同じ選び方）で、選ぶと右に組の中身（元・先・メモ・外す）を出す（ユーザ判断 2026-11-20）。
                            畳めるようにし、一覧は高さに上限を付けて中で流す（組が増えてもプロファイルの一覧を押し潰さない）。「逆も」は置かない（逆はもう1つの組で足す）。
                            「組を追加」は一覧の上（ユーザ判断 2026-11-20・②：下だと組が増えるたびに押し下げられた）。行は元と先の絵付きで、いつも元でまとめ、
                            元の見出しで畳める（同じ判断の①④）。並びは元の名前と追加した順（③）
                        -->
                        <Expander DockPanel.Dock="Top" Margin="14,10,14,0" DataContext="{Binding ConversionPairs}"
                                  Style="{StaticResource TriangleExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="追加した組" AutomationProperties.AutomationId="AvatarsConversionPairs"
                                  Visibility="{Binding DataContext.IsConversionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Expander.Header>
                                <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,6"
                                           Visibility="{Binding HasRows, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}"
                                           Text="プロファイルが無くても、元のアバター用の衣装を先に着せられる組を追加できます。" />

                                <!--
                                    組を追加：元と先を候補付きの欄で選び（左の欄は狭いので縦に積む）、「追加」を押した時だけ足す（ユーザ判断 2026-11-20）。
                                    候補を決めても足さないので、欄に CommitCommand を付けない。Enter は「追加」と同じ（候補が出ている間の Enter は候補を決めるだけ）
                                -->
                                <StackPanel Margin="0,4,0,0" AutomationProperties.AutomationId="AvatarsConversionPairAddArea">
                                    <StackPanel.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                    </StackPanel.InputBindings>
                                    <TextBlock Text="組を追加" Style="{StaticResource Caption}" Margin="2,2,0,4" />
                                    <controls:SuggestBox Source="{Binding Suggestions}" Text="{Binding FromText, Mode=TwoWay}"
                                                         IconSelector="{Binding IconSelector}" InfoSelector="{Binding InfoSelector}"
                                                         GroupHeadings="{Binding GroupHeadings}"
                                                         AllowNew="False" KeepsCommittedText="True" Placeholder="元のアバターか共通素体"
                                                         AutomationProperties.AutomationId="AvatarsConversionPairFrom" />
                                    <TextBlock Text="↓" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,2" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                Command="{Binding AddCommand}" AutomationProperties.AutomationId="AvatarsConversionPairAdd"
                                                ToolTip="元の衣装を先に着せられる組を追加します。" />
                                        <controls:SuggestBox Source="{Binding Suggestions}" Text="{Binding ToText, Mode=TwoWay}"
                                                             IconSelector="{Binding IconSelector}" InfoSelector="{Binding InfoSelector}"
                                                             GroupHeadings="{Binding GroupHeadings}"
                                                             AllowNew="False" KeepsCommittedText="True" Placeholder="先のアバターか共通素体"
                                                             AutomationProperties.AutomationId="AvatarsConversionPairTo" />
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock DataContext="{Binding Notice}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarsConversionPairNotice" />

                                <!-- 並び（ユーザ判断 2026-11-20・③）。選んだ並びは覚える（ui-state） -->
                                <DockPanel Margin="0,8,0,2" Visibility="{Binding HasRows, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock DockPanel.Dock="Left" Text="並び" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,8,0" />
                                    <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSortChoice, Mode=TwoWay}"
                                              DisplayMemberPath="Label" Height="26" FontSize="12" HorizontalAlignment="Left" MinWidth="140"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.Name="追加した組の並び" AutomationProperties.AutomationId="AvatarsConversionPairSort" />
                                </DockPanel>

                                <!--
                                    行と、元ごとのまとまりの見出し（ユーザ判断 2026-11-20・④）。見出しは選ぶ行ではなく畳むだけ（右に出す物は商品か組のどちらか1つで、
                                    まとまりには出す中身が無い）。見出しの行は止まらない入れ物にし、中の三角（見出し全体）が止まる。
                                    ↑↓・Home・End は行と見出しを渡り（行なら選ぶ）、見出しで Enter・Space は開閉、← で畳み → で開く（AvatarsView.xaml.cs。通知の束の見出しと同じ）
                                -->
                                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ConversionPairRowStyle}"
                                         PreviewKeyDown="ConversionPairList_PreviewKeyDown"
                                         BorderThickness="0" Background="Transparent" MaxHeight="260"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="追加した組" AutomationProperties.AutomationId="AvatarsConversionPairRows"
                                         Visibility="{Binding HasVisibleRows, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ListBox.Resources>
                                        <DataTemplate DataType="{x:Type vm:ConversionPairGroup}">
                                            <controls:ExpandToggle IsChecked="{Binding IsExpanded, Mode=TwoWay}" Subject="{Binding Subject}" Cursor="Hand"
                                                                   FocusVisualStyle="{StaticResource RowFocusVisual}" HorizontalContentAlignment="Stretch"
                                                                   AutomationProperties.AutomationId="AvatarsConversionPairGroup" Margin="0,6,0,2">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Back" Background="Transparent" CornerRadius="5" Padding="2,3">
                                                            <DockPanel>
                                                                <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <Ellipse x:Name="Ring" Fill="{DynamicResource SurfaceAlt}" Stroke="{DynamicResource Border}" StrokeThickness="1" />
                                                                    <Path x:Name="Mark" Data="M0,0 L8,6 L0,12 Z" Fill="{DynamicResource TextMuted}"
                                                                          Width="8" Height="12" Stretch="Fill" Margin="2,0,0,0"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L12,0 L6,8 Z" />
                                                                <Setter TargetName="Mark" Property="Width" Value="12" />
                                                                <Setter TargetName="Mark" Property="Height" Value="8" />
                                                                <Setter TargetName="Mark" Property="Margin" Value="0" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                                                <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding Icon}" Margin="0,0,8,0" />
                                                    <!-- 見出しの名前は行と同じ字の大きさで太く（行より小さい見出しの字だと、元の名前が行より目立たなかった） -->
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,4,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </DockPanel>
                                            </controls:ExpandToggle>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type vm:ConversionPairRow}">
                                            <!-- 元と先の絵（①）、プロファイルの商品の行と同じ字の大きさの「元 → 先」と、メモの1行目。見出しの中なので少し下げる -->
                                            <DockPanel Margin="14,3,0,5">
                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding FromIcon}" Margin="0,0,4,0" />
                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding ToIcon}" Margin="0,0,10,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                                    <TextBlock Text="{Binding MemoPreview}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasMemo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.Resources>
                                </ListBox>

                                <!-- 探して0件と、組がまだ無いのを言い分ける（E2。「アバター」の見方と同じ） -->
                                <StackPanel Margin="2,6,0,0" HorizontalAlignment="Left"
                                            Visibility="{Binding ShowsNoMatches, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="打ち込んだ言葉に当てはまる組がありません。"
                                               AutomationProperties.AutomationId="AvatarsConversionPairNoMatch" />
                                    <Button Content="絞り込みを消す" Style="{StaticResource SmallButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding ClearQueryCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 一覧をカードで見るかリストで見るか（ユーザ指示 2026-09-20・M4） -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,14,0"
                                    Visibility="{Binding IsAvatarMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <controls:CommandRadioButton Content="カード" GroupName="AvatarsView" Style="{StaticResource SegmentFirst}"
                                         IsChecked="{Binding IsCardMode, Mode=OneWay}" Command="{Binding ShowCardsCommand}"
                                         ToolTip="絵の大きなカードで並べます" />
                            <controls:CommandRadioButton Content="リスト" GroupName="AvatarsView" Style="{StaticResource SegmentLast}"
                                         IsChecked="{Binding IsListMode, Mode=OneWay}" Command="{Binding ShowListCommand}"
                                         ToolTip="名前が読める詰まった行で並べます" />
                        </StackPanel>

                        <Grid DockPanel.Dock="Top" Margin="14,12,14,10"
                              Visibility="{Binding IsAvatarMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBox x:Name="AvatarSearchBox" Padding="8,6" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 AutomationProperties.Name="名前・ID・呼び方で探す"
                                     ToolTip="アバター名・商品ID・BOOTHでの正式名・呼び方で絞り込みます。" />
                            <!--
                                空欄のままだと何を入れる欄か分からないので、内側に案内を出す。
                                出し分けは欄そのものの字で（Query は 200ms 遅れて入るので、それで決めると打った字と重なった。ユーザ判断 2026-11-20・①）
                            -->
                            <TextBlock Text="名前・ID・呼び方で探す" Margin="11,0,0,0" Style="{StaticResource InputPlaceholder}"
                                       Visibility="{Binding Text.IsEmpty, ElementName=AvatarSearchBox, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>

                        <!--
                            共通素体を探して足す欄（ユーザ判断 2026-11-20・⑤。前は探す欄と足す欄が縦に2本あった）。タグの管理の小分類の欄と同じく1本にし、右に「追加」。
                            打つと一覧を絞る（素体の名前か、素体に入ったアバターの名前・ID・正式名・呼び方。アバターで当たった行には何で当たったかを添える）。
                            候補は素体に入ったアバターの名前で、探すための物（素体の名前は候補にしない。新しく名付ける欄に今ある名前を並べると重複を誘う・ui-input.md）。
                            Enter：アバターの候補ならその名前で絞り、ほかの語は素体として足す（同じ名前の素体があれば選んで「既にあります」）。「追加」はいつも足す。
                            打ってすぐの Enter・「追加」は、結び付けの待ち（Delay=200）を先に流し込む（AvatarsView.xaml.cs。SearchAddBox と同じ）
                        -->
                        <DockPanel DockPanel.Dock="Top" Margin="14,12,14,0"
                                   Visibility="{Binding IsBaseMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="AvatarBaseAdd" Click="BaseAdd_Click"
                                    ToolTip="打った名前の共通素体を追加します。"
                                    Command="{Binding AddBaseCommand}" />
                            <controls:SuggestBox x:Name="BaseSearchBox" Text="{Binding BaseQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                                 Source="{Binding BaseSearchCandidates}" CommitCommand="{Binding BaseSearchCommitCommand}"
                                                 InfoSelector="{Binding BaseSearchInfoSelector}" GroupHeadings="{x:Static vm:AvatarSuggestionText.Headings}"
                                                 IconSelector="{Binding BaseSearchIconSelector}"
                                                 AllowNew="False" KeepsCommittedText="True" MaxLength="60"
                                                 Placeholder="素体・アバターを探す、または素体を追加"
                                                 PreviewKeyDown="BaseSearchBox_PreviewKeyDown"
                                                 AutomationProperties.Name="素体・アバターを探す、または素体を追加" AutomationProperties.AutomationId="AvatarBaseSearch"
                                                 ToolTip="共通素体を、素体の名前か入っているアバターで絞り込みます。" />
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" DataContext="{Binding AddBaseNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="16,4,14,0"
                                   AutomationProperties.AutomationId="AvatarBaseAddNote"
                                   Visibility="{Binding DataContext.IsBaseMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!-- アバターの一覧の右下の大きさのスライダー（検索と同じ。メモ10-④ 2026-10-02）。素体を見ているときは出さない -->
                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSizeBar}" Focusable="False"
                                        Visibility="{Binding IsAvatarMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!--
                            一覧は1つのListBoxにまとめ、所有／未所有はグループ見出しで分ける。
                            ListBoxを2つ縦に積んでScrollViewerへ入れると高さが無限になり、描画が壊れる。
                        -->
                        <Grid>
                            <!--
                                見出しでまとめると、WPFは既定で見える行だけ作るのをやめ、全行（約400）を作る。
                                行に絵を足したら（U18）、画面を開いてから一覧が出るまでが3.7〜4.6秒から4.9〜6.2秒に延びた。
                                まとめていても見える行だけ作らせると1.1〜1.8秒になった
                            -->
                            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     SelectionChanged="AvatarList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource AvatarRowStyle}" Tag="{Binding}"
                                     BorderThickness="0" Background="Transparent" Margin="14,0,14,14"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding IsAvatarMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!-- リストかカードかは、渡す型そのものを替える（メモ9-①。AvatarCard の上の説明） -->
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="ItemTemplate" Value="{StaticResource AvatarCard}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource AvatarRow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <!--
                                    見出しごとに畳める（ユーザ指示）。400体の中で見たいのは所有している数体と、
                                    見直すときの「扱わないもの」なので、残りを畳んでおけるようにする。
                                    畳んだ状態は画面を開き直しても残す（コードビハインドで ViewModel に預ける）
                                -->
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Style="{StaticResource TriangleExpander}" IsExpanded="True" Margin="0,8,0,2"
                                                                      Loaded="GroupExpander_Loaded"
                                                                      Expanded="GroupExpander_Changed"
                                                                      Collapsed="GroupExpander_Changed">
                                                                <Expander.Header>
                                                                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="（" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text="）" /></TextBlock>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>

                            <!-- 共通素体の一覧。選ぶと右にその素体の管理と、使っているアバターが出る -->
                            <ListBox ItemsSource="{Binding ShownBases}" SelectedItem="{Binding SelectedBase, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource AvatarBaseRowStyle}"
                                     BorderThickness="0" Background="Transparent" Margin="14,12,14,14"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding IsBaseMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AvatarBaseRowViewModel}">
                                        <!-- 頭に絵を出す（152：配布されていない素体は名前だけで見分けにくかった）。大きさと形はアバターの行に揃える -->
                                        <Grid Margin="0,3,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                                                    Width="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                                                    Height="{Binding ListIconSize, Source={x:Static vm:ItemViewSize.Current}}"
                                                    Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource AccentSoftText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MemberText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                <!-- 名前でなく入ったアバターで当たった行だけ、何で当たったかを添える（「アバター」の見方の行と同じ色・ユーザ判断 2026-11-20・⑤） -->
                                                <TextBlock Text="{Binding MatchNote}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource AccentSoftText}" TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.AutomationId="AvatarBaseRowMatchNote"
                                                           Visibility="{Binding HasMatchNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--
                                変換ツールのプロファイルを持つ商品（ユーザ判断 2026-11-09：決めていない物を上に群で分ける）。
                                行の頭に商品の絵（ユーザ判断 2026-11-20・③。取り込みの探した結果・通知と同じ ResultThumbnail で、見えた行だけが縮めて読む）。
                                群で分けると WPF は既定で全行を作るので、上の「アバター」の一覧と同じく見える行だけ作らせる（作った行の分だけ絵を読むため）。
                                決めていない・途中の行には「確認待ち 3・未設定 2」の数を添える
                            -->
                            <ListBox ItemsSource="{Binding ConversionItems}" SelectedItem="{Binding SelectedConversion, Mode=TwoWay}"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource AvatarBaseRowStyle}"
                                     BorderThickness="0" Background="Transparent" Margin="14,0,14,14"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="AvatarsConversionList"
                                     Visibility="{Binding IsConversionMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Style="{StaticResource TriangleExpander}" IsExpanded="True" Margin="0,8,0,2">
                                                                <Expander.Header>
                                                                    <!--
                                                                        群は見出しの物（ConversionItemGroupHeader：名前と数。絞っている間は「当たった数/全部」）で分けてある。
                                                                        「決めていない」「途中」の見出しの右に、その群の分だけをまとめて確認済みにするボタン（ユーザ判断 2026-11-20・④。
                                                                        効く相手のそばに置く。確認待ちが無い群には出さない）。押すと対象を並べた窓を出し、外したい物はチェックを外せる。
                                                                        左の最小の幅では、ボタンは見出しの下へ折り返す
                                                                    -->
                                                                    <WrapPanel>
                                                                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,10,4" VerticalAlignment="Center" Text="{Binding Name.Text, Mode=OneWay}" />
                                                                        <Button Content="{Binding Name.BulkText, Mode=OneWay}" Command="{Binding Name.BulkConfirmCommand}"
                                                                                Style="{StaticResource SmallButton}" Margin="0,0,0,4" VerticalAlignment="Center"
                                                                                AutomationProperties.AutomationId="AvatarsConversionBulk"
                                                                                ToolTip="この群の確認待ちを一覧で見て、まとめて確認済みにします。"
                                                                                Visibility="{Binding Name.ShowsBulk, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    </WrapPanel>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConversionItemRowViewModel}">
                                        <DockPanel Margin="0,3,0,3">
                                            <!-- 枠は名前と札の2行の高さの 36（ファイルの割り振りの左の行と同じ）。絵が届くまで・絵の無い商品は頭文字 -->
                                            <!-- 乗せると大きな絵（ユーザ判断 2026-11-20・①）。吹き出しは Picture の HoverImage を引くので、枠の DataContext を Picture にする -->
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    DataContext="{Binding Picture}"
                                                    ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                                                    Background="{DynamicResource ThumbBack}" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FontSizeHeading}" Foreground="{DynamicResource TextMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,2,0,0"
                                                           Visibility="{Binding HasBadge, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource Caption}" Margin="18,16,18,0" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsNoConversionItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                       Text="変換ツールのプロファイルを含む商品はまだありません。取り込むと、ここに並びます。" />

                            <!-- 探して0件と、そもそも1件も無いのを言い分ける（追加した組・「アバター」の見方と同じ。語は上の組を探す欄の物） -->
                            <StackPanel Margin="18,16,18,0" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowsNoMatchingConversionItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="打ち込んだ言葉に当てはまる商品がありません。"
                                           AutomationProperties.AutomationId="AvatarsConversionNoMatch" />
                                <Button Content="絞り込みを消す" Style="{StaticResource SmallButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Command="{Binding ConversionPairs.ClearQueryCommand}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Caption}" Margin="18,16,18,0" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsNoBases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                       Text="共通素体はまだありません。上の欄に素体の名前を入れると追加できます。" />

                            <!-- 探して0件と、そもそも1つも無いのを言い分ける（E2。「アバター」の見方と同じ） -->
                            <StackPanel Margin="18,16,18,0" HorizontalAlignment="Left"
                                        Visibility="{Binding ShowsNoMatchingBases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="打ち込んだ言葉に当てはまる共通素体がありません。" />
                                <Button Content="絞り込みを消す" Style="{StaticResource SmallButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Command="{Binding ClearBaseQueryCommand}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--
                    右：選んだアバターの詳細と、共通素体の管理。右の「商品ページを開く」で開いた商品ページは上に重ね、こちらは隠すだけ
                    （open.md 95 行。フォルダ・改変の画面と同じ）。Collapsed でなく Hidden にするのは、戻った時に流した位置を切り詰めないため
                -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RightItem.IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <!-- 文章と入力が主なので最大幅で止め、中央に寄せる（ユーザ判断 2026-09-23。広い窓で枠だけ横に伸び、中身は左に寄っていた） -->
                    <StackPanel MaxWidth="{StaticResource ReadingMaxWidth}">

                        <Border Style="{StaticResource Card}" Padding="22,18"
                                Visibility="{Binding ShowsAvatarDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                        名前の左に絵を大きく出す（ユーザ指示）。似た名前のアバターを一目で見分けるため。
                                        高さは名前・正式名・IDの3行ぶん。保存している絵は長辺384px（読み込みは96相当）
                                        なので、この大きさなら拡大でぼやけない
                                    -->
                                    <!-- 乗せると大きな絵（ユーザ判断 2026-11-20・①）。吹き出しが行の HoverImage を引くので、枠の DataContext を選んだ行にする -->
                                    <Border Grid.Column="0" Grid.RowSpan="2" Width="84" Height="84" CornerRadius="10" Margin="0,2,16,0"
                                            DataContext="{Binding Selected}"
                                            ToolTip="{DynamicResource HoverImageTip}" ToolTipService.IsEnabled="{Binding HasHoverImage, FallbackValue=False}" ToolTipService.InitialShowDelay="300"
                                            VerticalAlignment="Top" Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentSoftText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <!-- 表示名は短くしてある。編集できるようにし、正式名は下に添える -->
                                        <!--
                                            普段は名前を文字で出し、「名前を変更」で欄にする（ユーザ判断 2026-09-29）。
                                            枠の無い欄を常に出していたら、名前を変えられることが分からなかった。
                                            言い方と作法はタグの管理の「名前を変更」の窓に揃える：Enter で確定・Esc で取り消し
                                        -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                                            <RichTextBox Style="{StaticResource SelectableBody}" controls:SelectableText.FitWidth="True" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="4,3" MaxWidth="520" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectedName}" controls:SelectableText.PlainText="True" controls:SelectableText.Text="{Binding SelectedName}" />
                                            <Button AutomationProperties.AutomationId="AvatarRename" Content="名前を変更" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding StartRenameCommand}" Click="StartRename_Click"
                                                    ToolTip="このアプリで表示する名前を変えます。" />
                                            <!-- 付けた名前を消す操作は、欄を空にする形では分からないのでボタンで名乗る（ユーザ指示） -->
                                            <Button Content="BOOTHの名前に戻す" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding ResetNameCommand}"
                                                    ToolTip="{Binding ResetNameTip}"
                                                    Visibility="{Binding HasManualName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBox AutomationProperties.AutomationId="AvatarNameInput" MaxLength="60" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="19" FontWeight="Bold" MinWidth="240" MaxWidth="520"
                                                     Padding="6,3" VerticalAlignment="Center"
                                                     AutomationProperties.Name="新しい名前"
                                                     IsVisibleChanged="NameEditor_IsVisibleChanged">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button AutomationProperties.AutomationId="AvatarRenameCommit" Content="変更" AutomationProperties.Name="名前を変える" Style="{StaticResource InlinePrimaryButton}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding RenameCommand}"
                                                    IsEnabled="{Binding HasNameChange}" ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="今と違う名前を入れると押せます。" />
                                            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding CancelRenameCommand}" />
                                        </StackPanel>
                                        <TextBlock DataContext="{Binding AvatarNameNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0"
                                                   AutomationProperties.AutomationId="AvatarNameNote" />
                                        <RichTextBox Style="{StaticResource SelectableBody}" controls:SelectableText.FitWidth="True" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="4,2,0,0" MaxWidth="620" HorizontalAlignment="Left" controls:SelectableText.LineHeight="16" AutomationProperties.Name="{Binding SelectedBoothName}" controls:SelectableText.PlainText="True" controls:SelectableText.Text="{Binding SelectedBoothName}" Visibility="{Binding HasSelectedBoothName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <StackPanel Orientation="Horizontal" Margin="6,6,0,0">
                                            <!--
                                                ID そのものを押すとコピー（メモ9-②）。商品ページの ID と同じ作り（Hyperlink・下線なし・同じ吹き出し）。
                                                色も商品ページに揃える（前の TextFaint より1段濃い TextMuted。押せる物を薄すぎる色で出さない）
                                            -->
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" ToolTip="{Binding IdCopyTip}">
                                                <Hyperlink Command="{Binding CopyIdCommand}" controls:MiddleClick.Command="{Binding OpenBoothCommand}" TextDecorations="{x:Null}"
                                                           AutomationProperties.AutomationId="AvatarIdCopy"
                                                           Foreground="{DynamicResource TextMuted}">
                                                    <Run Text="{Binding SelectedIdText, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedCategoryText}" Style="{StaticResource Caption}"
                                                       Margin="14,0,0,0" />
                                            <TextBlock Text="{Binding SelectedCheckedText}" Style="{StaticResource Caption}"
                                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                                            <!-- 判定の根拠（カテゴリ・最終確認）を疑うときの逃げ道なので、その横に置く（U17） -->
                                            <Button Content="商品情報を取り直す" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                                    Command="{Binding RecheckCommand}"
                                                    ToolTip="BOOTHから取り直します。商品のファイルはダウンロードしません。" />
                                        </StackPanel>
                                        <TextBlock DataContext="{Binding IdNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0"
                                                   AutomationProperties.AutomationId="AvatarIdNote" />

                                        <!--
                                            名前が取れない項目のための欄。BOOTHが404を返すと
                                            商品IDしか出せず、IDと件数だけでは何のことか分からない。
                                            別名は IsAvatar の判定を通さずに溜まるので、404の項目にも残っている。
                                        -->
                                        <StackPanel Margin="6,8,0,0"
                                                    Visibility="{Binding NeedsName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding ReferencedByText}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                                                       Visibility="{Binding HasReferencedBy, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                            <StackPanel Margin="0,6,0,0"
                                                        Visibility="{Binding HasNameSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="呼ばれていた名前。押すと名前の欄に入ります。" Style="{StaticResource Caption}" />
                                                <controls:ContentItemsControl ItemsSource="{Binding NameSuggestions}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                                    Command="{Binding DataContext.UseNameSuggestionCommand,
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Click="StartRename_Click" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </controls:ContentItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--
                                        名前の欄と同じ列に右寄せで重ねると「名前を保存」の上に乗った。列を分けても名前の側が狭くなって切れたので、
                                        見出しの下の行に並べる（ユーザ指摘 2026-09-17）
                                    -->
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                                        <Button Content="対応商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                Command="{Binding ShowItemsCommand}"
                                                ToolTip="このアバターに対応している商品を、素体経由も含めて検索で開きます。" />
                                        <!-- このアバターに関連するプロファイル（ユーザ判断 2026-11-09）。検索の条件「プロファイル」に入れて開く -->
                                        <Button Content="プロファイルを検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                Command="{Binding ShowProfilesCommand}"
                                                AutomationProperties.AutomationId="AvatarShowProfiles"
                                                ToolTip="このアバターと、その素体のプロファイルを検索で開きます。" />
                                        <!-- 取り込んであるアバターは、ファイルや改変を見に商品ページへ（動線の点検 D2） -->
                                        <Button Content="商品ページを開く" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                Command="{Binding OpenItemCommand}"
                                                Visibility="{Binding CanOpenItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                ToolTip="このアバターの商品ページを開きます。手元のファイルや改変を見られます。" />
                                        <Button Content="BOOTHで開く" Style="{StaticResource SmallButton}"
                                                Command="{Binding OpenBoothCommand}"
                                                ToolTip="ブラウザでBOOTHの商品ページを開きます。アプリの外へ出ます。" />
                                    </WrapPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource Mono}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedOwnedText}" Style="{StaticResource Caption}" Margin="18,0,0,0"
                                               VerticalAlignment="Center" />
                                    <!--
                                        所有の切り替えは、取り込んだファイルで持っていないときだけ（ユーザ判断 2026-09-17：持っていれば「所有している」で固定）。
                                        本体を取り込んでいないアバターや、BOOTH外で入手したものを所有として扱うための逃げ道
                                    -->
                                    <Button Content="{Binding OwnedButtonText}" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                            Command="{Binding ToggleOwnedCommand}"
                                            Visibility="{Binding ShowsOwnedToggle, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                            ToolTip="取り込んでいないアバターも、所有として扱えます。" />
                                    <TextBlock DataContext="{Binding OwnedNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="320" />
                                </StackPanel>

                                <!-- どの経路で見つかったか。判定の根拠なので隠さない -->
                                <TextBlock Text="{Binding SelectedSeenAsText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />

                                <!--
                                    共通素体（U19）。説明は置かない（ユーザ判断 2026-09-17：使う人は分かっている）。
                                    基本は1つの素体にしか入らないので、候補を押せばそのまま入る。矢印キーで候補を見ているだけでは入れず、Enter で入れる
                                    （ユーザ指示 2026-09-17：勝手に入らないように）。まだ無い名前も Enter で作る。外すボタンだけ残す。

                                    **欄はほかの画面と同じ候補付きの欄**（ユーザ判断 2026-09-20・I6）。
                                    ここだけ編集できるプルダウンで、同じ「名前を選ぶ」操作の作法が3つに割れていた
                                -->
                                <TextBlock Text="共通素体" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="240">
                                        <controls:SuggestBox Source="{Binding BaseNames}" CommitCommand="{Binding PickBaseCommand}"
                                                             IconSelector="{Binding BaseIconSelector}"
                                                             AutomationProperties.AutomationId="AvatarBaseInput"
                                                             Text="{Binding BaseInput, Mode=TwoWay}"
                                                             AllowNew="True" KeepsCommittedText="True"
                                                             MaxLength="60"
                                                             Placeholder="素体を選ぶか、名前を打ってEnter" />
                                    </Grid>
                                    <Button Content="外す" AutomationProperties.Name="素体から外す" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                            Command="{Binding ClearBaseCommand}" />
                                </StackPanel>
                                <!--
                                    名前から推した素体（メモ46-3）。欄は手で決めた素体だけを映すので、推した素体は欄に入れず、
                                    下に薄い字で出して見分ける（欄に入れると、手で決めた素体と区別が付かない）
                                -->
                                <TextBlock Text="{Binding SelectedInferredBaseText}" Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasSelectedInferredBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                           AutomationProperties.AutomationId="AvatarInferredBase" />
                                <TextBlock DataContext="{Binding BaseFieldNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarBaseFieldNote" />
                                <TextBlock Text="{Binding NewBaseHint}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding HasNewBaseHint, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                <!--
                                    人が足す変換の組のうち、このアバターが元か先にある物（読むだけ・ユーザ判断 2026-11-20）。
                                    編集は「変換」の一覧の上の「追加した組」で行う（元と先の両方に共通素体も選べる）。向きが分かるよう「元 → 先」で書く
                                -->
                                <StackPanel DataContext="{Binding ConversionPairSummary}" Margin="0,20,0,0">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="変換で編集" Style="{StaticResource SmallButton}" Command="{Binding EditCommand}"
                                                AutomationProperties.AutomationId="AvatarConversionPairsEdit"
                                                ToolTip="「変換」で組を追加・編集します。" />
                                        <TextBlock Text="変換の組" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <controls:ContentItemsControl ItemsSource="{Binding Chips}" AutomationProperties.AutomationId="AvatarConversionPairs"
                                                                  Visibility="{Binding HasChips, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ConversionPairChip}">
                                                <Border BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6"
                                                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMemo}" Value="True">
                                                                    <Setter Property="ToolTip" Value="{Binding Memo}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Text}" FontSize="{StaticResource FontSizeSmall}" AutomationProperties.AutomationId="AvatarConversionPair" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </controls:ContentItemsControl>
                                    <TextBlock Text="このアバターの組はまだありません。「変換で編集」で追加できます。" Style="{StaticResource Caption}"
                                               Visibility="{Binding HasChips, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                </StackPanel>


                                <!--
                                    呼び方の履歴。普段は畳む（ユーザ指示 2026-09-17）。検出に使うので、明らかに間違っている物以外は消さなくてよいと書く。
                                    消した表記は、商品の対応アバターと同じく末尾に出して1件ずつ戻せるようにする
                                -->
                                <Expander Style="{StaticResource TriangleExpander}" Margin="0,20,0,0" IsExpanded="{Binding IsAliasesExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding AliasesTitle}">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding AliasesTitle}" Style="{StaticResource SectionLabel}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="620" HorizontalAlignment="Left"
                                                   Text="対応アバターの検出に使います。明らかに間違っているものだけ削除してください。括弧内は最後の検出で見つかった商品数です。" />
                                    <controls:ContentItemsControl ItemsSource="{Binding Aliases}" controls:ArrowGroup.IsEnabled="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center" />
                                                        <Button Content="×" ContentTemplate="{StaticResource CrossGlyph}" Margin="7,0,0,0" Padding="2,0" FontSize="11"
                                                                AutomationProperties.AutomationId="AvatarAliasRemove"
                                                                AutomationProperties.Name="{Binding StringFormat={}{0}を削除}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Foreground="{DynamicResource DangerText}"
                                                                Command="{Binding DataContext.RemoveAliasCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="明らかに間違っている呼び方を削除します。" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </controls:ContentItemsControl>
    
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Width="200" Padding="7,5"
                                                 MaxLength="60" Text="{Binding AliasInput, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="追加する呼び方"
                                                 ToolTip="検出できなかった呼び方を追加できます。">
                                            <!-- Enter で決められるように揃える（I12） -->
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddAliasCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Content="呼び方を追加" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                Command="{Binding AddAliasCommand}" />
                                    </StackPanel>
                                    <TextBlock DataContext="{Binding AliasNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                               AutomationProperties.AutomationId="AvatarAliasNote" />
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding HasRejectedAliases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="検出に使わない呼び方" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                            <controls:ContentItemsControl ItemsSource="{Binding RejectedAliases}" controls:ArrowGroup.IsEnabled="True">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextMuted}" TextDecorations="Strikethrough" />
                                                                <Button AutomationProperties.AutomationId="AvatarAliasRestore" AutomationProperties.Name="{Binding StringFormat={}{0}を戻す}" Content="戻す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RestoreAliasCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </controls:ContentItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!--
                                    このアバターの改変

                                    着せ替えごとに1つ作り、使った衣装やギミックをまとめて残す。
                                    住所をアバターにしたのは、改変が「アバター1体＋名前」で
                                    決まるから（docs/history/modifications.md）。

                                    **同じ名前を許してあるので、日付を一緒に出す。**
                                    「普段着」が2つ並んだときの見分けが付かないと困る
                                -->
                                <TextBlock Text="このアバターの改変" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />

                                <StackPanel Orientation="Horizontal">
                                    <!-- 空のままだと何を入れる欄か分からないので、内側に案内を出す（ユーザ指示 2026-09-17） -->
                                    <Grid Width="240">
                                        <TextBox Height="26" Padding="7,0" VerticalContentAlignment="Center"
                                                 MaxLength="60" Text="{Binding ModificationNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="改変の名前"
                                                 ToolTip="「普段着」「制服」のように、着せ替えごとに名前を付けます。">
                                            <!-- Enter で決められるように揃える（I12） -->
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding CreateModificationCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="新しい改変の名前（例：普段着）" Margin="10,0,0,0" Style="{StaticResource InputPlaceholder}"
                                                   Visibility="{Binding ModificationNameInput, Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                    </Grid>
                                    <Button Content="作る" AutomationProperties.Name="改変を作る" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Command="{Binding CreateModificationCommand}" />
                                </StackPanel>
                                <TextBlock DataContext="{Binding ModificationNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarModificationNote" />

                                <TextBlock Text="{Binding ModificationEmptyText}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" MaxWidth="480" HorizontalAlignment="Left"
                                           Visibility="{Binding HasModifications, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                                <!--
                                    改変の画面のアバターの項目と同じ行（ユーザ指示 2026-09-17）：絵・名前・Unityプロジェクト、畳んだ中身に使ったもの。
                                    絵と名前にはホバーで大きめの絵。ここには右のビューが無いので、どれを押しても改変に入る
                                -->
                                <controls:ContentItemsControl ItemsSource="{Binding Modifications}" Margin="0,7,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                              Visibility="{Binding HasModifications, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:HubMemberRow}">
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,8,0"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                                                        Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.ToolTip>
                                                        <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                            <StackPanel Width="180">
                                                                <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                                                        Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                    <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Text}" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                    <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource SurfaceAlt}" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Button AutomationProperties.AutomationId="AvatarModMemberLink" AutomationProperties.Name="{Binding Name}" Style="{StaticResource HubLink}" ToolTip="{Binding Name}"
                                                            Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="手元にありません" FontSize="10.5" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource Warn}"
                                                                   Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <TextBlock Text="{Binding FileText}" Style="{StaticResource Mono}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileText}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HubModificationRow}">
                                            <StackPanel Margin="0,4,0,2">
                                                <DockPanel>
                                                    <controls:ExpandToggle AutomationProperties.AutomationId="AvatarModToggle" Subject="{Binding Name, StringFormat={}{0}の使ったもの}" DockPanel.Dock="Left" Style="{StaticResource HubToggle}" VerticalContentAlignment="Top" Padding="0,10,0,0"
                                                                  Margin="0,0,2,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <Button AutomationProperties.AutomationId="AvatarModImage" DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,9,0" VerticalAlignment="Top"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                                                            Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ToolTip>
                                                            <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                                <StackPanel Width="180">
                                                                    <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                                                            Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource Text}" />
                                                                    <TextBlock Text="押すと、この改変を開きます" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Border Width="38" Height="38" CornerRadius="5" Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}" FontSize="13" Foreground="{DynamicResource Accent}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button AutomationProperties.AutomationId="AvatarModLink" AutomationProperties.Name="{Binding Name}" Style="{StaticResource HubLink}" ToolTip="この改変を開きます"
                                                                Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                        <WrapPanel Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"
                                                                       Visibility="{Binding Record.HasUnityProject, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border Margin="9,4,0,4" Padding="26,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <controls:ContentItemsControl ItemsSource="{Binding Members}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <!-- 検出では拾えない事情を残す場所。打ち終えて少し待つと残る（ユーザ指示 2026-09-17：保存ボタンを押さなくてよい） -->
                                <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="420" Height="56" Padding="7,5"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             MaxLength="10000" Text="{Binding MemoInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="メモ"
                                             ToolTip="素体は同じだが体型が違う、といった検出では分からないことを残せます。" />
                                </StackPanel>
                                <TextBlock DataContext="{Binding MemoNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarMemoNote" />

                                <!--
                                    アバターかどうか（判定の上書き）。今の扱いは文で出し、ボタンは変える操作だけにする
                                    （ユーザ指示 2026-09-17：「自動」のボタンが状態の表示も兼ねていて、押す物か読む物か分からなかった）。
                                    今の扱いと同じボタンは押せなくする。
                                    ボタンを押せなくするだけでは、どれが今効いているのか見た目で分からなかった（点検 2026-09-23）。
                                    3つのうち1つを選ぶ形なので、並べ替えや表示の切り替えと同じ繋がったボタンにし、今の扱いを塗って見せる。
                                    点いているかは読むだけ（OneWay）で、押したときだけコマンドで変える（カード／リストの切り替えと同じ作り）
                                -->
                                <TextBlock Text="アバターかどうか" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                                <TextBlock Text="{Binding JudgementText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" DataContext="{Binding JudgementNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <controls:CommandRadioButton Grid.Column="0" Content="自動の判定に任せる" GroupName="AvatarJudgement" Style="{StaticResource SegmentFirst}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="auto"
                                                 IsChecked="{Binding IsOverrideAuto, Mode=OneWay}"
                                                 ToolTip="カテゴリと、出品者が「対応アバター」に挙げているかで決めます。" />
                                    <controls:CommandRadioButton Grid.Column="1" Content="アバターとして扱う" GroupName="AvatarJudgement" Style="{StaticResource SegmentMiddle}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="true"
                                                 IsChecked="{Binding IsForcedAvatar, Mode=OneWay}"
                                                 ToolTip="カテゴリが「3Dキャラクター」でなくても、アバターとして扱います。" />
                                    <controls:CommandRadioButton Grid.Column="2" Content="アバターとして扱わない" GroupName="AvatarJudgement" Style="{StaticResource SegmentLast}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="false"
                                                 IsChecked="{Binding IsForcedNotAvatar, Mode=OneWay}"
                                                 ToolTip="対応アバターの候補と検索に表示しなくなります。一覧には残ります。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            共通素体を見ているときだけ出す（U16）。選んだ1つの管理と、それを使っているアバター。
                            アバターを見ているときに全素体の管理が付いて回ると、どちらの話か分からなくなる
                        -->
                        <StackPanel Visibility="{Binding ShowsBaseDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

                            <ContentControl Content="{Binding SelectedBase}" ContentTemplate="{StaticResource BaseCard}" Focusable="False" />

                            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="この素体を使っているアバター" FontSize="13" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="同じ素体のアバター向けに作られた衣装は「素体経由」として一緒に表示されます。押すとそのアバターを開きます。" />
                                    <!--
                                        素体の側からアバターを足す欄（メモ46）。候補はほかのアバターの候補と同じ作り（群・呼び方・絵）。
                                        ほかの素体に入っている物は聞かずに移し、欄の下で知らせる（アバターの側で選ぶと聞かずに入るのと揃える）
                                    -->
                                    <!-- 幅は280まで。右の欄が狭い（幅900）と欄の方が広く、右が切れていたので、残りの幅に縮める（2026-11-20） -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="280" />
                                        </Grid.ColumnDefinitions>
                                        <controls:SuggestBox Source="{Binding MemberCandidates}" CommitCommand="{Binding AddMemberCommand}"
                                                             InfoSelector="{Binding MemberInfoSelector}" GroupHeadings="{Binding MemberGroupHeadings}"
                                                             IconSelector="{Binding MemberIconSelector}"
                                                             AllowNew="False" MaxLength="60"
                                                             Placeholder="追加するアバターの名前"
                                                             AutomationProperties.AutomationId="AvatarBaseMemberInput" />
                                    </Grid>
                                    <TextBlock DataContext="{Binding SelectedBase.MemberNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                               AutomationProperties.AutomationId="AvatarBaseMemberNote" />
                                    <!--
                                        行は押せる枠（PressableBorder）にし、一覧は並び（ArrowGroup）にする（点検 2026-10-01）。
                                        前は素の枠にマウスの押し方だけを付けていて、キーボードと読み上げからは開けなかった
                                    -->
                                    <!--
                                        並びはドラッグで変える（ユーザ指示 2026-11-04）。商品ページの対応アバターの札と、検索の対応アバターの候補がこの順を使う。
                                        つまみと落とし先の線はタグ・属性の管理と同じ（RowReorder）。並べたときだけ「既定の順に戻す」を出す
                                    -->
                                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="ドラッグで並べ替えると、商品ページと検索の候補の並びも変わります。" />
                                        <Button DockPanel.Dock="Right" Content="既定の順に戻す" Style="{StaticResource SmallButton}"
                                                Command="{Binding ResetBaseMemberOrderCommand}"
                                                Visibility="{Binding HasSelectedBaseMemberOrder, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                ToolTip="持っているアバターが先、ほかは名前の順に戻します。"
                                                AutomationProperties.AutomationId="AvatarBaseMemberOrderReset" />
                                    </DockPanel>
                                    <controls:ContentItemsControl ItemsSource="{Binding SelectedBaseMembers}" Margin="0,4,0,0" controls:ArrowGroup.IsEnabled="True"
                                                                  AllowDrop="True"
                                                                  PreviewMouseLeftButtonDown="OnBaseMembersPreviewMouseLeftButtonDown"
                                                                  MouseMove="OnBaseMembersMouseMove"
                                                                  DragOver="OnBaseMembersDragOver"
                                                                  DragLeave="OnBaseMembersDragLeave"
                                                                  Drop="OnBaseMembersDrop">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AvatarRowViewModel}">
                                                <controls:PressableBorder Padding="6,4" Margin="0,0,0,2" Cursor="Hand" Background="Transparent"
                                                        Focusable="True" FocusVisualStyle="{StaticResource RowFocusVisual}"
                                                        Command="{Binding DataContext.OpenMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ContextMenu="{StaticResource AvatarBaseMemberMenu}"
                                                        AutomationProperties.AutomationId="AvatarBaseMemberRow"
                                                        AutomationProperties.Name="{Binding Name, StringFormat={}{0}を開く}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.OpenMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <!-- 基本の操作は右クリックと画面の両方に置く（メモ73-②）。右クリックの「この素体から外す」と同じ命令 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource ReorderGrip}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AvatarRow}" />
                                                        <Border Grid.ColumnSpan="3" Height="2" VerticalAlignment="Top" Margin="0,-5,0,0" Background="{DynamicResource Accent}"
                                                                Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <Border Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-5" Background="{DynamicResource Accent}"
                                                                Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <Button Grid.Column="2" Content="外す" Style="{StaticResource DangerButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="外しても、上の欄からまた追加できます。"
                                                                AutomationProperties.AutomationId="AvatarBaseMemberRemove"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}をこの素体から外す}" />
                                                    </Grid>
                                                </controls:PressableBorder>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </controls:ContentItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--
                            変換を見ているときの右の欄（ユーザ判断 2026-11-09：商品ページの「変換扱い」の欄を使い回し、下に決めて次へ進むボタン）。
                            Ctrl+Enter は「確認済みにして次へ」（未確定の「この内容で決める」と同じキー）
                        -->
                        <Border Style="{StaticResource Card}" Padding="22,18"
                                Visibility="{Binding ShowsConversionDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <!--
                                    商品の1枚目の絵を大きめに出す（ユーザ指示 2026-11-09：プロファイルの多くは、想定するアバターが商品の絵に写っている）。
                                    つなぎ先を決める材料なので、名前の横ではなく見て分かる大きさにする
                                -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="200" Height="200" CornerRadius="6" Background="{DynamicResource SurfaceAlt}" Margin="0,0,18,0" VerticalAlignment="Top"
                                            Visibility="{Binding HasSelectedConversionImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <Image Source="{Binding SelectedConversionImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               AutomationProperties.AutomationId="AvatarsConversionImage" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedConversion.Name}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="商品ページを開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                    Command="{Binding OpenConversionItemCommand}"
                                                    AutomationProperties.AutomationId="AvatarsConversionOpenItem" />
                                            <!-- 想定するアバターは、商品の説明や他の絵で分かることが多い（ユーザ指示 2026-11-09）。手元だけの商品は押せない -->
                                            <Button Content="BOOTHで開く" Style="{StaticResource SmallButton}"
                                                    Command="{Binding OpenConversionBoothCommand}"
                                                    AutomationProperties.AutomationId="AvatarsConversionOpenBooth"
                                                    ToolTip="ブラウザでBOOTHの商品ページを開きます。アプリの外へ出ます。" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                                <views:ItemConversionPanel DataContext="{Binding ConversionEditor}" />
                                <WrapPanel Margin="0,16,0,0">
                                    <!-- 確認待ちが無いと押せない（ユーザ判断 2026-11-09）。押せない理由を吹き出しで言う -->
                                    <Button Content="確認済みにして次へ" Margin="0,0,8,6"
                                            Command="{Binding DecideSuggestedCommand}"
                                            AutomationProperties.AutomationId="AvatarsConversionDecide"
                                            ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="ToolTip" Value="確認待ちを確認済みにして、次の商品へ進みます。" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConversionEditor.UnconfirmedCount}" Value="0">
                                                        <Setter Property="ToolTip" Value="確認待ちのつなぎ先がありません。" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="プロファイルではない" Margin="0,0,8,6"
                                            Command="{Binding MarkNotProfileCommand}"
                                            AutomationProperties.AutomationId="AvatarsConversionNotProfile"
                                            ToolTip="プロファイルとして扱わないようにして、次の商品へ進みます。" />
                                    <Button Content="後で" Margin="0,0,8,6"
                                            Command="{Binding LaterCommand}"
                                            AutomationProperties.AutomationId="AvatarsConversionLater"
                                            ToolTip="何も変えずに、次の商品へ進みます。" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!--
                            「追加した組」を選んだときの右の欄（ユーザ判断 2026-11-20：組もプロファイルの商品と同じに右で見る）。
                            元と先は押すとそのアバター・共通素体へ移る（登録簿から消えた物は押せない）。メモはここで直し、押さずに残る
                        -->
                        <Border Style="{StaticResource Card}" Padding="22,18" DataContext="{Binding ConversionPairs.SelectedRow}"
                                AutomationProperties.AutomationId="AvatarsConversionPairDetail"
                                Visibility="{Binding DataContext.ShowsConversionPairDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="AvatarsConversionPairTitle" />
                                <TextBlock Text="元のアバター用の衣装を、先に着せられる組です。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 名前の前に、左の行と同じ絵（2026-11-20・ユーザ「右側ビューにもアイコンを出しましょう」）。絵は押す所に入れない（押すのは名前） -->
                                    <TextBlock Grid.Row="0" Text="元" Style="{StaticResource SectionLabel}" Margin="0,0,14,6" VerticalAlignment="Center" />
                                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding FromIcon}" Margin="0,0,8,0"
                                                          AutomationProperties.AutomationId="AvatarsConversionPairFromIcon" />
                                        <Button Style="{StaticResource ConversionPairEndLink}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Command="{Binding OpenFromCommand}" ToolTip="このアバター・共通素体を開きます。"
                                                AutomationProperties.AutomationId="AvatarsConversionPairFromLink"
                                                AutomationProperties.Name="{Binding FromName, StringFormat={}元の{0}を開く}">
                                            <TextBlock Text="{Binding FromName}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="先" Style="{StaticResource SectionLabel}" Margin="0,0,14,6" VerticalAlignment="Center" />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding ToIcon}" Margin="0,0,8,0"
                                                          AutomationProperties.AutomationId="AvatarsConversionPairToIcon" />
                                        <Button Style="{StaticResource ConversionPairEndLink}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Command="{Binding OpenToCommand}" ToolTip="このアバター・共通素体を開きます。"
                                                AutomationProperties.AutomationId="AvatarsConversionPairToLink"
                                                AutomationProperties.Name="{Binding ToName, StringFormat={}先の{0}を開く}">
                                            <TextBlock Text="{Binding ToName}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </DockPanel>
                                    <!-- ツールの名前はファイルを直して書いた物だけ（画面では書かない）。あれば読めるように出す -->
                                    <TextBlock Grid.Row="2" Text="ツール" Style="{StaticResource SectionLabel}" Margin="0,0,14,6" VerticalAlignment="Center"
                                               Visibility="{Binding HasTool, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tool}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding HasTool, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- 打ち終えて少し待つと残る（アバターのメモと同じ）。選び直す・外す・離れる前に書き切る -->
                                <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                                <TextBox Width="420" Height="56" Padding="7,5" HorizontalAlignment="Left"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         MaxLength="2000" Text="{Binding MemoText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="AvatarsConversionPairMemo"
                                         AutomationProperties.Name="{Binding Text, StringFormat={}{0}のメモ}"
                                         ToolTip="直す所や使うツールなどを残せます。" />

                                <Button Content="この組を外す" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Command="{Binding RemoveCommand}"
                                        AutomationProperties.AutomationId="AvatarsConversionPairRemove"
                                        ToolTip="この組を外します。組のメモは戻せません。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- 右の欄の中に出す（ユーザ指摘 2026-11-14：画面全体の中央に出ると、左の一覧に切られて読めなかった）。右の欄を出さない間は、右の欄ごと隠れる -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />

                    <!-- 探して0件と、そもそも1体も無いのを言い分ける（E2） -->
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsFilteredEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                                   Text="打ち込んだ言葉に当てはまるアバターがありません。言葉を変えるか、絞り込みを消してください。" />
                        <Button Content="絞り込みを消す" Style="{StaticResource SmallButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Command="{Binding ClearQueryCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                               Text="「対応アバターを検出する」を押すと、取り込んだ商品の説明文などから読み取ります。"
                               Visibility="{Binding CanDetectFromItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 商品が0件だと検出しても何も見つからないので、先に取り込みへ（ユーザ判断 2026-09-17） -->
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding HasNoItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                                   Text="対応アバターは、取り込んだ商品の説明文やタグから見つけます。まず商品を取り込んでください。" />
                        <Button Content="取り込みを開く" Style="{StaticResource SmallButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                Command="{Binding ShowImportCommand}" />
                    </StackPanel>
                </StackPanel>
                <ContentControl Grid.Column="1" Content="{Binding RightItem}" Focusable="False"
                                Visibility="{Binding RightItem.IsOpen, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </controls:PaneGrid>
        </Grid>
    </DockPanel>
</UserControl>
