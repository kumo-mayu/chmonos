<UserControl x:Class="Chmonos.App.Views.AvatarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AvatarsViewModel}">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 一覧の行の右クリックは、カードと同じメニュー（ユーザ指示 2026-09-20・M2） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
            <!-- 繋がったボタン（タグ・属性の管理と同じ部品・M4） -->
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- 行の右クリック。アバターは商品でもあるので、カードと同じ操作ができる -->
        <Style x:Key="AvatarRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
            <!-- 付けないと、行の型の名前が読まれる（読み上げ・自動操作）。アバターの名前を読ませる -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.AutomationId" Value="AvatarRow" />
        </Style>
        <!--
            共通素体の一覧の行の右クリック（メモ9-⑦ 2026-10-02）。右の欄の「削除」と同じ道で、同じ確認の窓
            （何件が書き換わるかと、元に戻せないこと）を出してから消す。開くのは一度に1つなので、1つを全行で使い回す
        -->
        <ContextMenu x:Key="AvatarBaseRowMenu">
            <MenuItem Header="削除" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="AvatarBaseRowMenu.Delete" Style="{StaticResource DangerMenuItem}"
                      ToolTip="この共通素体を削除します。元に戻せません。" />
        </ContextMenu>
        <!--
            素体の詳細の「この素体を使っているアバター」の行の右クリック（メモ46）。名前から推した仲間も外せる（印を立てる）ので、
            どの行でも押せる。メニューは画面の木の外にあるので、画面の命令は行の Tag（画面の DataContext）から引く
        -->
        <ContextMenu x:Key="AvatarBaseMemberMenu">
            <MenuItem Header="この素体から外す" AutomationProperties.AutomationId="AvatarBaseMemberMenu.Remove"
                      Command="{Binding PlacementTarget.Tag.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      ToolTip="外しても、上の欄からまた追加できます。" />
        </ContextMenu>
        <!-- 共通素体の一覧の行。見た目は既定の行のまま、名前と ID と右クリックだけ足す -->
        <Style x:Key="AvatarBaseRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource AvatarBaseRowMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.AutomationId" Value="AvatarBaseRow" />
        </Style>
        <!-- 一覧の1行。選ぶと右に詳細が出る -->
        <DataTemplate x:Key="AvatarRow" DataType="{x:Type vm:AvatarRowViewModel}">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 頭に絵を出す（U18）。まだ取れていないアバターは頭文字のまま -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                        Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource AccentSoftText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                               Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Opacity="{Binding IsExcluded, Converter={x:Static vm:ExcludedOpacityConverter.Instance}}" />
                    <TextBlock Text="{Binding BaseText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding HasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 呼び方・正式名で当たった行だけ、何で当たったかを添える -->
                    <TextBlock Text="{Binding MatchNote}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource AccentSoftText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasMatchNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Mono}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!--
            一覧の1件のカードの見た目。リスト（詰まった行・AvatarRow）とカード（検索と同じ）を選べる（ユーザ指示 2026-09-20・M4）。
            **見せ分けは一覧に渡す型そのものを替える**（下の一覧の Style。メモ9-① 2026-10-02）。前は1つの型にリストとカードの両方を持ち、
            先祖の画面をたどって片方を隠していた。使い回した行や、まだ画面の木に付いていない行では先祖をたどれず、
            リストにしてもカードの出たままの行が混ざった。型を替えると一覧は行を全部作り直すので、前の見せ方の行は残らない。

            カードでも、リストに出ている情報を落とさない（ユーザ指摘 2026-09-20）。
            対応数は右上の札に、素体名はその札のツールチップに（素体名は長く、カードの幅に収まらない）。
            「アバターとして扱わない」印は、リストと同じ薄さで示す
        -->
        <DataTemplate x:Key="AvatarCard" DataType="{x:Type vm:AvatarRowViewModel}">
            <Grid Opacity="{Binding IsExcluded, Converter={x:Static vm:ExcludedOpacityConverter.Instance}}">
                <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False"
                                Visibility="{Binding HasCard, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!--
                    名前が挙がっただけで手元に商品が無いアバターの札。商品のカードを当てると、
                    中の結び付け先が全部外れて札が全部出てしまう（「所持」と「未所持」が同時に出ていた）。
                    出せる情報（絵か頭文字・名前・素体）だけをカードと同じ大きさで並べる
                -->
                <Border Style="{StaticResource Card}" Width="{DynamicResource CardWidth}" Height="{DynamicResource CardHeight}"
                        Margin="0,0,14,14" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding HasCard, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="11,0,11,11">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BaseText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <!-- 検索が商品を読み終えるまでは添えない。持っているアバターまで手元に無いと言っていた（2026-10-02） -->
                            <TextBlock Text="この名前の商品は手元にありません" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsMissingNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                        <Grid Background="{DynamicResource ImageBack}">
                            <TextBlock Text="{Binding Initial}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource PlaceholderGlyph}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,21,0"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,1"
                        ToolTip="{Binding BaseText}" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 見る物の切り替えボタン（U16）。今見ている方を太字と色で示す -->
        <!-- 改変の行の見た目は改変の画面と同じ（ユーザ指示 2026-09-17：アバターの管理の改変を改変の画面のアバターの項目に揃える） -->
        <!--
            文字だけのボタン。暗黙の Button スタイルは中央揃えと枠を持っていて上書きが効かないので、型ごと差し替える
        -->
        <Style x:Key="HubLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 畳む印。中身の無い行では印が空になる（ExpandGlyph） -->
        <Style x:Key="HubToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!--
                            三角は文字（▸▾）ではなく図形で描く。文字は小さく描かれる字形で、字を 11 → 14 に上げても見た目がほとんど変わらなかった
                            （ユーザ指摘 2026-09-13「折り畳みの三角が少し小さいかも」）。幅18の枠の真ん中に置くのは同じ（縦線を三角の真下に下ろしている）
                        -->
                        <!-- 押せる範囲は行の高さいっぱい（ユーザ指摘 2026-10-04「当たり判定が感覚より小さい」）。以前は改変の行で、上に寄せて下げた三角の枠だけ（18×9）が押せた。枠を行の高さに伸ばし、三角の位置だけ Padding で下げる -->
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Path x:Name="Mark" Data="M0,0 L6,4.5 L0,9 Z" Fill="{DynamicResource TextMuted}"
                                  Width="6" Height="9" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Visibility="{Binding HasGlyph, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L9,0 L4.5,6 Z" />
                                <Setter TargetName="Mark" Property="Width" Value="9" />
                                <Setter TargetName="Mark" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- 名前の欄の確定。窓の確定と同じ色で、横の「キャンセル」と同じ高さにする -->
        <Style x:Key="InlinePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- 共通素体1つの管理。素体を見ているときに、右に選んだ1つだけを出す -->
        <DataTemplate x:Key="BaseCard" DataType="{x:Type vm:AvatarBaseRowViewModel}">
            <Border Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <StackPanel>
                        <!--
                            名前は普段は文字で出し、「名前を変更」で欄にする（ユーザ判断 2026-09-29。アバターの名前と同じ形）。
                            枠の無い欄を常に出していたら、名前を変えられることが分からなかった。
                            言い方と作法はタグの管理の「名前を変更」の窓に揃える：Enter で確定・Esc で取り消し
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Margin="6,3"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                            <Button AutomationProperties.AutomationId="AvatarBaseRename" Content="名前を変更" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding StartRenameCommand}" Click="StartRename_Click"
                                    ToolTip="この素体の名前を使っている商品も一緒に書き換えます。" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBox AutomationProperties.AutomationId="AvatarBaseNameInput" MaxLength="60" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="19" FontWeight="Bold" MinWidth="240" MaxWidth="460"
                                     Padding="6,3" VerticalAlignment="Center"
                                     AutomationProperties.Name="新しい名前"
                                     IsVisibleChanged="NameEditor_IsVisibleChanged">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button AutomationProperties.AutomationId="AvatarBaseRenameCommit" Content="名前を変える" Style="{StaticResource InlinePrimaryButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding RenameCommand}"
                                    IsEnabled="{Binding HasNameChange}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="今と違う名前を入れると押せます。" />
                            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                        <TextBlock DataContext="{Binding NameNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding MemberText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ItemText}" Style="{StaticResource Caption}" Margin="14,0,0,0" />
                            <TextBlock Text="{Binding ItemIdText}" Style="{StaticResource Caption}" Margin="14,0,0,0" />
                        </StackPanel>
                        <!-- 素体そのものの商品の候補。自動では結ばず、押したら結ぶ（ユーザ指摘 2026-09-17：素体単体の配布を検知できていなかった） -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding ShowsItemCandidates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="素体の名前を含む商品" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <controls:ContentItemsControl ItemsSource="{Binding ItemCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                            <Button AutomationProperties.AutomationId="AvatarBaseCandidateUse" AutomationProperties.Name="{Binding Label, StringFormat={}{0}を素体の商品に設定}" Content="素体の商品に設定" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                    Command="{Binding UseCommand}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </StackPanel>
                        <!--
                            配布されている素体は商品に結べる。
                            結ぶと素体のページへ行けるようになり、所有の判定にも使える。
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <!-- 空のままだと何を入れる欄か分からないので、内側に案内を出す（ユーザ指示 2026-09-17） -->
                            <Grid Width="230" VerticalAlignment="Center">
                                <TextBox AutomationProperties.AutomationId="AvatarBaseItemId" AutomationProperties.Name="素体の商品のIDかURL" Padding="7,4"
                                         Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="商品IDかURLを入れます。空にすると紐付けが外れます。">
                                    <!-- Enter で決められるように揃える（I12） -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SetItemIdCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="素体の商品のIDかURL" Margin="10,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                           Visibility="{Binding ItemIdInput, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                            </Grid>
                            <Button AutomationProperties.AutomationId="AvatarBaseSetItemId" Content="素体の商品を設定" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Command="{Binding SetItemIdCommand}" />
                        </StackPanel>
                        <TextBlock DataContext="{Binding ItemIdNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0" />
                        <!-- 説明が無く何のことか分からず、実例も無いので隠す（ユーザ判断 2026-09-17）。仕組み（inferClothing）は残す -->
                        <CheckBox Content="衣装の互換を広げる" IsChecked="{Binding InferClothing, Mode=OneWay}" Visibility="Collapsed"
                                  Command="{Binding ToggleInferCommand}" Margin="0,12,0,0"
                                  Foreground="{DynamicResource Text}"
                                  ToolTip="衣装が合わない組だけ外してください。外すと素体経由の衣装が表示されなくなります。" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <!-- 取り返しがつかないので、そうと分かる顔にする（V4） -->
                        <Button AutomationProperties.AutomationId="AvatarBaseDelete" AutomationProperties.Name="この共通素体を削除" Content="削除" Style="{StaticResource DangerButton}"
                                ToolTip="この共通素体を削除します。元に戻せません。"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
      </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 戻る（U23）。商品ページの札から来たときに、元の商品へ戻れるように -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding BackText}" Command="{Binding BackCommand}" BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="アバターの管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="対応アバターの名前と、共通素体の関係を管理します"
                               Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding DetectButtonText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DetectCommand}"
                            ToolTip="{Binding DetectHint}" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            検出の途中経過と結果、素体を削除した結果（画面全体の状態と、押した所ごと消える操作の結果）。上の段の右に出していたときは
            幅520で「…」に切れ、検出の結果の長い文が読めなかった（2026-10-03 のユーザ判断：切らずに折り返して全部見せる）。
            出ていない間は場所を取らない。出るのは検出を押したときなど、人が押した直後の1回だけ
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,7"
                Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AvatarsStatus" />
        </Border>

        <Grid>
            <TextBlock Text="読み込んでいます…" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!-- まだ1体も無いとき。数字ではなく次にやることを出す -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />

                <!-- 探して0件と、そもそも1体も無いのを言い分ける（E2） -->
                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding IsFilteredEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                               Text="打ち込んだ言葉に当てはまるアバターがありません。言葉を変えるか、絞り込みを消してください。" />
                    <Button Content="絞り込みを消す" Style="{StaticResource SmallButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Command="{Binding ClearQueryCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                           Text="「対応アバターを検出する」を押すと、取り込んだ商品の説明文などから読み取ります。"
                           Visibility="{Binding CanDetectFromItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!-- 商品が0件だと検出しても何も見つからないので、先に取り込みへ（ユーザ判断 2026-09-17） -->
                <StackPanel HorizontalAlignment="Center"
                            Visibility="{Binding HasNoItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Style="{StaticResource EmptyNote}" Margin="0,8,0,0"
                               Text="対応アバターは、取り込んだ商品の説明文やタグから見つけます。まず商品を取り込んでください。" />
                    <Button Content="取り込みを開く" Style="{StaticResource SmallButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Command="{Binding ShowImportCommand}" />
                </StackPanel>
            </StackPanel>

            <controls:PaneGrid Visibility="{Binding IsLoading, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}"
                  Pane="{Binding ListPane}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                      MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
                <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                       ResetCommand="{Binding ListPane.ResetCommand}" />

                <!-- 左：アバターの一覧。所有しているものを先に出す -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!--
                            見る物の切り替え（U16）。以前は共通素体の管理がどのアバターの詳細の下にも付いて回り、
                            今どちらの話をしているのかが分からなかった
                        -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,14,14,0">
                            <Button Content="{Binding AvatarModeText}" Command="{Binding ShowAvatarModeCommand}"
                                    ToolTip="アバターを1体ずつ見て、名前・所有・共通素体を設定します。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBaseMode}" Value="False">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding BaseModeText}" Command="{Binding ShowBaseModeCommand}" Margin="6,0,0,0"
                                    ToolTip="複数のアバターが使っている共通の体（素体）を見て、名前や配布商品を設定します。">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBaseMode}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- 一覧をカードで見るかリストで見るか（ユーザ指示 2026-09-20・M4） -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,14,0"
                                    Visibility="{Binding IsBaseMode, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                            <controls:CommandRadioButton Content="カード" GroupName="AvatarsView" Style="{StaticResource SegmentFirst}"
                                         IsChecked="{Binding IsCardMode, Mode=OneWay}" Command="{Binding ShowCardsCommand}"
                                         ToolTip="絵の大きなカードで並べます" />
                            <controls:CommandRadioButton Content="リスト" GroupName="AvatarsView" Style="{StaticResource SegmentLast}"
                                         IsChecked="{Binding IsListMode, Mode=OneWay}" Command="{Binding ShowListCommand}"
                                         ToolTip="名前が読める詰まった行で並べます" />
                        </StackPanel>

                        <Grid DockPanel.Dock="Top" Margin="14,12,14,10"
                              Visibility="{Binding IsBaseMode, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                            <TextBox Padding="8,6" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 AutomationProperties.Name="名前・ID・呼び方で探す"
                                     ToolTip="アバター名・商品ID・BOOTHでの正式名・呼び方で絞り込みます。" />
                            <!-- 空欄のままだと何を入れる欄か分からないので、内側に案内を出す -->
                            <TextBlock Text="名前・ID・呼び方で探す" Margin="11,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                       Visibility="{Binding Query, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                        </Grid>

                        <!--
                            共通素体を手で足す欄（ユーザ判断 2026-09-28）。一覧には検出で見つかった素体しか並ばず、足す口が無かった。
                            **候補は付けない**（メモ9-⑥ 2026-10-02。「入力欄には候補を付ける」の例外・ui-input.md）。新しい素体を名付ける欄で、
                            今ある名前を候補に並べても重複を誘うだけだった。Enter か「追加」で足し、今ある名前なら「既にあります」と言う
                        -->
                        <DockPanel DockPanel.Dock="Top" Margin="14,12,14,0"
                                   Visibility="{Binding IsBaseMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Button DockPanel.Dock="Right" Content="追加" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="AvatarBaseAdd"
                                    Command="{Binding AddBaseCommand}" />
                            <Grid>
                                <TextBox Padding="8,6" MaxLength="60" Text="{Binding NewBaseName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="AvatarBaseAddInput"
                                         AutomationProperties.Name="追加する共通素体の名前">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddBaseCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <!-- 空欄のままだと何を入れる欄か分からないので、内側に案内を出す（上の検索の欄と同じ） -->
                                <TextBlock Text="追加する共通素体の名前" Margin="11,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                           Visibility="{Binding NewBaseName, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                            </Grid>
                        </DockPanel>

                        <TextBlock DockPanel.Dock="Top" DataContext="{Binding AddBaseNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="16,4,14,0"
                                   AutomationProperties.AutomationId="AvatarBaseAddNote"
                                   Visibility="{Binding DataContext.IsBaseMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!-- アバターの一覧の右下の大きさのスライダー（検索と同じ。メモ10-④ 2026-10-02）。素体を見ているときは出さない -->
                        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSizeBar}" Focusable="False"
                                        Visibility="{Binding IsBaseMode, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <!--
                            一覧は1つのListBoxにまとめ、所有／未所有はグループ見出しで分ける。
                            ListBoxを2つ縦に積んでScrollViewerへ入れると高さが無限になり、描画が壊れる。
                        -->
                        <Grid>
                            <!--
                                見出しでまとめると、WPFは既定で見える行だけ作るのをやめ、全行（約400）を作る。
                                行に絵を足したら（U18）、画面を開いてから一覧が出るまでが3.7〜4.6秒から4.9〜6.2秒に延びた。
                                まとめていても見える行だけ作らせると1.1〜1.8秒になった
                            -->
                            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     SelectionChanged="AvatarList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource AvatarRowStyle}" Tag="{Binding}"
                                     BorderThickness="0" Background="Transparent" Margin="14,0,14,14"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding IsBaseMode, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                                <!-- リストかカードかは、渡す型そのものを替える（メモ9-①。AvatarCard の上の説明） -->
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="ItemTemplate" Value="{StaticResource AvatarCard}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListMode}" Value="True">
                                                <Setter Property="ItemTemplate" Value="{StaticResource AvatarRow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <!--
                                    見出しごとに畳める（ユーザ指示）。400体の中で見たいのは所有している数体と、
                                    見直すときの「扱わないもの」なので、残りを畳んでおけるようにする。
                                    畳んだ状態は画面を開き直しても残す（コードビハインドで ViewModel に預ける）
                                -->
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Style="{StaticResource TriangleExpander}" IsExpanded="True" Margin="0,8,0,2"
                                                                      Loaded="GroupExpander_Loaded"
                                                                      Expanded="GroupExpander_Changed"
                                                                      Collapsed="GroupExpander_Changed">
                                                                <Expander.Header>
                                                                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="（" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text="）" /></TextBlock>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>

                            <!-- 共通素体の一覧。選ぶと右にその素体の管理と、使っているアバターが出る -->
                            <ListBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource AvatarBaseRowStyle}"
                                     BorderThickness="0" Background="Transparent" Margin="14,12,14,14"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding IsBaseMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AvatarBaseRowViewModel}">
                                        <StackPanel Margin="0,3,0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MemberText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource Caption}" Margin="18,16,18,0" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsNoBases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                       Text="共通素体はまだありません。上の欄に素体の名前を入れると追加できます。" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 右：選んだアバターの詳細と、共通素体の管理 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
                    <!-- 文章と入力が主なので最大幅で止め、中央に寄せる（ユーザ判断 2026-09-23。広い窓で枠だけ横に伸び、中身は左に寄っていた） -->
                    <StackPanel MaxWidth="{StaticResource ReadingMaxWidth}">

                        <Border Style="{StaticResource Card}" Padding="22,18"
                                Visibility="{Binding ShowsAvatarDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                        名前の左に絵を大きく出す（ユーザ指示）。似た名前のアバターを一目で見分けるため。
                                        高さは名前・正式名・IDの3行ぶん。保存している絵は長辺384px（読み込みは96相当）
                                        なので、この大きさなら拡大でぼやけない
                                    -->
                                    <Border Grid.Column="0" Grid.RowSpan="2" Width="84" Height="84" CornerRadius="10" Margin="0,2,16,0"
                                            VerticalAlignment="Top" Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Selected.Initial}" FontSize="30" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentSoftText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Selected.Icon}" Stretch="UniformToFill"
                                                   Visibility="{Binding Selected.HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <!-- 表示名は短くしてある。編集できるようにし、正式名は下に添える -->
                                        <!--
                                            普段は名前を文字で出し、「名前を変更」で欄にする（ユーザ判断 2026-09-29）。
                                            枠の無い欄を常に出していたら、名前を変えられることが分からなかった。
                                            言い方と作法はタグの管理の「名前を変更」の窓に揃える：Enter で確定・Esc で取り消し
                                        -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding SelectedName}" FontSize="19" FontWeight="Bold" Margin="6,3"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                            <Button AutomationProperties.AutomationId="AvatarRename" Content="名前を変更" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding StartRenameCommand}" Click="StartRename_Click"
                                                    ToolTip="このアプリで表示する名前を変えます。" />
                                            <!-- 付けた名前を消す操作は、欄を空にする形では分からないのでボタンで名乗る（ユーザ指示） -->
                                            <Button Content="BOOTHの名前に戻す" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding ResetNameCommand}"
                                                    ToolTip="{Binding ResetNameTip}"
                                                    Visibility="{Binding HasManualName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsEditingName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBox AutomationProperties.AutomationId="AvatarNameInput" MaxLength="60" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="19" FontWeight="Bold" MinWidth="240" MaxWidth="520"
                                                     Padding="6,3" VerticalAlignment="Center"
                                                     AutomationProperties.Name="新しい名前"
                                                     IsVisibleChanged="NameEditor_IsVisibleChanged">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding RenameCommand}" />
                                                    <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button AutomationProperties.AutomationId="AvatarRenameCommit" Content="名前を変える" Style="{StaticResource InlinePrimaryButton}" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding RenameCommand}"
                                                    IsEnabled="{Binding HasNameChange}" ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="今と違う名前を入れると押せます。" />
                                            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" Command="{Binding CancelRenameCommand}" />
                                        </StackPanel>
                                        <TextBlock DataContext="{Binding AvatarNameNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0"
                                                   AutomationProperties.AutomationId="AvatarNameNote" />
                                        <TextBlock Text="{Binding SelectedBoothName}" Style="{StaticResource Caption}"
                                                   Margin="6,2,0,0" TextWrapping="Wrap" MaxWidth="620"
                                                   HorizontalAlignment="Left"
                                                   Visibility="{Binding HasSelectedBoothName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <StackPanel Orientation="Horizontal" Margin="6,6,0,0">
                                            <!--
                                                ID そのものを押すとコピー（メモ9-②）。商品ページの ID と同じ作り（Hyperlink・下線なし・同じ吹き出し）。
                                                色も商品ページに揃える（前の TextFaint より1段濃い TextMuted。押せる物を薄すぎる色で出さない）
                                            -->
                                            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" ToolTip="{Binding IdCopyTip}">
                                                <Hyperlink Command="{Binding CopyIdCommand}" TextDecorations="{x:Null}"
                                                           AutomationProperties.AutomationId="AvatarIdCopy"
                                                           Foreground="{DynamicResource TextMuted}">
                                                    <Run Text="{Binding SelectedIdText, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedCategoryText}" Style="{StaticResource Caption}"
                                                       Margin="14,0,0,0" />
                                            <TextBlock Text="{Binding SelectedCheckedText}" Style="{StaticResource Caption}"
                                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                                            <!-- 判定の根拠（カテゴリ・最終確認）を疑うときの逃げ道なので、その横に置く（U17） -->
                                            <Button Content="商品情報を取り直す" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                                    Command="{Binding RecheckCommand}"
                                                    ToolTip="BOOTHから取り直します。商品のファイルはダウンロードしません。" />
                                        </StackPanel>
                                        <TextBlock DataContext="{Binding IdNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="6,2,0,0"
                                                   AutomationProperties.AutomationId="AvatarIdNote" />

                                        <!--
                                            名前が取れない項目のための欄。BOOTHが404を返すと
                                            商品IDしか出せず、IDと件数だけでは何のことか分からない。
                                            別名は IsAvatar の判定を通さずに溜まるので、404の項目にも残っている。
                                        -->
                                        <StackPanel Margin="6,8,0,0"
                                                    Visibility="{Binding NeedsName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding ReferencedByText}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                                                       Visibility="{Binding HasReferencedBy, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                            <StackPanel Margin="0,6,0,0"
                                                        Visibility="{Binding HasNameSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="呼ばれていた名前。押すと名前の欄に入ります。" Style="{StaticResource Caption}" />
                                                <controls:ContentItemsControl ItemsSource="{Binding NameSuggestions}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                                    Command="{Binding DataContext.UseNameSuggestionCommand,
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" Click="StartRename_Click" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </controls:ContentItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--
                                        名前の欄と同じ列に右寄せで重ねると「名前を保存」の上に乗った。列を分けても名前の側が狭くなって切れたので、
                                        見出しの下の行に並べる（ユーザ指摘 2026-09-17）
                                    -->
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="6,10,0,0">
                                        <Button Content="この商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                Command="{Binding ShowItemsCommand}"
                                                ToolTip="このアバターに対応している商品を、素体経由も含めて検索で開きます。" />
                                        <!-- 取り込んであるアバターは、ファイルや改変を見に商品ページへ（動線の点検 D2） -->
                                        <Button Content="商品ページを開く" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                Command="{Binding OpenItemCommand}"
                                                Visibility="{Binding CanOpenItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                ToolTip="このアバターの商品ページを開きます。手元のファイルや改変を見られます。" />
                                        <Button Content="BOOTHで開く" Style="{StaticResource SmallButton}"
                                                Command="{Binding OpenBoothCommand}"
                                                ToolTip="ブラウザでBOOTHの商品ページを開きます。アプリの外へ出ます。" />
                                    </WrapPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,14" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource Mono}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedOwnedText}" Style="{StaticResource Caption}" Margin="18,0,0,0"
                                               VerticalAlignment="Center" />
                                    <!--
                                        所有の切り替えは、取り込んだファイルで持っていないときだけ（ユーザ判断 2026-09-17：持っていれば「所有している」で固定）。
                                        本体を取り込んでいないアバターや、BOOTH外で入手したものを所有として扱うための逃げ道
                                    -->
                                    <Button Content="{Binding OwnedButtonText}" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                            Command="{Binding ToggleOwnedCommand}"
                                            Visibility="{Binding ShowsOwnedToggle, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                            ToolTip="取り込んでいないアバターも、所有として扱えます。" />
                                    <TextBlock DataContext="{Binding OwnedNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="320" />
                                </StackPanel>

                                <!-- どの経路で見つかったか。判定の根拠なので隠さない -->
                                <TextBlock Text="{Binding SelectedSeenAsText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />

                                <!--
                                    共通素体（U19）。説明は置かない（ユーザ判断 2026-09-17：使う人は分かっている）。
                                    基本は1つの素体にしか入らないので、候補を押せばそのまま入る。矢印キーで候補を見ているだけでは入れず、Enter で入れる
                                    （ユーザ指示 2026-09-17：勝手に入らないように）。まだ無い名前も Enter で作る。外すボタンだけ残す。

                                    **欄はほかの画面と同じ候補付きの欄**（ユーザ判断 2026-09-20・I6）。
                                    ここだけ編集できるプルダウンで、同じ「名前を選ぶ」操作の作法が3つに割れていた
                                -->
                                <TextBlock Text="共通素体" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="240">
                                        <controls:SuggestBox Source="{Binding BaseNames}" CommitCommand="{Binding PickBaseCommand}"
                                                             Text="{Binding BaseInput, Mode=TwoWay}"
                                                             AllowNew="True" KeepsCommittedText="True"
                                                             MaxLength="60"
                                                             Placeholder="素体を選ぶか、名前を打ってEnter" />
                                    </Grid>
                                    <Button Content="素体から外す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Command="{Binding ClearBaseCommand}" />
                                </StackPanel>
                                <!--
                                    名前から推した素体（メモ46-3）。欄は手で決めた素体だけを映すので、推した素体は欄に入れず、
                                    下に薄い字で出して見分ける（欄に入れると、手で決めた素体と区別が付かない）
                                -->
                                <TextBlock Text="{Binding SelectedInferredBaseText}" Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasSelectedInferredBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                           AutomationProperties.AutomationId="AvatarInferredBase" />
                                <TextBlock DataContext="{Binding BaseFieldNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarBaseFieldNote" />
                                <TextBlock Text="{Binding NewBaseHint}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding HasNewBaseHint, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                <TextBlock Text="{Binding SelectedBaseNote}" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}"
                                           Visibility="{Binding HasSelectedBaseNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                <!--
                                    呼ばれ方の履歴。普段は畳む（ユーザ指示 2026-09-17）。検出に使うので、明らかに間違っている物以外は消さなくてよいと書く。
                                    消した表記は、商品の対応アバターと同じく末尾に出して1件ずつ戻せるようにする
                                -->
                                <Expander Style="{StaticResource TriangleExpander}" Margin="0,20,0,0" IsExpanded="{Binding IsAliasesExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding AliasesTitle}">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding AliasesTitle}" Style="{StaticResource SectionLabel}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="620" HorizontalAlignment="Left"
                                                   Text="対応アバターの検出に使います。明らかに間違っているものだけ削除してください。括弧内は最後の検出で見つかった商品数です。" />
                                    <controls:ContentItemsControl ItemsSource="{Binding Aliases}" controls:ArrowGroup.IsEnabled="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center" />
                                                        <Button Content="×" Margin="7,0,0,0" Padding="2,0" FontSize="11"
                                                                AutomationProperties.AutomationId="AvatarAliasRemove"
                                                                AutomationProperties.Name="{Binding StringFormat={}{0}を削除}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Foreground="{DynamicResource DangerText}"
                                                                Command="{Binding DataContext.RemoveAliasCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="明らかに間違っている呼び方を削除します。" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </controls:ContentItemsControl>
    
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Width="200" Padding="7,5"
                                                 MaxLength="60" Text="{Binding AliasInput, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="追加する呼び方"
                                                 ToolTip="検出できなかった呼び方を追加できます。">
                                            <!-- Enter で決められるように揃える（I12） -->
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddAliasCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Content="呼び方を追加" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                Command="{Binding AddAliasCommand}" />
                                    </StackPanel>
                                    <TextBlock DataContext="{Binding AliasNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                               AutomationProperties.AutomationId="AvatarAliasNote" />
                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding HasRejectedAliases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="検出に使わない呼び方" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                            <controls:ContentItemsControl ItemsSource="{Binding RejectedAliases}" controls:ArrowGroup.IsEnabled="True">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextMuted}" TextDecorations="Strikethrough" />
                                                                <Button AutomationProperties.AutomationId="AvatarAliasRestore" AutomationProperties.Name="{Binding StringFormat={}{0}を戻す}" Content="戻す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RestoreAliasCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </controls:ContentItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!--
                                    このアバターの改変

                                    着せ替えごとに1つ作り、使った衣装やギミックをまとめて残す。
                                    住所をアバターにしたのは、改変が「アバター1体＋名前」で
                                    決まるから（docs/history/modifications.md）。

                                    **同じ名前を許してあるので、日付を一緒に出す。**
                                    「普段着」が2つ並んだときの見分けが付かないと困る
                                -->
                                <TextBlock Text="このアバターの改変" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />

                                <StackPanel Orientation="Horizontal">
                                    <!-- 空のままだと何を入れる欄か分からないので、内側に案内を出す（ユーザ指示 2026-09-17） -->
                                    <Grid Width="240">
                                        <TextBox Height="26" Padding="7,0" VerticalContentAlignment="Center"
                                                 MaxLength="60" Text="{Binding ModificationNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="改変の名前"
                                                 ToolTip="「普段着」「制服」のように、着せ替えごとに名前を付けます。">
                                            <!-- Enter で決められるように揃える（I12） -->
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding CreateModificationCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="新しい改変の名前（例：普段着）" Margin="10,0,0,0" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                                   Visibility="{Binding ModificationNameInput, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                                    </Grid>
                                    <Button Content="改変を作る" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Command="{Binding CreateModificationCommand}" />
                                </StackPanel>
                                <TextBlock DataContext="{Binding ModificationNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarModificationNote" />

                                <TextBlock Text="{Binding ModificationEmptyText}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" MaxWidth="480" HorizontalAlignment="Left"
                                           Visibility="{Binding HasModifications, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                                <!--
                                    改変の画面のアバターの項目と同じ行（ユーザ指示 2026-09-17）：絵・名前・Unityプロジェクト、畳んだ中身に使ったもの。
                                    絵と名前にはホバーで大きめの絵。ここには右のビューが無いので、どれを押しても改変に入る
                                -->
                                <controls:ContentItemsControl ItemsSource="{Binding Modifications}" Margin="0,7,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                              Visibility="{Binding HasModifications, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type vm:HubMemberRow}">
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,8,0"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                                                        Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.ToolTip>
                                                        <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                            <StackPanel Width="180">
                                                                <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                                                        Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                    <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Text}" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                    <Border Width="34" Height="34" CornerRadius="4" Background="{DynamicResource SurfaceAlt}" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Button AutomationProperties.AutomationId="AvatarModMemberLink" AutomationProperties.Name="{Binding Name}" Style="{StaticResource HubLink}" ToolTip="{Binding Name}"
                                                            Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="手元にありません" FontSize="10.5" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource Warn}"
                                                                   Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <TextBlock Text="{Binding FileText}" Style="{StaticResource Mono}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileText}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HubModificationRow}">
                                            <StackPanel Margin="0,4,0,2">
                                                <DockPanel>
                                                    <controls:ExpandToggle AutomationProperties.AutomationId="AvatarModToggle" Subject="{Binding Name, StringFormat={}{0}の使ったもの}" DockPanel.Dock="Left" Style="{StaticResource HubToggle}" VerticalContentAlignment="Top" Padding="0,10,0,0"
                                                                  Margin="0,0,2,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <Button AutomationProperties.AutomationId="AvatarModImage" DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,9,0" VerticalAlignment="Top"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                                                            Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ToolTip>
                                                            <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                                <StackPanel Width="180">
                                                                    <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                                                            Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource Text}" />
                                                                    <TextBlock Text="押すと、この改変を開きます" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Border Width="38" Height="38" CornerRadius="5" Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}" FontSize="13" Foreground="{DynamicResource Accent}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button AutomationProperties.AutomationId="AvatarModLink" AutomationProperties.Name="{Binding Name}" Style="{StaticResource HubLink}" ToolTip="この改変を開きます"
                                                                Command="{Binding DataContext.OpenModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                        <WrapPanel Margin="0,1,0,0">
                                                            <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"
                                                                       Visibility="{Binding Record.HasUnityProject, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border Margin="9,4,0,4" Padding="26,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0"
                                                        Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <controls:ContentItemsControl ItemsSource="{Binding Members}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <!-- 検出では拾えない事情を残す場所。打ち終えて少し待つと残る（ユーザ指示 2026-09-17：保存ボタンを押さなくてよい） -->
                                <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="420" Height="56" Padding="7,5"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             MaxLength="10000" Text="{Binding MemoInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="メモ"
                                             ToolTip="素体は同じだが体型が違う、といった検出では分からないことを残せます。" />
                                </StackPanel>
                                <TextBlock DataContext="{Binding MemoNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                           AutomationProperties.AutomationId="AvatarMemoNote" />

                                <!--
                                    アバターかどうか（判定の上書き）。今の扱いは文で出し、ボタンは変える操作だけにする
                                    （ユーザ指示 2026-09-17：「自動」のボタンが状態の表示も兼ねていて、押す物か読む物か分からなかった）。
                                    今の扱いと同じボタンは押せなくする。
                                    ボタンを押せなくするだけでは、どれが今効いているのか見た目で分からなかった（点検 2026-09-23）。
                                    3つのうち1つを選ぶ形なので、並べ替えや表示の切り替えと同じ繋がったボタンにし、今の扱いを塗って見せる。
                                    点いているかは読むだけ（OneWay）で、押したときだけコマンドで変える（カード／リストの切り替えと同じ作り）
                                -->
                                <TextBlock Text="アバターかどうか" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                                <TextBlock Text="{Binding JudgementText}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" DataContext="{Binding JudgementNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <controls:CommandRadioButton Grid.Column="0" Content="自動の判定に任せる" GroupName="AvatarJudgement" Style="{StaticResource SegmentFirst}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="auto"
                                                 IsChecked="{Binding IsOverrideAuto, Mode=OneWay}"
                                                 ToolTip="カテゴリと、出品者が「対応アバター」に挙げているかで決めます。" />
                                    <controls:CommandRadioButton Grid.Column="1" Content="アバターとして扱う" GroupName="AvatarJudgement" Style="{StaticResource SegmentMiddle}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="true"
                                                 IsChecked="{Binding IsForcedAvatar, Mode=OneWay}"
                                                 ToolTip="カテゴリが「3Dキャラクター」でなくても、アバターとして扱います。" />
                                    <controls:CommandRadioButton Grid.Column="2" Content="アバターとして扱わない" GroupName="AvatarJudgement" Style="{StaticResource SegmentLast}"
                                                 Command="{Binding TreatAsAvatarCommand}" CommandParameter="false"
                                                 IsChecked="{Binding IsForcedNotAvatar, Mode=OneWay}"
                                                 ToolTip="対応アバターの候補と検索に表示しなくなります。一覧には残ります。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            共通素体を見ているときだけ出す（U16）。選んだ1つの管理と、それを使っているアバター。
                            アバターを見ているときに全素体の管理が付いて回ると、どちらの話か分からなくなる
                        -->
                        <StackPanel Visibility="{Binding ShowsBaseDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

                            <ContentControl Content="{Binding SelectedBase}" ContentTemplate="{StaticResource BaseCard}" Focusable="False" />

                            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="この素体を使っているアバター" FontSize="13" FontWeight="Bold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Text="同じ素体のアバター向けに作られた衣装は「素体経由」として一緒に表示されます。押すとそのアバターを開きます。" />
                                    <!--
                                        素体の側からアバターを足す欄（メモ46）。候補はほかのアバターの候補と同じ作り（群・呼び方・絵）。
                                        ほかの素体に入っている物は聞かずに移し、欄の下で知らせる（アバターの側で選ぶと聞かずに入るのと揃える）
                                    -->
                                    <Grid Width="280" HorizontalAlignment="Left" Margin="0,12,0,0">
                                        <controls:SuggestBox Source="{Binding MemberCandidates}" CommitCommand="{Binding AddMemberCommand}"
                                                             InfoSelector="{Binding MemberInfoSelector}" GroupHeadings="{Binding MemberGroupHeadings}"
                                                             IconSelector="{Binding MemberIconSelector}"
                                                             AllowNew="False" MaxLength="60"
                                                             Placeholder="追加するアバターの名前"
                                                             AutomationProperties.AutomationId="AvatarBaseMemberInput" />
                                    </Grid>
                                    <TextBlock DataContext="{Binding SelectedBase.MemberNote}" Text="{Binding Text}" Style="{StaticResource AreaNoticeText}" Margin="2,4,0,0"
                                               AutomationProperties.AutomationId="AvatarBaseMemberNote" />
                                    <!--
                                        行は押せる枠（PressableBorder）にし、一覧は並び（ArrowGroup）にする（点検 2026-10-01）。
                                        前は素の枠にマウスの押し方だけを付けていて、キーボードと読み上げからは開けなかった
                                    -->
                                    <controls:ContentItemsControl ItemsSource="{Binding SelectedBaseMembers}" Margin="0,4,0,0" controls:ArrowGroup.IsEnabled="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AvatarRowViewModel}">
                                                <controls:PressableBorder Padding="6,4" Margin="0,0,0,2" Cursor="Hand" Background="Transparent"
                                                        ToolTip="このアバターを開きます"
                                                        Focusable="True" FocusVisualStyle="{StaticResource RowFocusVisual}"
                                                        Command="{Binding DataContext.OpenMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ContextMenu="{StaticResource AvatarBaseMemberMenu}"
                                                        AutomationProperties.AutomationId="AvatarBaseMemberRow"
                                                        AutomationProperties.Name="{Binding Name, StringFormat={}{0}を開く}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.OpenMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarRow}" />
                                                </controls:PressableBorder>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </controls:ContentItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </controls:PaneGrid>
        </Grid>
    </DockPanel>
</UserControl>
