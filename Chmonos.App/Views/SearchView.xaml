<UserControl x:Class="Chmonos.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 商品のカード（フォルダビューの右側と共通。Views/ItemCardResources.xaml） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
            <!-- 並べ替えの繋がったボタン（タグ・属性の管理と同じ部品・M5） -->
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!--
            畳む・開くの小さなボタン。既定のボタンの見た目（枠と余白）だと
            「絞り込み」の見出しより目立ってしまうので、山形だけを置く。
        -->
        <!--
            履歴のスロット。枠は外側の Border が持つので、中身は素のまま出す。
            **テンプレートごと置き換える。**暗黙の Button スタイルは枠線と余白を
            持っていて setter では外せない（他の画面で同じ罠を踏んでいる）。
        -->
        <Style x:Key="HistorySlotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            履歴の帯の端に出す「‹」「›」。続きのチップの上に重ねるので、外側へ向かって白く抜ける地を持たせ、
            切れたチップが「ここで終わり」ではなく「この先に続く」と読めるようにする
        -->
        <Style x:Key="HistoryScrollButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Fade" Fill="{DynamicResource SurfaceFade}" />
                            <Border x:Name="Face" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}" Margin="0,-3,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <!-- 左端の「‹」は向きを逆にする（地は右から白く、丸は左に寄せる） -->
                            <Trigger Property="HorizontalAlignment" Value="Left">
                                <Setter TargetName="Face" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="Fade" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Fade" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            つまみに止まった印。つまみの丸い縁（26）に重ねて、選んだ色の丸にする。
            ほかの小さなボタンの SmallFocusVisual（角の丸い四角）だと、四角の角が丸い縁の外へはみ出す
        -->
        <Style x:Key="PanelToggleFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="13" Margin="-1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{TemplateBinding Content}" Fill="{x:Null}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{DynamicResource TextMuted}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 条件を畳む・開く山形（ユーザ指示 2026-09-16。条件が増えるとパネルが縦に伸びる） -->
        <PathGeometry x:Key="IconChevronUp" Figures="M7,15 L12,10 L17,15" />
        <PathGeometry x:Key="IconChevronDown" Figures="M7,10 L12,15 L17,10" />

        <Style x:Key="ModuleCollapseToggle" TargetType="Button" BasedOn="{StaticResource PanelToggle}">
            <Setter Property="Content" Value="{StaticResource IconChevronUp}" />
            <Setter Property="ToolTip" Value="この条件を折りたたみます。条件は効いたままです。" />
            <!-- 条件の数だけ並ぶので、どの条件のボタンかを名前に入れる -->
            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenLabel, StringFormat={}{0}の条件を折りたたむ}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding IdKey, StringFormat='SearchModule.{0}.Collapse'}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="Content" Value="{StaticResource IconChevronDown}" />
                    <Setter Property="ToolTip" Value="この条件を開く" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding SpokenLabel, StringFormat={}{0}の条件を開く}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            条件の見出しの「…」（2026-10-01）。押すと条件のメニュー（右クリックと同じ物）を開く。
            乗せた・枠の中に止まったときだけ出す（RevealOnHoverOrFocusButton。隠している間も場所は取る＝出たときに見出しが動かない）
        -->
        <Style x:Key="ModuleMenuButton" TargetType="Button" BasedOn="{StaticResource RevealOnHoverOrFocusButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="この条件の操作" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                            <TextBlock Text="…" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            パネルの見出しの「…」（メモ2-③ 2026-10-02）。**いつも見せる**：条件の「…」と同じ隠す型にしていたので、
            見出しの行に乗せるか止まるまで出ず、メニューがあることが分からなかった。
            条件の「…」（薄い字・枠なし・隠れる）と見分けられるよう、本文の濃さの字と枠を付ける
        -->
        <Style x:Key="PanelMenuButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SmallFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1" CornerRadius="5">
                            <TextBlock Text="…" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 条件の枠に止まったときの印（メモ1-③ 2026-10-02）。枠の角に合わせ、内側に描く（外へはみ出すと隣の枠との間の線に見える） -->
        <Style x:Key="ModuleFrameFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 除いている条件の札「除く」（2026-10-01）。字と枠は Danger、地は Surface（新しい色を足さない・D11） -->
        <Style x:Key="ExcludedTag" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ChipFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource DangerBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="7,0,7,1">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerText}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 入力が残る欄を消す × （ユーザ指示 2026-09-16：消せることが分かるように） -->
        <Style x:Key="ClearFieldButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            条件の AND／OR（チェック1つの形とラジオボタン2つの形）。意味を成さない間（1つしか無い）も隠さず、薄く押せなくする
            （ユーザ判断 2026-10-06「消えたりついたりすると縦に揺れるので意味を成さない時はグレーアウト」）。
            押せない理由は吹き出しで言う（押せない間も出す）。薄さは編集状況の「両方」と同じ 0.45 で、外の欄ごと薄い間は重ねない（MatchModeDimmed）
        -->
        <Style x:Key="MatchModeCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="IsEnabled" Value="{Binding CanChooseMatchMode}" />
            <Setter Property="ToolTip" Value="{Binding MatchModeTip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MatchModeDimmed}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatchModeRadios" TargetType="WrapPanel">
            <Setter Property="IsEnabled" Value="{Binding CanChooseMatchMode}" />
            <Setter Property="ToolTip" Value="{Binding MatchModeTip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MatchModeDimmed}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Tab の区切り（Local）にして、つまみに番号 0 を振る（ユーザ指摘 2026-10-06「絞り込みの折り畳みの矢印に tab が止まらない」）。
        つまみは結果の上に重ねる（ZIndex 2）ので、WPF の Tab（描く順に通る）では結果のカードの後ろ、画面の最後に回っていた。
        番号の無いほかの部品は今までどおり木の順に通る
    -->
    <controls:PaneGrid Background="{DynamicResource Bg}" Pane="{Binding FilterPane}" KeyboardNavigation.TabNavigation="Local">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilterPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding FilterPane.MinWidth}" MaxWidth="{Binding FilterPane.MaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!--
            絞り込み欄の幅を変える境目（ユーザ判断 2026-09-14）。畳んでいる間は出さない。
            欄の地（下の Border・ZIndex 0）より上、開け閉めのつまみ（ZIndex 2）より下に置く。
            ZIndex 0 で欄より前に書いていたため、後ろの欄の地が境目に重なって掴めなかった（メモ1-① 2026-10-02）
        -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="1"
                               ResetCommand="{Binding FilterPane.ResetCommand}"
                               Visibility="{Binding FilterPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            絞り込みを畳む／開くつまみ。パネルと結果の境の線に半分はみ出させて置く（U3・ユーザ判断）。
            見出しの行で「条件をクリア」の右隣にあった頃は押し間違えやすかった。
            開いても畳んでも同じ高さに残るので、開け閉めでつまみの場所が変わらない
        -->
        <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,-13,0"
                Width="26" Height="26" CornerRadius="13" Panel.ZIndex="2"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
            <!-- 画面の最初に止まる（つまみは絞り込みの見出しの行の高さ、絞り込みの頭にある）。止まったことは丸い枠で見せる -->
            <Button x:Name="FilterPanelToggle" Command="{Binding ToggleFilterPanelCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabIndex="0" FocusVisualStyle="{StaticResource PanelToggleFocusVisual}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelToggle}">
                        <Setter Property="Content" Value="{StaticResource IconCollapse}" />
                        <Setter Property="ToolTip" Value="絞り込みを折りたたむ" />
                        <Setter Property="AutomationProperties.Name" Value="絞り込みを折りたたむ" />
                        <Setter Property="AutomationProperties.AutomationId" Value="SearchToggleFilterPanel" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterPanelCollapsed}" Value="True">
                                <Setter Property="Content" Value="{StaticResource IconExpand}" />
                                <Setter Property="ToolTip" Value="絞り込みを開く" />
                                <Setter Property="AutomationProperties.Name" Value="絞り込みを開く" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

        <!-- 絞り込み -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
          <Grid>
            <!--
                畳んだ姿。条件は外れていないので、効いている数を出しておく。
                数が見えていないと「なぜか商品が少ない」の原因を探す場所が無くなる。
                開くつまみは境の線の上（上の Border）にあるので、その下から並べる
            -->
            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentFill}" CornerRadius="8" Padding="5,1"
                        Margin="0,48,0,0" HorizontalAlignment="Center" ToolTip="{Binding FilterSummary}"
                        Visibility="{Binding ActiveFilterCount, Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                    <TextBlock Text="{Binding ActiveFilterCount}" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="絞り込み" Style="{StaticResource Caption}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </DockPanel>

            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                <!--
                    パネルの見出しの行。右クリック（と「絞り込み」の右の「…」・Shift+F10）でパネルのメニューを開く（2026-10-01）。
                    「…」は「条件をクリア」から離して「絞り込み」の文字の右隣に置く（見出しの行は押し間違えを避けて空けてある・U3・D13）
                -->
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource Surface}">
                    <Border.ContextMenu>
                        <ContextMenu AutomationProperties.AutomationId="SearchFilterMenuList" AutomationProperties.Name="絞り込みの操作">
                            <MenuItem Header="同じ種類の条件を隣に並べる" AutomationProperties.Name="同じ種類の条件を隣に並べる"
                                      AutomationProperties.AutomationId="SearchFilterMenu.GroupKinds"
                                      Command="{Binding GroupModulesCommand}"
                                      ToolTip="同じ種類の条件はもう隣に並んでいます。" ToolTipService.ShowOnDisabled="True">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <!-- 吹き出しは押せないときの理由だけ。押せるときは見出しの文字で足りる -->
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="True">
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <!--
                                見出しの行のボタンと同じ操作を置く（メモ2-③ 2026-10-02）。「条件をクリア」のボタンは今の場所にも残す。
                                畳むと「…」が消えるので、畳んだ後は開け閉めのつまみに止まる（OnCollapsePanelMenuClick）
                            -->
                            <MenuItem Header="条件をクリア" AutomationProperties.Name="条件をクリア"
                                      AutomationProperties.AutomationId="SearchFilterMenu.Clear"
                                      Command="{Binding ClearFiltersCommand}" />
                            <Separator />
                            <MenuItem Header="絞り込みを折りたたむ" AutomationProperties.Name="絞り込みを折りたたむ"
                                      AutomationProperties.AutomationId="SearchFilterMenu.Collapse"
                                      Command="{Binding ToggleFilterPanelCommand}" Click="OnCollapsePanelMenuClick" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <!-- 右の余白は、境の線に半分はみ出したつまみ（13px）から「条件をクリア」をはっきり離すため -->
                    <Grid Margin="16,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="絞り込み" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource PanelMenuButton}" Margin="6,0,0,0" Click="OnModuleMenuClick"
                                ToolTip="絞り込みの操作"
                                AutomationProperties.AutomationId="SearchFilterMenu"
                                AutomationProperties.Name="絞り込みの操作" />
                        <!-- 押す前の条件は検索の履歴に積むので、押し間違えても履歴から戻せる（U3・ユーザ判断） -->
                        <!--
                            文字に押す動きを付けただけでは、キーボードと読み上げ・自動操作から押せない
                            （実際に押せていなかった）。見た目は同じまま、ボタンにする
                        -->
                        <Button x:Name="ClearFiltersButton" Grid.Column="3" Content="条件をクリア" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource HistorySlotButton}" Foreground="{DynamicResource Accent}"
                                FontSize="12" VerticalAlignment="Center" Padding="4,2"
                                AutomationProperties.AutomationId="SearchClearFilters"
                                AutomationProperties.Name="条件をクリア"
                                ToolTip="入力と条件の値をクリアします。前の条件は検索の履歴から戻せます。" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <!--
                            条件はモジュールで足していく（ユーザ案 2026-09-15）。見出しはメニューの分け方で、同じ条件が
                            2つの見出しに出ることがある。1つまでの種類（三項・範囲・日付・ショップ・最近）は、足してあればどの見出しの下でもグレーになる
                        -->
                        <StackPanel x:Name="SavedAnchorRow" Orientation="Horizontal">
                        <Menu Background="Transparent" HorizontalAlignment="Left">
                            <MenuItem Header="＋ 条件を追加 ▾" ItemsSource="{Binding ModuleMenu}" Height="30" Padding="10,0"
                                      FontSize="12.5" Foreground="{DynamicResource Accent}"
                                      AutomationProperties.AutomationId="SearchAddModule"
                                      AutomationProperties.Name="条件を追加"
                                      ToolTip="絞り込みに使う条件を追加します。1つしか置けない条件は、追加済みなら選べません。">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Title}" />
                                        <Setter Property="ItemsSource" Value="{Binding Entries}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <Setter Property="ItemContainerStyle">
                                            <Setter.Value>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                    <Setter Property="Command" Value="{Binding AddCommand}" />
                                                    <Setter Property="ToolTip" Value="{Binding Hint}" />
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                    <!-- 同じ条件が2つの見出しの下に出る。名前は同じなので、条件の種類を ID にして探せるようにする -->
                                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Kind, StringFormat='SearchAddModule.{0}'}" />
                                                    <!--
                                                        足してある条件はグレーにする（ユーザ案）。名前の文字は MenuItem の色を明示して継ぐ——
                                                        アプリ全体の TextBlock の既定の見た目が生成された文字にも当たり、押せないのに黒のまま出ていた
                                                    -->
                                                    <Setter Property="HeaderTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                        </Trigger>
                                                        <!--
                                                            意味のまとまりの間の区切り線（ユーザ判断 2026-09-16・案1）。項目の見た目を線に差し替え、
                                                            押せず・キーボードでも止まらないようにする。
                                                            （項目の種類で部品を作り分ける仕組み〔UsesItemContainerTemplate〕は、ここでは作り方が見つからず中身が空になった）
                                                        -->
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                            <Setter Property="AutomationProperties.Name" Value="区切り" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <Border Height="1" Margin="30,4,6,4" Background="{DynamicResource Border}" />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>
                        <!--
                            保存した条件（ユーザ判断 2026-10-05・メモ36。案A3の節をやめ、「条件を追加」の隣のボタンから開く一覧にした）。
                            行を押すと今の検索を置き換えて閉じる。今の検索と同じ行は地の色と ✓、ボタンの末尾にも点を出す（閉じていても分かる）。
                            行の「…」と右クリックに条件を上書き・名前の変更・移動・削除。6件目からは探す欄を出し、5件ぶんの高さで中だけを流す。
                            キーボード：ボタンは Tab で止まり Enter・Space・↓ で開く。開くと先頭の行（無ければ「今の検索を保存」）に止まり、
                            条件の並びと同じ FrameList で ↑↓ が行を移り、Enter が呼び出す（FocusFrame.Command）。Esc で閉じてボタンへ戻る
                        -->
                        <ToggleButton x:Name="SavedSearchesButton" Margin="4,0,0,0" Height="30" Padding="10,0" Cursor="Hand"
                                      AutomationProperties.AutomationId="SavedSearchesButton" AutomationProperties.Name="保存した条件"
                                      AutomationProperties.HelpText="{Binding CurrentSavedName}"
                                      PreviewKeyDown="OnSavedButtonKeyDown"
                                      ToolTip="保存した条件を開いて、今の検索を置き換えます。">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Face" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="保存した条件 ▾" FontSize="12.5" Foreground="{DynamicResource Accent}" />
                                                        <Ellipse Width="6" Height="6" Margin="5,0,0,0" Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                 Visibility="{Binding ShowsCurrentSaved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- 開いている間にもう一度押すと、外を押した扱いで閉じてすぐ開き直す。開いている間は押しを素通りさせる -->
                                        <DataTrigger Binding="{Binding IsOpen, ElementName=SavedSearchPopup}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Popup x:Name="SavedSearchPopup" IsOpen="{Binding IsChecked, ElementName=SavedSearchesButton, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=SavedAnchorRow}" Placement="Bottom" AllowsTransparency="True"
                               Opened="OnSavedPopupOpened" Closed="OnSavedPopupClosed">
                            <Border x:Name="SavedSearchPanel" Width="280" Margin="0,2,8,8" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                                    PreviewKeyDown="OnSavedPanelKeyDown">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="保存した条件" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding SavedCountText}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <Button x:Name="SaveCurrentSearchButton" DockPanel.Dock="Right" Content="＋ 今の検索を保存" Command="{Binding SaveCurrentSearchCommand}"
                                                Style="{StaticResource HistorySlotButton}" Foreground="{DynamicResource Accent}"
                                                FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="4,2" Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="SavedSearchSave" AutomationProperties.Name="今の検索を保存"
                                                ToolTip="今の検索に名前を付けて保存します" />
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="「＋ 今の検索を保存」で、今の検索に名前を付けて残せます。" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasSavedSearches, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Surface}"
                                                Visibility="{Binding HasSavedSearches, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <StackPanel>
                                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="6,5"
                                                        Visibility="{Binding ShowsSavedFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <Grid>
                                                        <TextBox x:Name="SavedFilterBox" Text="{Binding SavedFilter, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                                                                 BorderThickness="0" Background="Transparent" Padding="2,1" MaxLength="100"
                                                                 AutomationProperties.AutomationId="SavedSearchFilter" AutomationProperties.Name="保存した検索を探す" />
                                                        <TextBlock Text="保存した検索を探す" FontSize="12" Foreground="{DynamicResource TextFaint}" Margin="4,1,0,0"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="{Binding Text.IsEmpty, ElementName=SavedFilterBox, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="見つかりません。探す語を変えてください。" Style="{StaticResource Caption}" Margin="8,6"
                                                           Visibility="{Binding ShowsSavedFilterEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                                                    <controls:ContentItemsControl x:Name="SavedSearchList" ItemsSource="{Binding SavedRows}" Focusable="False"
                                                                                  controls:FrameList.IsEnabled="True">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:SavedSearchRow}">
                                                                <controls:FocusFrame Command="{Binding ApplyCommand}" Height="30" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                                                                     FocusVisualStyle="{StaticResource ModuleFrameFocusVisual}" ToolTip="{Binding Summary}"
                                                                                     AutomationProperties.AutomationId="SavedSearch.Row"
                                                                                     AutomationProperties.Name="{Binding Name}"
                                                                                     AutomationProperties.HelpText="{Binding Summary}">
                                                                    <controls:FocusFrame.Style>
                                                                        <Style TargetType="controls:FocusFrame">
                                                                            <Setter Property="Background" Value="{DynamicResource Surface}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:FocusFrame.Style>
                                                                    <controls:FocusFrame.ContextMenu>
                                                                        <ContextMenu AutomationProperties.AutomationId="SavedSearch.MenuList"
                                                                                     AutomationProperties.Name="{Binding Name, StringFormat={}{0}の操作}">
                                                                            <MenuItem Header="条件を上書き" AutomationProperties.Name="条件を上書き" Command="{Binding OverwriteCommand}"
                                                                                      AutomationProperties.AutomationId="SavedSearch.Menu.Overwrite"
                                                                                      controls:MenuTips.Disabled="今の検索と同じです" />
                                                                            <MenuItem Header="名前を変更…" AutomationProperties.Name="名前を変更" Command="{Binding RenameCommand}"
                                                                                      AutomationProperties.AutomationId="SavedSearch.Menu.Rename" />
                                                                            <Separator />
                                                                            <MenuItem Header="上へ移動" AutomationProperties.Name="上へ移動" Command="{Binding MoveUpCommand}"
                                                                                      AutomationProperties.AutomationId="SavedSearch.Menu.MoveUp" />
                                                                            <MenuItem Header="下へ移動" AutomationProperties.Name="下へ移動" Command="{Binding MoveDownCommand}"
                                                                                      AutomationProperties.AutomationId="SavedSearch.Menu.MoveDown" />
                                                                            <Separator />
                                                                            <MenuItem Header="削除" AutomationProperties.Name="削除" Command="{Binding DeleteCommand}"
                                                                                      Style="{StaticResource DangerMenuItem}"
                                                                                      AutomationProperties.AutomationId="SavedSearch.Menu.Delete" />
                                                                        </ContextMenu>
                                                                    </controls:FocusFrame.ContextMenu>
                                                                    <DockPanel>
                                                                        <!-- 行に止まっているか乗せたときだけ出す（条件の「…」と同じ）。Tab では止まらない：行の操作は Shift+F10 で同じ物が開く -->
                                                                        <Button DockPanel.Dock="Right" Style="{StaticResource ModuleMenuButton}" Click="OnModuleMenuClick" IsTabStop="False"
                                                                                VerticalAlignment="Center" ToolTip="この保存した検索の操作"
                                                                                AutomationProperties.AutomationId="SavedSearch.Menu"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の操作}" />
                                                                        <Button Style="{StaticResource HistorySlotButton}" Command="{Binding ApplyCommand}" IsTabStop="False"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                AutomationProperties.AutomationId="SavedSearch.Apply"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}を呼び出す}">
                                                                            <DockPanel Margin="8,0,4,0">
                                                                                <!-- 今の検索と同じ行の印（★は商品のお気に入りの印なので使わない）。違う行は場所だけ空けて、名前の頭をそろえる -->
                                                            <TextBlock DockPanel.Dock="Left" Text="✓" FontSize="11" FontWeight="Bold" Width="16" Margin="0,0,2,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Accent}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </Button>
                                                                    </DockPanel>
                                                                </controls:FocusFrame>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </controls:ContentItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </StackPanel>

                        <TextBlock Text="条件がありません。「＋ 条件を追加」から追加できます。" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasModules, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <!--
                            順番はドラッグで変えられる（ユーザ指示 2026-09-16）。掴む所は見出しの左のつまみだけ。
                            キーボードでは並び全体が1つの止まり（FrameList・メモ1-③ 2026-10-02）：Tab で前にいた条件の枠に止まり、
                            ↑↓ で枠の間を移り、Enter で枠の中へ入る（枠の上の Tab は並びの後ろへ抜ける）。中から出るのは Esc（枠へ）か、最後の部品からの Tab（並びの後ろへ）
                        -->
                        <controls:ContentItemsControl x:Name="ModulesList" ItemsSource="{Binding Modules}" Margin="0,10,0,0" Focusable="False"
                                                      controls:FrameList.IsEnabled="True"
                                                      AllowDrop="True" DragOver="OnModulesDragOver"
                                                      DragLeave="OnModulesDragLeave" Drop="OnModulesDrop">
                            <ItemsControl.Resources>
                                <!-- 積んだ値1つ（チップ）。候補から積む条件と、ユーザータグの小分類で同じ形を使う -->
                                <DataTemplate x:Key="SearchChipTemplate" DataType="{x:Type vm:ListChip}">
                                    <!--
                                        矛盾していて必ず0件になるチップ（ユーザータグの AND の中の「小分類なし」・ユーザ判断 2026-10-06）は警告の色。
                                        選べなくはせず、見て分かるようにするだけ
                                    -->
                                    <Border x:Name="ChipFrame" BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorder}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <!--
                                            名前の列だけが縮み、件数と × は残す（メモ70）。横に並べる StackPanel は幅を無限に測るので、
                                            長い名前を2つ積むと2つ目の × が欄の外へ出て切れた。星の列は、名前が短いときは中身の幅のまま（引き伸ばさない）
                                        -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!--
                                                改変の札だけ、頭に小さな絵（改変の写真 → アバターの絵 → 頭文字。ユーザ指摘 2026-10-06）。
                                                札の高さを変えないよう、字の高さに収まる14pxにする
                                            -->
                                            <Border Grid.Column="0" Width="14" Height="14" Margin="-4,0,5,0" CornerRadius="3" ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceAlt}" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowsIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="8.5" Foreground="{DynamicResource TextMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                            <!-- 吹き出しは名前と、対応アバターならそのアバターのサムネイル（メモ82。絵は開いたときに読む） -->
                                            <!-- パスの札（ファイルの場所・Unityプロジェクト）は間を省いて末尾を残す（DisplayText。メモ83・メモ84）。吹き出しは全文 -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="{Binding (TextElement.Foreground), ElementName=ChipFrame}"
                                                       MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="260">
                                                            <Image Source="{Binding Icon}" Width="96" Height="96" Stretch="Uniform" Margin="0,2,0,6"
                                                                   HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasIconSource, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="{Binding ToolTipText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="10.5" Foreground="{Binding (TextElement.Foreground), ElementName=ChipFrame}"
                                                       Opacity="0.7" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            <!-- 形は呼ばれ方の履歴のチップに揃える（幅を決め打つと暗黙のButtonスタイルの枠が丸く出る） -->
                                            <Button Grid.Column="3" Content="×" ContentTemplate="{StaticResource CrossGlyph}" FontSize="11" Margin="6,0,0,0" Padding="2,0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" Foreground="{Binding (TextElement.Foreground), ElementName=ChipFrame}"
                                                    ToolTip="この値を外す"
                                                    AutomationProperties.AutomationId="SearchChipRemove"
                                                    AutomationProperties.Name="{Binding Text, StringFormat={}{0}を外す}"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                                <!-- 選ぶ条件（ユーザ案「三項」）。件数は「選んだら何件になるか」 -->
                                <DataTemplate DataType="{x:Type vm:ChoiceModule}">
                                    <StackPanel>
                                        <!-- 中の部品の名前は条件をまたいで同じになる（下限・上限など）。条件の種類を ID に入れて探せるようにする -->
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" Height="28" FontSize="12.5"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Choice'}"
                                                  AutomationProperties.Name="{Binding SpokenLabel}" />
                                        <CheckBox IsChecked="{Binding Flag, Mode=TwoWay}" Margin="0,7,0,0"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Flag'}"
                                                  AutomationProperties.Name="{Binding FlagLabel}"
                                                  Visibility="{Binding HasFlag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding FlagLabel}" FontSize="12" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    編集状況（2026-10-01。前の「未編集」）。三項に、どの項目を見るかのトグルを足した形。
                                    項目の件数は他の条件のもとでその項目が未入力の商品の数。最後の1つは外せない（全部切ると何も選ばない）
                                -->
                                <DataTemplate DataType="{x:Type vm:UneditedModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" Height="28" FontSize="12.5"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Choice'}"
                                                  AutomationProperties.Name="{Binding SpokenLabel}" />
                                        <!--
                                            「両方」の間は項目とつなぎ方を押せず薄くする（メモ2-④ 2026-10-02。値は残す）。
                                            薄さは対応アバターの「指定が無い商品だけ」のときと同じ 0.45
                                        -->
                                        <StackPanel IsEnabled="{Binding CanEditFields}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEditFields}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="見る項目" Style="{StaticResource Caption}" Margin="0,8,0,3" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EditFieldToggle}">
                                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,0,3"
                                                              AutomationProperties.AutomationId="{Binding AutomationId}"
                                                              AutomationProperties.Name="{Binding Label}">
                                                        <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <!--
                                            つなぎ方は2つの選択肢で、選んだときに何が出るかを文で言い切る（ユーザ判断 2026-10-01：案A）。
                                            前の1つのチェックは、未入力のみでは絞る向き・入力済みのみでは広げる向きと、意味が入れ替わっていた。
                                            GroupName は条件ごとに分ける（同じ名前だと、ほかの編集状況の条件のラジオボタンと1組になる）
                                        -->
                                        <WrapPanel Margin="0,3,0,0"
                                                   Style="{StaticResource MatchModeRadios}">
                                            <RadioButton IsChecked="{Binding MatchAny, Mode=TwoWay}" GroupName="{Binding IdKey, StringFormat='{}{0}.match'}" Margin="0,0,14,0"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAny'}"
                                                         AutomationProperties.Name="{Binding MatchAnyLabel}">
                                                <TextBlock Text="{Binding MatchAnyLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                            </RadioButton>
                                            <RadioButton IsChecked="{Binding MatchAll, Mode=TwoWay}" GroupName="{Binding IdKey, StringFormat='{}{0}.match'}"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                         AutomationProperties.Name="{Binding MatchAllLabel}">
                                                <TextBlock Text="{Binding MatchAllLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                            </RadioButton>
                                        </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    更新通知あり（ユーザ判断 2026-10-06）。編集状況と同じ形で、三択と見る種類のトグル（チップにしない）。
                                    件数は他の条件のもとでその種類の未読の通知がある商品の数。最後の1つは外せない
                                -->
                                <DataTemplate DataType="{x:Type vm:UpdateNoticeModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" Height="28" FontSize="12.5"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Choice'}"
                                                  AutomationProperties.Name="{Binding SpokenLabel}" />
                                        <StackPanel IsEnabled="{Binding CanEditKinds}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditKinds}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="見る種類" Style="{StaticResource Caption}" Margin="0,8,0,3" />
                                            <controls:ContentItemsControl ItemsSource="{Binding Kinds}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ChangeKindToggle}">
                                                        <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,0,3" ToolTip="{Binding Hint}"
                                                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                  AutomationProperties.Name="{Binding Label}">
                                                            <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </controls:ContentItemsControl>
                                            <!--
                                                種類どうしのつなぎ方（ユーザ判断 2026-10-06「未編集と同様の操作感」）。編集状況と同じ2つのラジオボタンで、言い方は MatchModeText。
                                                更新通知ありは1つまでの条件だが、GroupName は編集状況と同じく条件の鍵で分ける
                                            -->
                                            <WrapPanel Margin="0,3,0,0"
                                                       Style="{StaticResource MatchModeRadios}">
                                                <RadioButton IsChecked="{Binding MatchAny, Mode=TwoWay}" GroupName="{Binding IdKey, StringFormat='{}{0}.match'}" Margin="0,0,14,0"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAny'}"
                                                             AutomationProperties.Name="{Binding MatchAnyLabel}">
                                                    <TextBlock Text="{Binding MatchAnyLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                </RadioButton>
                                                <RadioButton IsChecked="{Binding MatchAll, Mode=TwoWay}" GroupName="{Binding IdKey, StringFormat='{}{0}.match'}"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                             AutomationProperties.Name="{Binding MatchAllLabel}">
                                                    <TextBlock Text="{Binding MatchAllLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                </RadioButton>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    候補から積む条件（ユーザ案「list」）。候補は必ず出し、全部を並べずに入力欄から1件ずつ積む
                                    （件数に比例して縦に伸びないように）。積んだ値の件数は「他の条件のもとで、この値に当てはまる件数」
                                -->
                                <DataTemplate DataType="{x:Type vm:ListModule}">
                                    <StackPanel>
                                      <!--
                                          選んだ値に照らす部分。対応アバターで「指定が無い商品だけ」を出すときは、選んだアバターが意味を持たないので薄くする
                                          （ユーザ判断 2026-09-16・案C）。ほかの条件では常に触れる（ShowMatched は既定で入）
                                      -->
                                      <StackPanel IsEnabled="{Binding ShowMatched}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowMatched}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}"
                                                             Placeholder="{Binding Placeholder}"
                                                             IconSelector="{Binding IconSelector}" TrimMiddle="{Binding TrimsMiddle}"
                                                             InfoSelector="{Binding InfoSelector}" GroupHeadings="{Binding GroupHeadings}"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Input'}"
                                                             AutomationProperties.Name="{Binding InputName}"
                                                             Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Chips}" controls:ArrowGroup.IsEnabled="True" Margin="0,6,0,0" Focusable="False"
                                                                      ItemTemplate="{StaticResource SearchChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </controls:ContentItemsControl>
                                        <!--
                                            選んだ値に加えて当てるかたまり（ショップの「お気に入りのショップの商品」・ユーザ指示 2026-09-16）。
                                            入れると、お気に入りのショップを全部選んだのと同じに働く。件数は他の条件を当てたうえでの数
                                        -->
                                        <CheckBox IsChecked="{Binding IncludeOn, Mode=TwoWay}" Margin="0,4,0,0"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.IncludeFavoriteShops'}"
                                                  AutomationProperties.Name="お気に入りのショップはすべて表示"
                                                  ToolTip="選んだショップに加えて、お気に入りのショップの商品も表示します。"
                                                  Visibility="{Binding HasInclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Text}">
                                                <Run Text="★" Foreground="{DynamicResource Star}" /> <Run Text="{Binding IncludeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}" Margin="0,3,0,0"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                  AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}のすべてを満たす商品のみ}"
                                                  Style="{StaticResource MatchModeCheck}" Visibility="{Binding AllowsAnd, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{x:Static vm:MatchModeText.All}" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Flag, Mode=TwoWay}" Margin="0,4,0,0"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Flag'}"
                                                  AutomationProperties.Name="{Binding FlagLabel}"
                                                  Visibility="{Binding HasFlag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding FlagLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </CheckBox>
                                      </StackPanel>

                                      <!--
                                          出すもの（対応アバターだけ・ユーザ判断 2026-09-16・案C）。商品を「対応が書いてある」と「対応の指定が無い」に分け、
                                          どちらを出すかを印で選ぶ。BOOTH には対応アバターを書かずに「どのアバターでも使える」商品がある。
                                          件数は他の条件を当てたうえでの数。最後の1つは外せない
                                      -->
                                      <StackPanel Margin="0,8,0,0"
                                                  Visibility="{Binding HasGroups, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                          <TextBlock Text="表示するもの" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                          <CheckBox IsChecked="{Binding ShowMatched, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ShowMatched'}"
                                                    AutomationProperties.Name="{Binding NameSuffix, StringFormat={}対応している商品を表示{0}}"
                                                    ToolTip="選んだアバターに対応している商品を表示します。">
                                              <TextBlock Text="{Binding MatchedLabel}" FontSize="12" Foreground="{DynamicResource Text}" />
                                          </CheckBox>
                                          <CheckBox IsChecked="{Binding ShowUnspecified, Mode=TwoWay}" Margin="0,3,0,0"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ShowUnspecified'}"
                                                    AutomationProperties.Name="{Binding NameSuffix, StringFormat={}対応の指定が無い商品を表示{0}}"
                                                    ToolTip="対応アバターが書かれていない商品も表示します。">
                                              <TextBlock Text="{Binding UnspecifiedLabel}" FontSize="12" TextWrapping="Wrap"
                                                         Foreground="{DynamicResource Text}" />
                                          </CheckBox>
                                      </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 数の範囲（ユーザ案「上下指定・数値・単品」）。空欄の側は制限しない -->
                                <DataTemplate DataType="{x:Type vm:RangeModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" Height="28" FontSize="12.5" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Source'}"
                                                  AutomationProperties.Name="何の数で絞るか"
                                                  Visibility="{Binding HasSources, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <!--
                                            外れ値を無視（価格だけ・ユーザ判断 2026-09-16）。支援用のバリエーションや販売を止めるための高値は値段ではなく目印なので、
                                            目盛と照合から外す。何円以上を何個外しているかを数で出す
                                        -->
                                        <!--
                                            払った額を見ているときは押せなくして薄くする（メモ16-③）。払った額は自分で入れた数で、外れ値は無い。
                                            値は残す（BOOTHの価格に切り替えれば、また効く）。文字の色は自分で決めず、チェックの色に従わせて薄くなるようにする
                                        -->
                                        <CheckBox IsChecked="{Binding IgnoreOutliers, Mode=TwoWay}" Margin="0,0,0,6"
                                                  IsEnabled="{Binding OutliersApply}"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.IgnoreOutliers'}"
                                                  AutomationProperties.Name="外れ値を無視"
                                                  ToolTip="極端に高い価格を、目盛と絞り込みから外します。商品は外しません。"
                                                  Visibility="{Binding SupportsOutliers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding OutlierLabel}" FontSize="12" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <!--
                                            切のときは種類ごとの価格のどれか1つが範囲に入れば当たる（メモ82-6）。
                                            入れると、全部の価格が範囲に入る商品だけ（無料版と支援版のある商品を「500円以下」から外せる）
                                        -->
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                  AutomationProperties.Name="すべての価格が範囲内の商品のみ"
                                                  ToolTip="切っているときは、どれか1つの価格が範囲に入る商品を表示します。"
                                                  Visibility="{Binding SupportsMatchAll, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="すべての価格が範囲内の商品のみ" FontSize="12" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <!-- 価格の分からない商品を足す（ユーザ判断 2026-10-06。既定は切・有料・無料の同じチェックとは同期しない） -->
                                        <CheckBox IsChecked="{Binding IncludeUnpriced, Mode=TwoWay}" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.IncludeUnpriced'}"
                                                  AutomationProperties.Name="{Binding UnpricedLabel}"
                                                  Visibility="{Binding SupportsUnpriced, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <!-- 文は元（購入額・BOOTHの価格）で出し分ける（ユーザ判断 2026-10-06） -->
                                            <TextBlock Text="{Binding UnpricedLabel}" FontSize="12" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <!--
                                            目盛を出す（ユーザ指示 2026-09-16：目盛が無いと指定しづらい）。
                                            つまみは割合（0〜100）で動かし、目盛の刻みだけでは数が読めないので両端の数を下に出す
                                        -->
                                        <!--
                                            分布の帯（ユーザ判断 2026-09-16・案5）。商品がどこに集まっているかが見えると範囲を決められる。
                                            つまみと同じ対数の配り方で数えているので、帯の位置とつまみの位置が合う。
                                            左の余白はトグルの幅ぶん（スライダの左端に揃える）
                                        -->
                                        <controls:ContentItemsControl ItemsSource="{Binding Histogram}" Height="22" Margin="24,0,0,1"
                                                                      Focusable="False" ToolTip="商品の数の分布"
                                                                      AutomationProperties.Name="商品の数の分布"
                                                                      Visibility="{Binding HasHistogram, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HistogramBar}">
                                                    <Rectangle Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                                               Fill="{DynamicResource AccentBorder}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>

                                        <!--
                                            端に寄せても効いたまま（ユーザ指示 2026-09-16）。片側を外すのは左のトグルで、既定は上下とも効く。
                                            前はつまみを端に置くと黙って「制限なし」になり、「0以上」と「下限なし」を言い分けられなかった
                                        -->
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding MinEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、下限で絞りません。"
                                                      AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MinEnabled'}"
                                                      AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の下限を効かせる}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding LowPosition, Mode=TwoWay}"
                                                    TickFrequency="10" TickPlacement="TopLeft" IsSnapToTickEnabled="False" LargeChange="10"
                                                    IsEnabled="{Binding MinEnabled}" ToolTip="{Binding MinHint}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MinSlider'}"
                                                    AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の下限}" />
                                        </DockPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding MaxEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、上限で絞りません。"
                                                      AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MaxEnabled'}"
                                                      AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の上限を効かせる}" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding HighPosition, Mode=TwoWay}"
                                                    TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False" LargeChange="10"
                                                    IsEnabled="{Binding MaxEnabled}" ToolTip="{Binding MaxHint}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MaxSlider'}"
                                                    AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の上限}" />
                                        </DockPanel>
                                        <DockPanel LastChildFill="False" Margin="24,2,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding MinimumLabel}" Style="{StaticResource Caption}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaximumLabel}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBox Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="62" Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding MinEnabled}" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の下限}"
                                                     AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Min'}"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MinHint}" />
                                            <Button Style="{StaticResource ClearFieldButton}" Command="{Binding ClearMinCommand}"
                                                    ToolTip="下限を消す" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の下限を消す}"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ClearMin'}"
                                                    Visibility="{Binding HasMin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="〜" VerticalAlignment="Center" Margin="4,0" Style="{StaticResource Caption}" />
                                            <TextBox Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="62" Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding MaxEnabled}" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の上限}"
                                                     AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Max'}"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MaxHint}" />
                                            <Button Style="{StaticResource ClearFieldButton}" Command="{Binding ClearMaxCommand}"
                                                    ToolTip="上限を消す" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の上限を消す}"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ClearMax'}"
                                                    Visibility="{Binding HasMax, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    日付の範囲（ユーザ案「カレンダー」）。欄に打つか、右のカレンダーで選ぶ。指定した日をまるまる含む。
                                    どう読んだかを下に添える（「9/1」を去年と読んだ、などが分かるように）
                                -->
                                <DataTemplate DataType="{x:Type vm:DateModule}">
                                    <StackPanel>
                                        <!--
                                            入手日だけ：最初の購入（既定）か、購入ごとの日付の全部か（メモ82・83・判断8）。
                                            価格の「購入額／BOOTHの価格」と同じく、何の日付で見るかを上で選ぶ
                                        -->
                                        <ComboBox ItemsSource="{Binding PurchaseScopes}" SelectedItem="{Binding PurchaseScope, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" Height="28" FontSize="12.5" Margin="0,0,0,6"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.PurchaseScope'}"
                                                  AutomationProperties.Name="どの購入の日付で絞るか"
                                                  ToolTip="「すべての購入」は、2回目以降に買った日が範囲に入る商品も表示します。"
                                                  Visibility="{Binding HasPurchaseScopes, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <!--
                                            「から」は欄の後ろに置く（ユーザ指示 2026-09-16。日本語では値のあとに付く）。
                                            左のトグルで片側を切れる（同。空欄を「制限なし」と読ませるより、切ってあることが見える方が分かる）
                                        -->
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SinceEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、始まりの日で絞りません。"
                                                      AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.SinceEnabled'}"
                                                      AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の始まりの日を効かせる}" />
                                            <ToggleButton x:Name="SinceCalendarButton" DockPanel.Dock="Right" Width="28" Height="26"
                                                          IsEnabled="{Binding SinceEnabled}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Margin="4,0,0,0" ToolTip="{Binding SinceHint}"
                                                          AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.SinceCalendar'}"
                                                          AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の開始の日をカレンダーで選ぶ}">
                                                <!-- 字形のアイコンは字体が無いと四角になる。ほかの画面と同じく線で描く -->
                                                <Path Data="M4,6 H20 V20 H4 Z M4,10 H20 M8,3.5 V7.5 M16,3.5 V7.5" Stroke="{DynamicResource TextMuted}"
                                                      StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                            </ToggleButton>
                                            <TextBlock DockPanel.Dock="Right" Text="から" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearFieldButton}"
                                                    Command="{Binding ClearSinceCommand}" ToolTip="開始の日を消す"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ClearSince'}"
                                                    AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の開始の日を消す}"
                                                    Visibility="{Binding HasSince, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBox Text="{Binding SinceText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding SinceEnabled}" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の開始の日}"
                                                     AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Since'}"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding SinceHint}" />
                                        </DockPanel>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=SinceCalendarButton}" StaysOpen="False" controls:CalendarMonth.FollowsSelection="True"
                                               PlacementTarget="{Binding ElementName=SinceCalendarButton}" Placement="Bottom">
                                            <Calendar SelectedDate="{Binding SinceDate, Mode=TwoWay}" />
                                        </Popup>
                                        <TextBlock Text="{Binding SinceNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Margin="24,2,0,6" />
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding TillEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、終わりの日で絞りません。"
                                                      AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.TillEnabled'}"
                                                      AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の終わりの日を効かせる}" />
                                            <ToggleButton x:Name="TillCalendarButton" DockPanel.Dock="Right" Width="28" Height="26"
                                                          IsEnabled="{Binding TillEnabled}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Margin="4,0,0,0" ToolTip="{Binding TillHint}"
                                                          AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.TillCalendar'}"
                                                          AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の終わりの日をカレンダーで選ぶ}">
                                                <Path Data="M4,6 H20 V20 H4 Z M4,10 H20 M8,3.5 V7.5 M16,3.5 V7.5" Stroke="{DynamicResource TextMuted}"
                                                      StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                            </ToggleButton>
                                            <TextBlock DockPanel.Dock="Right" Text="まで" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearFieldButton}"
                                                    Command="{Binding ClearTillCommand}" ToolTip="終わりの日を消す"
                                                    AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.ClearTill'}"
                                                    AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の終わりの日を消す}"
                                                    Visibility="{Binding HasTill, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBox Text="{Binding TillText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding TillEnabled}" AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の終わりの日}"
                                                     AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Till'}"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding TillHint}" />
                                        </DockPanel>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=TillCalendarButton}" StaysOpen="False" controls:CalendarMonth.FollowsSelection="True"
                                               PlacementTarget="{Binding ElementName=TillCalendarButton}" Placement="Bottom">
                                            <Calendar SelectedDate="{Binding TillDate, Mode=TwoWay}" />
                                        </Popup>
                                        <TextBlock Text="{Binding TillNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Margin="24,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    ユーザータグ（ユーザ指示 2026-09-28）。欄の候補は大分類だけで、選ぶと大分類の枠が1つ立つ。
                                    枠の中の欄から小分類と「小分類なし」を1件ずつ足す（全部並べると小分類の数だけ縦に伸びる）。
                                    小分類どうしの AND／OR は枠ごと、大分類どうしは下のチェック
                                -->
                                <DataTemplate DataType="{x:Type vm:UserTagModule}">
                                    <StackPanel>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}" Placeholder="大分類を選んで追加"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Input'}"
                                                             AutomationProperties.Name="{Binding NameSuffix, StringFormat={}大分類を選んで追加{0}}"
                                                             Visibility="{Binding ShowsInput, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="ユーザータグがまだ登録されていません。編集画面から追加できます。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsMasterEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:UserTagTopRow}">
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5"
                                                            Padding="8,6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <Button DockPanel.Dock="Right" Content="×" ContentTemplate="{StaticResource CrossGlyph}" FontSize="11" Padding="4,0" Cursor="Hand"
                                                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource TextMuted}" ToolTip="この大分類を外す"
                                                                        AutomationProperties.Name="{Binding Top, StringFormat={}{0}を外す}"
                                                                        Command="{Binding RemoveCommand}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center" Margin="6,0,4,0" />
                                                                <TextBlock Text="{Binding Top}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Top}"
                                                                           VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False" Margin="0,5,0,0"
                                                                                 CommitCommand="{Binding AddCommand}" Placeholder="小分類を選んで追加"
                                                                                 AutomationProperties.Name="{Binding Top, StringFormat={}{0}の小分類を選んで追加}"
                                                                                 Visibility="{Binding ShowsInput, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <controls:ContentItemsControl ItemsSource="{Binding Chips}" controls:ArrowGroup.IsEnabled="True" Margin="0,5,0,0" Focusable="False"
                                                                                          ItemTemplate="{StaticResource SearchChipTemplate}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </controls:ContentItemsControl>
                                                            <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Top, StringFormat={}{0}の小分類のすべてを満たす商品のみ}"
                                                                      Style="{StaticResource MatchModeCheck}">
                                                                <TextBlock Text="{x:Static vm:MatchModeText.All}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                  AutomationProperties.Name="{Binding NameSuffix, StringFormat={}すべての大分類を満たす商品のみ{0}}"
                                                  Style="{StaticResource MatchModeCheck}"
                                                  Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <!-- 大分類どうしは0〜1件の間は出さない（ユーザ判断 2026-10-06。ずれは受け入れる）。枠の中の小分類どうしは薄く出したまま -->
                                            <TextBlock Text="{Binding TopMatchAllText}" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    改変（ユーザ判断 2026-10-06）。ユーザータグと同じ2段：欄の候補はアバターと改変（改変に追加の窓と同じ探し方）。
                                    アバターを選ぶとアバターの枠が立ち、改変を選ぶとそのアバターの枠にその改変が入る。
                                    改変どうしの AND／OR は枠ごと、アバターどうしは下のチェック。画面に「大分類」「小分類」とは書かない
                                -->
                                <DataTemplate DataType="{x:Type vm:ModificationModule}">
                                    <StackPanel>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}" Placeholder="アバターか改変を選んで追加"
                                                             IconSelector="{Binding IconSelector}" InfoSelector="{Binding InfoSelector}"
                                                             Matcher="{Binding Matcher}"
                                                             GroupHeadings="{x:Static vm:ModificationModule.Headings}"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Input'}"
                                                             AutomationProperties.Name="{Binding NameSuffix, StringFormat={}アバターか改変を選んで追加{0}}"
                                                             Visibility="{Binding ShowsInput, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="改変がまだありません。アバターの管理から作れます。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ModificationAvatarRow}">
                                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5"
                                                            Padding="8,6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <!-- アバターの絵。無ければ頭文字（候補の欄と同じ出し方） -->
                                                                <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,7,0" CornerRadius="4" ClipToBounds="True"
                                                                        Background="{DynamicResource SurfaceAlt}" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                                                    </Grid>
                                                                </Border>
                                                                <Button DockPanel.Dock="Right" Content="×" ContentTemplate="{StaticResource CrossGlyph}" FontSize="11" Padding="4,0" Cursor="Hand"
                                                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource TextMuted}" ToolTip="このアバターを外す"
                                                                        AutomationProperties.Name="{Binding AvatarName, StringFormat={}{0}を外す}"
                                                                        Command="{Binding RemoveCommand}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center" Margin="6,0,4,0" />
                                                                <TextBlock Text="{Binding AvatarName}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AvatarName}"
                                                                           VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False" Margin="0,5,0,0"
                                                                                 CommitCommand="{Binding AddCommand}" Placeholder="改変を選んで追加"
                                                                                 IconSelector="{Binding IconSelector}"
                                                                                 AutomationProperties.Name="{Binding AvatarName, StringFormat={}{0}の改変を選んで追加}"
                                                                                 Visibility="{Binding ShowsInput, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="改変を選ばないときは、このアバターのすべての改変が対象です。" Style="{StaticResource Caption}"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                                       Visibility="{Binding HasNoModification, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <controls:ContentItemsControl ItemsSource="{Binding Chips}" controls:ArrowGroup.IsEnabled="True" Margin="0,5,0,0" Focusable="False"
                                                                                          ItemTemplate="{StaticResource SearchChipTemplate}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </controls:ContentItemsControl>
                                                            <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding AvatarName, StringFormat={}{0}の改変のすべてを満たす商品のみ}"
                                                                      Style="{StaticResource MatchModeCheck}">
                                                                <TextBlock Text="{x:Static vm:MatchModeText.All}" FontSize="12" Foreground="{DynamicResource Text}" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                  AutomationProperties.Name="{Binding NameSuffix, StringFormat={}すべてのアバターを満たす商品のみ{0}}"
                                                  Style="{StaticResource MatchModeCheck}"
                                                  Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <!-- アバターどうしもユーザータグの大分類と同じく0〜1件の間は出さない（ユーザ判断 2026-10-06） -->
                                            <TextBlock Text="{Binding AvatarMatchAllText}" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 属性（ユーザ案「上下指定・数値・AND OR」）。使う属性だけを候補から選んで積む -->
                                <DataTemplate DataType="{x:Type vm:AttributeModule}">
                                    <StackPanel>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}" Placeholder="属性を選んで追加"
                                                             AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Input'}"
                                                             AutomationProperties.Name="属性を選んで追加"
                                                             Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="属性がまだ登録されていません。編集画面から追加できます。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AttributeFilter}">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <Button DockPanel.Dock="Right" Content="×" ContentTemplate="{StaticResource CrossGlyph}" FontSize="11" Padding="4,0" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource TextMuted}" ToolTip="この属性を外す"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}"
                                                                    Command="{Binding RemoveCommand}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}"
                                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                                        </DockPanel>
                                                        <!--
                                                            分布の帯（メモ82：価格と同じくヒストグラムを出す）。目盛は直線なので、帯も等しい幅で数える
                                                        -->
                                                        <controls:ContentItemsControl ItemsSource="{Binding Histogram}" Height="22" Margin="0,3,0,1"
                                                                                      Focusable="False" ToolTip="評価した商品の数の分布"
                                                                                      AutomationProperties.Name="評価した商品の数の分布"
                                                                                      Visibility="{Binding HasHistogram, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:HistogramBar}">
                                                                    <Rectangle Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                                                               Fill="{DynamicResource AccentBorder}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </controls:ContentItemsControl>
                                                        <!--
                                                            1%刻み（メモ82・判断9）。目盛（10%）は読む手掛かりにだけ使い、吸い付けない。
                                                            キーの刻みも1にする（既定の0.1のままだと、丸めて同じ値に戻りキーでは動かない。点検 2026-09-23 と同じ）。上下を外すチェックは付けない（メモ82）
                                                        -->
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding LowPosition, Mode=TwoWay}"
                                                                TickFrequency="10" TickPlacement="TopLeft" IsSnapToTickEnabled="False"
                                                                SmallChange="1" LargeChange="10"
                                                                AutomationProperties.AutomationId="SearchAttributeMinSlider"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の下限}" />
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding HighPosition, Mode=TwoWay}"
                                                                TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                                                SmallChange="1" LargeChange="10"
                                                                AutomationProperties.AutomationId="SearchAttributeMaxSlider"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の上限}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MatchAll'}"
                                                  AutomationProperties.Name="すべての属性を満たす商品のみ"
                                                  Style="{StaticResource MatchModeCheck}">
                                            <TextBlock Text="{x:Static vm:MatchModeText.All}" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </CheckBox>
                                        <TextBlock Text="追加した属性は、評価済みの商品だけが対象になります。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    最近（ユーザ判断 2026-10-06・案A）。記録の種類ごとに「最後にそれをしてからの日数」を軸に、価格・属性と同じ分布の帯とスライダ2本。
                                    帯の範囲は一週間・一か月・一年・全期間から選ぶ（いちばん古い記録がとても昔だと、全期間の帯は最近の数日が潰れる）。
                                    範囲を区切ると右端の1本が「それより前」で、色を分ける
                                -->
                                <DataTemplate DataType="{x:Type vm:RecentModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" Height="28" FontSize="12.5"
                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Choice'}"
                                                  AutomationProperties.Name="何の記録で絞るか" />
                                        <!-- 4つは同じ幅に並べる（つながったボタン。並べ替えの向きと同じ部品） -->
                                        <UniformGrid Rows="1" Columns="4" Margin="0,6,0,0">
                                            <RadioButton Style="{StaticResource SegmentFirst}" Content="一週間" IsChecked="{Binding IsWeek, Mode=TwoWay}"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Period.Week'}"
                                                         AutomationProperties.Name="帯の範囲：一週間" />
                                            <RadioButton Style="{StaticResource SegmentMiddle}" Content="一か月" IsChecked="{Binding IsMonth, Mode=TwoWay}"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Period.Month'}"
                                                         AutomationProperties.Name="帯の範囲：一か月" />
                                            <RadioButton Style="{StaticResource SegmentMiddle}" Content="一年" IsChecked="{Binding IsYear, Mode=TwoWay}"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Period.Year'}"
                                                         AutomationProperties.Name="帯の範囲：一年" />
                                            <RadioButton Style="{StaticResource SegmentLast}" Content="全期間" IsChecked="{Binding IsAll, Mode=TwoWay}"
                                                         AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Period.All'}"
                                                         AutomationProperties.Name="帯の範囲：全期間" />
                                        </UniformGrid>
                                        <TextBlock Text="{Binding RangeText}" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Right"
                                                   AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.RangeText'}" />
                                        <TextBlock Text="記録が付くと、ここに日数の分布が表示されます。" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasRecords, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Histogram}" Height="22" Margin="0,3,0,1"
                                                                      Focusable="False" ToolTip="最後の記録の日数の分布"
                                                                      AutomationProperties.Name="最後の記録の日数の分布"
                                                                      Visibility="{Binding HasHistogram, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HistogramBar}">
                                                    <Rectangle x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                                               Fill="{DynamicResource AccentBorder}" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutside}" Value="True">
                                                            <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BorderStrong}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <!--
                                            つまみは位置（0〜100）で動かし、日数に割り戻す（価格と同じ。右端を日数に結ぶと、範囲を変えた瞬間に丸めた値が書き戻されうる）。
                                            矢印キーは1日ずつ。上下を外すチェックは付けない（右端が「それより前もすべて」・左端が今日）
                                        -->
                                        <Slider Minimum="0" Maximum="100" Value="{Binding LowPosition, Mode=TwoWay}"
                                                TickFrequency="{Binding TickFrequency}" TickPlacement="TopLeft" IsSnapToTickEnabled="False"
                                                SmallChange="{Binding DayStep}" LargeChange="{Binding TickFrequency}" ToolTip="{Binding ScaleHint}"
                                                AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MinSlider'}"
                                                AutomationProperties.Name="何日前から" />
                                        <Slider Minimum="0" Maximum="100" Value="{Binding HighPosition, Mode=TwoWay}"
                                                TickFrequency="{Binding TickFrequency}" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                                                SmallChange="{Binding DayStep}" LargeChange="{Binding TickFrequency}" ToolTip="{Binding ScaleHint}"
                                                AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MaxSlider'}"
                                                AutomationProperties.Name="何日前まで" />
                                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding MinimumLabel}" Style="{StaticResource Caption}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaximumLabel}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                        <Button Content="新しい順に並べる" Command="{Binding SortCommand}" IsEnabled="{Binding CanSort}"
                                                HorizontalAlignment="Left" Height="28" FontSize="12" Padding="10,0" Margin="0,8,0,0"
                                                ToolTip="{Binding SortHint}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Sort'}"
                                                AutomationProperties.Name="この記録の新しい順に並べる" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.Resources>

                            <!--
                                条件1つの枠。左のチェックで、値を残したまま効かせない（ユーザ案：追加状態を保ったまま無効化）。
                                右上の × で条件ごと外す
                            -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <!-- 落とし先の線。Adorner ではなく行のプロパティで出す（タグ・属性の並べ替えと同じ作り） -->
                                        <Border Height="2" Margin="0,0,0,2" Background="{DynamicResource Accent}"
                                                Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <!--
                                            条件の枠。右クリック（と見出しの「…」・Shift+F10）で条件のメニューを開く（2026-10-01）。
                                            入力欄・候補の欄の上では、その欄のメニュー（切り取り・貼り付け）が先に出る。
                                            「…」は乗せた・枠の中に止まったときだけ出る（RevealOnHoverOrFocusButton。いちばん近い Border＝この枠で見る・D8）
                                        -->
                                        <controls:FocusFrame BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,8" Background="{DynamicResource Surface}"
                                                FocusVisualStyle="{StaticResource ModuleFrameFocusVisual}"
                                                AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の条件}"
                                                AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Frame'}">
                                            <controls:FocusFrame.ContextMenu>
                                                <ContextMenu AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.MenuList'}"
                                                             AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の操作}">
                                                    <!-- 除くを持つ種類だけ押せる（三項・最近・編集状況は押せない・D10）。項目は出したまま理由を言う（右クリックの決まり・2026-10-04） -->
                                                    <MenuItem Header="当てはまる商品を除く" AutomationProperties.Name="当てはまる商品を除く" IsCheckable="True" IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                                              AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu.Exclude'}"
                                                              IsEnabled="{Binding SupportsExclude}"
                                                              controls:MenuTips.Disabled="この条件では「除く」を使えません" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding CollapseMenuText}" Command="{Binding ToggleCollapseCommand}"
                                                              AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu.Collapse'}"
                                                              AutomationProperties.Name="{Binding CollapseMenuText}" />
                                                    <MenuItem Header="上へ移動" AutomationProperties.Name="上へ移動" Command="{Binding MoveUpCommand}"
                                                              AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu.MoveUp'}" />
                                                    <MenuItem Header="下へ移動" AutomationProperties.Name="下へ移動" Command="{Binding MoveDownCommand}"
                                                              AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu.MoveDown'}" />
                                                    <Separator />
                                                    <MenuItem Header="この条件を外す" AutomationProperties.Name="この条件を外す" Command="{Binding RemoveCommand}"
                                                              AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu.Remove'}" />
                                                </ContextMenu>
                                            </controls:FocusFrame.ContextMenu>
                                            <StackPanel>
                                                <!--
                                                    見出し。Tab はチェック → 札「除く」→「…」→ ⌃ → × の順（左から右。前は × が先に止まっていた）。
                                                    チェックと札は左寄せの DockPanel に入れる：札を見出しの文字のすぐ右に置き、幅が足りないときは
                                                    札を残して文字の方を切る。札を先に置く（右寄せの子は先に並べる）ので、Tab の順は番号で決める
                                                -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--
                                                        つまんで動かす所。カードのどこでも掴めるようにすると、
                                                        スライダを動かすたびに並べ替えが始まってしまう
                                                    -->
                                                    <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="11" Margin="0,0,6,0"
                                                               Cursor="SizeAll" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFaint}"
                                                               ToolTip="ドラッグで順番を変えられます"
                                                               AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の順番を変える}"
                                                               PreviewMouseLeftButtonDown="OnModuleHandlePress"
                                                               MouseMove="OnModuleHandleMove" />
                                                    <DockPanel Grid.Column="1" HorizontalAlignment="Left" LastChildFill="True"
                                                               KeyboardNavigation.TabNavigation="Local">
                                                        <!--
                                                            除いているときの札（2026-10-01）。押すと除くのをやめる。色は字と枠を Danger、地は Surface（D11。
                                                            結果を大きく減らす向きの印で、未選択の Warn・選んだ値の Accent と見分けられる）
                                                        -->
                                                        <Button DockPanel.Dock="Right" Content="除く" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                KeyboardNavigation.TabIndex="1" Cursor="Hand"
                                                                Style="{StaticResource ExcludedTag}" ToolTip="{Binding ExcludedHint}"
                                                                AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Excluded'}"
                                                                AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}を除くのをやめる}"
                                                                Command="{Binding ToggleExcludeCommand}" Click="OnExcludedTagClick"
                                                                Visibility="{Binding IsExcluded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <CheckBox x:Name="ModuleEnabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                                  KeyboardNavigation.TabIndex="0"
                                                                  ToolTip="切ると、値を残したままこの条件を効かせません"
                                                                  AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Enabled'}"
                                                                  AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の条件を効かせる}">
                                                            <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Text}" ToolTip="{Binding Hint}" />
                                                        </CheckBox>
                                                    </DockPanel>
                                                    <Button x:Name="ModuleMenu" Grid.Column="2" Style="{StaticResource ModuleMenuButton}" Click="OnModuleMenuClick"
                                                            AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Menu'}"
                                                            AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の操作}" />
                                                    <Button Grid.Column="3" Style="{StaticResource ModuleCollapseToggle}"
                                                            Command="{Binding ToggleCollapseCommand}" Margin="0,0,2,0" />
                                                    <Button Grid.Column="4" Content="×" ContentTemplate="{StaticResource CrossGlyph}" FontSize="13" Padding="4,0" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                                            Foreground="{DynamicResource TextMuted}" ToolTip="この条件を外す"
                                                            AutomationProperties.AutomationId="{Binding IdKey, StringFormat='SearchModule.{0}.Remove'}"
                                                            AutomationProperties.Name="{Binding SpokenLabel, StringFormat={}{0}の条件を外す}"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                                <!-- 畳んでも条件は効いたままなので、何で絞っているかを1行で出す -->
                                                <TextBlock Text="{Binding CollapsedSummary}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="18,4,0,0"
                                                           Visibility="{Binding IsCollapsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding HasDisabledReason, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <ContentControl x:Name="ModuleBody" Content="{Binding}" Focusable="False" Margin="0,7,0,0"
                                                                Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasDisabledReason}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </StackPanel>
                                        </controls:FocusFrame>
                                        <Border Height="2" Margin="0,2,0,0" Background="{DynamicResource Accent}"
                                                Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <!-- 結果 -->
        <DockPanel Grid.Column="1">
            <!--
                検索の履歴

                **一番上に横のスロットで出す**（ユーザ指示）。絞り込みパネルは
                既に手狭で、足したい条件も控えているので幅を食わせない。

                横に溢れるので `ScrollViewer` に入れる。件数の上限は設定にある——
                増やすほど端まで送る手間が増えるので、好みで決められるようにした。

                入っているものが無いときは出さない。初回起動で空の帯が居座ると、
                何のための場所か分からない
            -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="18,7"
                    Visibility="{Binding HasHistory, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
              <DockPanel>
                <!--
                    帯の左端に見出し（ユーザ指示 2026-09-16：上に履歴が溜まっていることが分かりにくい）。
                    帯そのものが履歴のあるときだけ出るので、見出しも履歴のあるときだけ見える
                -->
                <TextBlock DockPanel.Dock="Left" Text="検索履歴" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <!--
                    横に送れるが、バーは出さない（ユーザ指示 2026-09-16）。バーが無いとつまめないので、ホイールで横に送る。
                    バーが無いと右端のチップが切れても続きがあると分からなかった（点検 2026-09-23）ので、
                    続きがある側の端にだけ「‹」「›」を出す（押すと1画面ぶん送る）。切れたチップの上に薄い地を重ねて、端だと分かるようにする
                -->
                <Grid>
                <ScrollViewer x:Name="HistoryStrip" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnHistoryMouseWheel" ScrollChanged="OnHistoryScrollChanged">
                    <controls:ContentItemsControl ItemsSource="{Binding History}" controls:ArrowGroup.IsEnabled="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchHistorySlot}">
                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 押すとその条件に戻る -->
                                        <Button Style="{StaticResource HistorySlotButton}"
                                                Command="{Binding ApplyCommand}"
                                                AutomationProperties.AutomationId="SearchHistoryApply"
                                                AutomationProperties.Name="{Binding Summary, StringFormat={}{0}の条件に戻す}"
                                                ToolTip="{Binding Summary}">
                                            <StackPanel Orientation="Horizontal" Margin="10,4">
                                                <!-- 名前を付けたものは件数で落とさないので、印で区別する -->
                                                <TextBlock Text="★" FontSize="10" Margin="0,0,5,0"
                                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNamed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- 要らない条件は個別に消せる。全部消すのは設定から -->
                                        <!--
                                            赤にしない（消す操作の例外。ユーザ判断 2026-10-05「重要度が高くない割に大量に並んでしまうからだ」）。
                                            色は中の文字に直に付ける。この型は ContentPresenter に文字を任せるので、ボタンの Foreground は
                                            アプリ全体の TextBlock の暗黙の型に負ける
                                        -->
                                        <Button Style="{StaticResource HistorySlotButton}"
                                                FontSize="10" Padding="6,4" Command="{Binding RemoveCommand}"
                                                AutomationProperties.AutomationId="SearchHistoryRemove"
                                                AutomationProperties.Name="{Binding Summary, StringFormat={}{0}の履歴を削除}"
                                                ToolTip="この履歴を削除します。検索の条件は変わりません。">
                                            <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </controls:ContentItemsControl>
                </ScrollViewer>
                <Button x:Name="HistoryBack" Style="{StaticResource HistoryScrollButton}" HorizontalAlignment="Left" Content="‹"
                        Click="OnHistoryScrollBack" Visibility="Collapsed"
                        ToolTip="前の履歴へ送ります。ホイールでも送れます。" AutomationProperties.Name="前の検索履歴へ送る" />
                <Button x:Name="HistoryForward" Style="{StaticResource HistoryScrollButton}" HorizontalAlignment="Right" Content="›"
                        Click="OnHistoryScrollForward" Visibility="Collapsed"
                        ToolTip="続きの履歴へ送ります。ホイールでも送れます。" AutomationProperties.Name="続きの検索履歴へ送る" />
                </Grid>
              </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="78" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <StackPanel Margin="18,9,18,0">
                  <!-- 検索欄の右に「対象」と「オプション」（ユーザ案 2026-09-15）。どちらもトグルなので、開いたまま続けて切り替えられる -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                            Height="34" HorizontalAlignment="Stretch" Background="{DynamicResource InputBack}">
                        <Grid>
                            <TextBox x:Name="QueryBox" MaxLength="500" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0,34,0"
                                     FontSize="13" Background="Transparent"
                                     AutomationProperties.Name="検索欄" />
                            <!-- 打った文字を消す（ユーザ指示 2026-09-16）。絞り込みの条件は消さない -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                                    Style="{StaticResource ClearFieldButton}" Command="{Binding ClearQueryCommand}"
                                    ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                                    AutomationProperties.AutomationId="SearchClearQuery"
                                    Visibility="{Binding HasQueryText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding QueryPlaceholder}" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFaint}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueryText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                        <MenuItem Header="対象 ▾" ItemsSource="{Binding TargetOptions}" Height="34" Padding="10,0"
                                  AutomationProperties.AutomationId="SearchTargets" AutomationProperties.Name="対象"
                                  ToolTip="探す項目を選びます。name: などを付けた語は、その項目を探します。">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsOn, Mode=TwoWay}" />
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="オプション ▾" Height="34" Padding="10,0"
                                  AutomationProperties.AutomationId="SearchOptions" AutomationProperties.Name="オプション">
                            <MenuItem Header="大文字と小文字を区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding CaseSensitive, Mode=TwoWay}" AutomationProperties.AutomationId="SearchOption.CaseSensitive" />
                            <MenuItem Header="全角と半角を区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding WidthSensitive, Mode=TwoWay}" AutomationProperties.AutomationId="SearchOption.WidthSensitive" />
                            <MenuItem Header="ひらがなとカタカナを区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding KanaSensitive, Mode=TwoWay}" AutomationProperties.AutomationId="SearchOption.KanaSensitive" />
                            <Separator />
                            <MenuItem Header="別表記でも検索" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding SearchAlternates, Mode=TwoWay}" AutomationProperties.AutomationId="SearchOption.Alternates"
                                      ToolTip="読み・漢字・英語などの別の書き方でも探します。" />
                            <MenuItem Header="　ローマ字変換（tori → とり・トリ）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseRomaji, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SearchOption.Romaji" />
                            <MenuItem Header="　漢字変換（とり → 鳥）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseKanji, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SearchOption.Kanji" />
                            <MenuItem Header="　英日変換（shark → サメ）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseEnglishToJapanese, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SearchOption.EnglishToJapanese" />
                            <MenuItem Header="　日英変換（リボン → ribbon）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseJapaneseToEnglish, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SearchOption.JapaneseToEnglish" />
                            <MenuItem Header="　造語変換（nadeoto → 撫で音）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseCoined, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="SearchOption.Coined"
                                      ToolTip="辞書に無い語は、商品名の漢字を1字ずつ読んで探します。" />
                        </MenuItem>
                    </Menu>
                  </Grid>

                    <!-- 書き方の見本。削れてよいので、はみ出した分は切る -->
                    <StackPanel Orientation="Horizontal" ClipToBounds="True" Margin="2,5,2,0">
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="衣装 -無料 &quot;夏セット&quot;" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="衣装 (夏 OR 冬)" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="path:ring" />
                        <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" Foreground="{DynamicResource TextFaint}"
                                   Text="スペースで両方、-で除く、&quot;&quot;でひとまとまり、name: で探す項目を絞る">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    スペースで区切ると、どちらも含むものを探します。<LineBreak />
                                    -無料 のように書くと、その語を含むものを除きます。<LineBreak />
                                    &quot;夏セット&quot; と囲むと、その並びのまま含むものだけを探します。<LineBreak />
                                    <LineBreak />
                                    括弧が無いと 衣装 夏 OR 冬 は「衣装かつ夏」または「冬」と読まれます。<LineBreak />
                                    衣装 (夏 OR 冬) と書けば「衣装かつ、夏か冬」になります。<LineBreak />
                                    <LineBreak />
                                    前に付けると、その項目だけを探します。「対象」で外していても探します。<LineBreak />
                                    name: 商品名　shop: ショップ名　memo: メモ　subdomain: サブドメイン　main: 本文<LineBreak />
                                    tag: BOOTHタグ　variation: バリエーション名　id: 商品ID<LineBreak />
                                    file: ファイル名　path: ファイルの場所　content: zipの中のファイル名<LineBreak />
                                    name:&quot;夏 セット&quot; や tag:(夏 OR 冬) のようにも書けます。&quot;…&quot; の中の name: はそのままの文字として探します。
                                </TextBlock>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                件数（左）と表示順・カード／リスト（右）の帯。**入り切らなければ右を次の行へ送る**（点検 2026-09-23）。
                前は右の塊を右寄せで重ね、左に決め打ちの余白を取っていたので、幅 900px の窓で件数の上に表示順が乗って読めなかった。
                カード／リストの切り替えも、一覧の右下に浮かせるのをやめてここに置く（狭い窓でカードの上に重なった）
            -->
            <Border DockPanel.Dock="Top" MinHeight="38" Background="{DynamicResource Bg}" Padding="18,5">
                <controls:SplitRowPanel VerticalAlignment="Center" MinLeftWidth="200">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ResultSummary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="SearchResultSummary" />
                        <TextBlock DockPanel.Dock="Left" Text="読み込み中…" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!--
                            表記をまたいで探したときは、何で当たったかを必ず出す。
                            辞書は引いた結果を説明できるのが取り柄なので、説明を捨てない。
                        -->
                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasWidened, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding WidenedText}" FontSize="11" Foreground="{DynamicResource AccentText}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </Border>
                        <!-- なぜこの結果になったかを結果の隣で読めるようにする。幅が足りなければ省略して縮む（全文は吹き出し） -->
                        <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FilterSummary}"
                                   Visibility="{Binding HasActiveFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </DockPanel>

                    <!--
                        表示順は絞り込みと別の場所に置く。**使う項目と向きを分ける**（ユーザ指示 2026-09-20・M5）。
                        項目は多いのでプルダウン、向きは2つなので繋がったボタン（ui-rules.md の並べ替えの決め事）。
                        向きの言い方は項目で変わる（日付は「新しい順／古い順」、数は「多い順／少ない順」、額は「高い順／安い順」、
                        名前とショップは「昇順／降順」、カテゴリは「BOOTHの並び／逆順」）
                    -->
                    <!-- 絞り込み欄を開いた幅 900px の窓では、送った先の1行にも入り切らない。表示順と切り替えの間でも折り返す -->
                    <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <!--
                            押すとメニューが開くボタン（ユーザ判断 2026-10-06：「属性」の中に大量の属性が入っている形）。
                            プルダウンは子の一覧を持てないので、「属性 ▸」の子に属性を入れるためにメニューにした。閉じた姿はプルダウンと同じ顔（DropDownButton）。
                            メニューの並びと区切りは SearchViewModel.SortMenu。属性が多くても、下の段は画面の高さで止まって中が流れる（メニューの型の MenuScrollViewer）
                        -->
                        <Button x:Name="SortFieldButton" Style="{StaticResource DropDownButton}" Content="{Binding SortField.Label}"
                                Width="150" Height="28" FontSize="12"
                                Click="OnSortFieldMenuClick" PreviewKeyDown="OnSortFieldMenuKeyDown"
                                AutomationProperties.AutomationId="SearchSortField"
                                AutomationProperties.Name="{Binding SortField.Label, StringFormat='並べ替えに使う項目、{0}'}">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding SortMenu}" Opened="OnSortFieldMenuOpened">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Label}" />
                                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                            <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                            <Setter Property="ItemsSource" Value="{Binding Children}" />
                                            <Setter Property="controls:MenuTips.Disabled" Value="{Binding DisabledHint}" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                            <!-- 子の属性も同じ形で出す（印・選ぶ・名前） -->
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                                        <Setter Property="Command" Value="{Binding ChooseCommand}" />
                                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- 属性が0個でも子を開く見た目（▸）のまま押せなくする。子が無いと型が子を持たない項目の物に替わり、▸ が消える -->
                                                <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                    <Setter Property="Template" Value="{StaticResource MenuSubmenuHeader}" />
                                                </DataTrigger>
                                                <!-- 区切り線：見た目を線に差し替え、押せず・キーボードでも止まらない（「＋ 条件を追加」と同じ作り） -->
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="MenuItem">
                                                                <Border Height="1" Margin="30,4,4,4" Background="{DynamicResource MenuSeparator}" SnapsToDevicePixels="True" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                        <Grid Margin="0,2,16,2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="SearchSortOrder" Style="{StaticResource SegmentFirst}"
                                         Content="{Binding DescendingLabel}" MinWidth="82"
                                         IsChecked="{Binding SortsDescending, Mode=TwoWay}" AutomationProperties.AutomationId="SearchSortDescending" />
                            <RadioButton Grid.Column="1" GroupName="SearchSortOrder" Style="{StaticResource SegmentLast}"
                                         Content="{Binding AscendingLabel}" MinWidth="82"
                                         IsChecked="{Binding SortsAscending, Mode=TwoWay}" AutomationProperties.AutomationId="SearchSortAscending" />
                        </Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                    VerticalAlignment="Center" Margin="0,2" />
                    </WrapPanel>
                </controls:SplitRowPanel>
            </Border>

            <!-- 右下の大きさのスライダー（ユーザ判断 2026-09-29）。下から積むので、選択中の帯より先に書いて一番下に置く -->
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSizeBar}" Focusable="False" />

            <!--
                選択中だけ出る操作バー。下端に重ねて出す。
                上に差し込むと結果の位置がずれて、選んでいる最中に操作が途切れる。
            -->
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSelectionBar}" Focusable="False"
                            Visibility="{Binding ShowsSelectionBar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!--
                取り込み中に増えたぶんは、押されるまで一覧へ入れない。
                読んでいる最中に足元が動くと、どこを見ていたか分からなくなる。
                件数とバッジは即座に動くので、増えたこと自体は隠していない。
            -->
            <Button DockPanel.Dock="Top" Margin="18,0,18,4" FontSize="12"
                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding Main.ApplyPendingCommand}"
                    AutomationProperties.AutomationId="SearchApplyPending"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <Grid SizeChanged="OnResultsSizeChanged">
                <!--
                    行を仮想化の単位にする。WPFには仮想化するWrapPanelが無いので、
                    列数をViewModel側で決めて結果を行に切り、その行をListBoxに並べている。
                    画面外の行のカードは実体化されないので、サムネイルの復号も走らない。
                -->
                <!--
                    リスト（ユーザ指示 2026-09-14）。1行ずつ、絵・星・名前・ショップ・札を並べる。
                    列の幅は見出しの境目をドラッグで変え、全部の行で共通（ListColumns）。行の操作はカードと同じ
                -->
                <controls:ItemListView ItemsSource="{Binding ListViewItems}" View="{StaticResource SearchItemListGridView}"
                          ItemContainerStyleSelector="{StaticResource ItemListRowStyles}"
                          ScrollViewer.ScrollChanged="OnResultsScrollChanged" Loaded="OnResultsLoaded"
                          BorderThickness="0" Background="Transparent" Margin="18,4,18,18"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!-- カードの行の一覧。Tab で1回だけ入り、中は矢印でカードからカードへ移る（CardRowsListBox が並び ArrowGroup になる。ユーザ判断 2026-10-01） -->
                <!-- 段は読み上げ・自動操作の木に出さず、カードを一覧の直下に出す（CardRowsListBox と CardRowItems。ユーザ判断 2026-09-30） -->
                <controls:CardRowsListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                         ScrollViewer.ScrollChanged="OnResultsScrollChanged" Loaded="OnResultsLoaded"
                         Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <controls:CardRowsListBox.ItemContainerStyle>
                        <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </controls:CardRowsListBox.ItemContainerStyle>
                    <controls:CardRowsListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:CardRowItems ItemsSource="{Binding Cards}" ItemTemplateSelector="{StaticResource CardSlotTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </controls:CardRowItems>
                        </DataTemplate>
                    </controls:CardRowsListBox.ItemTemplate>
                </controls:CardRowsListBox>

                <!--
                    空の文の型（EmptyTitle・EmptyNote。ui-empty-and-errors.md）。見出しは折り返しを指定しておらず、
                    説明は折り返しても中央に揃わなかった。左右の 24 は、折り返した文が欄の縁に付かないため（フォルダの右の欄と同じ）
                -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="該当するものがありません" Style="{StaticResource EmptyTitle}" />
                    <!--
                        絞り込んで0件なのか、そもそも何も入っていないのかで、次にやることが違う。
                        「取り込んでください」は、条件で絞った結果が0件のときには的外れになる。
                    -->
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource EmptyNote}" Margin="0,6,0,0" />
                    <!-- 0件でも自動では広げない（ユーザ判断 2026-09-16）。広げるかはここで選ばせる -->
                    <Button Content="別表記でも検索する" Style="{StaticResource SmallButton}" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Command="{Binding WidenCommand}"
                            AutomationProperties.AutomationId="SearchWiden"
                            ToolTip="読み・漢字・英語などの別の書き方でも探します。"
                            Visibility="{Binding ShowsWidenOffer, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </controls:PaneGrid>
</UserControl>
