<Window x:Class="Chmonos.App.Views.RegisterPastedItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegisterPastedItemsDialogViewModel}"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        コピーした物から見つけた2件以上の商品を、まとめて登録する（計画 26・ユーザ判断 2026-11-11）。
        出てきた順に並べる（ページで見た順のまま）。ライブラリにある物はチェックを外し、押せなくして並べる
    -->
    <StackPanel Margin="22,20">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSizeHeading}" />
        <TextBlock Text="{Binding HeadingText}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,7,0,0" />
        <TextBlock Text="{Binding NoteText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Visibility="{Binding HasBulkSelect, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Button Content="すべて選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}"
                    AutomationProperties.AutomationId="RegisterPastedSelectAll" />
            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Command="{Binding ClearSelectionCommand}"
                    AutomationProperties.AutomationId="RegisterPastedClearSelection" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                Margin="0,8,0,0" Padding="10,4,4,4">
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PastedItemRow}">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" Margin="0,4"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding NoteText}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                               Visibility="{Binding HasNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding CommitText}" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.AutomationId="RegisterPastedCommit"
                        IsDefault="True" IsEnabled="{Binding CanCommit}" Click="OnCommit" />
                <Button Content="キャンセル" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            </StackPanel>
            <!-- 押せないときは理由を出す（E9） -->
            <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="{Binding HasCommitHint, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </DockPanel>
    </StackPanel>
</Window>
