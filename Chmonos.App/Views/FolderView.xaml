<UserControl x:Class="Chmonos.App.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderViewModel}">
    <!--
        フォルダビュー（ユーザ仕様 2026-09-13・docs/history/folder-view.md）。左はフォルダの木（ファイルまで・未確定も印付きで）、
        右は選んだ物の詳細（管理しているファイルは商品ページ、未確定は未確定の画面の右側、フォルダは場所と操作）。
    -->
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 木の行の右クリックは、カードと同じメニュー（ユーザ指示 2026-09-20・M3） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
        </ResourceDictionary.MergedDictionaries>
        <!-- 畳む印。行を選ばずに開け閉めする -->
        <Style x:Key="FolderGlyph" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 三角は図形で描く（改変の画面と同じ。文字の ▸▾ は字を大きくしても小さく見えた） -->
                        <Border Background="Transparent">
                            <Path x:Name="Mark" Data="M0,0 L6,4.5 L0,9 Z" Fill="{DynamicResource TextMuted}"
                                  Width="6" Height="9" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding CanExpand, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L9,0 L4.5,6 Z" />
                                <Setter TargetName="Mark" Property="Width" Value="9" />
                                <Setter TargetName="Mark" Property="Height" Value="6" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字だけのボタン -->
        <Style x:Key="FolderLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右：フォルダ。検索画面と同じカードで直下の商品と子フォルダを並べる（ユーザ指示 2026-09-14・FolderBrowserView） -->
        <DataTemplate DataType="{x:Type vm:FolderViewDetail}">
            <views:FolderBrowserView />
        </DataTemplate>

        <!-- 右：管理しているファイル。商品ページをそのまま組み込む（戻るは隠す） -->
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView />
        </DataTemplate>

        <!-- 右：未確定のファイル。未確定の画面の右側をそのまま組み込む（上の帯と左の一覧は隠す） -->
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>

        <!-- ===== 左の一覧の行。種類ごとに要る部品だけ組む（技術的負債 4-4・FolderRowTemplateSelector） ===== -->

        <!--
            木の行のうち、商品のファイル（とフォルダごと登録した商品）にだけカードと同じ右クリックを付ける
            （ユーザ指示 2026-09-20・M3：カードと同じ癖で右クリックしても何も出なかった）。
            フォルダと未確定の行には商品が無いので、メニューの項目は押せない（理由はツールチップに出る）
        -->
        <Style x:Key="FolderTreeRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <!-- 付けないと、行の型の名前が読まれる（読み上げ・自動操作）。見えている名前（商品名で出していれば商品名）を読ませる -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.AutomationId" Value="FolderTreeRow" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsItemFile}" Value="True">
                    <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 2行目：小さいまま、商品名のときだけ本文の色（灰色の小さい字は読み飛ばされる。2026-10-02 メモ6） -->
        <Style x:Key="FolderRowSubText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubTextIsItemName}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 薄く出す行（取り外したドライブ・見つからないファイル） -->
        <Style x:Key="FolderRowText" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDim}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- フォルダ・根・ボリューム：開け閉めの三角・数・未確定の札・入れ物の印 -->
        <DataTemplate x:Key="FolderRowTemplate" DataType="{x:Type vm:FolderViewRow}">
            <DockPanel Margin="{Binding Indent}" MinHeight="26">
                <Button AutomationProperties.AutomationId="FolderRowToggle" AutomationProperties.Name="{Binding ToggleName}" DockPanel.Dock="Left" Style="{StaticResource FolderGlyph}" Content="{Binding Glyph}"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                    <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="6,0" Margin="0,0,6,0" ToolTip="{Binding UnresolvedBadgeTip}"
                            Visibility="{Binding HasUnresolvedBadge, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding UnresolvedBadgeText}" FontSize="10" Foreground="{DynamicResource Warn}" />
                    </Border>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                </StackPanel>

                <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,2,7,2" VerticalAlignment="Top">
                    <Path Data="M3,6 H9.5 L11.5,8 H21 V19 H3 Z" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"
                          Stretch="Uniform" Width="17" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Style="{StaticResource FolderRowText}">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- ファイルの行の下の1行（見つからない・ほかの場所・展開したフォルダ）。商品のファイルと未確定で同じ -->
        <DataTemplate x:Key="FolderRowFileNotes" DataType="{x:Type vm:FolderViewRow}">
            <WrapPanel>
                <TextBlock Text="{Binding MissingText}" FontSize="10.5" Foreground="{DynamicResource Warn}" Margin="0,0,8,0"
                           Visibility="{Binding HasMissingText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button AutomationProperties.AutomationId="FolderRowShowOther" AutomationProperties.Name="{Binding Title, StringFormat={}{0}のほかの場所へ移る}" Style="{StaticResource FolderLink}" Margin="0,0,8,0"
                        Visibility="{Binding HasOthers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                        Command="{Binding DataContext.ShowOtherCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="同じ中身のファイルが置いてある、もう1つの場所へ移ります">
                    <TextBlock Text="{Binding OthersText}" FontSize="10.5" Foreground="{DynamicResource Accent}" TextDecorations="Underline" />
                </Button>
                <!-- zip の横の展開したフォルダ（ユーザ判断：zip の下に薄く出す） -->
                <Button AutomationProperties.AutomationId="FolderRowRevealExtracted" AutomationProperties.Name="{Binding Title, StringFormat={}{0}の展開したフォルダを開く}" Style="{StaticResource FolderLink}"
                        Visibility="{Binding HasExtracted, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                        Command="{Binding DataContext.RevealExtractedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" ToolTip="横にある、このzipを展開したフォルダをエクスプローラで開きます">
                    <TextBlock Text="展開したフォルダあり" FontSize="10.5" Foreground="{DynamicResource TextFaint}" TextDecorations="Underline" />
                </Button>
            </WrapPanel>
        </DataTemplate>

        <!-- 管理しているファイル・フォルダごと登録した商品：商品の絵 -->
        <DataTemplate x:Key="ItemFileRowTemplate" DataType="{x:Type vm:FolderViewRow}">
            <DockPanel Margin="{Binding Indent}" MinHeight="26">
                <!-- 三角の幅だけ空ける（フォルダの行と絵の位置を揃える。ファイルは開け閉めしない） -->
                <FrameworkElement DockPanel.Dock="Left" Width="18" />

                <!--
                    商品の絵。乗せると大きめの絵と商品名を出す（ユーザ指摘 2026-09-14：フォルダビューの商品の絵にホバーが無い。
                    改変の画面の使ったものの行と同じ出し方・180px）
                -->
                <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,2,7,2" VerticalAlignment="Top"
                        CornerRadius="4" Background="{DynamicResource SurfaceAlt}" ClipToBounds="True"
                        ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Grid>
                    <Border.ToolTip>
                        <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                            <StackPanel Width="180">
                                <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                        Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}" />
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                </Border>

                <!-- 名前は切り替えで商品名になる（Title）。そのときは2行目に元のファイル名（SubText） -->
                <StackPanel Style="{StaticResource FolderRowText}">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Text}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource FolderRowSubText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FolderRowFileNotes}" Focusable="False" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- 未確定のファイル：「?」の印 -->
        <DataTemplate x:Key="UnresolvedRowTemplate" DataType="{x:Type vm:FolderViewRow}">
            <DockPanel Margin="{Binding Indent}" MinHeight="26">
                <FrameworkElement DockPanel.Dock="Left" Width="18" />

                <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,2,7,2" VerticalAlignment="Top"
                        CornerRadius="4" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1">
                    <TextBlock Text="?" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Warn}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Style="{StaticResource FolderRowText}">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Text}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSubText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FolderRowFileNotes}" Focusable="False" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <views:FolderRowTemplateSelector x:Key="FolderRowSelector"
                                         Folder="{StaticResource FolderRowTemplate}"
                                         ItemFile="{StaticResource ItemFileRowTemplate}"
                                         Unresolved="{StaticResource UnresolvedRowTemplate}" />
      </ResourceDictionary>
    </UserControl.Resources>

    <controls:PaneGrid Background="{DynamicResource Bg}" Pane="{Binding ListPane}" OppositeWidth="{Binding DetailWidthWanted}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 左の木の幅を変える境目（ユーザ判断 2026-09-14） -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                               ResetCommand="{Binding ListPane.ResetCommand}" />

        <!-- 左：絞り込みとフォルダの木 -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 今どの画面にいるかを、ほかの画面の上の帯と同じく太字の名前で出す（ユーザ指示 2026-09-14） -->
                <!--
                    木のファイルの行を、ファイル名で出すか商品名で出すかの切り替え（ユーザ判断 2026-10-01）。右の一覧のカード／リストと同じ繋がったボタンで、
                    画面の名前の行の右に置く（絞り込みの欄の下に足すと、木が下がる）。名前の行の高さに収めるため、切り替えだけ少し低くする
                -->
                <DockPanel DockPanel.Dock="Top" Margin="14,16,14,0">
                    <!-- 上下を負の余白で名前の行の高さに収め、下の絞り込みの欄と木を1画素も動かさない -->
                    <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1" CornerRadius="6" IsEnabled="{Binding CanChooseRowNames}" Margin="0,-4,0,-4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <controls:CommandRadioButton Content="ファイル名" Style="{StaticResource ItemViewModeSegment}" Height="22" Padding="10,0"
                                                         IsChecked="{Binding ShowsFileNames, Mode=OneWay}" AutomationProperties.AutomationId="FolderRowNames.File"
                                                         Command="{Binding ShowFileNamesCommand}" ToolTip="ファイルの行を、ディスク上のファイル名で表示します">
                                <controls:CommandRadioButton.Tag>
                                    <CornerRadius>5,0,0,5</CornerRadius>
                                </controls:CommandRadioButton.Tag>
                            </controls:CommandRadioButton>
                            <Border Width="1" Background="{DynamicResource BorderStrong}" />
                            <controls:CommandRadioButton Content="商品名" Style="{StaticResource ItemViewModeSegment}" Height="22" Padding="10,0"
                                                         IsChecked="{Binding ShowsItemNames, Mode=OneWay}" AutomationProperties.AutomationId="FolderRowNames.Item"
                                                         Command="{Binding ShowItemNamesCommand}" ToolTip="ファイルの行を商品名で表示します。ファイル名はその下に表示されます">
                                <controls:CommandRadioButton.Tag>
                                    <CornerRadius>0,5,5,0</CornerRadius>
                                </controls:CommandRadioButton.Tag>
                            </controls:CommandRadioButton>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="フォルダ" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,10,14,8">
                    <Grid>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" Height="30"
                                 VerticalContentAlignment="Center" Padding="7,0"
                                 AutomationProperties.Name="ファイル名・商品名・フォルダ名で絞り込む" />
                        <TextBlock Text="ファイル名・商品名・フォルダ名で絞り込む" IsHitTestVisible="False" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFaint}"
                                   Visibility="{Binding HasFilter, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                    </Grid>
                    <!--
                        木に商品（ファイル）を出すかの切り替え（ユーザ指示 2026-09-14）。切ると純粋なフォルダの木になる。
                        「管理対象」「未確定」は、商品を出すときだけ効く。商品は右の一覧（検索画面と同じカード）でも見られる
                    -->
                    <CheckBox Content="商品を表示する" IsChecked="{Binding ShowItems, Mode=TwoWay}" Margin="0,10,0,0"
                              Foreground="{DynamicResource Text}" />
                    <StackPanel Orientation="Horizontal" Margin="22,6,0,0" IsEnabled="{Binding ShowItems}">
                        <CheckBox Content="管理対象" IsChecked="{Binding ShowManaged, Mode=TwoWay}" Margin="0,0,14,0"
                                  Foreground="{DynamicResource Text}" ToolTip="商品に紐付いているファイル・フォルダを木に表示します" />
                        <CheckBox Content="未確定" IsChecked="{Binding ShowUnresolved, Mode=TwoWay}"
                                  Foreground="{DynamicResource Text}" ToolTip="商品が決まっていないファイルを「?」の印で木に表示します" />
                    </StackPanel>
                </StackPanel>

                <!-- 状態の1行は下に置く（改変の画面と同じ理由：文が出ても一覧が動かない） -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource Bg}" Padding="16,8"
                        Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="18,10,18,0"
                           Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!-- 見えている行だけを平らに並べて仮想化する（1つのフォルダに1000本あっても重くしない） -->
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Tag="{Binding}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="4,4"
                         ItemTemplateSelector="{StaticResource FolderRowSelector}"
                         ItemContainerStyle="{StaticResource FolderTreeRowStyle}"
                         Padding="6,0,6,6">
                    <!--
                        画面外に作っておく行は上下4行だけ（技術的負債 4-4）。既定は上下1画面ぶんで、1000本並ぶ根を開くと
                        見えていない80行ほども一度に組んでいた。行は種類ごとの見た目で、要る部品だけ組む（FolderRowTemplateSelector）
                    -->
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右：選んだ物の詳細 -->
        <ContentControl Grid.Column="1" Content="{Binding Detail}" Focusable="False" />
        <TextBlock Grid.Column="1" Text="左の木から、フォルダかファイルを選ぶと、ここに表示されます。"
                   Style="{StaticResource EmptyNote}" VerticalAlignment="Center" Margin="24,0"
                   Visibility="{Binding HasDetail, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
    </controls:PaneGrid>
</UserControl>
