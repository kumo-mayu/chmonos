<UserControl x:Class="Chmonos.App.Views.ResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResolveViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
        <!-- 畳む印の三角（TriangleExpander）を使う。ほかの画面と同じ物 -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- 入力が残る欄を消す ×（検索画面の ClearFieldButton と同じ見た目）。暗黙のボタンの見た目（高さ32など）を当てないため明示する -->
        <Style x:Key="ClearFieldButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            登録している間の帯（ユーザ指示 2026-09-29：押した後に何も出ず、どうなっているのか分からなかった）。
            押したボタンのすぐ下に出すので、置く所ごとに Visibility だけを変えて使い回す。中身は画面の ViewModel に結ぶ
        -->
        <DataTemplate x:Key="RegisteringStrip" DataType="{x:Type vm:ResolveViewModel}">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding RegisteringText}" Style="{StaticResource Caption}"
                           AutomationProperties.AutomationId="ResolveRegisteringText" />
                <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0"
                             Maximum="{Binding RegisteringTotal, Mode=OneWay}"
                             Value="{Binding RegisteringDone, Mode=OneWay}"
                             IsIndeterminate="{Binding HasRegisteringTotal, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource BarTrack}" BorderThickness="0" />
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Bg}">

        <!-- フォルダビューに組み込んだときは上の帯と左の一覧を隠す（ShowsChrome・ListColumnWidth） -->
        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 戻る（V3）。統計・取り込み・フォルダから飛んで来られるのに、戻る道が無かった -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Main.CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding Main.BackButtonText}" Command="{Binding Main.GoBackCommand}"
                                BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="未確定" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding RemainingText}" ToolTip="{Binding RemainingToolTip}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="商品IDが決まらなかったファイルです。商品のIDを登録するか、管理対象から除外します。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <!-- 元のzipが登録済みなので出していない中身。黙って減らさない（ユーザ判断 2026-09-17） -->
                    <TextBlock Text="{Binding HiddenByRegisteredZipText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                               ToolTip="元のzipを消すと、中身として一覧に戻ります。"
                               Visibility="{Binding HasHiddenByRegisteredZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--
                    行ごと消える操作（まとめての登録・除外・戻す・フォルダのまま登録）の結果。押した所が消えるので、一覧の見出しの近くのここに出す
                    （docs/feedback/notice-placement-2026-10-03.md「未確定」）。帯の高さは決まっているので、出ても下は動かない
                -->
                <TextBlock Text="{Binding ListNoticeText}" ToolTip="{Binding ListNoticeText}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="ResolveListNotice" />
                <!-- 外した直後に戻す（ユーザ判断 2026-09-17：戻す場所が設定の「隠したもの」だけだった）。次に外すまで出す -->
                <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding UndoExcludeCommand}" ToolTip="直前に管理対象から除外したファイルを、未確定に戻します。"
                        Visibility="{Binding HasUndoExclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!-- 確定分はここで溜めて、まとめて編集へ渡す（ID確定と入力を分ける設計）。画面を離れても残る -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding SettledText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- 正しく結び付いたかを、その場で商品ページで確かめる（動線の点検 D3） -->
                    <Button Content="最後に確定した商品を開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            VerticalAlignment="Center" Command="{Binding OpenLastSettledCommand}"
                            ToolTip="最後に確定した商品のページを開きます。" />
                    <Button Content="確定したものを編集する" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendSettledToEditCommand}" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 検索・要確認と同じ理由。読んでいる最中に一覧を動かさない -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Button Margin="20,12,20,0" FontSize="12"
                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding ReloadCommand}"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Border>

        <!-- 片付いた表示と一覧は重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>

        <!--
            読み込んでいる間（E1：読み込み中と「1つも無い」を言い分ける）。一覧は読み終えるまで0件なので、
            前は読み込みの間も下の「未確定のファイルはありません」が出ていた。フォルダビューを開いた直後に未確定の zip を選ぶと、
            フォルダの読み込みと重なって読み終わるのが遅れ、選んだファイルが無いように見えた（点検 2026-09-23）
        -->
        <TextBlock Text="読み込んでいます…" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding IsLoaded, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

        <!-- 全部片付いたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RemainingCount}" Value="0" />
                                <Condition Binding="{Binding IsLoaded}" Value="True" />
                                <Condition Binding="{Binding LoadFailed}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="未確定のファイルはありません" Style="{StaticResource EmptyTitle}" />
            <TextBlock Text="取り込みで情報を読み取れなかったファイルがここに並びます。"
                       Style="{StaticResource EmptyNote}" Margin="0,6,0,0" />
            <!-- 次の一手（ユーザ判断 2026-09-17：空になったときに何をすればよいかが弱かった） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <!-- 外して空になった直後にも戻せるように（組み込んだ画面で1件だけを外すと、ここしか見えない） -->
                <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Command="{Binding UndoExcludeCommand}"
                        Visibility="{Binding HasUndoExclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button Content="確定したものを編集する" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding SendSettledToEditCommand}"
                        Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button Content="取り込みを開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                        Command="{Binding OpenImportCommand}" />
            </StackPanel>
        </StackPanel>

        <!--
            右の欄には最小の幅を付け、覚えた一覧の幅は窓が狭いと頭打ちにする（PaneGrid。ほかの画面と同じ・ui-rules）。
            前は右の欄に最小が無く、表示を大きくした狭い窓で右の欄が約130pxまで潰れ、見出しとボタンが重なって切れた（ユーザ 2026-10-02 メモ12）
        -->
        <controls:PaneGrid Pane="{Binding ListPane}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14）。組み込んだときは一覧が無いので出さない -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}"
                                   Visibility="{Binding ListPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!-- 左：未確定の一覧（フォルダごとにまとめる） -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                      <StackPanel>
                        <!-- 一覧を探す（ユーザ指示 2026-09-17）。「全て選択」は見えている行だけに効く -->
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="FilterBox" AutomationProperties.AutomationId="ResolveFilter" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="9,5,26,5"
                                     BorderBrush="{DynamicResource BorderStrong}" AutomationProperties.Name="未確定を探す" />
                            <TextBlock Text="ファイル名・フォルダ・zipの名前で探す" Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 打った文字を消す（検索画面と同じ ×） -->
                            <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                                    Style="{StaticResource ClearFieldButton}" Command="{Binding ClearFilterCommand}"
                                    ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                                    Visibility="{Binding HasFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="すべて選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}" />
                            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                    Command="{Binding ClearChecksCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 束の見出しの中のボタン（まとめて扱う・元zipとして扱う・このフォルダを選択）は、素の ListBox だと束が開いている間は読み上げ・自動操作に出ない（GroupedListBox） -->
                    <controls:GroupedListBox x:Name="FilesList" ItemsSource="{Binding FilesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             PreviewMouseRightButtonDown="OnFileRowRightClick"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             AutomationProperties.Name="未確定のファイル">
                        <!-- 行は、読み上げ・自動操作にファイル名で出す（付けないと、行の型の名前が読まれる）。見た目は既定の行のまま -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" /><Setter Property="AutomationProperties.AutomationId" Value="ResolveFileRow" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!--
                            行の右クリック（ユーザ指示 2026-09-20・M2）。押した行を選んでから出すので（下の OnFileRowRightClick）、
                            右の詳細と同じ物に効く。中身は右の操作と同じ命令
                        -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="エクスプローラで開く"
                                          AutomationProperties.AutomationId="ResolveRowMenu.Reveal"
                                          ToolTip="このファイルの場所を開きます。"
                                          ToolTipService.ShowOnDisabled="True"
                                          Command="{Binding PlacementTarget.DataContext.RevealCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="ファイル名をコピー"
                                          AutomationProperties.AutomationId="ResolveRowMenu.CopyName"
                                          Command="{Binding PlacementTarget.DataContext.CopyFileNameCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="管理対象から除外する"
                                          AutomationProperties.AutomationId="ResolveRowMenu.Exclude"
                                          ToolTip="未確定の一覧から外します。設定の「隠したもの」から戻せます。"
                                          ToolTipService.ShowOnDisabled="True"
                                          Command="{Binding PlacementTarget.DataContext.ExcludeRowCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <!--
                            束は元zip（分からなければフォルダ）。元zipの束は畳んで出し、zipを単位に扱う。
                            1件ずつ扱いたいときだけ開いて行を選ぶ。
                            束の見出しは GroupItem の DataContext（CollectionViewGroup）に結ぶので、
                            元zipかどうかは先頭の行（Items[0]）から読む
                        -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander Style="{StaticResource TriangleExpander}" IsExpanded="{Binding Items[0].StartsExpanded, Mode=OneTime}"
                                                              Background="{DynamicResource SurfaceAlt}"
                                                              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                                              SnapsToDevicePixels="True" Padding="0"
                                                              AutomationProperties.AutomationId="ResolveGroup"
                                                              AutomationProperties.Name="{Binding Name}">
                                                        <Expander.Header>
                                                            <!-- 見出しは中身に合わせて縮まないので、束の幅（左の列の幅）から開け閉めの印の分を引いた幅にする。前は270で固定で、列を広げても長いパスが切れたままだった（ユーザ指示 2026-09-17） -->
                                                            <!-- 上下の 7 は、三角の型にする前（既定の型は見出しの押す所に 1px の外の余白を持っていた）と同じ高さにするため（点検 2026-09-30 の D） -->
                                                            <StackPanel Margin="2,7,0,7" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GroupItem}, Converter={x:Static vm:SubtractConverter.Instance}, ConverterParameter=40}">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Items[0].HasOrigin}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <WrapPanel Margin="0,4,0,0">
                                                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="zipの中身" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                                    </Border>
                                                                    <!-- 展開元のzipが無いフォルダ。畳んでいても分かるように見出しに出す -->
                                                                    <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="zipが無い" FontSize="10" Foreground="{DynamicResource Warn}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 件}"
                                                                               Style="{StaticResource Mono}" FontSize="11"
                                                                               VerticalAlignment="Center" />
                                                                    <!-- 束の数だけ並ぶので、どの束のボタンかを名前に入れる -->
                                                                    <Button Content="まとめて扱う" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            AutomationProperties.AutomationId="ResolveGroupSelect"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0}をまとめて扱う}"
                                                                            Command="{Binding DataContext.SelectGroupCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    <!-- 元のzipが残っているなら、中身は外してzipで登録すればよい（ユーザ判断 2026-09-17） -->
                                                                    <Button Content="元zipとして扱う" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="6,0,0,0"
                                                                            AutomationProperties.AutomationId="ResolveGroupTreatAsOriginZip"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0}を元zipとして扱う}"
                                                                            Command="{Binding DataContext.TreatAsOriginZipCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            ToolTip="元のzipを選びます。zipを登録すると、中身は一覧から消えます。"
                                                                            Visibility="{Binding Items[0].CanTreatAsOriginZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    <!-- 展開先の中身が固まって並ぶので、フォルダ単位で選べるようにする -->
                                                                    <Button Content="このフォルダを選択" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            AutomationProperties.AutomationId="ResolveGroupSelectFolder"
                                                                            AutomationProperties.Name="{Binding Name, StringFormat={}{0}のフォルダを選択}"
                                                                            Command="{Binding DataContext.SelectFolderCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <!-- 開いた中身は深く字下げし、左に線を引く。束と中身が同じ密度で並ぶと、どこを見ればよいか分からなかった（ユーザ指摘 2026-09-17） -->
                                                        <Border Background="{DynamicResource Surface}">
                                                            <Border Margin="22,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="2,0,0,0">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </Border>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!--
                                            1件だけの束は畳まずに1行で出す。まとめる物が無いのに畳むと、全部が同じ見出しの並びになり、
                                            何がまとまりなのか分からなかった（ユーザ指摘 2026-09-17）。まとめるのはフォルダ・zipを展開した中身で2件以上のときだけ
                                        -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ResolveRowSelect"
                                              AutomationProperties.Name="{Binding FileName, StringFormat='{}{0}を選ぶ'}"
                                              VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <!--
                                            上に確かな情報（ファイル名と大きさ・展開元）、その下に候補と操作（札・ボタン）（ユーザ指示 2026-09-17）。
                                            大きさは最長でも「1023.9 MB」で幅が小さいので名前の右に置く。札まで横に並べると、真ん中くらいの長さの名前でも切れる
                                        -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11"
                                                       Margin="8,0,4,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <!--
                                            zipを展開した中身が束にならず1行で出るとき（そのzipの中身が1件だけ）、どのzipの中身かが一覧で分からない。
                                            束の中では見出しに出ているので出さない（ユーザ判断 2026-09-17）
                                        -->
                                        <TextBlock Text="{Binding Origin.ArchiveName, StringFormat='展開元：{0}'}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Origin.ArchivePath}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpandedContent}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.ItemCount, RelativeSource={RelativeSource AncestorType=GroupItem}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,4,0,0">
                                            <!--
                                                取り込みで zip として開けなかった物（途中で切れたダウンロードなど）。前は普通の未確定と見分けられなかった
                                                （大容量の確かめ 問題4・ユーザ判断 2026-09-30）。ほかの札は「確かめてほしい」の黄、これは直さないと使えないので赤
                                            -->
                                            <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,5,0"
                                                    ToolTip="zipを開けませんでした。ダウンロードし直してください。"
                                                    Visibility="{Binding IsBrokenArchive, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="壊れたzip" FontSize="10" Foreground="{DynamicResource Bad}"
                                                           AutomationProperties.AutomationId="ResolveRowBrokenZip" />
                                            </Border>
                                            <!-- 取り込んだときに手掛かりから見つかった商品IDの数（自動検索の候補は数えない）。0件は出さない（ユーザ指示 2026-09-17：ほぼ全部の行に並んで目が滑る） -->
                                            <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,5,0"
                                                    Visibility="{Binding HasCandidates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CandidateText}" FontSize="10" Foreground="{DynamicResource Warn}"
                                                           AutomationProperties.AutomationId="ResolveRowCandidateCount" />
                                            </Border>
                                            <!-- 展開物の中身と判断したものは一覧でも分かるようにする -->
                                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,5,0"
                                                    Visibility="{Binding IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="展開" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                           AutomationProperties.AutomationId="ResolveRowExpanded" />
                                            </Border>
                                        </WrapPanel>
                                        <!-- 1行で出ている中身にも「元zipとして扱う」（束の見出しと同じ動き） -->
                                        <Button Content="元zipとして扱う" HorizontalAlignment="Left" Height="23" FontSize="10.5" Margin="0,4,0,0"
                                                Command="{Binding DataContext.TreatAsOriginZipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="ResolveRowTreatAsOriginZip"
                                                AutomationProperties.Name="{Binding FileName, StringFormat={}{0}を元zipとして扱う}"
                                                ToolTip="元のzipを選びます。zipを登録すると、中身は一覧から消えます。">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CanTreatAsOriginZip}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.ItemCount, RelativeSource={RelativeSource AncestorType=GroupItem}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </controls:GroupedListBox>
                </DockPanel>
            </Border>

            <!-- 右：手掛かりと決定 -->
            <DockPanel Grid.Column="1"
                       Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <!--
                今の対象（メモ22・ユーザ判断 2026-10-03「案1」）。送っても動かない上の帯の1か所で見せて切り替える。
                下の「このIDで登録」「この名前で登録する」「除外する」はどれもこの対象に効くので、ボタンの名前に対象を入れない。
                帯の高さは変えない（ユーザ 2026-10-03：上で物が出入りして下が一瞬で大きくずれる動きは避ける）。3行とも1行に切って吹き出しで全部を読ませ、
                3行目は出す物が無くても1行分を取っておく
            -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1" Padding="20,10" AutomationProperties.AutomationId="ResolveTargetBand">
                <Grid MaxWidth="{StaticResource ReadingMaxWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="対象" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding TargetText}" ToolTip="{Binding TargetToolTip}" FontWeight="Bold" FontSize="15.5"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ResolveTargetText" />
                    </DockPanel>
                    <!-- 元zipとして扱うは、押すと一覧の zip の行へ選び替わる。対象の切り替え（この行の中の対）と性質が違うので右端に離す（ユーザ判断 2026-10-03） -->
                    <DockPanel Grid.Row="1" VerticalAlignment="Center" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="元zipとして扱う" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                AutomationProperties.AutomationId="ResolveTargetOriginZip"
                                ToolTip="一覧の元のzipを選びます。zipを登録すると、中身は一覧から消えます。"
                                Command="{Binding UseOriginZipCommand}"
                                Visibility="{Binding HasOriginZipChoice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasUnitChoice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <RadioButton Style="{StaticResource SegmentFirst}" GroupName="ResolveTarget" Padding="12,0"
                                             AutomationProperties.AutomationId="ResolveTargetUnit"
                                             Content="{Binding UnitChoiceText}" IsChecked="{Binding IsUnitTarget, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentLast}" GroupName="ResolveTarget" Padding="12,0"
                                             AutomationProperties.AutomationId="ResolveTargetSingle"
                                             Content="このファイルだけ" IsChecked="{Binding SingleFileOnly, Mode=TwoWay}"
                                             ToolTip="1つのzipに複数の商品があるときに使います。" />
                            </StackPanel>
                            <Button Content="選択を解除" Style="{StaticResource SmallButton}"
                                    AutomationProperties.AutomationId="ResolveTargetClearChecks"
                                    ToolTip="チェックを外して、選んでいる1件に戻します。"
                                    Command="{Binding ClearChecksCommand}"
                                    Visibility="{Binding IsCheckedTarget, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="一覧でチェックを入れると、まとめて扱えます。" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsSingleRowTarget, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="{Binding BandNoticeText}" ToolTip="{Binding BandNoticeText}" VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ResolveTargetNotice">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBandNoticeWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel MaxWidth="{StaticResource ReadingMaxWidth}">

                    <!-- 組み込んだとき（上の帯が無い）だけ、外した直後に戻すボタンと出していない件数をここに出す -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding ShowsInlineUndo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}"
                                Command="{Binding UndoExcludeCommand}" ToolTip="直前に管理対象から除外したファイルを、未確定に戻します。" />
                    </StackPanel>
                    <TextBlock Text="{Binding HiddenByRegisteredZipText}" Style="{StaticResource Caption}" Margin="0,0,0,12"
                               ToolTip="元のzipを消すと、中身として一覧に戻ります。"
                               Visibility="{Binding ShowsInlineHidden, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                    <!-- 手掛かり -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <!--
                                自動検索はここには置かない（ユーザ判断 2026-10-02「わかっていることからは消してよいでしょう」）。
                                「商品IDを決める」と「候補」の見出しに置いてあり、3つ並ぶと多かった
                            -->
                            <TextBlock Text="このファイルについて分かっていること" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!--
                                壊れていて開けない zip。中身の一覧が出ないだけでは壊れていると分からないので、欄の先頭で言う（ユーザ判断 2026-09-30）。
                                商品IDを決めて登録することは止めない（落とし直せない物を、壊れたままでも記録しておきたいことがある）
                            -->
                            <Border Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,0,0,12"
                                    Visibility="{Binding Selected.IsBrokenArchive, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                                <TextBlock Text="このzipは壊れていて開けません。ダウンロードし直して、もう一度取り込んでください。"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Bad}" />
                            </Border>

                            <!-- 中身を見て判断したいときのために、場所を開ける（以前の動線の記録 C3） -->
                            <!-- ファイル名は BOOTH やブラウザの検索に貼りたい（ユーザ指示 2026-09-29）。一覧の右クリックにも同じ物がある -->
                            <!-- 上の見出しと同じく、狭いときはボタンを次の行へ送る。ボタンの並びも入り切らなければ折り返す -->
                            <controls:SplitRowPanel Gap="10" MinLeftWidth="1000">
                                <TextBlock Text="保存場所" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <WrapPanel>
                                    <TextBlock Text="{Binding CopyNote}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding HasCopyNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    <Button Content="ファイル名をコピー" Style="{StaticResource SmallButton}"
                                            AutomationProperties.AutomationId="ResolveCopyFileName"
                                            Command="{Binding CopyFileNameCommand}" />
                                    <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            AutomationProperties.AutomationId="ResolveReveal"
                                            Command="{Binding RevealCommand}" />
                                </WrapPanel>
                            </controls:SplitRowPanel>
                            <controls:ContentItemsControl ItemsSource="{Binding SelectedPaths}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>

                            <TextBlock Text="ダウンロード元" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding ZoneText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 今もそこにあるとは限らない。消したzipや、別のPCで展開したzipでも記録は残る -->
                            <TextBlock Text="展開したときの元のzip" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding SelectedOriginText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <!--
                                展開した中身で、元のzipが今も残っているとき。zipで登録するのが一番きれい（配布された単位と一致し、
                                展開したフォルダは自動で対象から外れる）なので、zipへ移って普通に登録を進められるようにする（ユーザ指示 2026-09-17）
                            -->

                            <TextBlock Text="{Binding ContentsSummary}" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="6" Padding="11,9" MaxHeight="150"
                                    Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!--
                                    見える行だけ作る（大容量の確かめ 2026-09-30：仮想化していない一覧を ScrollViewer で包んでいたので、
                                    中身7万件の zip の行を選ぶと7万行を作って約49秒止まり、メモリが約1GBまで上がっていた）
                                -->
                                <controls:ContentItemsControl ItemsSource="{Binding SelectedContents}" Focusable="False"
                                                              VirtualizingPanel.IsVirtualizing="True"
                                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                                              VirtualizingPanel.ScrollUnit="Pixel"
                                                              ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--
                        並びは「分かっていること → 商品IDを決める → 候補 → その他」（ユーザ指示 2026-09-17）。
                        前は候補が決める欄より上にあり、決める道が「確定」「管理対象から除外する」「BOOTHに無い商品」と1枚の中に混ざっていた
                    -->
                    <!-- 決定 -->
                    <Border Style="{StaticResource Card}" x:Name="DecisionCard" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <!--
                                自動検索はここと候補の欄にも置く（ユーザ指示 2026-10-02：「商品IDを決める」と候補に重なってあってよい）。
                                IDを決めようとしてここまで来た人が、上の「分かっていること」へ戻らずに押せるように。動きは見出しの横の物と同じ
                            -->
                            <controls:SplitRowPanel Gap="10" MinLeftWidth="1000">
                                <TextBlock Text="商品IDを決める" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="自動検索" Style="{StaticResource SmallButton}"
                                        AutomationProperties.AutomationId="ResolveProposeInDecision"
                                        ToolTip="{Binding ProposeHint}" ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding ProposeCommand}" />
                            </controls:SplitRowPanel>
                            <TextBlock Text="商品IDかURLを入れるか、BOOTHの商品ページをドロップしてください。下に表示された商品を確かめてから登録します。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ItemIdBox" Grid.Column="0" PreviewDragOver="OnIdBoxPreviewDragOver" PreviewDrop="OnIdBoxPreviewDrop" Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ResolveItemId" AutomationProperties.Name="商品IDかURL"
                                         Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,7,0">
                                    <!--
                                        Enter で「情報を確認」まで進む（I12）。登録は Enter では走らせない（取り返しがつかない）。
                                        登録のキーは編集画面の「保存して次へ」と同じ割り当て（既定 Ctrl+Enter。MainViewModel.RunShortcut → AssignByShortcut）
                                    -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PreviewCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <!-- 「このIDで確認」は「このIDで確定」と近すぎた（ユーザ 2026-10-03）。確かめるのは商品の情報 -->
                                <Button Grid.Column="1" Content="情報を確認" Command="{Binding PreviewCommand}"
                                        AutomationProperties.AutomationId="ResolvePreview" />
                            </Grid>

                            <!-- プレビュー -->
                            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,12,0,0"
                                    Visibility="{Binding HasPreview, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="このIDの商品" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center" />
                                        <!-- 状態はチップにする。文で出すと「だから登録できない」に読める -->
                                        <Border Background="{DynamicResource GoodSoft}" BorderBrush="{DynamicResource GoodBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                Visibility="{Binding IsPreviewOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding PreviewOwnedNote}" FontSize="10"
                                                       Foreground="{DynamicResource Good}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ResolvePreviewTitle" />
                                    <TextBlock Text="{Binding PreviewDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <!--
                                欄とボタン（情報を確認・このIDで登録）の誤りと途中経過。出ていない間も1行分を取っておき、出る・消えるで下が跳ねないようにする
                                （ユーザ 2026-10-03。docs/feedback/notice-placement-2026-10-03.md）
                            -->
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="16"
                                       AutomationProperties.AutomationId="ResolveStatusText" />

                            <!--
                                BOOTHで見つからなかった商品IDのまま登録する（ユーザ判断 2026-09-29）。仮IDで登録すると再び公開されても情報を取れない。
                                BOOTHが「無い」と答えたときだけ出す（一時的に届かないときに出すと、実はある商品を空のまま登録してしまう）
                            -->
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0"
                                    Visibility="{Binding HasNotOnBoothItemId, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="このIDのまま登録できます。BOOTHで公開されたら情報を取得し、通知に表示します。" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <Run Text="名前：" /><Run Text="{Binding UnpublishedNameDraft, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="{Binding UnpublishedButtonText}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="ResolveAssignUnpublished"
                                            Command="{Binding AssignUnpublishedCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- 押したら何が起きるかを、ボタンのすぐ上に必ず出す -->
                            <TextBlock Text="{Binding AssignOutcomeText}" Style="{StaticResource Caption}"
                                       AutomationProperties.AutomationId="ResolveAssignOutcomeText"
                                       TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasAssignOutcome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="このIDで登録" Style="{StaticResource PrimaryButton}"
                                        AutomationProperties.AutomationId="ResolveAssign" ToolTip="{Binding AssignKeyHint}"
                                        Command="{Binding AssignCommand}" />
                            </StackPanel>
                            <ContentControl ContentTemplate="{StaticResource RegisteringStrip}" Content="{Binding}" Focusable="False"
                                            Visibility="{Binding IsRegisteringInDecision, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!-- 候補 -->
                    <Border Style="{StaticResource Card}" x:Name="CandidatesCard" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <controls:SplitRowPanel Margin="0,0,0,10" Gap="10" MinLeftWidth="1000">
                                <TextBlock Text="候補" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="自動検索" Style="{StaticResource SmallButton}" Margin="0,0,7,0"
                                            AutomationProperties.AutomationId="ResolveProposeInCandidates"
                                            ToolTip="{Binding ProposeHint}" ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding ProposeCommand}" />
                                    <Button Content="ブラウザで検索" Style="{StaticResource SmallButton}"
                                            AutomationProperties.AutomationId="ResolveSearchInBrowser"
                                            ToolTip="このファイル名でBOOTHを検索します。アプリの外へ出ます。"
                                            Command="{Binding OpenBoothCommand}" />
                                </WrapPanel>
                            </controls:SplitRowPanel>

                            <TextBlock Text="{Binding SearchTargetText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!--
                                自動検索は1件ずつ間隔を空けて取りに行くので十数秒かかる。
                                何をどこまでやっているかを出さないと、止まったように見える。
                            -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsSearching, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SearchProgressText}" Style="{StaticResource Caption}"
                                           AutomationProperties.AutomationId="ResolveSearchProgressText" />
                                <!-- 件数が分かる段階だけ実際の進み具合を出し、それ以外は動いていることだけ示す -->
                                <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0"
                                             Maximum="{Binding SearchTotal, Mode=OneWay}"
                                             Value="{Binding SearchCurrent, Mode=OneWay}"
                                             IsIndeterminate="{Binding HasSearchTotal, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource BarTrack}" BorderThickness="0" />
                            </StackPanel>

                            <controls:ContentItemsControl ItemsSource="{Binding Candidates}" controls:ArrowGroup.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel Margin="0,0,200,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                                               AutomationProperties.AutomationId="ResolveCandidateTitle" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                               AutomationProperties.AutomationId="ResolveCandidateSource" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- 候補を出す以上、それが目当てのものか確かめる手段が要る。BOOTHに無い商品（仮のID）には開くページが無いので出さない -->
                                                    <!-- 候補の数だけ並ぶので、どの候補のボタンかを名前に入れる -->
                                                    <Button Content="BOOTHで開く" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                            AutomationProperties.AutomationId="ResolveCandidateOpenBooth"
                                                            AutomationProperties.Name="{Binding Title, StringFormat={}{0}をBOOTHで開く}"
                                                            ToolTip="この候補の商品ページをブラウザで開きます。アプリの外へ出ます。"
                                                            Visibility="{Binding HasBoothPage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                            Command="{Binding OpenBoothCommand}" />
                                                    <Button Content="これで確認" Style="{StaticResource SmallButton}"
                                                            AutomationProperties.AutomationId="ResolveCandidateUse"
                                                            AutomationProperties.Name="{Binding Title, StringFormat={}{0}で確認}"
                                                            Command="{Binding DataContext.UseCandidateCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>

                            <TextBlock Text="{Binding CandidatesEmptyText}" TextWrapping="Wrap" AutomationProperties.AutomationId="ResolveCandidatesEmptyText">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 探す前から「無い」と言わない（ユーザ指示 2026-09-17） -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Candidates.Count}" Value="0" />
                                                    <Condition Binding="{Binding HasSearched}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--
                        その他（メモ22）：商品IDで確定できないときの出口を、どれも今の対象に効く1つずつのボタンで並べる。
                        選んだ物を「その他」へ送るボタンはやめた（押すと別の所へ飛び、どこへ飛んだのか分からなかった）
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="その他" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDで登録できないときに使います。" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />

                            <Border x:Name="LocalCard" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,16,0,0"
                                    AllowDrop="True" PreviewDragOver="OnLocalBoxPreviewDragOver" PreviewDrop="OnLocalBoxPreviewDrop">
                                <StackPanel>
                                    <TextBlock Text="BOOTHに無い商品として登録する" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="非公開・削除済みで商品IDが分からないもの。名前を付けて手元の商品として登録します。" />

                                    <TextBlock Text="名前" Style="{StaticResource SectionLabel}" Margin="0,12,0,5" />
                                    <TextBox x:Name="LocalNameBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                             AutomationProperties.AutomationId="ResolveLocalName" AutomationProperties.Name="登録する名前"
                                             Text="{Binding LocalNameInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding HasLocalNameSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="手元の記録にあった名前。押すと入力欄に入ります。" Style="{StaticResource Caption}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding LocalNameSuggestions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.UseLocalNameCommand,
                                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                    </StackPanel>

                                    <!-- 画像を足せると分かるよう、空でも「＋」の枠を並べたギャラリーの形にする（メモ22） -->
                                    <TextBlock Text="画像" Style="{StaticResource SectionLabel}" Margin="0,12,0,5" />
                                    <WrapPanel>
                                        <controls:ContentItemsControl ItemsSource="{Binding LocalImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="96" Height="96" Margin="0,0,8,8" ToolTip="{Binding Name}">
                                                        <!-- 読めない形式（WebP など）は名前を出す。絵が読めれば上に重なって隠れる -->
                                                        <Border CornerRadius="6" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Surface}">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                       Margin="6" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <Border CornerRadius="6" ClipToBounds="True" Margin="1">
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <Button Style="{StaticResource ClearFieldButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="{DynamicResource ImagePill}" Margin="0,3,3,0"
                                                                AutomationProperties.AutomationId="ResolveLocalImageRemove"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}"
                                                                ToolTip="この画像を外します。"
                                                                Command="{Binding DataContext.RemoveLocalImageCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <Button Width="96" Height="96" Margin="0,0,8,8" Cursor="Hand"
                                                AutomationProperties.AutomationId="ResolveLocalImageAdd" AutomationProperties.Name="画像を追加"
                                                ToolTip="画像を選びます。ここにドロップしても追加できます。"
                                                Command="{Binding ChooseLocalImagesCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle x:Name="Frame" RadiusX="6" RadiusY="6" Stroke="{DynamicResource BorderStrong}"
                                                                   StrokeDashArray="4 3" StrokeThickness="1.2" />
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="＋" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                                            <TextBlock Text="画像を追加" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <Run Text="仮のID（" /><Run Text="{Binding LocalIdPreview, Mode=OneWay}" FontFamily="Consolas" /><Run Text="）として登録します。" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource Warn}"
                                               Text="BOOTHから情報を取り直さないので、名前も画像も自動では増えません。" />
                                    <!-- 誤りはボタンの右に出す。下に出すと、出る・消えるで下の欄が跳ねる（ユーザ 2026-10-03） -->
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Left" Content="この名前で登録する" Command="{Binding RegisterLocalCommand}" VerticalAlignment="Top"
                                                AutomationProperties.AutomationId="ResolveRegisterLocal" />
                                        <TextBlock Text="{Binding LocalStatusText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   AutomationProperties.AutomationId="ResolveLocalStatusText" />
                                    </DockPanel>
                                    <ContentControl ContentTemplate="{StaticResource RegisteringStrip}" Content="{Binding}" Focusable="False"
                                                    Visibility="{Binding IsRegisteringLocal, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <!-- zipの中身・zipが無い展開物のときだけ。対象のフォルダを押す前に見せる -->
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0"
                                    Visibility="{Binding CanChooseSingleFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="zipの代わりにフォルダを登録する" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               ToolTip="{Binding Selected.ContentReason}"
                                               Text="展開したフォルダを、そのまま商品のファイルとして登録します。zipをダウンロードし直せないときに使います。" />
                                    <TextBlock Text="{Binding RegisterTargetSummary}" Style="{StaticResource Mono}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <!--
                                        ボタンの名前にフォルダの名前が入るので、長いと欄からはみ出して切れていた（幅900。担当PREと確かめで見つけた）。
                                        名前は欄の幅で「…」に切り、全部は吹き出しで読む。誤りはボタンの右に出す
                                    -->
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Left" VerticalAlignment="Top" ToolTip="{Binding RegisterFolderText}"
                                                AutomationProperties.AutomationId="ResolveRegisterFolder" AutomationProperties.Name="{Binding RegisterFolderText}"
                                                Command="{Binding RegisterFolderOfCommand}" CommandParameter="{Binding Selected.GroupKey}">
                                            <TextBlock Text="{Binding RegisterFolderText}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <TextBlock Text="{Binding FolderStatusText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   AutomationProperties.AutomationId="ResolveFolderStatusText" />
                                    </DockPanel>
                                    <ContentControl ContentTemplate="{StaticResource RegisteringStrip}" Content="{Binding}" Focusable="False"
                                                    Visibility="{Binding IsRegisteringFolder, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <!-- 除外。取り返しがつくことを押す前に書く -->
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="管理対象から除外する" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="ファイル自体は消しません。設定の「隠したもの」から戻せます。" />
                                    <Button Content="除外する" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="ResolveExclude"
                                            Command="{Binding ExcludeCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </controls:PaneGrid>

        </Grid>
    </DockPanel>
</UserControl>
