<Window x:Class="Chmonos.App.Views.FilePoolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FilePoolViewModel}"
        Title="{Binding Title}"
        Width="940" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        選んだ商品の間でファイルを割り振るサブ画面（plan 30）。主の窓を塞がない別の窓（docs/spec/ui-subwindows.md）。
        左：選んだ商品（押すと付ける先に選ぶ。行の「商品ページを開く」でメインの画面に開く）。三角で広げた商品の下に付いているファイルと「外す」（開閉は付ける先と別）。
        右：選んだ商品のファイルの溜まり。名前の頭で組にして畳み、組ごと・1つずつチェックする。下の「付ける」で左の商品に付ける
    -->
    <Window.Resources>
      <ResourceDictionary>
        <!-- 組を畳む三角（TriangleExpander）は管理の画面と共通の資源にある -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <!--
            左の商品の行の開閉の三角（右の組の TriangleExpander と同じ丸と三角）。行の押せる所（付ける先に選ぶ）の外に置く：
            中に置くと、畳んだだけで付ける先が替わる
        -->
        <Style x:Key="RowExpandToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="22" Height="22" Background="Transparent">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource SurfaceAlt}" Stroke="{DynamicResource Border}" StrokeThickness="1" />
                            <Path x:Name="Mark" Data="M0,0 L8,6 L0,12 Z" Fill="{DynamicResource TextMuted}"
                                  Width="8" Height="12" Stretch="Fill" Margin="2,0,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L12,0 L6,8 Z" />
                                <Setter TargetName="Mark" Property="Width" Value="12" />
                                <Setter TargetName="Mark" Property="Height" Value="8" />
                                <Setter TargetName="Mark" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            左の商品の行の頭の絵。通知の行（InboxView の ResultThumbnail の型）と同じ作りで、行が1行の名前なので枠は小さく 36。
            絵が届くまで・絵の無い商品は頭文字
        -->
        <DataTemplate DataType="{x:Type vm:ResultThumbnail}">
            <Border Width="36" Height="36" CornerRadius="4" Margin="0,0,10,0" Background="{DynamicResource ThumbBack}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FontSizeHeading}" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 右の溜まりのファイル1行。1つだけの組は見出しを出さずにこの行だけを出す -->
        <DataTemplate x:Key="PoolFileRow" DataType="{x:Type vm:FilePoolFileRow}">
            <Border Style="{StaticResource ButtonListRow}" Padding="4,3">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="{Binding CheckName}">
                    <DockPanel Margin="4,0,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontSizeSmall}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                            <TextBlock Text="{Binding HolderText}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding HoldersTip}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </CheckBox>
            </Border>
        </DataTemplate>

        <!-- 2つ以上の組：三角で畳む見出し（組のチェック・名前と数・中の unitypackage）と、開くとファイルの行 -->
        <DataTemplate x:Key="PoolGroupRow" DataType="{x:Type vm:FilePoolGroupRow}">
            <Expander Style="{StaticResource TriangleExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,4,0,2"
                      AutomationProperties.Name="{Binding HeaderText}">
                <Expander.Header>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}"
                                  VerticalAlignment="Top" Margin="0,2,6,0"
                                  AutomationProperties.Name="{Binding CheckName}" />
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PackagesText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PackagesText}"
                                       Visibility="{Binding HasPackages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <controls:ContentItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource PoolFileRow}" Margin="22,2,0,4" />
            </Expander>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSizeHeading}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="左で付ける先の商品を選び、右でファイルにチェックを入れて付けます。付けても元の商品からは外れません。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--
                    左右の比率は間の境目のドラッグで変える（ユーザ指摘 2026-11-11）。最小は撮って決めた（file-pool-drag-*）：
                    左 300 は、付ける先の行（三角・絵・「付ける先」の札・ファイルの数）に名前が数文字残る幅（240 では名前が「..」だけになった）。
                    右 360 は、絞りの1行（付いている商品の数が [n] [以下] のファイルを表示）が約340を使うので、折り返さずに収まる幅（320 では2行に割れた）。
                    窓の最小 720 は、この2つ＋境目 16＋左右の余白 36
                -->
                <ColumnDefinition x:Name="LeftColumn" Width="2*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="RightColumn" Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 境目。主の画面の境目と同じ部品（乗せると色が付く・ダブルクリックで元の比率） -->
            <controls:PaneSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Center"
                                   AutomationProperties.Name="左右の幅の境目" />

            <!-- 左：選んだ商品 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding ItemsHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="商品を押すと付ける先に選びます。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <Grid Margin="0,6,0,0">
                        <TextBox Text="{Binding ItemFilterText, UpdateSourceTrigger=PropertyChanged}" Padding="9,5,26,5"
                                 BorderBrush="{DynamicResource BorderStrong}"
                                 AutomationProperties.Name="選んだ商品を探す" AutomationProperties.AutomationId="FilePoolItemFilter" />
                        <TextBlock Text="商品名で探す" Margin="12,0,0,0" Style="{StaticResource InputPlaceholder}"
                                   Visibility="{Binding HasItemFilterText, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                        <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                                Style="{StaticResource ClearFieldButton}" Command="{Binding ClearItemFilterCommand}"
                                ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                                Visibility="{Binding HasItemFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="すべて広げる" Style="{StaticResource SmallButton}" Margin="0,2,6,2" Command="{Binding ExpandAllItemsCommand}"
                                AutomationProperties.Name="選んだ商品のファイルをすべて広げる" AutomationProperties.AutomationId="FilePoolExpandItems" />
                        <Button Content="すべて畳む" Style="{StaticResource SmallButton}" Margin="0,2,0,2" Command="{Binding CollapseAllItemsCommand}"
                                AutomationProperties.Name="選んだ商品のファイルをすべて畳む" AutomationProperties.AutomationId="FilePoolCollapseItems" />
                    </WrapPanel>
                    <TextBlock Text="{Binding RemovedText}" Style="{StaticResource FieldNotice}" TextWrapping="Wrap" Margin="0,4,0,0"
                               AutomationProperties.AutomationId="FilePoolRemoved"
                               Visibility="{Binding HasRemoved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Grid>
                    <TextBlock Text="{Binding ItemsEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="6"
                               Visibility="{Binding HasItemsEmptyText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!--
                        商品の行で仮想化する（通知の一覧と同じ形）：見えない商品の行は作らず、絵も読まない。外の ScrollViewer の中に置くと
                        仮想化が効かず、選んだ商品の全部の絵を読む（docs/dev/wpf.md「一覧と速さ」）。広げた行は高さが違うので画素で流す
                    -->
                        <controls:ContentItemsControl ItemsSource="{Binding ShownItems}" AutomationProperties.AutomationId="FilePoolItems"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      VirtualizingPanel.ScrollUnit="Pixel"
                                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FilePoolItemRow}">
                                    <StackPanel>
                                        <!-- 三角・行・ボタンを見た順に書く（Tab も左から順に止まる。DockPanel では右のボタンを行より先に書くことになり、行より先に止まった） -->
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 開閉は三角だけで行う。付ける先（行を押す）とは別に持つ -->
                                        <ToggleButton Grid.Column="0" Style="{StaticResource RowExpandToggle}" VerticalAlignment="Center" Margin="2,0,4,0"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding ExpandName}" />
                                        <controls:PressableBorder Grid.Column="1" x:Name="Head" Focusable="True" Cursor="Hand" CornerRadius="4" Padding="6,4"
                                                                  Background="Transparent"
                                                                  Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  FocusVisualStyle="{StaticResource RowFocusVisual}"
                                                                  AutomationProperties.Name="{Binding SelectName}">
                                            <controls:PressableBorder.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </controls:PressableBorder.InputBindings>
                                            <DockPanel>
                                                <!--
                                                    絵に乗せると大きめの絵と商品名（ユーザ指摘 2026-11-11「他の商品サムネアイコンと同様に」）。
                                                    フォルダビューの商品の絵・改変の使ったもの・タグの管理の商品と同じ吹き出し（180px・待ち 300ms・Surface の地）と、
                                                    同じ読み方（HoverImage：開いたときに初めてカードの大きさで読む）。左の一覧なので、大きな絵は右へ出す。
                                                    吹き出しは外の Border に付ける（ContentPresenter は中身を自分の DataContext にするので、商品名に届かない）
                                                -->
                                                <Border DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent"
                                                        ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right">
                                                    <Border.ToolTip>
                                                        <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                            <StackPanel Width="180">
                                                                <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True" Margin="0,0,0,8"
                                                                        Visibility="{Binding Picture.HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                    <Image Source="{Binding Picture.HoverImage}" Stretch="Uniform" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Text}" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <ContentPresenter Content="{Binding Picture}" Focusable="False" />
                                                </Border>
                                                <!--
                                                    名前を1行目に1本で置き、札と数は2行目へ（36 の絵の高さに2行が収まる）。
                                                    右に「商品ページを開く」を足したら、1行に並べたままでは左の最小の幅（300）で名前が1字も残らなかった（撮って確かめた）
                                                -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <!-- 狭いときは数を「…」で省く（横に並べる StackPanel は省かずに途中で切れた） -->
                                                    <DockPanel Margin="0,1,0,0">
                                                        <!-- 付ける先の印。色だけだと、広げた行が並ぶと区切りの色と見分けにくい -->
                                                        <Border x:Name="TargetBadge" DockPanel.Dock="Left" Style="{StaticResource BadgeAccent}" VerticalAlignment="Center"
                                                                Margin="0,0,6,0" Visibility="Collapsed">
                                                            <TextBlock Text="付ける先" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource AccentText}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </controls:PressableBorder>
                                        <!--
                                            メインの画面で商品ページを開くのはこのボタンだけ。付ける先（行を押す）とは別に持つ
                                            （ユーザ指摘 2026-11-11「付ける先の商品画面を常に見たいわけではない…付ける先とは独立して管理する」）。
                                            行の押せる所の外に置く：中に置くと、開くだけのつもりで付ける先も替わる
                                        -->
                                        <Button Grid.Column="2" Content="商品ページを開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Margin="6,0,2,0"
                                                Command="{Binding DataContext.OpenItemPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="メインの画面でこの商品のページを開きます。"
                                                AutomationProperties.Name="{Binding OpenPageName}" AutomationProperties.AutomationId="FilePoolOpenItemPage" />
                                        </Grid>

                                        <!-- 広げた商品の下に、付いているファイルを並べる -->
                                        <StackPanel x:Name="Held" Visibility="Collapsed" Margin="44,0,4,6">
                                            <TextBlock Text="ファイルはありません。" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasFiles, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                            <controls:ContentItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FilePoolHeldFile}">
                                                        <Border Style="{StaticResource ButtonListRow}" Padding="4,3">
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.DetachCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.Name="{Binding DetachName}"
                                                                        ToolTip="この商品から外します。ファイルは削除しません。" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontSizeSmall}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </controls:ContentItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Head" Property="Background" Value="{DynamicResource ListSelectedBack}" />
                                            <Setter TargetName="TargetBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="Held" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Head}" Value="True" />
                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Head" Property="Background" Value="{DynamicResource ListHoverBack}" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 右：選んだ商品のファイル -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PoolCountText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                    <TextBlock Text="選んだ商品のファイル" FontWeight="SemiBold" />
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="付いている商品の数が" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Margin="0,2,6,2" />
                    <ComboBox ItemsSource="{Binding ThresholdChoices}" SelectedItem="{Binding Threshold, Mode=TwoWay}" MinWidth="56"
                              VerticalAlignment="Center" Margin="0,2,6,2"
                              AutomationProperties.Name="付いている商品の数" AutomationProperties.AutomationId="FilePoolThreshold" />
                    <ComboBox ItemsSource="{Binding FilterChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                              SelectedValue="{Binding Filter, Mode=TwoWay}" MinWidth="72"
                              VerticalAlignment="Center" Margin="0,2,6,2"
                              AutomationProperties.Name="数の比べ方" AutomationProperties.AutomationId="FilePoolFilter" />
                    <TextBlock Text="のファイルを表示" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Margin="0,2,14,2" />
                </WrapPanel>
                <!-- 探す欄は付いている商品の数の絞りと重ねて効く -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox Text="{Binding FileFilterText, UpdateSourceTrigger=PropertyChanged}" Padding="9,5,26,5"
                             BorderBrush="{DynamicResource BorderStrong}"
                             AutomationProperties.Name="選んだ商品のファイルを探す" AutomationProperties.AutomationId="FilePoolFileFilter" />
                    <TextBlock Text="ファイル名・組の名前で探す" Margin="12,0,0,0" Style="{StaticResource InputPlaceholder}"
                               Visibility="{Binding HasFileFilterText, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                    <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                            Style="{StaticResource ClearFieldButton}" Command="{Binding ClearFileFilterCommand}"
                            ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                            Visibility="{Binding HasFileFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </Grid>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="すべて広げる" Style="{StaticResource SmallButton}" Margin="0,2,6,2" Command="{Binding ExpandAllCommand}"
                            AutomationProperties.Name="ファイルの組をすべて広げる" AutomationProperties.AutomationId="FilePoolExpandGroups" />
                    <Button Content="すべて畳む" Style="{StaticResource SmallButton}" Margin="0,2,6,2" Command="{Binding CollapseAllCommand}"
                            AutomationProperties.Name="ファイルの組をすべて畳む" AutomationProperties.AutomationId="FilePoolCollapseGroups" />
                    <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="0,2,0,2" Command="{Binding ClearChecksCommand}"
                            AutomationProperties.AutomationId="FilePoolClearChecks" />
                </WrapPanel>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <Grid>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="6"
                                   Visibility="{Binding HasEmptyText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <controls:ContentItemsControl ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="FilePoolGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FilePoolGroupRow}">
                                        <ContentControl x:Name="Host" Content="{Binding}" ContentTemplate="{StaticResource PoolGroupRow}" Focusable="False" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSingle}" Value="True">
                                                <Setter TargetName="Host" Property="Content" Value="{Binding First}" />
                                                <Setter TargetName="Host" Property="ContentTemplate" Value="{StaticResource PoolFileRow}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>

        <!-- 下：付ける。押せない理由と付ける先はボタンの左、結果はその下（ui-dialogs.md「どこに言うか」） -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding AttachText}" Style="{StaticResource PrimaryButton}" MinWidth="110"
                            AutomationProperties.AutomationId="FilePoolAttach"
                            Command="{Binding AttachCommand}" IsEnabled="{Binding CanAttach}" />
                    <Button Content="閉じる" Margin="8,0,0,0" IsCancel="True" Click="OnClose"
                            AutomationProperties.AutomationId="FilePoolClose" />
                </StackPanel>
                <TextBlock Text="{Binding AttachHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
            <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="FilePoolResult"
                       Visibility="{Binding HasResult, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>
    </Grid>
</Window>
