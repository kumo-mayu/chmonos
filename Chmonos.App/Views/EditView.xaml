<UserControl x:Class="Chmonos.App.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:models="clr-namespace:Chmonos.Core.Models;assembly=Chmonos.Core"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditViewModel}">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 続く商品の帯の右クリックは、カードと同じメニュー（ユーザ指示 2026-09-20・M2） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
            <!-- 畳む印は商品ページと同じ三角（ユーザ判断 2026-09-27）。対応アバターの部品もここから見た目を引く -->
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <!--
            上部バー：何件目かと進み方の操作（1段目）、続く商品の帯（2段目）。
            帯は最初ボタンの間の空きに34pxで置いたが、小さくて見分けにくく、ボタンと横幅も取り合った。
            案B（ユーザ判断）：ボタンの段の下に帯だけの段を置き、横幅を全部使って56pxにする。
            帯を設定で消すと2段目ごと畳まれ、元の1段に戻る
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <!--
                    列は1本。左の件数とバーは左寄せ、右のボタンは右寄せで同じ行に重ねる。
                    幅が中身で決まる列（Auto）をまたいで帯を置くと、WPFは帯を「幅の上限なし」で測るので、
                    全部の絵が収まる幅があるつもりになって横に送れず、最後の絵が窓の縁で切れていた
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ボタンの段と帯の段の境目。帯を消しても2段目には「1件目へ」などが残るので、常に出す -->
                <Border Grid.Row="1" Height="1" VerticalAlignment="Top" Background="{DynamicResource Divider}" />

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="編集" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <ProgressBar Width="160" Height="5" Margin="12,0,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding StepProgress, Mode=OneWay}"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource BarTrack}" BorderThickness="0" />
                    <!--
                        保存していない入力が残っている商品へ戻る入口（ユーザ指示）。書きかけが無ければ出さない。
                        書きかけはアプリを閉じるまで残る（閉じるときに残っていれば尋ねる）
                    -->
                    <Button Content="{Binding Drafts.ButtonText}" Style="{StaticResource SmallButton}" Margin="14,0,0,0"
                            VerticalAlignment="Center" Command="{Binding OpenDraftsCommand}"
                            ToolTip="保存していない入力がある商品だけを並べて開きます。"
                            Visibility="{Binding Drafts.HasAny, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <!--
                    続く商品を小さな絵で（ユーザ指示）。済んだ物は5件まで、これからの物は全部。
                    見えるのは幅に収まる分で、マウスが帯の上にあるときだけホイールで横に送れる（ユーザ指示）。
                    見えている分しか作らないので、2000件の順番でも重くならない。
                    保存した物は右下に緑の印、保存せずに飛ばした物は薄く、いま開いている物は青い枠。
                    乗せるとその絵だけ大きく出し、押すとその商品へ飛ぶ。
                    帯の中で絵を拡大すると上のバーの高さで切れるので、大きな絵は帯の下へ浮かせて出す。
                    キーボードの操作を奪わないよう、絵はフォーカスを取らない
                -->
                <!--
                    帯の段。左端に「1件目へ」「最初の未保存へ」（ユーザ指示でボタンの段から移した。
                    どちらも帯の上を動く操作なので、帯の隣にある方が何が起きるか分かる）。
                    どちらも今の入力は保存しない（スキップと同じ）。帯を設定で消してもボタンは残る
                -->
                <DockPanel Grid.Row="1" Margin="0,8,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button Content="1件目へ" Command="{Binding GoFirstCommand}"
                                ToolTip="編集の1件目へ戻ります。いま開いている商品の入力は保存しません。" />
                        <Button Content="最初の未保存へ" Command="{Binding GoFirstUnsavedCommand}" Margin="8,0,0,0"
                                ToolTip="まだ保存していない最初の商品へ移ります。今の入力は保存しません。" />
                    </StackPanel>
                <controls:ContentItemsControl x:Name="QueueStrip" ItemsSource="{Binding QueueTiles}"
                              AutomationProperties.Name="続く商品"
                              Height="56" VerticalAlignment="Center" Focusable="False"
                              PreviewMouseWheel="QueueStrip_PreviewMouseWheel"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding ShowsQueueStrip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EditQueueTile}">
                            <!--
                                大きさは絵の枠と同じにはっきり書く。書かないとアプリ全体のボタンの既定の高さが効き、
                                56の枠が上だけ残して切れた（右下の保存の印も見えなくなった）
                            -->
                            <Button Width="56" Height="56" Margin="0,0,6,0" Padding="0" Focusable="False" Cursor="Hand"
                                    Tag="{Binding DataContext.CardHost, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ContextMenu="{StaticResource CardMenu}"
                                    ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0"
                                    ToolTipService.Placement="Bottom"
                                    Command="{Binding DataContext.JumpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="EditQueueTile"
                                    AutomationProperties.Name="{Binding Title, StringFormat={}{0}へ移る}"
                                    CommandParameter="{Binding}">
                                <Button.ToolTip>
                                    <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                        <StackPanel Width="200">
                                            <Border Width="200" Height="200" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="56" Height="56" Background="Transparent">
                                            <Border x:Name="Frame" CornerRadius="8" BorderThickness="2"
                                                    BorderBrush="Transparent" Background="{DynamicResource ThumbBack}">
                                                <Border CornerRadius="6" ClipToBounds="True">
                                                    <Image x:Name="Picture" Source="{Binding Image}" Stretch="UniformToFill" />
                                                </Border>
                                            </Border>
                                            <Border x:Name="SavedMark" Width="18" Height="18" CornerRadius="9"
                                                    Background="{DynamicResource GoodFill}" BorderBrush="{DynamicResource Surface}"
                                                    BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,1,1" Visibility="Collapsed">
                                                <TextBlock Text="✓" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- 書きかけ（保存していない入力が残っている）。保存の印の対角に置く -->
                                            <Border x:Name="DraftMark" Width="12" Height="12" CornerRadius="6"
                                                    Background="{DynamicResource Warn}" BorderBrush="{DynamicResource Surface}"
                                                    BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="1,1,0,0" Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                                <Setter TargetName="DraftMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                <Setter TargetName="Picture" Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter TargetName="SavedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Border}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
                </DockPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!--
                        取り直す（ユーザ指示 2026-09-12。商品ページと同じ位置・同じ動き）。
                        取り直した後は編集の中で読み直す。右の打ちかけの入力は書きかけとして控えて重ね直すので消えない
                    -->
                    <TextBlock Text="{Binding ItemPage.RefreshStatus, FallbackValue=''}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    <Button Content="{Binding ItemPage.RefreshButtonText}" Command="{Binding ItemPage.RefreshCommand}" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ItemPage.RefreshButtonTip}"
                            Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <Button Content="BOOTHで開く" Command="{Binding OpenBoothCommand}" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding OpenBoothTip}" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="4,0,12,0" />
                    <!-- 「前へ」「スキップ」は右の入力欄の上と下へ移した（ユーザ指示）。入力しながら押す物なので入力欄の側に置く -->
                    <Button Content="保存して次へ" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndNextCommand}" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <Button Content="終える" Command="{Binding FinishCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 終了表示と編集本体は重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>

        <!-- キューを終えたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsFinished, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="編集するものがありません" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="ユーザータグが未設定の商品が対象です。" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />

            <!-- 自動で戻る。設定 ReturnToSearchWhenEditDone / ReturnToSearchDelaySeconds -->
            <TextBlock Text="{Binding ReturnNoticeText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding IsReturning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Content="{Binding FinishButtonText}" Command="{Binding FinishCommand}" />
                <Button Content="ここに留まる" Margin="8,0,0,0" Command="{Binding StayCommand}"
                        Visibility="{Binding IsReturning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </StackPanel>

        <controls:PaneGrid Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
              Pane="{Binding RightPane}">
            <Grid.ColumnDefinitions>
                <!--
                    左の最小は、窓の最小の幅（900）でナビを開いたときの本文（692）に、右の最小（380）と並べて収まる幅（2026-10-06）。
                    前は360で、合計740が692を超え、右の列と上の「保存して次へ」の右が窓の縁で切れていた
                -->
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="{Binding RightPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding RightPane.MinWidth}" MaxWidth="{Binding RightPane.MaxWidth}" />
            </Grid.ColumnDefinitions>

            <!-- 右の入力欄の幅を変える境目（ユーザ判断 2026-09-14）。右の列の左端に置く -->
            <controls:PaneSplitter Grid.Column="1" HorizontalAlignment="Left" Panel.ZIndex="2"
                                   ResetCommand="{Binding RightPane.ResetCommand}" />

            <!-- 左：何を編集しているかが分かるだけの控えめな表示 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!--
                        左右で保存のしかたが違う（左は押した時点・右は「保存して次へ」）。
                        今の形のままにすると決めた（ユーザ判断 2026-09-20・B7）ので、**画面に書く**。
                        書いていないと、左で触った分も「保存して次へ」を押すまで残らないと読める
                    -->
                    <TextBlock Text="この列は押した時点で保存されます。右の欄は「保存して次へ」で保存します。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <!--
                        画像の欄は商品ページと同じ部品（ユーザ判断 2026-09-12：画像の追加などの編集は両方で同等にする）。
                        足す（ファイル・落とす・貼る）・消す・並べ替え・サムネイルの指名・役割・足りない画像の取得がそのまま使える。
                        書き込みはその場で保存する（右の入力の「保存して次へ」を待たない。商品ページと同じ）
                    -->
                    <views:ItemGalleryPanel DataContext="{Binding ItemPage}" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,70,0" />
                                <Button Content="{Binding EditBasicsLabel}" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Right" Command="{Binding EditBasicsCommand}"
                                        ToolTip="商品名・ショップ・カテゴリを直します。" />
                            </Grid>
                            <!--
                                お気に入りの星は商品名の先頭（ユーザ指示 2026-09-12。商品ページと同じ位置・同じ見た目）。
                                押すとその場で保存する（右の入力の「保存して次へ」を待たない）
                            -->
                            <DockPanel Margin="0,6,0,0">
                                <!-- 押せる枠は Border のままだと、名前を付けても読み上げ・自動操作に出ない。見た目はそのままで「押せるボタン」として出す -->
                                <!-- Tab で止まり、Enter・Space で入れる・外す（点検 2026-10-01：商品ページの星と同じく、キーボードからは届かなかった） -->
                                <controls:PressableBorder DockPanel.Dock="Left" DataContext="{Binding ItemPage}" VerticalAlignment="Top"
                                        Margin="0,0,6,0" Padding="0,0,2,0"
                                        Focusable="True" FocusVisualStyle="{StaticResource SmallFocusVisual}"
                                        Background="Transparent" Cursor="Hand" ToolTip="{Binding FavoriteTip}"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        AutomationProperties.AutomationId="EditFavorite"
                                        AutomationProperties.Name="{Binding FavoriteTip}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleFavoriteCommand}" />
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding FavoriteGlyph}" FontSize="19">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Star}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </controls:PressableBorder>
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding ShopName}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,6,0,0" />

                            <!-- IDと「IDを変える」（ユーザ指示：商品ページの欄に倣う）。IDそのものを押すと写せる -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" DataContext="{Binding ItemPage}">
                                <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{Binding IdCopyTip}">
                                    <Hyperlink Command="{Binding CopyIdCommand}" TextDecorations="{x:Null}"
                                               Foreground="{DynamicResource TextMuted}">
                                        <Run Text="{Binding IdText, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <Button Content="IDを変える" Style="{StaticResource SmallButton}"
                                        Padding="7,1" FontSize="10.5" VerticalAlignment="Center"
                                        Command="{Binding ChangeIdCommand}"
                                        ToolTip="この商品の中身を別のIDの商品へ移します。移す前に確認できます。" />
                            </StackPanel>

                            <!--
                                商品名・ショップ・カテゴリ。**普段は変える必要が無い**ので、
                                「編集」を押して初めて開く（ユーザ指示）。上の下見は打った内容を映すので、
                                開いている間も何になるかが見える。
                            -->
                            <StackPanel Margin="0,16,0,0" MaxWidth="480" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        Visibility="{Binding IsEditingBasics, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!--
                                    商品名。BOOTHから取れない商品はこれしか名前が無い。
                                    取れている商品でも変えられるようにしてある。
                                -->
                                <TextBlock Text="商品名" FontWeight="Bold" FontSize="13" />

                                <!--
                                    **空欄が何になるかは欄そのものに名乗らせる。**
                                    以前は下に「空欄にするとBOOTHの名前『〇〇』に戻ります」と
                                    常時出していたが、普段変えない欄なのに説明文で縦を食っていた。
                                    空欄は「入力を求めている」とも読まれる。
                                -->
                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="NameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="商品名"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding NamePlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=NameBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- これは注意なので消さない。空欄にすると仮IDが名前として出てしまう -->
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource Warn}"
                                           Text="BOOTHに無い商品なので、空欄にすると仮のIDが名前の代わりに表示されます。"
                                           Visibility="{Binding IsLocalOnly, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,16" />

                                <!--
                                    ショップ。**商品が非公開でもショップは見られる場合がある。**
                                    URLを貼れば本物のサブドメインが取れ、既にあるショップに正しく束ねられる。
                                    貼らなければ手元だけの鍵になる（本物のアイコンやバナーは出ない）。
                                -->
                                <TextBlock Text="ショップ" FontWeight="Bold" FontSize="13" />

                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="ShopBox" Text="{Binding ShopNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="ショップ"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding ShopPlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=ShopBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!--
                                    **候補は触ったときだけ出す。**普段変えない欄なので、
                                    常時並べると縦を食うだけになる（手元のショップ名が6件並ぶ）。
                                    focusで出すのは、キーボードでもタッチでも届くから——
                                    ホバーのtipだけにすると届かない経路がある。
                                -->
                                <controls:ContentItemsControl ItemsSource="{Binding ShopSuggestions}" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasShopSuggestions}" Value="True" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopBox}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.UseShopCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <TextBox x:Name="ShopUrlBox" Text="{Binding ShopUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="ショップのURL"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <!-- URLの形は placeholder で見せる。ここは既定が無く、実際に入力を求めている -->
                                    <TextBlock Text="ショップのURL（https://〇〇.booth.pm/）" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=ShopUrlBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!--
                                    URLを貼るかどうかで結果が変わる（本物のショップに束ねられるか、
                                    手元だけの鍵になるか）。**押す前に知る必要がある注意なので消さない。**
                                    ただし触っているときだけ出す
                                -->
                                <TextBlock Text="{Binding ShopKeyNote}"
                                           TextWrapping="Wrap" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopUrlBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16,0,16" />

                                <!--
                                    BOOTHのカテゴリ。検索の絞り込みと並べ替えと同じ「カテゴリ」と呼ぶ（ユーザ指示 2026-09-24。
                                    前は「BOOTH分類名」で、同じ物に2つの名前が付いていた）。
                                    取れない商品には無いので、統計にも絞り込みにも出てこない。
                                    候補は同梱したBOOTHのカテゴリ表から出す。
                                -->
                                <TextBlock Text="カテゴリ" FontWeight="Bold" FontSize="13" />

                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="CategoryBox" Text="{Binding CategoryInput, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="カテゴリ"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding CategoryPlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{DynamicResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=CategoryBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- 候補は触ったときだけ。3Dモデルの子が12件並ぶので、常時出すと縦を食う -->
                                <controls:ContentItemsControl ItemsSource="{Binding CategorySuggestions}" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasCategorySuggestions}" Value="True" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=CategoryBox}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.UseCategoryCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <!-- 「空欄にするとBOOTHの分類に戻ります」は placeholder に移した -->
                            </StackPanel>

                            <!-- BOOTHのタグは畳める（ユーザ指示 2026-09-12）。畳んだかどうかは商品ページと共通 -->
                            <Expander Style="{StaticResource TriangleExpander}" Margin="0,16,0,0" IsExpanded="{Binding IsBoothTagsExpanded, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="EditBoothTagsExpander" AutomationProperties.Name="BOOTHのタグ">
                                <Expander.Header>
                                    <TextBlock Style="{StaticResource SectionLabel}"><Run Text="BOOTHのタグ" /><Run Text="{Binding BoothTagsCountText, Mode=OneWay}" /></TextBlock>
                                </Expander.Header>
                                <!-- 畳んでいる間は作らず、多い商品は最初の一部と「残り n 件を表示」だけ。作った札は隠すだけで捨てない（商品ページと同じ・見た目は App.xaml） -->
                                <controls:ContentItemsControl ItemsSource="{Binding BoothTagTiles}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </controls:ContentItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!--
                        対応アバターと手元のファイルも商品ページと同じ部品（ユーザ判断 2026-09-12）。
                        手元のファイルの欄は、外す・フォルダの登録を外す・エクスプローラで開くだけを出す
                        （Unityへ送る・展開して開くは商品ページ。編集画面はJSONに関わる操作と確かめたいものを見せる所）
                    -->
                    <views:ItemAvatarsPanel DataContext="{Binding ItemPage}" />
                    <views:ItemFilesPanel DataContext="{Binding ItemPage}" />
                    <!-- 説明文に載っている YouTube の動画。商品ページと同じ部品（ユーザ判断 2026-09-29） -->
                    <views:ItemVideosPanel DataContext="{Binding ItemPage}" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="商品説明" FontWeight="Bold" Margin="0,0,0,10" />
                            <!-- 高さの上限は人が変えられる（ユーザ指摘 2026-10-02 メモ4）。下の縁のつまみで変え、ダブルクリックで既定の 360 に戻す -->
                            <RichTextBox x:Name="DescriptionBox" Style="{StaticResource SelectableBody}" MaxHeight="{Binding DescriptionHeight}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         controls:SelectableText.Text="{Binding DescriptionPreview}" />
                            <controls:HeightGrip Margin="0,2,0,-10" Target="{Binding ElementName=DescriptionBox}"
                                                 Length="{Binding DescriptionHeight}"
                                                 MinLength="{Binding DescriptionMinHeight}" MaxLength="{Binding DescriptionMaxHeight}"
                                                 ResetCommand="{Binding ResetDescriptionHeightCommand}"
                                                 AutomationProperties.Name="商品説明の高さ" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：入力 -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel>

                        <!--
                            入力欄の上にも「前へ」「スキップ」（ユーザ指示。下の行と同じ並び）。
                            入力欄は長く流れるので、上から見始めたときも下まで入れたときも手の届く所に置く
                        -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                            <Button Content="← 前へ" Command="{Binding BackCommand}" Margin="0,0,8,0" ToolTip="{Binding BackTip}" />
                            <Button Content="スキップ" Command="{Binding SkipCommand}" ToolTip="{Binding SkipTip}" />
                        </StackPanel>

                        <!-- userTag：候補から選んで積む。マスタ全部は並べない -->
                        <TextBlock Text="ユーザータグ" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="入力すると候補が表示されます。候補に無い語はそのまま新しいユーザータグとして追加されます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8" />

                        <!-- 打ちかけの字も書きかけに残す（I4）。Text を結んでおくと、控えに入れられる -->
                        <controls:SuggestBox Source="{Binding TagSuggestions}" CommitCommand="{Binding AddTagCommand}"
                                             Text="{Binding TagInput, Mode=TwoWay}"
                                             Placeholder="ユーザータグを追加（例：衣装）" AutomationProperties.Name="ユーザータグを追加"
                                             AutomationProperties.AutomationId="EditTagInput" />

                        <controls:ContentItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="11,9" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Top}" FontSize="13" FontWeight="Medium"
                                                           VerticalAlignment="Center" />
                                                <!-- 行の数だけ並ぶので、どのタグの「外す」かを名前に入れる -->
                                                <Button Content="外す" Style="{StaticResource DangerButton}"
                                                        AutomationProperties.AutomationId="EditTagRemove"
                                                        AutomationProperties.Name="{Binding Top, StringFormat={}{0}を外す}"
                                                        HorizontalAlignment="Right" Command="{Binding RemoveCommand}" />
                                            </Grid>

                                            <!-- 付けたサブだけを並べる -->
                                            <!--
                                                付けた小分類の札の並び。✕ に Tab で止まる（点検 2026-10-01：キーボードからは外せなかった）。
                                                札の並びなので Tab で1回だけ入り、中は矢印で ✕ から ✕ へ移る（ArrowGroup。商品ページの対応アバターと同じ）
                                            -->
                                            <controls:ContentItemsControl ItemsSource="{Binding Subs}" Margin="0,8,0,0" controls:ArrowGroup.IsEnabled="True"
                                                          Visibility="{Binding HasSubs, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                                                BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource AccentText}" />
                                                                <!--
                                                                    押せる ✕ は文字のままだと読み上げ・自動操作から押せない。大きさを持たない枠で包み、
                                                                    「押せるボタン」として出す（余白・手の形は枠へ移した。見た目と押せる範囲は同じ）
                                                                -->
                                                                <controls:PressableBorder Margin="7,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                                                        Focusable="True" FocusVisualStyle="{StaticResource SmallFocusVisual}"
                                                                        Command="{Binding DataContext.RemoveSubCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="EditSubRemove"
                                                                        AutomationProperties.Name="{Binding StringFormat={}{0}を外す}">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                      Command="{Binding DataContext.RemoveSubCommand,
                                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                      CommandParameter="{Binding}" />
                                                                    </Border.InputBindings>
                                                                    <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ChipRemove}" />
                                                                </controls:PressableBorder>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </controls:ContentItemsControl>

                                            <controls:SuggestBox Source="{Binding SubCandidates}" CommitCommand="{Binding AddSubCommand}"
                                                                 Placeholder="小分類を追加" Margin="0,6,0,0"
                                                                 AutomationProperties.AutomationId="EditSubInput"
                                                                 AutomationProperties.Name="{Binding Top, StringFormat={}{0}に小分類を追加}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,16" />

                        <!-- 属性：評価したものだけを積む。未評価は行が無いことで表す -->
                        <TextBlock Text="属性" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="追加した属性だけが評価済みになります。追加していないものは「未評価」で、0%とは区別されます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8" />

                        <controls:SuggestBox Source="{Binding AttributeSuggestions}" CommitCommand="{Binding AddAttributeCommand}"
                                             Text="{Binding AttributeInput, Mode=TwoWay}"
                                             Placeholder="属性を追加（例：かっこいい）" AutomationProperties.Name="属性を追加"
                                             AutomationProperties.AutomationId="EditAttributeInput" />

                        <controls:ContentItemsControl ItemsSource="{Binding Attributes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <!--
                                            1%刻み（ユーザ判断 2026-10-06・判断9。検索の属性のスライダとそろえる。前は5%）。目盛りは描かず、吸い付けるだけに使う。
                                            キーの刻みも合わせる：←→ で1、PageUp/PageDown で25（4分の1）、Home/End で0/100。
                                            既定の刻み（0.1）のままだと、動かした値が目盛りへ吸い寄せられて元に戻り、キーでは動かなかった（点検 2026-09-23）。
                                            キーで値が変わったら触ったのと同じ（並べてあるだけの行も、その時点で保存する行になる）
                                        -->
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Value, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="25"
                                                AutomationProperties.AutomationId="EditAttributeSlider"
                                                AutomationProperties.Name="{Binding Name}" />
                                        <!--
                                            並べてあるだけの行は値を出さない。
                                            50%と書いてあると、そう評価したように読める
                                        -->
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Mono}"
                                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSuggested, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="—" Style="{StaticResource Mono}"
                                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFaint}"
                                                   Visibility="{Binding IsSuggested, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <Button Grid.Column="3" Content="外す" Style="{StaticResource DangerButton}"
                                                AutomationProperties.AutomationId="EditAttributeRemove"
                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}"
                                                Margin="7,0,0,0" Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,16" />

                        <!--
                            購入記録（案A・ユーザ判断）。**種類の行はお金のことだけ**にし、印を付けても形を変えない：
                            値段・誰のためか・［＋］（この版をもう1回買った）を常に並べ、印が無いときは灰色にする
                            （以前は印を付けるたびに行が3段に膨らみ、選び欄や札も出入りして分かりにくかった）。
                            ファイルの結び付けは下の「ファイルの種類分け」だけで行い、ここには数だけ出す。
                            種類の多い商品では膨大になるので、この欄だけ畳める。畳んだかどうかは次の商品へ進んでも保つ
                        -->
                        <Expander Style="{StaticResource TriangleExpander}" IsExpanded="{Binding IsPurchasesExpanded, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="EditPurchasesExpander" AutomationProperties.Name="購入したバリエーション">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Bold" FontSize="13" VerticalAlignment="Center"><Run Text="購入したバリエーション" /><Run Text="{Binding PurchasesCountText, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFaint}" /></TextBlock>
                                    <!-- 印が1つも無ければ、畳んでいても見出しで分かるようにする（ユーザ指示 2026-09-13） -->
                                    <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                                            CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="買ったバリエーションに印を付けてください。"
                                            Visibility="{Binding IsPurchaseUnselected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="未選択" FontSize="11" Foreground="{DynamicResource Warn}" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="買ったバリエーションに印を付けます。値段にはBOOTH価格が入ります。払った額が違うときは書き換えてください。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,6"
                                           ToolTip="空欄は0円として記録します。2回買ったときは［＋］で追加します。" />

                                <controls:ContentItemsControl ItemsSource="{Binding Variations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FileCountText}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   ToolTip="付いたファイルの数です。下の「バリエーション分け」で変えられます。" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- 印・値段・誰のためかはバリエーションの数だけ並ぶ。どのバリエーションの物かを名前に入れる -->
                                                            <CheckBox IsChecked="{Binding IsPurchased, Mode=TwoWay}" VerticalAlignment="Center"
                                                                      AutomationProperties.AutomationId="EditVariationPurchased"
                                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0}を買った}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding Name}" />
                                                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsGone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="BOOTHに現存しない" FontSize="10" Foreground="{DynamicResource TextFaint}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- 値段・誰のためか・日付・［＋］。2段に分ける（日付を足すと右の欄の幅に収まらない）。印が無いときも出して灰色にする（印を付けるたびに行が膨らまないように） -->
                                                    <StackPanel Margin="22,6,0,0" IsEnabled="{Binding IsPurchased}">
                                                        <StackPanel Orientation="Horizontal" Margin="0">
                                                        <TextBlock Text="¥" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                        <!-- 空欄は0円として記録する（ユーザ判断 2026-09-29：未入力を無くす）。空欄のときは薄い 0 を出す -->
                                                        <Grid>
                                                            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="86"
                                                                     Height="26" FontSize="12" Margin="4,0,0,0" Padding="7,0"
                                                                     AutomationProperties.AutomationId="EditVariationPrice"
                                                                     AutomationProperties.Name="{Binding Name, StringFormat={}{0}の払った額}"
                                                                     VerticalContentAlignment="Center" />
                                                            <TextBlock Text="0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12"
                                                                       Foreground="{DynamicResource TextFaint}"
                                                                       Visibility="{Binding Price, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                                                        </Grid>
                                                        <!-- BOOTH の値段が無い行（種類を指さない購入・消えた版）は「現在 -」になるだけなので出さない -->
                                                        <TextBlock Text="{Binding ListPriceText, StringFormat=現在 {0}}" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   Visibility="{Binding HasListPrice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <!--
                                                            「ギフト」のチェック1つでは、貰ったのか贈ったのかが書き分けられない。
                                                            貰い物は支出に数えず、贈答は支出に入るが所持には入らないので、集計上まったく別の扱いになる。
                                                        -->
                                                        <ComboBox SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag"
                                                                  Width="96" Height="26" FontSize="12" Margin="14,0,0,0"
                                                                  AutomationProperties.AutomationId="EditVariationKind"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat={}{0}は誰のための購入か}"
                                                                  VerticalContentAlignment="Center">
                                                            <ComboBoxItem Content="自分用" Tag="{x:Static models:PurchaseKind.ForSelf}" />
                                                            <ComboBoxItem Content="貰った" Tag="{x:Static models:PurchaseKind.Received}" />
                                                            <ComboBoxItem Content="贈った" Tag="{x:Static models:PurchaseKind.Given}" />
                                                        </ComboBox>
                                                        </StackPanel>
                                                        <!--
                                                            この1回の日付（メモ45）。名前は種類に合わせる（買った日／贈った日／貰った日）。
                                                            空欄は入手日を使うので、空のときは薄い字でそう出す（入手日の欄と同じ作り）
                                                        -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding PurchasedAtLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <Grid Margin="6,0,0,0">
                                                            <TextBox x:Name="PurchasedAtBox" Text="{Binding PurchasedAt, UpdateSourceTrigger=PropertyChanged}" Width="104"
                                                                     Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                                     AutomationProperties.AutomationId="EditVariationPurchasedAt"
                                                                     ToolTip="2026-09-20 の形で入れてください。"
                                                                     AutomationProperties.Name="{Binding Name, StringFormat={}{0}の日付}" />
                                                            <TextBlock Text="入手日と同じ" Margin="9,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12"
                                                                       Foreground="{DynamicResource TextFaint}"
                                                                       Visibility="{Binding Text, ElementName=PurchasedAtBox, Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                                        </Grid>
                                                        <!-- 「＋」だけではファイルの結び付けか追加購入か分からなかった（ユーザ指摘）。何が起きるかを名乗らせる -->
                                                        <Button Content="＋ 追加購入" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                                AutomationProperties.AutomationId="EditVariationAddPurchase"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の追加購入}"
                                                                Command="{Binding AddPurchaseCommand}"
                                                                ToolTip="このバリエーションをもう1回買った記録を追加します。" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!--
                                                        同じ版を2回買った記録。買った1回が1レコードなので、行を増やす形で足す。
                                                        1件目の値段の段と同じ位置から始める。種類の行からは既に1段下がっているので、
                                                        さらに下げなくても1件目と見分けられる（ユーザ指摘。以前は行頭に「＋」を置いてずらしていた）
                                                    -->
                                                    <controls:ContentItemsControl ItemsSource="{Binding Extras}" Margin="22,4,0,0"
                                                                  Visibility="{Binding HasExtras, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,8,0,0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0">
                                                                    <TextBlock Text="¥" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                                    <Grid>
                                                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="86"
                                                                                 Height="26" FontSize="12" Margin="4,0,0,0" Padding="7,0"
                                                                                 AutomationProperties.AutomationId="EditExtraPrice"
                                                                                 AutomationProperties.Name="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0}の追加購入の払った額}"
                                                                                 VerticalContentAlignment="Center" />
                                                                        <TextBlock Text="0" Margin="12,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12"
                                                                                   Foreground="{DynamicResource TextFaint}"
                                                                                   Visibility="{Binding Price, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                                                                    </Grid>
                                                                    <ComboBox SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag"
                                                                              Width="96" Height="26" FontSize="12" Margin="14,0,0,0"
                                                                              AutomationProperties.AutomationId="EditExtraKind"
                                                                              AutomationProperties.Name="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0}の追加購入は誰のための購入か}"
                                                                              VerticalContentAlignment="Center">
                                                                        <ComboBoxItem Content="自分用" Tag="{x:Static models:PurchaseKind.ForSelf}" />
                                                                        <ComboBoxItem Content="貰った" Tag="{x:Static models:PurchaseKind.Received}" />
                                                                        <ComboBoxItem Content="贈った" Tag="{x:Static models:PurchaseKind.Given}" />
                                                                    </ComboBox>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding PurchasedAtLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                                    <Grid Margin="6,0,0,0">
                                                                        <TextBox x:Name="ExtraPurchasedAtBox" Text="{Binding PurchasedAt, UpdateSourceTrigger=PropertyChanged}" Width="104"
                                                                                 Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                                                 AutomationProperties.AutomationId="EditExtraPurchasedAt"
                                                                                 ToolTip="2026-09-20 の形で入れてください。"
                                                                                 AutomationProperties.Name="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0}の追加購入の日付}" />
                                                                        <TextBlock Text="入手日と同じ" Margin="9,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12"
                                                                                   Foreground="{DynamicResource TextFaint}"
                                                                                   Visibility="{Binding Text, ElementName=ExtraPurchasedAtBox, Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                                                    </Grid>
                                                                    <!-- 印を外すのではなく行ごと消す。「買った回数」を減らす操作なので -->
                                                                    <Button Content="この記録を削除" Style="{StaticResource DangerButton}"
                                                                            AutomationProperties.AutomationId="EditExtraRemove"
                                                                            AutomationProperties.Name="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0}の追加購入の記録を削除}"
                                                                            ToolTip="この購入記録を消します。元に戻せません。"
                                                                            Margin="10,0,0,0" Command="{Binding RemoveCommand}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </controls:ContentItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,16" />

                        <!--
                            ファイルの種類分け（ユーザ指示・案A）。ファイルの結び付けはこの欄だけで行う。
                            中の表示は「ファイルごと」（ファイルを主に種類を選ぶ）と「種類ごと」（種類を主にファイルを足す）。
                            どちらも同じ中身を直す。既定は畳み、勝手には開かない（残りは見出しの「未指定 n」で知らせる）。
                            開けないとき（種類を1つしか買っていない・ファイルも1つ以下）は消さずに灰色にして、理由を右に書く。
                            買った種類が1つのときは、選び欄に「〇〇（自動）」と見せるだけ（書かない）。結び付けられるのは買った種類だけ
                        -->
                        <Expander IsExpanded="{Binding IsFileSortExpanded, Mode=TwoWay}" IsEnabled="{Binding CanSortFiles}"
                                  AutomationProperties.AutomationId="EditFileSortExpander" AutomationProperties.Name="バリエーション分け">
                            <Expander.Style>
                                <Style TargetType="Expander" BasedOn="{StaticResource TriangleExpander}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Expander.Style>
                            <Expander.Header>
                                <DockPanel>
                                    <!-- 種類を選んでいないファイルがあれば、畳んでいても見出しで分かるようにする（「購入した種類」と同じ・ユーザ指示 2026-09-13） -->
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="ファイルごとにバリエーションを選んでください。"
                                            Visibility="{Binding IsFileSortUnselected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="未選択" FontSize="11" Foreground="{DynamicResource Warn}" />
                                    </Border>
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="バリエーション分け" FontWeight="Bold" FontSize="13" /><Run Text="{Binding FileSortHeaderNote, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFaint}" /></TextBlock>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="ファイルごと" FontSize="11.5" Foreground="{DynamicResource Text}"
                                                     IsChecked="{Binding IsByFileView, Mode=TwoWay}" />
                                        <RadioButton Content="バリエーションごと" FontSize="11.5" Foreground="{DynamicResource Text}" Margin="12,0,0,0"
                                                     IsChecked="{Binding IsByVariationView, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBlock Text="どのバリエーションのファイルかを選びます。" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               ToolTip="選べるのは買ったバリエーションだけです。1つだけなら選ぶ必要はありません。" />
                                </DockPanel>

                                <TextBlock Text="この商品に付いたファイルがありません。ファイルを追加すると、ここでバリエーションを選べます。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNoFilesToSort, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                <!-- ファイルごと -->
                                <controls:ContentItemsControl ItemsSource="{Binding FileSortRows}"
                                              Visibility="{Binding IsByFileView, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FileSortRow}">
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <DockPanel>
                                                    <ComboBox DockPanel.Dock="Right" Width="170" Height="26" FontSize="11.5" Margin="10,0,0,0"
                                                              VerticalAlignment="Top" ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name"
                                                              IsEnabled="{Binding IsAuto, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                                              AutomationProperties.AutomationId="EditFileSortChoice"
                                                              AutomationProperties.Name="{Binding Name, StringFormat={}{0}のバリエーション}"
                                                              ToolTip="このファイルがどのバリエーションのものかを選びます。" />
                                                    <!-- まだどの種類にも付いていないファイル。残りが一目で分かるように -->
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="5,0" Margin="0,2,7,0" VerticalAlignment="Top"
                                                            Visibility="{Binding IsUnassigned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="未指定" FontSize="10" Foreground="{DynamicResource Warn}" />
                                                    </Border>
                                                    <!-- ファイル名は切らずに折り返す -->
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11.5"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <!-- 種類ごと（以前「購入した種類」の各行にあった選び方） -->
                                <controls:ContentItemsControl ItemsSource="{Binding PurchasedVariationRows}"
                                              Visibility="{Binding IsByVariationView, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top">
                                                        <Grid Width="170"
                                                              Visibility="{Binding CanLinkFiles, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <ComboBox x:Name="FileChoiceBox" ItemsSource="{Binding FileChoices}"
                                                                      SelectedItem="{Binding SelectedFileChoice, Mode=TwoWay}"
                                                                      DisplayMemberPath="Display" Height="26" FontSize="11.5"
                                                                      AutomationProperties.AutomationId="EditVariationFileChoice"
                                                                      AutomationProperties.Name="{Binding FileChoiceAutomationName}"
                                                                      ToolTip="このバリエーションのファイルを選びます。同じバリエーションに複数付けられます。" />
                                                            <!-- 選んでいないときに何の欄かを名乗る（ComboBox は空欄の文字を持てない） -->
                                                            <TextBlock Text="{Binding FileChoiceHint}" IsHitTestVisible="False" FontSize="11.5"
                                                                       Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="8,0,24,0"
                                                                       Visibility="{Binding Text, ElementName=FileChoiceBox,
                                                                                    Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                                        </Grid>
                                                        <!--
                                                            新しいファイルを選んでこの商品に紐付け、このバリエーションにも付ける（ユーザ判断 2026-10-06）。
                                                            行の名前が何に足すかを言っているので動詞だけ（ui-writing.md「文脈が薄くないボタンは、動詞だけで言う」）。
                                                            左の選ぶ欄は今あるファイルから選ぶ（空欄の文字「ファイルを選択…」）
                                                        -->
                                                        <Button Content="追加…" Style="{StaticResource SmallButton}" Height="26" Margin="6,0,0,0"
                                                                Command="{Binding AddFilesCommand}"
                                                                AutomationProperties.AutomationId="EditVariationAddFiles"
                                                                AutomationProperties.Name="{Binding AddFilesAutomationName}"
                                                                ToolTip="選んだファイルをこの商品に紐付け、このバリエーションに付けます。"
                                                                ToolTipService.ShowOnDisabled="True"
                                                                Visibility="{Binding CanAddFiles, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>

                                                    <!-- この種類に付けたファイル。✕で外す（買った種類が1つで自動で見せている札には✕を出さない） -->
                                                    <!-- ✕ に Tab で止まる。並びなので Tab で1回だけ入り、中は矢印で移る（上の小分類の札と同じ） -->
                                                    <controls:ContentItemsControl ItemsSource="{Binding LinkedFiles}" Margin="0,6,0,0" controls:ArrowGroup.IsEnabled="True"
                                                                  Visibility="{Binding HasLinkedFiles, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                        BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,5,5">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11" Style="{StaticResource Mono}"
                                                                                   MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                        <!-- 押せる ✕ を「押せるボタン」として出す（上の小分類の ✕ と同じ。見た目と押せる範囲は同じ） -->
                                                                        <controls:PressableBorder Margin="7,0,0,0" Cursor="Hand" VerticalAlignment="Center" ToolTip="このバリエーションから外す"
                                                                                Focusable="True" FocusVisualStyle="{StaticResource SmallFocusVisual}"
                                                                                Command="{Binding UnlinkCommand}"
                                                                                AutomationProperties.AutomationId="EditLinkedFileUnlink"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}をこのバリエーションから外す}"
                                                                                Visibility="{Binding CanUnlink, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                            <Border.InputBindings>
                                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding UnlinkCommand}" />
                                                                            </Border.InputBindings>
                                                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ChipRemove}" />
                                                                        </controls:PressableBorder>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </controls:ContentItemsControl>
                                                    <TextBlock Text="まだファイルを付けていません。" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                               Visibility="{Binding HasLinkedFiles, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,16" />

                        <!-- メモ・入手日・その他 -->
                        <TextBlock Text="メモ" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <TextBox MaxLength="10000" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 AutomationProperties.AutomationId="EditMemo" AutomationProperties.Name="メモ"
                                 TextWrapping="Wrap" MinHeight="72" Padding="9,7" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="入手日" FontWeight="Bold" FontSize="13" Margin="0,18,0,8" />
                        <!--
                            空欄のときに使われる日付は、欄の中の薄い字で出す（商品名・ショップ・カテゴリの欄と同じ）。
                            前は欄の右の余白に置いていたが、文が余白より長く、欄の枠が字に掛かって浮いて見えた（ユーザ指摘 2026-09-27）
                        -->
                        <Grid>
                            <TextBox x:Name="AcquiredBox" Text="{Binding AcquiredAt, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                     AutomationProperties.Name="入手日"
                                     ToolTip="2026-09-20 の形で入れてください。"
                                     VerticalContentAlignment="Center" Padding="8,0" />
                            <TextBlock Text="{Binding AcquiredHintText}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="10,0,10,0"
                                       Foreground="{DynamicResource TextFaint}" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, ElementName=AcquiredBox,
                                                    Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                        </Grid>

                        <CheckBox Content="更新を通知する" IsChecked="{Binding NotifyOnUpdate, Mode=TwoWay}"
                                  Margin="0,18,0,0" Foreground="{DynamicResource Text}" />
                        <CheckBox Content="非表示にする" IsChecked="{Binding IsHidden, Mode=TwoWay}" ToolTip="検索に表示しなくなります。統計には含めます。"
                                  Margin="0,9,0,0" Foreground="{DynamicResource Text}" />

                        <!--
                            アバターとして登録する（ユーザ判断 2026-10-07）。作者がカテゴリを3Dキャラクターにしていないアバターは、
                            登録簿に載らず扱いを変える場所が無かった。押した時にすぐ登録簿へ書く（商品ページと編集ページで同じ部品）
                        -->
                        <StackPanel DataContext="{Binding AvatarRegistration}" Margin="0,0,0,0">
                            <!-- 見出しはこの画面のほかの欄（入手日など）と同じ形 -->
                            <TextBlock Text="アバター" FontWeight="Bold" FontSize="13" Margin="0,18,0,2" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="アバターとして登録" Style="{StaticResource SmallButton}"
                                        AutomationProperties.AutomationId="EditRegisterAvatar"
                                        Command="{Binding RegisterCommand}"
                                        Visibility="{Binding IsAvatar, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}"
                                        ToolTip="アバターの管理の一覧に載り、衣装の対応アバターを見分けるのに使います。" />
                                <Button Content="アバターの管理で開く" Style="{StaticResource SmallButton}"
                                        AutomationProperties.AutomationId="EditOpenInAvatars"
                                        Command="{Binding OpenInAvatarsCommand}"
                                        Visibility="{Binding IsAvatar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                <Button Content="登録を外す" Style="{StaticResource DangerButton}" Margin="7,0,0,0"
                                        AutomationProperties.AutomationId="EditUnregisterAvatar"
                                        Command="{Binding UnregisterCommand}"
                                        Visibility="{Binding IsManual, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                        ToolTip="自動の判定に戻します。" />
                                <!-- 押しても欄の高さが変わらないよう、ボタンと同じ行の右に出す（ユーザ指摘 2026-10-07。前はボタンの上に出入りして並びがずれた） -->
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding StateText, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Notice}" Style="{StaticResource FieldNotice}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="260"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding Notice, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                        </StackPanel>

                        <!--
                            保存できたこと（I8）と、読めなかった欄（I3）を同じ行に出す。
                            **困りごとのときだけ赤**にする——「保存しました。」まで赤いと、できたのか失敗したのか読めない
                        -->
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,14,0,20" AutomationProperties.AutomationId="EditStatusText">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            **埋め終わった所にも進む道を置く。**上から下へ埋めていく画面なので、
                            埋め終わった時点で視線と手は下にある。そこから右上まで戻らせていた。

                            上部バーの分は消さない。あちらはキューの進捗と並んでいて、
                            途中で抜ける道（前へ・終える）も要る。
                            中身が短い商品では上下に2つ見えるが、それは害にならない
                        -->
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 下まで入力してから前の商品を見直すことがある（ユーザ指示）。並びは上のバーと同じ -->
                                <Button Content="← 前へ" Command="{Binding BackCommand}" Margin="0,0,8,0" ToolTip="{Binding BackTip}" />
                                <Button Content="スキップ" Command="{Binding SkipCommand}" Margin="0,0,8,0" ToolTip="{Binding SkipTip}" />
                                <Button Content="保存して次へ" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveAndNextCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </controls:PaneGrid>

        </Grid>
    </DockPanel>
</UserControl>
