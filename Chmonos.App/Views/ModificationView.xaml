<UserControl x:Class="Chmonos.App.Views.ModificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:views="clr-namespace:Chmonos.App.Views"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AllowDrop="True"
             d:DataContext="{d:DesignInstance Type=vm:ModificationViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 使ったものは検索と同じカード・リストで出す（Views/ItemCardResources.xaml・ユーザ指示 2026-09-14） -->
            <ResourceDictionary.MergedDictionaries>
                <views:ItemCardResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- 使ったもののリストの名前。押すと商品ページ（「開く」ボタンの代わり・ユーザ指示 2026-09-14）。乗せると青い下線 -->
            <!--
                外した使ったもの（ユーザ指示 2026-09-19：商品の手元のファイルと同じく、消さずに薄く残して戻せるように）。
                薄くするのは絵と名前だけ。「戻す」「削除」まで薄いと押せないように見える
            -->
            <Style x:Key="DetachedMemberDim" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDetached}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MemberNameLink" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 使ったもののリストの行。見た目は検索のリストと同じ（境目の線・乗せると薄い灰）。押す操作は名前と右端のボタンに置く -->
            <Style x:Key="MemberListRowStyle" TargetType="ListViewItem">
                <!-- 付けないと、行の型の名前が読まれる（読み上げ・自動操作）。使ったものの名前を読ませる -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="AutomationProperties.AutomationId" Value="ModificationMemberRow" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <!-- 行の高さは一覧の右下のスライダー（全画面で共有・ユーザ判断 2026-09-29） -->
                <Setter Property="MinHeight" Value="{Binding ListRowHeight, Source={x:Static vm:ItemViewSize.Current}}" />
                <!--
                    カード表示と同じ右クリック（ユーザ指示 2026-09-20・M1：表示を切り替えただけで操作が消えていた）。
                    行はカードそのものではないので、メニューは行から Card を取り出す（SearchViewModel.AsCard）
                -->
                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                    Padding="0,5">
                                <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                                      VerticalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Bg}">

        <!-- 上部バー。商品ページと同じ格の画面なので、戻る導線も同じ形にする -->
        <!--
            高さは決め打ちにしない。組み込んだときの右の欄は 360 まで狭くなり、日付2つ（約190）と「この改変を削除」（約100）が
            間と余白を入れてちょうど入る幅しかない。表示の大きさを上げたとき・知らせの文が出たときは入り切らず、右端のボタンが切れていた。
            入り切らないときは日付と知らせを下の段へ送り、帯を2段ぶんに伸ばす（ユーザ判断 2026-09-30：隠さない）。
            上下の余白 9 は、1段のとき（ボタンの高さ 32）に帯の高さが前と同じ 52 のままになる値（32＋9×2＋線1＝51 で、下限 52 が効く）
        -->
        <Border DockPanel.Dock="Top" MinHeight="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 改変の画面の右側に組み込んだときは出さない。左の一覧が行き来の役をする -->
                    <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                            BorderThickness="0" Background="Transparent"
                            Visibility="{Binding ShowsBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- アバターは右の列の「改変の名前」の上へ移した（ユーザ指示 2026-09-14） -->
                </StackPanel>

                <!--
                    左の塊＝知らせと日付（右寄せ）、右の塊＝削除のボタン。入り切らないときに下へ送るのは左の塊（SendsLeftDown）——
                    ボタンは上の段の右端に残し、日付は下の段の右端に出す。1段のときの並び（知らせ・作成・更新・ボタン）と間（14）は前と同じ。
                    MinLeftWidth 320 は、日付2つ（約190）＋間 12＋知らせに約120（「写真を消しました。」が切れずに入る幅）。
                    知らせが長いときは「…」で切る（日付は切らない。日付を右に留めて、知らせに残りを渡す）
                -->
                <controls:SplitRowPanel SendsLeftDown="True" Gap="14" MinLeftWidth="320" VerticalAlignment="Center">
                    <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Mono}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Mono}" FontSize="11"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                   ToolTip="{Binding Status}"
                                   Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </DockPanel>
                    <!-- 改変の画面の右側では、ここで消す（ユーザ判断 2026-09-13：作るのはアバターの行、消すのは右のビュー） -->
                    <Button Content="この改変を削除" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}"
                            ToolTip="記録を削除します。元に戻せません。使った商品とUnityプロジェクトは残ります。"
                            Visibility="{Binding IsEmbedded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </controls:SplitRowPanel>
            </Grid>
        </Border>

        <!--
            大きさのスライダーは検索と同じ部品で、検索などと同じく画面の右下に固定する（ユーザ判断 2026-09-29・2026-10-02）。
            流れる入れ物の中に置くと、使ったものの一覧の大きさが変わるたびに一緒に動いて、手を置いた所から逃げていた。
            下から積むので、流れる入れ物より先に書く
        -->
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSizeBar}" Focusable="False"
                        Visibility="{Binding HasMembers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            **横にも送れるようにする。**商品ページで踏んだのと同じ理由——
            左の列が固定幅なので、窓が狭いと右の列が幅0まで潰れて到達できなくなる
        -->
        <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
            <!-- 幅を窓に合わせる理由は商品ページと同じ（無限幅で測ると折り返さない） -->
            <!-- 改変の画面の右側に組み込んだときは、最小の幅と左の列の幅を窓に合わせる（BodyMinWidth・LeftColumnWidth） -->
            <Border Padding="20" MinWidth="{Binding BodyMinWidth}"
                    Width="{Binding ViewportWidth, ElementName=Body}">
            <!-- 覚えた左の幅は窓が狭いと頭打ちにする（右の最小 320 を割らないように。PaneGrid） -->
            <controls:PaneGrid Pane="{Binding LeftPane}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding LeftPane.Width, Mode=TwoWay}"
                                      MinWidth="{Binding LeftPane.MinWidth}" MaxWidth="{Binding LeftPane.MaxWidth}" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左の列の幅を変える境目（ユーザ判断 2026-09-14）。改変の画面に組み込んだときも出す（ユーザ指示 2026-09-14） -->
                <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,7,0" Panel.ZIndex="2"
                                       ResetCommand="{Binding LeftPane.ResetCommand}"
                                       Visibility="{Binding LeftPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!--
                    左：ギャラリー。商品のギャラリーと同じ部品（ユーザ指示 2026-09-13：「改変後の姿」という文言ではなく、
                    ほかの箇所のギャラリーUIと同じにする）。並べ替え・消す・足すは右クリックと末尾の「＋」。
                    落とす・Ctrl+V で貼るのはこの画面全体（ModificationView.xaml.cs）で受けるので、そのまま使える
                -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <!-- 写真が無いときの案内は、大きい絵の所に出す（GalleryEmptyText・ユーザ指示 2026-09-14） -->
                    <views:ItemGalleryPanel />

                    <!--
                        使ったもの

                        **並びが導入の順。**依存物を先に入れないと本体が通らない
                        ことがあるので、番号を出して並べ替えられるようにする
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,18">
                        <StackPanel>
                            <!--
                                見出し（左）と切り替え・送るボタン（右）。**入り切らなければ右を次の段へ送る**（検索の結果の帯と同じ部品）。
                                前は右寄せで重ねて置いていたので、左の列が狭いと切り替えが見出しの上に乗り、送るボタンが右で切れた
                                （改変の画面に組み込んだ幅 900 の窓。ユーザ判断 2026-09-30）。右の塊は、それでも入らない幅では中で折り返す
                            -->
                            <controls:SplitRowPanel Margin="0,0,0,4" Gap="12">
                                <TextBlock Text="使ったもの" FontWeight="Bold" VerticalAlignment="Center" />
                                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- カード／リストの切り替え（検索と同じ部品。どちらで出すかはこの画面で覚える） -->
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasMembers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    <!--
                                        並びの順（＝導入の順）に Unity へ1件ずつ送る（#69・ユーザ判断）。
                                        改変を作り直すとき、記録した順に入れ直せば同じものが組める
                                    -->
                                    <Button Content="使ったものを順にUnityへ送る" Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding SendAllToUnityCommand}"
                                            ToolTip="上から順に1件ずつ、Unityの取り込み画面を表示します。" />
                                </WrapPanel>
                            </controls:SplitRowPanel>
                            <!-- 送っている間だけ「中止」を添える（E7）。いちばん長い待ちは取り込み画面を見ている時間 -->
                            <DockPanel Margin="0,2,0,6"
                                       Visibility="{Binding HasUnityQueueText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <Button DockPanel.Dock="Right" Content="中止" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding StopUnityCommand}"
                                        Visibility="{Binding IsSendingToUnity, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                        ToolTip="送るのを中止します。残った取り込み画面は「Cancel」で閉じてください。" />
                                <TextBlock Text="{Binding UnityQueueText}" FontSize="12" Foreground="{DynamicResource AccentText}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="上から順に入れた記録です。依存するものが先に来るように並べ替えられます。" />

                            <TextBlock Text="{Binding MembersEmptyText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding HasMembers, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                            <!--
                                使ったものは検索と同じカード・リストで出す（ユーザ指示 2026-09-14：リストだけなのは違和感。検索と同等の機能に、
                                ここ独自の物を足して成り立たせる）。押す・星・右クリック・中クリックは検索のカードと同じ（この画面が IItemCardHost）。
                                この画面独自の物：導入の順の番号・使ったファイル・▲▼（並べ替え）・外す。
                                **並びが導入の順。**依存物を先に入れないと本体が通らないことがあるので、番号を出して並べ替えられるようにする。
                                手元に無い商品はカードが作れないので、名前だけの枠で出す（そのとき使ったのは事実なので記録は残す）
                            -->
                            <Grid Tag="{Binding}" Visibility="{Binding HasMembers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!-- カード -->
                                <!--
                                    使ったもののカードと、その下のボタン（順番の ◀ ▶・Unity・外す）は並び（ArrowGroup。点検 2026-10-01）：Tab で1回だけ入り、
                                    ←→ でカード → ボタン → 次のカード、↑↓ で上下の近い物へ移る。前は1件ごとにカードとボタンの数だけ Tab が止まった
                                -->
                                <controls:ContentItemsControl ItemsSource="{Binding Members}" Focusable="False" controls:ArrowGroup.IsEnabled="True"
                                              Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModificationMemberRowViewModel}">
                                            <StackPanel Width="{DynamicResource CardSlotWidth}" Margin="0,0,0,14">
                                                <!-- 導入の順（人が読む番号なので1から）と、使ったファイル（空欄の意味を言い分ける。推定で埋めない） -->
                                                <DockPanel Width="{DynamicResource CardWidth}" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Left" MinWidth="24" Height="24" CornerRadius="6" Padding="6,0"
                                                            Background="{DynamicResource AccentSoft}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding OrderText}" FontSize="11" Foreground="{DynamicResource AccentSoftText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- 外した行の印（ユーザ指示 2026-09-19：消していない物と外した物を見分けられるように） -->
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            ToolTip="この改変から外したものです。「戻す」で元に戻せます。"
                                                            Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="外した" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />
                                                </DockPanel>

                                                <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False"
                                                                HorizontalAlignment="Left" Margin="0,0,0,-8" Style="{StaticResource DetachedMemberDim}"
                                                                Visibility="{Binding HasCard, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                                <!-- 手元に無い商品（記録だけ残る）。カードが作れないので名前と状態だけ -->
                                                <Border Style="{StaticResource Card}" Width="{DynamicResource CardWidth}" HorizontalAlignment="Left" Padding="12,10"
                                                        Visibility="{Binding HasCard, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" />
                                                        <TextBlock Text="手元にありません。記録は残っています。" FontSize="11" Foreground="{DynamicResource Warn}"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{Binding VariationText}" Style="{StaticResource Caption}" Width="{DynamicResource CardWidth}"
                                                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                           Visibility="{Binding HasVariation, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                                <!-- カードは左から右へ並ぶので、並べ替えは左右の矢印（ユーザ指摘 2026-09-14。リストは縦なので上下のまま） -->
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="◀" Style="{StaticResource SmallButton}" ToolTip="{Binding MoveBackHint}"
                                                                AutomationProperties.AutomationId="MemberMoveBack"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}を前へ移動}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            IsEnabled="{Binding CanMoveBack}"
                                                            Command="{Binding DataContext.MoveMemberBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="▶" Style="{StaticResource SmallButton}" Margin="5,0,0,0" ToolTip="{Binding MoveForwardHint}"
                                                                AutomationProperties.AutomationId="MemberMoveForward"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}を後ろへ移動}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            IsEnabled="{Binding CanMoveForward}"
                                                            Command="{Binding DataContext.MoveMemberForwardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- Unity へのインポートと選択の2択（ユーザ指示 2026-09-14。「開く」はやめ、商品ページはカードを押すと開く） -->
                                                    <Button AutomationProperties.AutomationId="ModificationMemberUnityMenu" AutomationProperties.Name="{Binding Name, StringFormat={}{0}のUnityのメニュー}" Content="Unity ▾" Style="{StaticResource SmallButton}" Margin="10,0,0,0" Click="OnUnityMenuClick"
                                                            Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            ToolTip="Unityへ送るか、Unityのプロジェクトタブで選択します">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem AutomationProperties.AutomationId="ModificationMemberUnityMenu.Send" Header="Unityへ送る" CommandParameter="{Binding}"
                                                                          Command="{Binding PlacementTarget.Tag.ImportMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem AutomationProperties.AutomationId="ModificationMemberUnityMenu.Select" Header="Unityで選択" CommandParameter="{Binding}"
                                                                          Command="{Binding PlacementTarget.Tag.SelectMemberInUnityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                    <Button AutomationProperties.AutomationId="ModificationMemberRemove" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}" Content="外す" Style="{StaticResource SmallButton}" Margin="5,0,0,0"
                                                            ToolTip="この改変から外します。商品は残り、「戻す」で元に戻せます。"
                                                            Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- 外した行だけ：戻す／完全に消す（ユーザ指示 2026-09-19：改変ではもう一段、紐付けを完全に解く削除を置く） -->
                                                    <Button AutomationProperties.AutomationId="ModificationMemberRestore" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を戻す}" Content="戻す" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                            ToolTip="この改変の使ったものに戻します。"
                                                            Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                            Command="{Binding DataContext.RestoreMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button AutomationProperties.AutomationId="ModificationMemberDelete" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を削除}" Content="削除" Style="{StaticResource DangerButton}" Margin="5,0,0,0"
                                                            ToolTip="この改変から完全に削除します。使ったファイルの記録も消え、元に戻せません。"
                                                            Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                            Command="{Binding DataContext.DeleteMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>

                                <!-- リスト。絵・星は検索のリストと同じ部品。列の幅は見出しの境目をドラッグで変え、この画面で覚える -->
                                <ListView x:Name="MemberList" SizeChanged="OnMemberListSizeChanged"
                                          ItemsSource="{Binding Members}" Tag="{Binding}" BorderThickness="0" Background="Transparent"
                                          ItemContainerStyle="{StaticResource MemberListRowStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="False">
                                            <GridViewColumn Header="順" Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border MinWidth="24" Height="24" CornerRadius="6" Padding="6,0"
                                                                Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding OrderText}" FontSize="11" Foreground="{DynamicResource AccentSoftText}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="{Binding ListColumns.IconWidth, Mode=TwoWay}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- 絵を押しても商品ページ（ユーザ指摘 2026-09-14：カードでは飛べるのにリストでは飛べない。名前と同じ） -->
                                                        <Button Style="{StaticResource MemberNameLink}" HorizontalAlignment="Stretch"
                                                                AutomationProperties.Name="{Binding Name}"
                                                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemListIconCell}" Focusable="False"
                                                                            Style="{StaticResource DetachedMemberDim}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="★" Width="{Binding ListColumns.FavWidth, Mode=TwoWay}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemListFavCell}" Focusable="False" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!--
                                                名前は残りの幅を全部使う（点検 2026-09-23：固定の幅だと窓を広げても商品名・使ったファイルが見切れたままだった）。
                                                幅は裏のコードが「一覧の幅 − ほかの列」で決めるので覚えない。切れた分はツールチップで全文
                                            -->
                                            <GridViewColumn x:Name="MemberNameColumn" Header="名前" Width="160">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ItemListCellFrame}">
                                                            <StackPanel VerticalAlignment="Center" Style="{StaticResource DetachedMemberDim}">
                                                                <!-- 名前を押すと商品ページ（「開く」ボタンの代わり） -->
                                                                <Button AutomationProperties.AutomationId="ModificationMemberLink" AutomationProperties.Name="{Binding Name}" Style="{StaticResource MemberNameLink}" ToolTip="{Binding Name}"
                                                                        Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Button>
                                                                <!-- 使ったファイル。列にすると狭い左の列からはみ出すので、名前の下に置く（改変の画面の行と同じ形） -->
                                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />
                                                                <WrapPanel Margin="0,3,0,0">
                                                                    <!-- 外した行の印（カードと同じ） -->
                                                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                                                            ToolTip="この改変から外したものです。「戻す」で元に戻せます。"
                                                                            Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="外した" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                                    </Border>
                                                                    <!-- 手元に無くても記録は残す。そのとき使ったのは事実 -->
                                                                    <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                                                            Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="手元に無い" FontSize="10" Foreground="{DynamicResource Warn}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding VariationText}" Style="{StaticResource Caption}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding VariationText}"
                                                                               Visibility="{Binding HasVariation, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- 操作は右端にまとめる（ユーザ指示 2026-09-14）。並べ替え・Unity へのインポートと選択・外す -->
                                            <GridViewColumn Header="操作" Width="216">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ItemListCellFrame}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="▲" Style="{StaticResource SmallButton}" ToolTip="{Binding MoveBackHint}"
                                                                    AutomationProperties.AutomationId="MemberMoveBack"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0}を前へ移動}"
                                                                        ToolTipService.ShowOnDisabled="True"
                                                                        IsEnabled="{Binding CanMoveBack}"
                                                                        Command="{Binding DataContext.MoveMemberBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="▼" Style="{StaticResource SmallButton}" Margin="4,0,0,0" ToolTip="{Binding MoveForwardHint}"
                                                                    AutomationProperties.AutomationId="MemberMoveForward"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0}を後ろへ移動}"
                                                                        ToolTipService.ShowOnDisabled="True"
                                                                        IsEnabled="{Binding CanMoveForward}"
                                                                        Command="{Binding DataContext.MoveMemberForwardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button AutomationProperties.AutomationId="ModificationMemberUnityMenu" AutomationProperties.Name="{Binding Name, StringFormat={}{0}のUnityのメニュー}" Content="Unity ▾" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnUnityMenuClick"
                                                                        Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        ToolTip="Unityへ送るか、Unityのプロジェクトタブで選択します">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem AutomationProperties.AutomationId="ModificationMemberUnityMenu.Send" Header="Unityへ送る" CommandParameter="{Binding}"
                                                                                      Command="{Binding PlacementTarget.Tag.ImportMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                            <MenuItem AutomationProperties.AutomationId="ModificationMemberUnityMenu.Select" Header="Unityで選択" CommandParameter="{Binding}"
                                                                                      Command="{Binding PlacementTarget.Tag.SelectMemberInUnityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Button AutomationProperties.AutomationId="ModificationMemberRemove" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}" Content="外す" Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                                                        ToolTip="この改変から外します。商品は残り、「戻す」で元に戻せます。"
                                                                        Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button AutomationProperties.AutomationId="ModificationMemberRestore" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を戻す}" Content="戻す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                                        ToolTip="この改変の使ったものに戻します。"
                                                                        Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                                        Command="{Binding DataContext.RestoreMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button AutomationProperties.AutomationId="ModificationMemberDelete" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を削除}" Content="削除" Style="{StaticResource DangerButton}" Margin="4,0,0,0"
                                                                        ToolTip="この改変から完全に削除します。使ったファイルの記録も消え、元に戻せません。"
                                                                        Visibility="{Binding IsDetached, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                                        Command="{Binding DataContext.DeleteMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                            <!-- 手で足す入口。手元にある商品だけを候補に出す -->
                            <controls:SuggestBox Source="{Binding ItemSuggestions}" AllowNew="False"
                                                 CommitCommand="{Binding AddMemberCommand}"
                                                 AutomationProperties.Name="使ったものを追加"
                                                 Placeholder="使ったものを商品名で探して追加"
                                                 Margin="0,12,0,0" />

                            <!--
                                紐付けたプロジェクトの中から探す（#72・ユーザ案）。
                                プロジェクトのファイルを見るだけで、Unity の画面は読まない。自動では足さず、人が「足す」を押す
                            -->
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding HasProject, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!-- 入り切らなければボタンを次の段へ送る（見出しがボタンに押されて末尾が切れていた。2026-10-03） -->
                                <controls:SplitRowPanel Gap="12">
                                    <TextBlock Text="紐付けたプロジェクトの中から探す" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Content="プロジェクトの中を調べる" Style="{StaticResource SmallButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding FindInProjectCommand}"
                                            ToolTip="プロジェクトのファイルを手元の商品と比べます。プロジェクトは書き換えません。" />
                                </controls:SplitRowPanel>
                                <TextBlock Text="{Binding ProjectFindText}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasProjectFindText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                <controls:ContentItemsControl ItemsSource="{Binding FoundInProject}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProjectCandidateRowViewModel}">
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 絵に乗せると大きめの絵の吹き出し。使ったものの行（ModificationHubView）と同じ形 -->
                                                    <Border Grid.Column="0" AutomationProperties.AutomationId="ModificationCandidateImage"
                                                            Width="34" Height="34" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource SurfaceAlt}" ClipToBounds="True"
                                                            ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right">
                                                        <Border.ToolTip>
                                                            <ToolTip Padding="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
                                                                <StackPanel Width="180">
                                                                    <Border Width="180" Height="180" CornerRadius="6" Background="{DynamicResource ThumbBack}" ClipToBounds="True"
                                                                            Margin="0,0,0,8"
                                                                            Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource Text}" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button AutomationProperties.AutomationId="ModificationCandidateAdd" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を追加}" Grid.Column="2" Content="追加" Style="{StaticResource SmallButton}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="「使ったもの」の最後に追加します。あとで並べ替えたり外したりできます。"
                                                            Command="{Binding DataContext.AddCandidateCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右：名前とメモ -->
                <StackPanel Grid.Column="1">
                    <!--
                        この改変のアバター（ユーザ指示 2026-09-14：左上に置いていたのを、「改変の名前」の上にアバターとして置く）。
                        押すとアバターの管理でこのアバターを開く（動線の点検 D6。同じアバターのほかの改変も見られる）
                    -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="アバター" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource MemberNameLink}" Command="{Binding OpenAvatarCommand}"
                                    AutomationProperties.AutomationId="ModificationOpenAvatar"
                                    AutomationProperties.Name="このアバターをアバターの管理で開く"
                                    ToolTip="このアバターをアバターの管理で開きます。同じアバターのほかの改変も見られます。">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="6" Margin="0,0,12,0"
                                            Background="{DynamicResource AccentSoft}" ClipToBounds="True">
                                        <Image Source="{Binding AvatarIcon}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding AvatarText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,14,0,0">
                        <StackPanel>
                            <!-- 押さずに残す（ユーザ指示 2026-09-19：タグ・属性・アバターのメモと揃える） -->
                            <TextBlock Text="改変の名前" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <TextBox Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="改変の名前"
                                     Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="「普段着」「制服」のような呼び分けです。打ち終えると保存されます。" />

                            <!--
                                VRChat の blueprint ID（ユーザ指示 2026-09-19：改変の名前の下に）。
                                VRChat の OSC に /avatar/change で送ると、このアバターに着替えられる
                            -->
                            <TextBlock Text="VRChatのblueprint ID" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="VRChatで着替える" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding ChangeAvatarCommand}"
                                        IsEnabled="{Binding CanChangeAvatar}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="VRChatへ着替えの合図を送ります。IDが空のときは押せません。" />
                                <TextBox Height="28" Padding="8,0" VerticalContentAlignment="Center" FontFamily="Consolas"
                                         AutomationProperties.Name="VRChatのblueprint ID"
                                         Text="{Binding BlueprintInput, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="アップロードしたアバターのID（avtr_…）。入れておくと、VRChatをこのアバターに着替えられます。打ち終えると保存されます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding BlueprintHint}" FontSize="11" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasBlueprintHint, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        Unityプロジェクト

                        **改変1つにプロジェクトは0個か1個。**1つのプロジェクトで
                        着替えを作り分けることがあるので、逆は多対1になる
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Unityプロジェクト" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding ProjectEmptyText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasProject, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                            <StackPanel Visibility="{Binding HasProject, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- パスは等幅の英字の字体で出す（日本語の字体では区切りの「\」が「¥」に見える）。長ければ間を省いて吹き出しで全文 -->
                                <controls:PathLine Path="{Binding ProjectPath}" Style="{StaticResource Mono}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />

                                <!-- 消えていても黙って外さない。指し直す導線を残す -->
                                <Border Background="{DynamicResource WarnSoft}"
                                        BorderBrush="{DynamicResource WarnBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,5"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding ProjectMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Text="このフォルダが見つかりません。移したのなら下から指し直せます。"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Warn}" />
                                </Border>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Unityを開く" Style="{StaticResource SmallButton}"
                                            Command="{Binding OpenProjectCommand}"
                                            ToolTip="既に開いていれば、そのUnityを手前に出します。" />
                                    <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Command="{Binding OpenProjectFolderCommand}" />
                                    <Button Content="紐付けを外す" Style="{StaticResource SmallButton}"
                                            Margin="6,0,0,0" Command="{Binding UnlinkProjectCommand}"
                                            ToolTip="改変の記録は残ります。外す前に、今の紐付け先と付け直し方を表示して確かめます。" />
                                </WrapPanel>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,12" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="紐付ける先" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" />
                                <Button Content="読み直す" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding RefreshProjectsCommand}"
                                        ToolTip="{Binding RefreshProjectsHint}" />
                            </Grid>

                            <TextBlock Text="{Binding ProjectCandidatesEmptyText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasProjectCandidates, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                            <!-- 開いているものが先に来る。紐付けたいのは大抵いま作業しているもの -->
                            <!-- 行ごとに「紐付ける」のある一覧なので並び（ArrowGroup）：Tab で1回だけ入り、↑↓ で行を移る（点検 2026-10-01：プロジェクトの数だけ Tab が止まっていた） -->
                            <controls:ContentItemsControl ItemsSource="{Binding ProjectCandidates}" MaxHeight="260" controls:ArrowGroup.IsEnabled="True"
                                          Visibility="{Binding HasProjectCandidates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <!-- 右を空けるのは、行の右端が縦のスクロールバーに隠れないため -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:UnityProjectRowViewModel}">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--
                                                            **名前とパスに上限を置く。**横に送れる作りなので、
                                                            長いパスをそのまま測ると右の列が窓より広くなり、
                                                            横スクロールが常に出てしまう
                                                        -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                                                                   VerticalAlignment="Center" MaxWidth="240"
                                                                   HorizontalAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <Border Grid.Column="1" Background="{DynamicResource AccentSoft}"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsOpen, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="開いています" FontSize="10"
                                                                       Foreground="{DynamicResource AccentSoftText}" />
                                                        </Border>

                                                        <Border Grid.Column="2" Background="{DynamicResource WarnSoft}"
                                                                BorderBrush="{DynamicResource WarnBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="見つかりません" FontSize="10"
                                                                       Foreground="{DynamicResource Warn}" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,2,0,0" MaxWidth="300"
                                                               HorizontalAlignment="Left"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- 今の紐付け先は押させない。同じ操作を2度出す意味が無い -->
                                                <Button AutomationProperties.AutomationId="ModificationProjectLink" AutomationProperties.Name="{Binding Name, StringFormat={}{0}に紐付ける}" Grid.Column="1" Content="紐付ける" Style="{StaticResource SmallButton}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.LinkProjectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsCurrent, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Grid.Column="1" Text="紐付け中" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <TextBox Height="120" Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="メモ"
                                     Text="{Binding MemoInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="貫通の直し方など、次に作るときに要ることを書けます。打ち終えると保存されます。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:PaneGrid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
