<Window x:Class="Chmonos.App.Views.LocalItemNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LocalItemNameDialogViewModel}"
        Title="BOOTHに無い商品を登録"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop">
    <Window.Resources>
        <!-- 添える画像の枠。未確定の画面（ResolveView の LocalImageGallery）と同じ部品・同じ文言（ユーザ 2026-11-20）。窓は UserControl の外なので、祖先だけ Window にしている -->
        <DataTemplate x:Key="LocalImageGallery" DataType="{x:Type vm:LocalItemNameDialogViewModel}">
            <WrapPanel>
                <controls:ContentItemsControl ItemsSource="{Binding LocalImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="96" Height="96" Margin="0,0,8,8" ToolTip="{Binding Name}">
                                <!-- 読めない形式（WebP など）は名前を出す。絵が読めれば上に重なって隠れる -->
                                <Border CornerRadius="6" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Surface}">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Margin="6" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="6" ClipToBounds="True" Margin="1">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <Button Style="{StaticResource ClearFieldButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource ImagePill}" Margin="0,3,3,0"
                                        AutomationProperties.AutomationId="LocalItemImageRemove"
                                        AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}"
                                        ToolTip="この画像を外します。"
                                        Command="{Binding DataContext.RemoveLocalImageCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
                <Button Width="96" Height="96" Margin="0,0,8,8" Cursor="Hand"
                        AutomationProperties.AutomationId="LocalItemImageAdd" AutomationProperties.Name="画像を追加"
                        ToolTip="画像を選びます。ここにドロップしても追加できます。"
                        Command="{Binding ChooseLocalImagesCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Rectangle x:Name="Frame" RadiusX="6" RadiusY="6" Stroke="{DynamicResource BorderStrong}"
                                           StrokeDashArray="4 3" StrokeThickness="1.2" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="画像を追加" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Margin="22,20">
        <TextBlock Text="BOOTHに無い商品を登録" FontWeight="Bold" FontSize="14" />

        <TextBlock Text="商品名" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <!-- 新しく名付ける欄なので候補は付けない。商品は同じ名前を許すので「既にあります」も出さない -->
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,4"
                 VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="LocalItemNameBox" AutomationProperties.Name="商品名" />

        <TextBlock Text="画像" Style="{StaticResource SectionLabel}" Margin="0,14,0,5" />
        <ContentControl ContentTemplate="{StaticResource LocalImageGallery}" Content="{Binding}" Focusable="False" />
        <TextBlock Text="{Binding LocalImagesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                   Visibility="{Binding HasLocalImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <TextBlock Text="ファイルを持たない商品として登録します。ファイルは後から商品ページで追加できます。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="登録" Style="{StaticResource PrimaryButton}" Click="OnCommit"
                    IsDefault="True" IsEnabled="{Binding CanCommit}"
                    AutomationProperties.AutomationId="LocalItemNameCommit" />
            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
