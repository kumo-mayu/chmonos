<Window x:Class="Chmonos.App.Views.LocalItemNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LocalItemNameDialogViewModel}"
        Title="BOOTHに無い商品を登録"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <StackPanel Margin="22,20">
        <TextBlock Text="BOOTHに無い商品を登録" FontWeight="Bold" FontSize="14" />

        <TextBlock Text="商品名" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
        <!-- 新しく名付ける欄なので候補は付けない。商品は同じ名前を許すので「既にあります」も出さない -->
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="6,4"
                 VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="LocalItemNameBox" AutomationProperties.Name="商品名" />

        <TextBlock Text="ファイルを持たない商品として登録します。ファイルは後から商品ページで追加できます。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="登録" Style="{StaticResource PrimaryButton}" Click="OnCommit"
                    IsDefault="True" IsEnabled="{Binding CanCommit}"
                    AutomationProperties.AutomationId="LocalItemNameCommit" />
            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
