<UserControl x:Class="Chmonos.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}">
    <UserControl.Resources>
        <!-- 知らせ1件の中身。平らな一覧の行（InboxRowLine）が、束の枠の中にこれを出す -->
        <DataTemplate x:Key="InboxRowTemplate" DataType="{x:Type vm:NotificationRow}">
                <!-- 通知どうしの区切りが見えなかったので線を濃くし、上下の余白も広げる（ユーザ指摘 2026-09-18） -->
                <!-- 押せる行は Border のままだと読み上げ・自動操作から押せない。見た目はそのままで「押せるボタン」として出す（PressableBorder） -->
                <controls:PressableBorder BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,15"
                                          Command="{Binding OpenItemCommand}"
                                          Focusable="True" FocusVisualStyle="{StaticResource RowFocusVisual}" AutomationProperties.AutomationId="InboxRow"
                                          AutomationProperties.Name="{Binding Title}">
                    <!--
                        行を押すと、その商品を開く（ユーザ指示 2026-09-20・B3）。
                        行を押す意味はアプリ全体で「選ぶ」か「開く」の2つだけで、この画面は「開く」。
                        以前はどこを押しても何も起きず、乗せたときだけ色が変わるので押せるように見えていた。
                        中のボタン（既読の印・商品ページを開く・直しに行く）は自分で受け止めるので、ここまで上がってこない
                    -->
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenItemCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <!-- 読んだ行は薄くする。未読が浮き上がって、どこまで読んだかが分かる -->
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                    <Setter Property="Opacity" Value="0.62" />
                                </DataTrigger>
                                <!-- 商品のある行だけが押せる。押せない行に手の形を出さない -->
                                <DataTrigger Binding="{Binding HasItem}" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
            
                        <!--
                            既読の印は「読んだ」という状態なので、右の「何かをする」ボタンとは分ける
                            （ユーザ判断 2026-09-18）。タイトルの左に置き、押すと既読・もう一度押すと未読

                            **Tab で止まれる**（ユーザ判断 2026-09-30）。前は止まれないようにしてあり、キーボードからは1件ずつ既読にできなかった。
                            行の操作のボタンと違って常に見えている部品なので、行にフォーカスが無くても届く。Enter・Space で切り替わる（ボタンの既定）。
                            名前は、どの行の物かと、今押すと起きることを入れる（ToggleButton は「オン・オフ」しか言わない）
                        -->
                        <ToggleButton Grid.Column="0" Width="16" Height="16" Margin="0,2,11,0"
                                      VerticalAlignment="Top" Cursor="Hand" FocusVisualStyle="{StaticResource SmallFocusVisual}"
                                      AutomationProperties.AutomationId="InboxRowRead"
                                      AutomationProperties.Name="{Binding ReadButtonName}"
                                      ToolTip="{Binding ReadButtonText}"
                                      IsChecked="{Binding IsRead, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Ring" Width="14" Height="14"
                                                 Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.4"
                                                 Fill="Transparent" />
                                        <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed"
                                                 Fill="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Border}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Unread}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
            
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- 見落とすと困る側にだけ印を付ける -->
                                <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                        Visibility="{Binding IsStrong, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Text="重要" FontSize="10" Foreground="{DynamicResource Warn}" />
                                </Border>
                                <!-- 用が済んだもの。消さずに印を付ける（ユーザ判断 2026-09-18） -->
                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                        Visibility="{Binding IsResolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Text="解消済み" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                
                            <!--
                                行の中身は、どの種別も同じ札で出す（ユーザ指示 2026-09-18）。
                                変化を持つ知らせは変わったところを1つずつ、持たない知らせは「見出し：中身」を1枚で
                            -->
                            <controls:ContentItemsControl ItemsSource="{Binding Cards}" Margin="0,7,0,0"
                                          Visibility="{Binding HasCards, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Divider}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Field}" FontSize="11.5" FontWeight="Medium"
                                                           Visibility="{Binding Field, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding Text, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                                                <!-- 説明文の見出しは、変わった行だけを出す（メモ13-②）。札の色と文字は商品ページの印と同じ -->
                                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,4,0,0"
                                                              ItemTemplate="{StaticResource ChangedLineTemplate}"
                                                              Visibility="{Binding Lines.Count, Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}" />
                                                <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                           Visibility="{Binding MoreText, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                
                            <!--
                                操作は本文のすぐ下、日時と同じ行に置く（ユーザ判断 2026-09-18）。
                                指した行にだけ出すが、**行の高さは変えない**——出し入れで行が伸び縮みすると、
                                境目にマウスがあるときに出たり消えたりして画面が揺れる。
                                日時の行をボタンの高さ（28）で確保しておき、その中に出す
                            -->
                            <StackPanel Orientation="Horizontal" MinHeight="28" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}"
                                           FontSize="11" VerticalAlignment="Center" ToolTip="{Binding CreatedTip}" />
                                <!--
                                    出すのは、行にマウスが乗っているときと、**行かその中にキーボードのフォーカスがあるとき**（ユーザ判断 2026-09-30）。
                                    前は乗せた・離れたの知らせで出し入れしていたので、キーボードからは届かなかった。
                                    中のボタンにフォーカスが移っても、行の中にある間は消えない
                                -->
                                <StackPanel x:Name="RowActions" Orientation="Horizontal" Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=controls:PressableBorder}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=controls:PressableBorder}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <!-- アプリの中で開くのか、BOOTHへ出るのかが分かるように名乗る（ユーザ指摘 2026-09-18） -->
                                <Button AutomationProperties.Name="{Binding Title, StringFormat={}{0}の商品ページを開く}" Content="商品ページを開く" Style="{StaticResource SmallButton}"
                                        AutomationProperties.AutomationId="InboxRowOpenItem"
                                        Command="{Binding OpenItemCommand}"
                                        ToolTip="このアプリの中で商品ページを開きます。"
                                        Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                <!-- 「確認した」では何も直らないので、直しに行ける道を種類ごとに1つ（ユーザ指示 2026-09-18） -->
                                <Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}"
                                        AutomationProperties.AutomationId="InboxRowAction"
                                        Margin="8,0,0,0" Command="{Binding ActionCommand}"
                                        ToolTip="{Binding ActionTip}"
                                        Visibility="{Binding HasAction, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:PressableBorder>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Bg}">

        <!-- 狭いと見出し・件数・チェックが重なっていたので、入り切らないとき右の操作を次の段へ送る（SplitRowPanel。2026-10-02 メモ6-④） -->
        <Border DockPanel.Dock="Top" MinHeight="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <controls:SplitRowPanel Margin="20,8" MinLeftWidth="320" Gap="8" VerticalAlignment="Center">
                <DockPanel VerticalAlignment="Center" MinHeight="35">
                    <TextBlock DockPanel.Dock="Left" Text="要確認" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border DockPanel.Dock="Left" Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="確認しても消えません" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="未読のみ" IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Text}" />
                    <Button Content="読み直す" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="すべて既読にする" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Command="{Binding MarkAllReadCommand}" />
                </StackPanel>
            </controls:SplitRowPanel>
        </Border>

        <!-- 空表示は一覧に重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyTitle}" />
                <TextBlock Text="商品の更新、一覧との食い違い、BOOTH側の構造変化などがここに表示されます。"
                           Style="{StaticResource EmptyNote}" Margin="0,6,0,0" />
            </StackPanel>

            <!--
                この Grid は空表示を一覧へ重ねるためのもの。1行を足すときは
                DockPanel で包む（Grid の子のままだと一覧の上に重なって操作を塞ぐ）。
            -->
            <DockPanel>
                <!-- 検索と同じ理由。読んでいる最中に一覧を動かさない -->
                <Button DockPanel.Dock="Top" Margin="20,14,20,0" FontSize="12"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        Content="{Binding Main.PendingItemText}"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!--
                    束の見出しと行を平らな1本に並べて仮想化する（2026-09-24：束の中に行を入れ子にしていた頃は、
                    知らせ1000件で開くのに約7秒固まった）。束の枠は行ごとに描き分け、見た目は1枚の札のまま。
                    束の幅は中身の長さで変えない（畳むと札の幅が縮んで目が泳ぐ）ので、どの行も同じ上限の幅で真ん中に置く
                -->
                <controls:ContentItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" controls:ArrowGroup.IsEnabled="True" Focusable="False"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="20" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="MaxWidth" Value="{StaticResource ReadingMaxWidth}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.Resources>
                        <!-- 先頭の1行：状況の文（この画面そのものに結ぶ） -->
                        <DataTemplate DataType="{x:Type vm:InboxViewModel}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </DataTemplate>

                        <!-- 束の見出し。束の枠の上側（畳んだ束・中身の無い束では枠を閉じる） -->
                        <DataTemplate DataType="{x:Type vm:InboxHeadLine}">
                            <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                <Grid DataContext="{Binding Group}">
                                    <!--
                                        見出しごと畳めるようにする（ユーザ指示 2026-09-18）。見出しのどこを押しても開閉できるよう、
                                        ToggleButton を見出し全体にする。件数は畳んでいる間も出す（何件あるか見えないと開く判断ができない）。
                                        キーボードでも止まる（点検 2026-10-01：止まらない物にしてあり、キーボードからは畳めなかった）。
                                        一覧は並び（ArrowGroup）なので、↑↓ で行と見出しを渡り、Enter・Space で開閉する
                                    -->
                                    <controls:ExpandToggle AutomationProperties.AutomationId="InboxGroupToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{StaticResource RowFocusVisual}"
                                                  Subject="{Binding KindText}"
                                                  HorizontalContentAlignment="Stretch" Padding="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Back" Background="Transparent"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="14,13,18,13">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Back" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <!--
                                            名前と説明（左）と件数（右）を1行に並べ、入り切らなければ件数を次の段へ送る（メモ13-①）。
                                            前は右の 400px を件数のために常に空けていて、窓を狭くすると説明の欄だけが細くなり改行だらけになった。
                                            左が説明を折り返さずに要る幅は MinLeftWidth まで（説明は折り返せるので、その長さだけで件数を送らない）
                                        -->
                                        <controls:SplitRowPanel MinLeftWidth="320" Gap="16" AlignsTop="True">
                                            <!-- 横に並べる StackPanel だと幅が無限になり、説明文が折り返さずに右で切れていた（幅 900 で見つけた） -->
                                            <DockPanel>
                                                <Path Data="M0,0 L6,4.5 L0,9 Z" Fill="{DynamicResource TextMuted}"
                                                      Width="6" Height="9" Stretch="Fill" VerticalAlignment="Top" Margin="0,4,10,0"
                                                      Visibility="{Binding IsExpanded, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                <Path Data="M0,0 L9,0 L4.5,6 Z" Fill="{DynamicResource TextMuted}"
                                                      Width="9" Height="6" Stretch="Fill" VerticalAlignment="Top" Margin="0,6,7,0"
                                                      Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding KindText}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{DynamicResource Text}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <!--
                                                件数は行の札と同じ色・同じ言葉で出す（ユーザ指示 2026-09-18）。
                                                畳んでいる間もここだけで「何件あって、何を先に読むか」が分かるようにする
                                            -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                                        BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                        Visibility="{Binding HasStrong, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="{Binding StrongText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Warn}" />
                                                </Border>
                                                <Border Background="{DynamicResource UnreadSoft}" BorderBrush="{DynamicResource UnreadBorder}"
                                                        BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                        Visibility="{Binding HasUnread, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="{Binding UnreadText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Unread}" />
                                                </Border>
                                                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                        BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                        Visibility="{Binding HasResolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="{Binding ResolvedText}" FontSize="12"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Border>
                                                <TextBlock Text="{Binding TotalText}" Style="{StaticResource Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <!--
                                                    束ごとの「まとめて既読」（ユーザ判断 2026-09-18：選んで既読にするより、
                                                    束ごとにあれば十分）。未読がある束にだけ出す
                                                -->
                                                <Button AutomationProperties.AutomationId="InboxGroupMarkRead" AutomationProperties.Name="{Binding KindText, StringFormat={}{0}の束を既読にする}" Content="この束を既読にする" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                        Command="{Binding MarkGroupReadCommand}"
                                                        ToolTip="この種別の未読を、まとめて既読にします。"
                                                        Visibility="{Binding HasUnread, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            </StackPanel>
                                        </controls:SplitRowPanel>
                                    </controls:ExpandToggle>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="Frame" Property="CornerRadius" Value="8" />
                                    <Setter TargetName="Frame" Property="Margin" Value="0,0,0,16" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- 知らせ1件。束の枠の左右の線（束の最後の行では枠の下を閉じ、次の束との間を空ける） -->
                        <DataTemplate DataType="{x:Type vm:InboxRowLine}">
                            <Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1,0,1,0">
                                <ContentPresenter Content="{Binding Row}" ContentTemplate="{StaticResource InboxRowTemplate}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderThickness" Value="1,0,1,1" />
                                    <Setter TargetName="Frame" Property="CornerRadius" Value="0,0,8,8" />
                                    <Setter TargetName="Frame" Property="Margin" Value="0,0,0,16" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </controls:ContentItemsControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
