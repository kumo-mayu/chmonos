<Window x:Class="Chmonos.App.Views.PickModificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:views="clr-namespace:Chmonos.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PickModificationDialogViewModel}"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <Window.Resources>
        <!-- 探す欄の ×（検索画面・未確定の画面の ClearFieldButton と同じ見た目。暗黙のボタンの見た目を当てないため明示する） -->
        <Style x:Key="ClearFieldButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22,20">

        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="{Binding HeadingText}" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,7,0,0" />
        <TextBlock Text="{Binding ContextText}" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,3,0,0"
                   Visibility="{Binding HasContext, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            手で足すときの使ったファイル（メモ26-②）。何を足すか（ファイル）→ どこへ足すか（改変）の順に上から置く。
            選ばなくても「追加」は押せる。送って足すときは送る物で決まるので出さない
        -->
        <views:MemberFilePicker DataContext="{Binding Files}" Margin="0,16,0,0"
                                Visibility="{Binding DataContext.HasFiles, RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!-- どの改変に積むか。1件のときも選ばせる（新しく作るのが答えのことがある） -->
        <StackPanel Margin="0,18,0,0"
                    Visibility="{Binding HasRows, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <RadioButton Content="{Binding ExistingLabel}" GroupName="Where"
                         IsChecked="{Binding PickingExisting, Mode=TwoWay}"
                         Foreground="{DynamicResource Text}" />

            <!-- 今ある改変を探す（メモ41）。改変・アバター・Unity プロジェクトの名前で絞り、当たった理由は行に出す -->
            <Grid Margin="20,8,0,0">
                <TextBox x:Name="FilterBox" AutomationProperties.AutomationId="PickModificationFilter"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="9,5,26,5"
                         BorderBrush="{DynamicResource BorderStrong}" AutomationProperties.Name="今ある改変を探す" />
                <TextBlock Text="改変・アバター・プロジェクトの名前で探す" Margin="12,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 打った文字を消す（検索画面と同じ ×） -->
                <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                        Style="{StaticResource ClearFieldButton}" Command="{Binding ClearFilterCommand}"
                        ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                        Visibility="{Binding HasFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </Grid>

            <TextBlock Text="当たる改変がありません。" Style="{StaticResource Caption}" Margin="20,8,0,0"
                       Visibility="{Binding HasNoMatch, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                    Margin="20,8,0,0" Padding="4,2"
                    Visibility="{Binding HasNoMatch, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                <controls:ContentItemsControl ItemsSource="{Binding Rows}" MaxHeight="200">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PickModificationRowViewModel}">
                            <Border Padding="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 改変の絵（メモ58）：改変の写真の1枚目 → そのアバターの絵 → 無ければ頭文字。名前と同じく見た目の飾りで、読み上げには出さない -->
                                    <Border Grid.Column="0" Width="36" Height="36" Margin="6,0,0,0" CornerRadius="5" ClipToBounds="True"
                                            VerticalAlignment="Center" Background="{DynamicResource SurfaceAlt}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   MaxWidth="280" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   MaxWidth="280" HorizontalAlignment="Left"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        <!-- 名前以外で当たったとき、何で当たったか -->
                                        <TextBlock Text="{Binding MatchNote}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource AccentText}"
                                                   MaxWidth="280" HorizontalAlignment="Left"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasMatchNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>

                                    <Button AutomationProperties.AutomationId="PickModificationPick" AutomationProperties.Name="{Binding Name, StringFormat={}{0}に追加}" Grid.Column="2" Content="これに追加" Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.PickCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Margin="0,18,0,0"
                   Visibility="{Binding HasRows, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

        <RadioButton Content="新しい改変を作って、そこに追加" GroupName="Where" Margin="0,14,0,0"
                     IsChecked="{Binding MakingNew, Mode=TwoWay}"
                     Foreground="{DynamicResource Text}" />

        <!-- 改変はアバター1体に属するので、作るなら誰の分かが要る -->
        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="20,8,0,0"
                Visibility="{Binding MakingNew, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="どのアバターの改変か" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <!-- 選んだ名前は欄にそのまま出す（ユーザ指摘 2026-09-19）。下の1行は選んでいない間だけ -->
                <controls:SuggestBox Source="{Binding AvatarNames}" InfoSelector="{Binding AvatarSuggestInfoSelector}" GroupHeadings="{Binding AvatarGroupHeadings}" IconSelector="{Binding AvatarIconSelector}" CommitCommand="{Binding PickAvatarCommand}"
                                     AllowNew="False" KeepsCommittedText="True"
                                     Text="{Binding NewAvatarQuery, Mode=TwoWay}"
                                     Placeholder="アバターの名前で探す" />
                <TextBlock Text="{Binding NewAvatarLabel}" Style="{StaticResource Caption}" Margin="0,7,0,0"
                           Visibility="{Binding HasNewAvatar, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                <TextBlock Text="改変の名前" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                <TextBox Height="28" Padding="8,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="改変の名前"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="「普段着」「制服」のような呼び分けです。" />
            </StackPanel>
        </Border>

        <!-- 押せないときは理由を出す（E9）。ボタンの列に混ぜると窓の幅からはみ出すので、1行上に置く -->
        <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   TextAlignment="Right" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding CommitLabel}" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" IsEnabled="{Binding CanCommit}" Click="OnCommit" />
            <Button Content="キャンセル" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
