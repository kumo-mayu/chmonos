<UserControl x:Class="Chmonos.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Chmonos.App.Controls"
             xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
             AllowDrop="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 探した結果の一覧の畳む印は、商品ページと同じ三角 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ManageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                文字リンクの見た目のボタンで、長い商品名を「…」で切る（App.xaml の HyperlinkButton は切らないので、
                幅900で長い名前が枠の外へはみ出す）
            -->
            <Style x:Key="TrimmedLinkButton" TargetType="Button" BasedOn="{StaticResource HyperlinkButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}" Background="Transparent"
                                       TextTrimming="CharacterEllipsis" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Bg}">
        <Border DockPanel.Dock="Top" Height="60" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <!-- 戻る（V3）。未確定・フォルダから飛んで来られるのに、戻る道が無かった -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding Main.CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{Binding Main.BackButtonText}" Command="{Binding Main.GoBackCommand}"
                            BorderThickness="0" Background="Transparent" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                </StackPanel>
                <TextBlock Text="取り込み" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="フォルダやファイルをスキャンして、zipから商品IDを特定します"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ImportScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" MaxWidth="{StaticResource ReadingMaxWidth}">

                <!-- 取り込み元 -->
                <Border BorderBrush="{DynamicResource DropZoneBorder}" BorderThickness="2" CornerRadius="10" Background="{DynamicResource DropZoneBack}" Padding="24,22">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="フォルダかファイルをここにドロップ" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" />
                        <TextBlock Text="ファイルをドロップすると、そのファイルだけを取り込みます。"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="フォルダを選択" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.AutomationId="ImportChooseFolder"
                                    Command="{Binding AddFolderCommand}" Height="34" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    監視対象で増えていたぶん。見つけるところまでは自動でやるが、
                    取り込みは押させる。走査は手元のディスクを読むだけだが、
                    取り込みはBOOTHへの通信で1件あたり十数秒かかる。
                -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                        Visibility="{Binding Main.HasWatchedNew, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Main.WatchedNewText}" FontSize="13" FontWeight="Medium"
                                       AutomationProperties.AutomationId="ImportWatchedNewText" />
                            <TextBlock Text="押すまで取り込みは始まりません。" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="取り込み対象に入れる" Style="{StaticResource PrimaryButton}"
                                AutomationProperties.AutomationId="ImportTakeWatchedNew"
                                VerticalAlignment="Center" Command="{Binding TakeWatchedNewCommand}" />
                        <!--
                            取り込むつもりの無いファイルが監視フォルダに居座ると、起動のたびに同じ件数を
                            知らされ続けていた（消す以外に黙らせる手が無かった・G16）
                        -->
                        <Button DockPanel.Dock="Right" Content="知らせなくてよい" Margin="0,0,9,0"
                                AutomationProperties.AutomationId="ImportDismissWatchedNew"
                                VerticalAlignment="Center" Command="{Binding Main.DismissWatchedNewCommand}"
                                ToolTip="今あるファイルは、これ以上知らせません。新しいファイルは知らせます。" />
                    </DockPanel>
                </Border>

                <!--
                    ドライブは在るのに見つからない監視フォルダ（名前を変えた・移した）。外付けを外しているのと違い待っても戻らないので言う
                    （見つからない・移動の点検 9・2026-10-05。前は外付けと同じに黙っていた）。外すのは下の監視の一覧から
                -->
                <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="18,12" Margin="0,16,0,0"
                        Visibility="{Binding Main.HasWatchedMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Main.WatchedMissingText}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Warn}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ImportWatchedMissingText" />
                        <TextBlock Text="名前を変えたか移したなら、監視から外して新しい場所をドロップしてください。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- 対象フォルダ -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                            <TextBlock Text="取り込み対象" FontWeight="Bold" FontSize="13" />
                        </Border>

                        <!-- ボタンは押せない状態になっているが、何を入れれば埋まるかは別に書く -->
                        <TextBlock Text="{Binding FoldersEmptyText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="18,12,18,0"
                                   Visibility="{Binding HasFolders, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <controls:ContentItemsControl ItemsSource="{Binding Folders}" controls:ArrowGroup.IsEnabled="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="18,11"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <!-- 右クリック（ユーザ指示 2026-09-20・M2）。行のボタンと同じ操作に、場所を開くを足す -->
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="エクスプローラで開く" Command="{Binding PlacementTarget.Tag.RevealFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.Reveal" ToolTipService.ShowOnDisabled="True">
                                                    <MenuItem.ToolTip>
                                                        <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}" ConverterParameter="menu">
                                                            <Binding />
                                                            <Binding Path="PlacementTarget.Tag" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                            <Binding Path="PlacementTarget.Tag.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                        </MultiBinding>
                                                    </MenuItem.ToolTip>
                                                </MenuItem>
                                                <MenuItem Header="取り込み対象から外す" Style="{StaticResource DangerMenuItem}" Command="{Binding PlacementTarget.Tag.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.RemoveFolder" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <!-- 消すのは一覧からの登録だけで、ファイルには触らない。語も「外す」に揃える（V4・W の語彙） -->
                                            <!-- 行の数だけ並ぶので、どのフォルダのボタンかを名前に入れる -->
                                            <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource DangerButton}" Width="60" Height="27" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="ImportFolderRemove"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}を取り込み対象から外す}"
                                                    FontSize="12"
                                                    ToolTip="取り込み対象の一覧から外します。フォルダとファイルはそのまま残ります。"
                                                    Command="{Binding DataContext.RemoveFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- 右クリックの「エクスプローラで開く」と同じ命令（基本の操作は右クリックと画面の両方に置く・ユーザ判断 2026-10-06） -->
                                            <Button DockPanel.Dock="Right" Content="エクスプローラで開く" MinWidth="112" Height="27" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="ImportRowReveal"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}をエクスプローラで開く}"
                                                    FontSize="12"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.RevealFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="DataContext.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.ToolTip>
                                            </Button>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                        <StackPanel Margin="18,12">
                            <StackPanel Orientation="Horizontal">
                                <!-- 実行中は「今の取り込みに積む」に変わる。押した先が今の取り込みだと分かるように -->
                                <Button Content="{Binding StartText}" Style="{StaticResource PrimaryButton}"
                                        AutomationProperties.AutomationId="ImportStart"
                                        Command="{Binding StartCommand}" />
                                <Button Content="中断" Margin="9,0,0,0" Command="{Binding CancelCommand}"
                                        AutomationProperties.AutomationId="ImportCancel" />
                                <!-- 起動時の裏の作業を今始める（ユーザ判断 2026-09-28）。取り込みとは別の作業なので少し離す -->
                                <Button Content="足りない情報を取得" Margin="18,0,0,0" Command="{Binding FetchMissingCommand}"
                                        AutomationProperties.AutomationId="ImportFetchMissing"
                                        ToolTip="取り切れなかった画像と、期限の来た商品の情報を取得します。" />
                            </StackPanel>
                            <TextBlock Text="{Binding StackNotice}" Style="{StaticResource Caption}"
                                       AutomationProperties.AutomationId="ImportStackNotice"
                                       Margin="0,9,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasStackNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!--
                                中断は黙って起きる。閉じた時に何件残っていたかは覚えていない。
                                **押せるボタンを横に置く**（2026-09-22）。前は「もう一度押すと続きから進みます」と
                                書いてあるだけで、指していた「開始」は対象が空なので押せなかった
                            -->
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="11,8" Margin="0,10,0,0"
                                    Visibility="{Binding HasInterrupted, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="続きから進む" Command="{Binding ResumeCommand}"
                                                AutomationProperties.AutomationId="ImportResume" />
                                        <Button Content="続きを捨てる" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding DiscardInterruptedCommand}"
                                                AutomationProperties.AutomationId="ImportDiscardInterrupted"
                                                ToolTip="{x:Static vm:ImportViewModel.DiscardInterruptedTip}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding InterruptedText}" FontSize="12" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="ImportInterruptedText"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    監視対象。取り込み対象（今回積んだもの）とは別物なので、別の枠に出す。
                    こちらは起動をまたいで残り、次に開いたときに見に行く範囲になる。
                    **空でも枠は出す**（2026-09-21）——隠していたので、中に置いた
                    「見つからないファイルを探す」（G17）ごと見えなくなっていた。空表示には次の一手を書く
                -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="監視対象" FontWeight="Bold" FontSize="13" />
                                <!--
                                    起動時に自動で取り込む設定で出し分ける（U7）。以前の「次に開いたとき」は
                                    取り込み画面を開くことにも読め、設定を入にした人には「勝手には取り込みません」が嘘になっていた
                                -->
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding ImportsOnLaunch, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}"><Run Text="起動時にファイルが増えていないかを自動で調べます。取り込みの開始を自動化するには" /><Hyperlink Command="{Binding ShowSettingsCommand}">設定</Hyperlink><Run Text="を変更してください。" /></TextBlock>
                                <TextBlock Text="起動時にファイルが増えていないか自動で調べ、増えたファイルを自動で取り込みます。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding ImportsOnLaunch, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                <!--
                                    動かしたファイルを結び直す（ユーザ判断 2026-09-21・G17）。
                                    ファイルの同一性はハッシュで持っているので、移した・名前を変えただけなら
                                    同じ中身を探して場所を書き換えれば戻る。手で1件ずつ結び直すのは現実的ではない
                                -->
                                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                                    <!-- 押すと探す場所を選ぶ窓が開くので「…」を付ける（D10・点検 11-A） -->
                                    <Button DockPanel.Dock="Left" Content="見つからないファイルを探す…"
                                            AutomationProperties.AutomationId="ImportFindMissingFiles"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding FindMissingFilesCommand}"
                                            ToolTip="探すフォルダを選んで紐付け直します。ファイルは動かしません。" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding MissingSearchText}"
                                               AutomationProperties.AutomationId="ImportMissingSearchText"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="18,12,18,14"
                                   Text="まだ監視しているフォルダはありません。フォルダを上の枠にドロップすると、監視するかどうかを聞きます。"
                                   Visibility="{Binding HasWatched, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <controls:ContentItemsControl ItemsSource="{Binding Watched}" controls:ArrowGroup.IsEnabled="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="18,11"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <!-- 右クリック（M2）。行のボタンと同じ操作に、場所を開くを足す -->
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="エクスプローラで開く" Command="{Binding PlacementTarget.Tag.RevealFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.Reveal" ToolTipService.ShowOnDisabled="True">
                                                    <MenuItem.ToolTip>
                                                        <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}" ConverterParameter="menu">
                                                            <Binding />
                                                            <Binding Path="PlacementTarget.Tag" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                            <Binding Path="PlacementTarget.Tag.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                        </MultiBinding>
                                                    </MenuItem.ToolTip>
                                                </MenuItem>
                                                <MenuItem Header="監視から外す" Style="{StaticResource DangerMenuItem}" Command="{Binding PlacementTarget.Tag.RemoveWatchedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.RemoveWatched" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource DangerButton}" Width="60" Height="27" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="ImportWatchedRemove"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}を監視から外す}"
                                                    FontSize="12"
                                                    ToolTip="監視をやめます。取り込んだ記録はそのままです。"
                                                    Command="{Binding DataContext.RemoveWatchedCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="エクスプローラで開く" MinWidth="112" Height="27" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="ImportRowReveal"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}をエクスプローラで開く}"
                                                    FontSize="12"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.RevealFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="DataContext.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.ToolTip>
                                            </Button>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </Border>

                <!--
                    見つからないファイルを探した結果（メモ74 で監視対象の欄から独立させた）。紐付け直したファイル・見つからなかったファイル・
                    見つからない登録フォルダは数千件になり得るので、見出しと行を1本に並べて見えている行だけを作る（通知の画面と同じ作り）。
                    画面全体は1本のスクロールの中にあり、その中の一覧は仮想化が効かない（中の板が高さの制限なしで測られ、全部の行を作る。
                    docs/dev/wpf.md「一覧と速さ」）。一覧の高さを窓の見えている高さまでにして、中で流す。端まで流したらホイールは画面へ渡す。
                    置き場所は監視対象のすぐ下：押した「探す…」のボタンから近く、監視フォルダが数本なら押した位置のまま結果の頭が見える。
                    並べる物も探せなかった場所の文も無ければ、欄ごと出さない
                -->
                <Border x:Name="MissingResultCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                        AutomationProperties.AutomationId="ImportMissingResult"
                        Visibility="{Binding HasMissingResult, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="見つからないファイルを探した結果" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="{Binding MissingSearchNotes}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="ImportMissingSearchNotes"
                                           Visibility="{Binding HasMissingSearchNotes, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </Border>

                        <!-- 高さの上限は、見えている高さから欄の頭（見出しと上下の余白）の分を引いた物。欄の頭を上端に寄せれば一覧が窓に収まる -->
                        <controls:ContentItemsControl x:Name="MissingResultList" ItemsSource="{Binding MissingResultLines}"
                                                      MaxHeight="{Binding ViewportHeight, ElementName=ImportScroll, Converter={x:Static vm:SubtractConverter.Instance}, ConverterParameter=70}"
                                                      AutomationProperties.AutomationId="ImportMissingResultList"
                                                      AutomationProperties.Name="見つからないファイルを探した結果"
                                                      controls:ArrowGroup.IsEnabled="True"
                                                      controls:ForwardWheel.AtEdges="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      VirtualizingPanel.ScrollUnit="Pixel"
                                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True" Focusable="False" Padding="18,0,18,14">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <!--
                                    見出し。中身の無い三角の Expander で、見た目と読み上げの開閉は商品ページ・前の結果の見出しと同じ。
                                    中身の行は一覧の後ろの行として並び、畳むと一覧から抜ける（入れ子にすると仮想化されない）
                                -->
                                <DataTemplate DataType="{x:Type vm:MissingResultHeadLine}">
                                    <Expander Style="{StaticResource TriangleExpander}" Margin="0,12,0,4"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Title}">
                                        <Expander.Header>
                                            <TextBlock FontWeight="SemiBold" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Good}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding CountText, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFaint}" /></TextBlock>
                                        </Expander.Header>
                                    </Expander>
                                </DataTemplate>

                                <!-- ファイル1行（紐付け直した物・見つからなかった物で同じ形。メモ73）。見出しの三角の分だけ字下げする -->
                                <DataTemplate DataType="{x:Type vm:MissingFileResultRow}">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,7,0,5" Margin="30,0,0,0">
                                        <!-- 左の線で成否を分ける（紐付け直した＝緑・見つからなかった＝赤。流して見出しが見えなくても分かる） -->
                                        <Border BorderThickness="3,0,0,0" Padding="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Good}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        <StackPanel>
                                            <!--
                                                絵（3行の高さの四角）の右に、商品名・ファイル名・場所をいつも3行で出す。折り返さない：
                                                商品名とファイル名は末尾を「…」、場所は奥のフォルダが残るように頭を「…」で切る（幅が変われば切り直す）。
                                                全部の場所は、行に乗せると吹き出しで出す（メモ76・判断B）。高さを絵の高さに固定して、どの行も同じ高さにそろえる
                                            -->
                                            <Grid Height="56" ToolTip="{Binding PathTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Picture}" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Content="{Binding ItemName}" Style="{StaticResource TrimmedLinkButton}" FontSize="12.5"
                                                            HorizontalAlignment="Left" Command="{Binding OpenItemCommand}"
                                                            AutomationProperties.AutomationId="ImportMissingResultItem"
                                                            ToolTip="商品ページを開きます。" />
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0" />
                                                    <DockPanel Margin="0,2,0,0" MinHeight="16">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding PlaceLabel}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                                        <!-- 場所はコードの書体（区切りが「」に見え、エクスプローラやほかの画面の場所と同じ見え方。ユーザ判断 2026-10-06） -->
                                                        <controls:PathLine Path="{Binding PlaceText}" TrimHead="True" Style="{StaticResource Mono}" FontSize="11" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                        </Border>
                                    </Border>
                                </DataTemplate>

                                <!-- 見つからなかったファイルの次の手 -->
                                <DataTemplate DataType="{x:Type vm:MissingResultHintLine}">
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="30,6,0,0" />
                                </DataTemplate>

                                <!--
                                    見つからない登録フォルダと、移した先かもしれないフォルダ（見つからない・移動の点検 10-A）。
                                    フォルダはハッシュを持たないので同じ物と言い切れない。候補として並べ、押した物だけ差し替える。
                                    候補は1つの登録フォルダに5つまでなので、行の中で並べてよい
                                -->
                                <DataTemplate DataType="{x:Type vm:MissingFolderRow}">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,9,0,4" Margin="30,0,0,0">
                                        <!-- 見つからない登録フォルダは失敗の側（ファイルの行と同じ赤の左の線） -->
                                        <Border BorderThickness="3,0,0,0" Padding="8,0,0,0" BorderBrush="{DynamicResource Bad}">
                                        <!-- 絵は上にそろえて固定し、文と候補は下へ伸びる（メモ76・判断A。候補の数で行の高さが変わる） -->
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding Picture}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <Button Content="{Binding ItemName}" Style="{StaticResource TrimmedLinkButton}" FontSize="12.5"
                                                    HorizontalAlignment="Left" Command="{Binding OpenItemCommand}"
                                                    AutomationProperties.AutomationId="ImportMissingFolderItem"
                                                    ToolTip="商品ページを開きます。" />
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                           Margin="10,0,0,0" VerticalAlignment="Top" />
                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                                           <Run Text="元の場所：" /><Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" />
                                                </TextBlock>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Candidates}" Margin="14,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CountText, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="この場所にする" Style="{StaticResource SmallButton}"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    AutomationProperties.AutomationId="ImportUseFolderCandidate"
                                                                    AutomationProperties.Name="{Binding Path, StringFormat={}{0}を登録の場所にする}"
                                                                    Command="{Binding DataContext.UseFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=controls:ContentItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="登録の場所をここに変えます。ファイルは動かしません。" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="ImportMissingFolderStatus"
                                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                        </Grid>
                                        </Border>
                                    </Border>
                                </DataTemplate>

                                <!-- 商品の絵の枠（3行の高さの四角）。絵が無い間・無い商品は頭文字 -->
                                <DataTemplate DataType="{x:Type vm:ResultThumbnail}">
                                    <Border Width="56" Height="56" CornerRadius="4" Background="{DynamicResource ThumbBack}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="18" Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </Border>

                <!--
                    取り込み元の履歴（ユーザ判断 2026-09-21・G3/G4）。
                    **何を読んだかを確かめるための一覧で、対象ではない。**
                    前は履歴がそのまま「取り込み対象」に積まれていたので、1本落としたつもりでも
                    過去に指したフォルダ全部が走っていた。ここから1件ずつ対象に積む。
                    ファイルも残す（何を読んだかは確かめたい）が、監視の対象にはしない
                -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="取り込み元の履歴" FontWeight="Bold" FontSize="13" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="これまでに取り込んだフォルダとファイルです。ここに並んでいるだけでは取り込みません。「対象に追加」を押すと、今回の取り込み対象に入ります。" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="18,12,18,14"
                                   Visibility="{Binding HasHistory, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <controls:ContentItemsControl ItemsSource="{Binding History}" controls:ArrowGroup.IsEnabled="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="18,11"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="エクスプローラで開く" Command="{Binding PlacementTarget.Tag.RevealFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.Reveal" ToolTipService.ShowOnDisabled="True">
                                                    <MenuItem.ToolTip>
                                                        <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}" ConverterParameter="menu">
                                                            <Binding />
                                                            <Binding Path="PlacementTarget.Tag" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                            <Binding Path="PlacementTarget.Tag.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                        </MultiBinding>
                                                    </MenuItem.ToolTip>
                                                </MenuItem>
                                                <MenuItem Header="取り込み対象に追加" Command="{Binding PlacementTarget.Tag.TakeFromHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.TakeFromHistory" />
                                                <MenuItem Header="履歴から消す" Style="{StaticResource DangerMenuItem}" Command="{Binding PlacementTarget.Tag.ForgetHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ImportRowMenu.ForgetHistory" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <!-- 3つの一覧の赤いボタンは1語（外す・消す）にして同じ幅にそろえる（ユーザ判断 2026-10-06・メモ75）。何を外す・消すかは吹き出しと読み上げの名前で言う -->
                                            <Button DockPanel.Dock="Right" Content="消す" Style="{StaticResource DangerButton}" Width="60" Height="27"
                                                    AutomationProperties.AutomationId="ImportHistoryForget"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}を履歴から消す}"
                                                    FontSize="12" Margin="8,0,0,0"
                                                    ToolTip="履歴の一覧から消します。フォルダとファイルはそのまま残ります。"
                                                    Command="{Binding DataContext.ForgetHistoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="対象に追加" MinWidth="88" Height="27"
                                                    AutomationProperties.AutomationId="ImportHistoryTake"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}を対象に追加}"
                                                    FontSize="12"
                                                    ToolTip="今回の取り込み対象に入れます。押しただけでは取り込みは始まりません。"
                                                    Command="{Binding DataContext.TakeFromHistoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="エクスプローラで開く" MinWidth="112" Height="27"
                                                    AutomationProperties.AutomationId="ImportRowReveal"
                                                    AutomationProperties.Name="{Binding StringFormat={}{0}をエクスプローラで開く}"
                                                    FontSize="12" Margin="8,0,8,0"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.RevealFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <MultiBinding Converter="{x:Static vm:PlaceTipConverter.Instance}">
                                                        <Binding />
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="DataContext.PlacesVersion" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Button.ToolTip>
                                            </Button>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </Border>

                <!-- 進捗 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16"
                        Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <!-- 進み具合を見ている目の先に中断を置く（ユーザ指摘 2026-09-28。上の「開始」の横だけでは気付きにくい） -->
                        <DockPanel>
                        <Button DockPanel.Dock="Right" Content="中断" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ImportProgressCancel" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PhaseText}" FontWeight="Bold" FontSize="13" AutomationProperties.AutomationId="ImportPhaseText" />
                            <!-- 何を数えているか。件数だけだと検出の「346 / 599」がアバターの数に見えた -->
                            <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="ImportStepText" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="ImportProgressText" />
                        </StackPanel>
                        </DockPanel>
                        <!-- ProgressBar.Value は RangeBase 由来で既定が TwoWay。読み取り専用プロパティに繋ぐので明示的に OneWay にする -->
                        <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0"
                                     Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Current, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource BarTrack}" BorderThickness="0"
                                     Visibility="{Binding HasTotal, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!--
                            閉じても大丈夫だと先に書く（U9・ユーザ判断）。中断を知らせるのは閉じた後だけだった。
                            ②③の途中で閉じると説明が埋まらない穴を塞いでから入れた（嘘にならないように）。

                            2026-09-21：取り込み対象のカードの中（ボタンの下）に置いていたが気付かない人がいる、
                            というユーザの指摘で**バーの真下**へ移した。進み具合を見ている目の先にある。
                            走っている間はどの画面からでも見えるよう、常設の1行の横にも短い形で出している（MainWindow.xaml）
                        -->
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="アプリを閉じても、取得した分は残ります。次に「開始」を押すと続きから進みます。" />
                        <!--
                            残り時間の見込み（U1）。取り込みの時間のほとんどは問い合わせの間隔を待つ時間なので、
                            残りの問い合わせの数から出す。今の段／編集できるまで／画像を取り終わるまで、に分ける
                        -->
                        <WrapPanel Margin="0,8,0,0"
                                   Visibility="{Binding HasEstimate, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding EtaPhaseText}" Style="{StaticResource Caption}" Margin="0,0,20,0" />
                            <TextBlock Text="{Binding EtaEditableText}" Style="{StaticResource Caption}" Margin="0,0,20,0" />
                            <TextBlock Text="{Binding EtaImagesText}" Style="{StaticResource Caption}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="ImportDetailText"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 黙って遅くなると原因が分からないので、減速中はその旨を出す -->
                        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,10,0,0"
                                Visibility="{Binding IsThrottled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding ThrottleText}" FontSize="12" Foreground="{DynamicResource Warn}"
                                       AutomationProperties.AutomationId="ImportThrottleText"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--
                    使っていない間の取得（⑤の残り・アバターの1枚目・⑦の期限）。取り込みではないが、
                    ユーザからは取り込みの続きに見える（ユーザ判断 2026-09-12）。下の1行を押すとこの画面へ来るので、
                    来た先に何も無いと食い違う
                -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14"
                        Visibility="{Binding Activity.HasBackgroundWork, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="使っていない間の取得" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding Activity.BackgroundText}" Style="{StaticResource Caption}"
                                       AutomationProperties.AutomationId="ImportBackgroundText"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding Activity.BackgroundProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource BarTrack}" BorderThickness="0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="取り込みで取得できなかった画像や、持っていないアバターの1枚目を、BOOTHから少しずつ取得しています。取り込みを始めると、そちらが先に進みます。" />
                    </StackPanel>
                </Border>

                <!-- エラー -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14"
                        Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadBorder}"
                        Visibility="{Binding HasError, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ImportErrorText" />
                </Border>

                <!-- 結果 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16"
                        Visibility="{Binding HasSummary, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="結果" FontWeight="Bold" FontSize="13" Margin="0,0,0,12" />

                        <!-- 取り込みの続きに走らせた対応アバターの検出。何をしたか分かるように出す -->
                        <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,14"
                                Visibility="{Binding HasAvatarSummary, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding AvatarSummaryText}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ImportAvatarSummaryText"
                                       Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <!--
                            BOOTHに無かったもの。タイルを増やさず1行で出す。
                            普段0の数字が常設で並ぶのを避けるため（ナビのバッジと同じ理由）。
                        -->
                        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,10,0,0"
                                Visibility="{Binding HasNotFound, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding NotFoundText}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="ImportNotFoundText"
                                       Foreground="{DynamicResource Warn}" />
                        </Border>

                        <!-- 読めずに飛ばしたもの（E4）。同じく1行で、0のときは出さない -->
                        <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,10,0,0"
                                Visibility="{Binding HasUnreadable, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <!-- 文ごとに分け、間に空きを置く（折り返した行と次の文の切れ目が分かるように） -->
                            <controls:ContentItemsControl ItemsSource="{Binding UnreadableLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- ID は文の種類ごと（読めなかった・オンラインのみ・壊れたzip。ImportResultLine） -->
                                        <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="{Binding Id}"
                                                   Foreground="{DynamicResource Warn}" Margin="0,7,0,0" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                <Setter TargetName="Line" Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </Border>

                        <!--
                            取り込みの次の一手（動線の点検 D1・ユーザ判断 2026-09-12）。以前は「未確定で確かめて」と
                            文で言うだけで、そこへ飛ぶボタンが無く、ナビから探し直していた
                        -->
                        <!-- 下の余白はボタンの側に持たせる。どちらも出ないときに空の帯が残らないように -->
                        <!-- 3つ並ぶと狭い幅で右が切れるので、入らない分は次の行へ送る（下の余白が行の間になる） -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="未確定を開く" Style="{StaticResource SmallButton}" Margin="0,0,8,14"
                                    AutomationProperties.AutomationId="ImportOpenResolve"
                                    Command="{Binding OpenResolveCommand}"
                                    Visibility="{Binding HasUnresolvedResult, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    ToolTip="商品が決まらなかったファイルを、1件ずつ確かめて決めます。" />
                            <!-- 商品に結び付いた壊れた zip。上の文が言う商品を、検索の条件「壊れたzip」で並べる（ユーザ判断 2026-09-30） -->
                            <Button Content="壊れたzipがある商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,14"
                                    AutomationProperties.AutomationId="ImportShowBrokenZip"
                                    Command="{Binding ShowBrokenZipCommand}"
                                    Visibility="{Binding HasBrokenOnItemsResult, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    ToolTip="壊れたzipがある商品だけを検索で表示します。ほかの条件は外します。" />
                            <Button Content="取り込んだ商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,0,14"
                                    AutomationProperties.AutomationId="ImportShowAdded"
                                    Command="{Binding ShowAddedCommand}"
                                    Visibility="{Binding HasAddedResult, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    ToolTip="最近取り込んだ順に並べて、検索を開きます。ほかの条件は外します。" />
                        </WrapPanel>


                        <UniformGrid Columns="4" Rows="3">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="スキャンしたファイル" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesScanned}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.FilesScanned" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="中身を確かめた" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesHashed}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.FilesHashed" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="確かめを省いた" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesReusedFromCache}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.FilesReusedFromCache" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="展開先として除外" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesSkippedAsUnpacked}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.FilesSkippedAsUnpacked" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="新規に取得" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ItemsAdded}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.ItemsAdded" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="取得済みだった" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ItemsAlreadyKnown}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.ItemsAlreadyKnown" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="未確定" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.UnresolvedFiles}" FontSize="20" FontWeight="Bold"
                                           AutomationProperties.AutomationId="ImportSummary.UnresolvedFiles"
                                           FontFamily="Consolas" Foreground="{DynamicResource Warn}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="取得した画像" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ImagesDownloaded}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.ImagesDownloaded" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <!-- 手作業で紐付けたファイル。手掛かりからは決まらないので毎回ここへ落ちてくる -->
                                <TextBlock Text="管理済みで再掲せず" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesAlreadyOwned}" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                                           AutomationProperties.AutomationId="ImportSummary.FilesAlreadyOwned" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 展開先フォルダ -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,24" Padding="18,16"
                        Visibility="{Binding HasUnpackedFolders, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="展開先とみなしたフォルダ" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="アーカイブを展開したものなので取り込んでいません。アーカイブを残すなら削除して容量を戻せます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <controls:ContentItemsControl ItemsSource="{Binding UnpackedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="ImportUnpackedSelect"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='{}{0}を選ぶ'}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="展開元:" />
                                                    <Run Text="{Binding ArchiveName}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat={}{0} ファイル}"
                                                       Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{Binding UnpackedSelectionText}" Style="{StaticResource Caption}"
                                       AutomationProperties.AutomationId="ImportUnpackedSelectionText"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,230,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="選択を切り替え" Command="{Binding SelectAllUnpackedCommand}"
                                        AutomationProperties.AutomationId="ImportUnpackedToggleAll" />
                                <!-- 破壊的な操作なので、押した先で必ず確認を挟む。実際の削除はごみ箱送り -->
                                <Button Content="ごみ箱へ移動" Style="{StaticResource DangerButton}" Margin="9,0,0,0" Command="{Binding RemoveUnpackedCommand}"
                                        AutomationProperties.AutomationId="ImportUnpackedRemove" />
                            </StackPanel>
                        </Grid>

                        <controls:ContentItemsControl ItemsSource="{Binding RemovalResults}" Margin="0,12,0,0"
                                      Visibility="{Binding HasRemovalResults, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
