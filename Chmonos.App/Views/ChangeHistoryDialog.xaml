<Window x:Class="Chmonos.App.Views.ChangeHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        Title="BOOTHでの変化の履歴" Width="900" Height="620" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        商品ページの「…」・上の帯の右クリックから開く窓（ユーザ判断 2026-11-20）。左に新しい順の履歴（日付・未読の印・変わった項目の札）、
        右に選んだ件の差分（商品ページの本文と同じ帯と線：足した行＝緑・消えた行＝赤）。読むだけなので「閉じる」1つ。
        左の一覧と右の差分はそれぞれ自分で流す（窓の高さは決まっているので、DialogFit の送る入れ物で包まない）
    -->
    <Window.Resources>
        <DataTemplate x:Key="HistoryLabel" DataType="{x:Type vm:ChangeHistoryLabel}">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,4,6,0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle x:Name="Edge" Width="3" Height="11" Margin="0,0,5,0" Fill="{DynamicResource Warn}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:ChangeTone.Added}">
                    <Setter TargetName="Edge" Property="Fill" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:ChangeTone.Removed}">
                    <Setter TargetName="Edge" Property="Fill" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="22,20">
        <TextBlock DockPanel.Dock="Top" Text="BOOTHでの変化の履歴" FontWeight="Bold" FontSize="14" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ItemName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ItemName}" Margin="0,5,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="通知の保管庫の一部を読めなかったため、その分は表示していません。" Foreground="{DynamicResource Warn}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasDamage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        <Button DockPanel.Dock="Bottom" Content="閉じる" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"
                AutomationProperties.AutomationId="ChangeHistory.Close" Click="OnClose" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 新しい順。押すと右にその件の差分 -->
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="12,8,12,4" />
                    <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="ChangeHistory.List" AutomationProperties.Name="変化の履歴">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="Padding" Value="10,7" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChangeHistoryEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 未読の印は通知の画面の丸と同じ色。読んだ物は空ける（位置を揃える） -->
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,6,0,0"
                                             ToolTip="未読"
                                             Visibility="{Binding IsUnread, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DateText}" FontSize="12.5" ToolTip="{Binding DateTip}" />
                                        <ItemsControl ItemsSource="{Binding Labels}" ItemTemplate="{StaticResource HistoryLabel}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 選んだ件の差分。前の本文は保存していないので、変わった行だけを並べる -->
            <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="ChangeHistory.Diff">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.DateTip}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding SelectedFields}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChangeHistoryField}">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <RichTextBox Style="{StaticResource SelectableBody}" Margin="-2,0,0,0"
                                                 controls:SelectableText.MarkedLines="{Binding Marks}"
                                                 controls:SelectableText.Text="{Binding Text}"
                                                 Visibility="{Binding Text, Converter={x:Static vm:EmptyToCollapsedConverter.Instance}}" />
                                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Visibility="{Binding HasMore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
