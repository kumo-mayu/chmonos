<Window x:Class="Chmonos.App.Views.MissingSearchScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MissingSearchScopeViewModel}"
        Title="見つからないファイルを探す"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        どこを探すかを選ぶ窓（見つからない・移動の点検 11-A）。監視フォルダは既定で入っていて、
        ほかの場所は「フォルダを追加…」でこの回だけ足す。足した場所は監視に足さない
    -->
    <StackPanel Margin="22,20">
        <TextBlock Text="見つからないファイルを探す" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="選んだフォルダの中から、同じ中身のファイルを探して紐付け直します。ファイルは動かしません。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />

        <TextBlock Text="探すフォルダ" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />

        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Visibility="{Binding HasRows, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

        <!-- 並びが長くなっても窓が画面からはみ出さないよう、一覧だけを縦に送る -->
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRows, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <controls:ContentItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource Text}"
                                      AutomationProperties.AutomationId="MissingSearchFolder"
                                      AutomationProperties.Name="{Binding Path}">
                                <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                            </CheckBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </controls:ContentItemsControl>
        </ScrollViewer>

        <Button Content="フォルダを追加…" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                AutomationProperties.AutomationId="MissingSearchAddFolder"
                Command="{Binding AddFolderCommand}"
                ToolTip="この回だけ探します。監視フォルダには追加しません。" />

        <!-- 押せないときは理由を出す（E9） -->
        <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   TextAlignment="Right" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="探す" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    AutomationProperties.AutomationId="MissingSearchStart"
                    IsEnabled="{Binding CanSearch}" Click="OnSearch" />
            <Button Content="キャンセル" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
