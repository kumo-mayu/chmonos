<Window x:Class="Chmonos.App.Views.ApiClientApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ApiClientApprovalViewModel}"
        Title="APIの利用の許可"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <!--
        ソフトが API の許しを求めてきたときの窓（plan 31・docs/spec/api-clients.md）。
        頼んでいないのに出る窓なので、Enter と Esc はどちらも「拒否」（打っている途中の Enter で許してしまわないように）
    -->
    <StackPanel Margin="22,20">
        <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ApiApproval.Heading" />
        <TextBlock Text="名前はソフトが自分で付けたものです。心当たりが無ければ拒否してください。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />

        <TextBlock Text="実行ファイル" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
        <TextBlock Text="{Binding ExePathText}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ApiApproval.ExePath"
                   Visibility="{Binding HasExePath, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        <TextBlock Text="{Binding ExePathText}" Style="{StaticResource FieldWarning}" TextWrapping="Wrap"
                   Visibility="{Binding HasExePath, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

        <StackPanel Visibility="{Binding HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="オリジン" Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
            <TextBlock Text="{Binding Origin}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ApiApproval.Origin" />
        </StackPanel>

        <TextBlock Text="許可する変更" Style="{StaticResource SectionLabel}" Margin="0,16,0,4" />
        <TextBlock Text="データの読み取りは、許可するといつでもできます。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="変更は求めていません。読み取りだけを許可します。" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Visibility="{Binding HasScopes, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
        <controls:ContentItemsControl ItemsSource="{Binding Scopes}"
                                      Visibility="{Binding HasScopes, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ApiScopeChoice}">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,4"
                              Foreground="{DynamicResource Text}"
                              AutomationProperties.AutomationId="ApiApproval.Scope"
                              AutomationProperties.Name="{Binding Label}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:ContentItemsControl>

        <TextBlock Text="前に許可したソフトです。許可すると、前のトークンは使えなくなります。"
                   Style="{StaticResource FieldWarning}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Replaces, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <TextBlock Text="許可した後も、設定の「API」で変更や取り消しができます。"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="許可" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.AutomationId="ApiApproval.Approve" Click="OnApprove" />
            <Button x:Name="DenyButton" Content="拒否" Margin="8,0,0,0" IsDefault="True" IsCancel="True"
                    AutomationProperties.AutomationId="ApiApproval.Deny" Click="OnDeny" />
        </StackPanel>
    </StackPanel>
</Window>
