<Window x:Class="Chmonos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chmonos.App.ViewModels"
        xmlns:controls="clr-namespace:Chmonos.App.Controls"
        xmlns:views="clr-namespace:Chmonos.App.Views"
        Title="Chmonos"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- 検索の View は作り直さず1つを持ち回す（SearchViewHost に理由） -->
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchViewHost />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InboxViewModel}">
            <views:InboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagManageViewModel}">
            <views:TagManageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttributeManageViewModel}">
            <views:AttributeManageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopsViewModel}">
            <views:ShopsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolderViewModel}">
            <views:FolderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AvatarsViewModel}">
            <views:AvatarsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModificationViewModel}">
            <views:ModificationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModificationHubViewModel}">
            <views:ModificationHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- NavButton のテンプレートから引くので、必ずその前に置く（StaticResourceは前方参照できない） -->
        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            ナビのアイコン。モックのSVGを24×24の座標系のまま持ち込み、Viewboxで16pxへ縮める。
            線の太さも一緒に縮むので、どのアイコンも同じ太さで揃う。
        -->
        <PathGeometry x:Key="IconSearch" Figures="M4,11 A7,7 0 1 1 18,11 A7,7 0 1 1 4,11 M20,20 L16.5,16.5" />
        <PathGeometry x:Key="IconShops" Figures="M4,9 H20 V20 H4 Z M4,9 L5.5,4 H18.5 L20,9" />
        <PathGeometry x:Key="IconFolders" Figures="M3,6 H9.5 L11.5,8 H21 V19 H3 Z" />
        <PathGeometry x:Key="IconStats" Figures="M5,19 V11 M12,19 V5 M19,19 V14" />
        <PathGeometry x:Key="IconImport" Figures="M12,4 V15 M8,11 L12,15 L16,11 M5,19 H19" />
        <PathGeometry x:Key="IconResolve" Figures="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M9.6,9.6 A2.5,2.5 0 1 1 13.6,11.6 C12.8,12.2 12,12.6 12,13.6 M12,17.2 V17.3" />
        <PathGeometry x:Key="IconInbox" Figures="M18,15 V11 A6,6 0 1 0 6,11 V15 L4,18 H20 Z M10,21 H14" />
        <PathGeometry x:Key="IconEdit" Figures="M4,20 H8 L18,10 L14,6 L4,16 Z" />
        <PathGeometry x:Key="IconAvatars" Figures="M8.6,8 A3.4,3.4 0 1 1 15.4,8 A3.4,3.4 0 1 1 8.6,8 M5,20 C6,16.4 8.7,14.6 12,14.6 S18,16.4 19,20" />
        <!-- 改変（着せ替え）。服の形 -->
        <PathGeometry x:Key="IconModifications" Figures="M8.5,4 L4,7 L5.8,10.2 L8,9.2 V20 H16 V9.2 L18.2,10.2 L20,7 L15.5,4 C14.8,5.4 13.5,6.2 12,6.2 S9.2,5.4 8.5,4 Z" />
        <PathGeometry x:Key="IconTags" Figures="M4,12 V5 H11 L19,13 L12,20 L4,12 Z M7.2,8.5 A1.3,1.3 0 1 1 9.8,8.5 A1.3,1.3 0 1 1 7.2,8.5" />
        <PathGeometry x:Key="IconAttributes" Figures="M5,7 H19 M5,12 H19 M5,17 H19" />
        <PathGeometry x:Key="IconSettings" Figures="M8.8,12 A3.2,3.2 0 1 1 15.2,12 A3.2,3.2 0 1 1 8.8,12 M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4" />

        <!--
            ナビのボタンにキーボードで止まった印（ユーザ判断 2026-10-05・メモ62）。ナビは明暗どちらのテーマでも暗い地なので、
            App.xaml の SmallFocusVisual（Accent。明るい配色の Accent は暗い地で沈む）ではなく、ナビの字の色で枠を描く。
            マウスで押したときは WPF の既定どおり出ない
        -->
        <Style x:Key="RailFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource RailTextActive}" BorderThickness="1.5" CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ナビの1項目。11項目とも「アイコン・名前・件数」で同じ形なので、
            並べ方はここだけに書き、項目ごとの違いは views:Nav の添付プロパティで渡す。
            畳んだときに名前を消す、という変更も1箇所で済む。
        -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RailFocusVisual}" />
            <!--
                名前はテンプレートの中のTextBlockに入るので、ボタン自体には文字が無い。
                読み上げと自動化には名前が見えなくなるので、ここで明示する。
            -->
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource RailText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon" Data="{Binding Path=(views:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              Fill="{x:Null}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{DynamicResource RailText}" />
                                    </Canvas>
                                </Viewbox>

                                <TextBlock x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource RailText}" />

                                <!--
                                    0件のときは出さない。残っている作業を示すものなので、
                                    0が並ぶと数字そのものが目に入ってしまう。
                                -->
                                <Border x:Name="Badge" Grid.Column="2" Style="{StaticResource NavBadge}" Margin="6,0,0,0"
                                        Background="{Binding Path=(views:Nav.BadgeBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                        Visibility="{Binding Path=(views:Nav.Badge), RelativeSource={RelativeSource TemplatedParent},
                                                             Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                                    <!-- 頭の名前（「未:」など）は、件数が2つ並ぶ項目にだけ付く。無い項目では空で、数字だけになる -->
                                    <TextBlock x:Name="BadgeText" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"
                                               FontFamily="Yu Gothic UI, Meiryo, Segoe UI"><Run Text="{Binding Path=(views:Nav.BadgePrefix), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="{Binding Path=(views:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /></TextBlock>
                                </Border>

                                <!--
                                    2つ目の件数（編集途中の数・ユーザ指示）。数字だけが2つ並ぶとどちらが何か分からないので
                                    「途中 n」と名乗る。0件のときは出さない
                                -->
                                <Border x:Name="SubBadge" Grid.Column="3" Style="{StaticResource NavBadge}" Margin="4,0,0,0"
                                        Background="{Binding Path=(views:Nav.SubBadgeBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                        Visibility="{Binding Path=(views:Nav.SubBadge), RelativeSource={RelativeSource TemplatedParent},
                                                             Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                                    <TextBlock x:Name="SubBadgeText" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"
                                               FontFamily="Yu Gothic UI, Meiryo, Segoe UI"><Run Text="{Binding Path=(views:Nav.SubBadgePrefix), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text="{Binding Path=(views:Nav.SubBadge), RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /></TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                選んでいる項目は白。前は変換器が色を作っていたが、色の表を差し替えても変換器は
                                作り直されず古い色のまま残るので、鍵を指すトリガーにした
                            -->
                            <Trigger Property="views:Nav.IsActive" Value="True">
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource RailTextActive}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource RailTextActive}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RailHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <!--
                                畳んだときは名前を消し、件数は数字ごと落として点だけ残す。
                                アイコンだけになっても「ここに残作業がある」ことは見えるようにする。

                                点はアイコンの角へ重ねる。畳んだ幅では内容領域がアイコン16pxちょうどで、
                                バッジを別の列に置くと幅が残らず消えてしまうため。
                                レール色の縁を巻いて、線画に重なっても輪郭が潰れないようにする。
                            -->
                            <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Grid.Column" Value="0" />
                                <Setter TargetName="Badge" Property="Width" Value="10" />
                                <Setter TargetName="Badge" Property="Height" Value="10" />
                                <Setter TargetName="Badge" Property="Padding" Value="0" />
                                <!-- 行の高さ34に対しアイコンは中央の16px。その上端より少し上に置く -->
                                <Setter TargetName="Badge" Property="Margin" Value="0,6,-5,0" />
                                <Setter TargetName="Badge" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Badge" Property="VerticalAlignment" Value="Top" />
                                <Setter TargetName="Badge" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Rail}" />
                                <!-- 2つ目の件数は右下の点。右上の点（残っている作業）と重ならない -->
                                <Setter TargetName="SubBadgeText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SubBadge" Property="Grid.Column" Value="0" />
                                <Setter TargetName="SubBadge" Property="Width" Value="10" />
                                <Setter TargetName="SubBadge" Property="Height" Value="10" />
                                <Setter TargetName="SubBadge" Property="Padding" Value="0" />
                                <Setter TargetName="SubBadge" Property="Margin" Value="0,0,-5,6" />
                                <Setter TargetName="SubBadge" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SubBadge" Property="VerticalAlignment" Value="Bottom" />
                                <Setter TargetName="SubBadge" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SubBadge" Property="BorderBrush" Value="{DynamicResource Rail}" />
                                <Setter Property="ToolTip"
                                        Value="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource Self}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            区切りの見出し。畳んでも場所は残す（Hidden）。場所ごと消すと、下のアイコンが
            開閉のたびに上下へずれた（U2）。畳んだときは同じ高さに細い線（NavGroupRule）を出す
        -->
        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RailLabel}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="22,12,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 線の左右はナビのアイコン（左から20・幅16）にそろえる -->
        <Style x:Key="NavGroupRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="20,4,0,0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource RailLabel}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            ナビの中の小さなボタン（戻る・進む）。ナビの配色に合わせる
            （既定のボタンのままだと、暗いナビの上に明るい箱が浮いた。2026-09-20）
        -->
        <Style x:Key="RailSmallButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RailFocusVisual}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource RailText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{DynamicResource RailNoticeFrame}"
                                BorderThickness="1" CornerRadius="6">
                            <!--
                                文字は TextBlock で直に描く。ContentPresenter に任せると、暗いナビの上で見えなかった
                                （docs/dev/wpf.md「ボタンの文字はボタンの Foreground に従わない」）
                            -->
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource RailHover}" />
                            </Trigger>
                            <!-- 行き先が無いときは薄く。理由はツールチップで出す -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource RailLabel}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource RailButtonDimBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 開いたときだけ見せる。畳んでも場所は残す -->
        <Style x:Key="NavExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavCollapsedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            ナビの「上（下）にまだ項目がある」帯。地の色で上から（下から）透けて消え、真ん中に矢印を置く。
            ナビの項目の上に重ねるので、見えても消えても項目の位置は動かない。乗せたときだけ矢印を明るくする
        -->
        <ControlTemplate x:Key="NavMoreTemplate" TargetType="Button">
            <Grid Background="Transparent" Cursor="Hand">
                <Border x:Name="Fade" Background="{DynamicResource Rail}">
                    <Border.OpacityMask>
                        <LinearGradientBrush x:Name="FadeMask" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{x:Static Colors.Black}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource RailMuted}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Up">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleY="-1" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Chevron" Property="Margin" Value="0,0,0,2" />
                </Trigger>
                <Trigger Property="Tag" Value="Down">
                    <Setter TargetName="Fade" Property="OpacityMask">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="{x:Static Colors.Black}" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource RailTextActive}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <PathGeometry x:Key="IconApp" Figures="M4,8 L12,4 L20,8 V16 L12,20 L4,16 Z M4,8 L12,12 L20,8 M12,12 V20" />
    </Window.Resources>

    <!--
        表示の大きさ（AppZoom）で中身を丸ごと縮尺する。縮尺の内側は 100% と同じ DIP で並ぶので、
        上げた分だけ中身に渡る幅と高さが減り、足りない分はナビが縦に・本文が横に送る（窓の最小の大きさは変えない）
    -->
    <Grid LayoutTransform="{DynamicResource AppZoomTransform}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding NavPane.MinWidth}" MaxWidth="{Binding NavPane.MaxWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ナビの幅を変える境目（ユーザ判断 2026-09-14）。畳んでいる間は出さない -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                               ResetCommand="{Binding NavPane.ResetCommand}"
                               Visibility="{Binding NavPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!-- ナビゲーション -->
        <Border x:Name="NavRail" Grid.Column="0" Background="{DynamicResource Rail}" controls:NavKeys.IsEnabled="True">
            <!--
                窓が低いと下の「設定」が窓の外に出て押せなかった（点検 2026-09-23・高さ700px）。
                「設定」（と BOOTH の形式の知らせ）は送る入れ物の外で下端に固定し、残りの項目だけを溢れたときに縦に送る。
                送る入れ物はスクロールバーを見せない（ユーザ指摘 2026-10-02 メモ6：畳んだ 56px の列ではバーの幅がそのまま中身をつぶした）。
                ホイールと、Tab で移った先を見せる送り（BringIntoView）はバーが無くても効く
            -->
            <!-- 行で分ける（DockPanel の下端に先に書くと、Tab の順で「設定」がナビの先頭に来る） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- 送る入れ物と、上下に続きがある印を重ねる入れ物。印は重ねるだけで、出入りで項目を押し動かさない（ユーザ指示 2026-10-03） -->
            <Grid Grid.Row="0">
            <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          ScrollChanged="OnNavScrollChanged">
                <StackPanel Margin="0,16,0,0">
                    <!--
                        畳んだ幅ではタイトルが入らないので、同じ高さにアプリの印を置く。
                        場所ごと消すと、畳むボタンと下のアイコンが開閉のたびに上へ詰まってずれた（U2）。
                        印の位置と描き方はナビのアイコン（左から20・16px・線の太さ1.8）にそろえる
                    -->
                    <Grid Margin="10,0,10,14">
                        <StackPanel Margin="8,0" Style="{StaticResource NavExpandedOnly}">
                            <!--
                                読みを添える（ユーザ判断 2026-09-14）。綴りから「クモノス」とは読めない（ch をクと読むのはギリシャ語から来た綴りの約束）。
                                行を増やすとナビの頭の高さが変わる（U2）ので、同じ行に小さく薄く続ける
                            -->
                            <TextBlock Foreground="{DynamicResource RailTitle}" FontSize="13">
                                <Run Text="Chmonos" FontWeight="Bold" /><Run Text=" クモノス" FontSize="10.5" Foreground="{DynamicResource RailSubtitle}" />
                            </TextBlock>
                            <!-- 日本語にして英語の頃より幅が要る。万単位でもナビの幅からはみ出さないよう、溢れたら「…」で切る -->
                            <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource RailMuted}" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LibrarySummary}" />
                        </StackPanel>
                        <Viewbox Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Style="{StaticResource NavCollapsedOnly}" ToolTip="Chmonos（クモノス）">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconApp}" Fill="{x:Null}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{DynamicResource RailText}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <!--
                        戻る・進む（ユーザ指示 2026-09-20・M7：ブラウザと同じく左上に）。
                        画面の中の「← ○○に戻る」は残す（行き先の名前が出せるのはあちらだけ）。
                        畳んでいる間は幅（56）に2つは入らないので、戻るだけを残す（ユーザ判断 2026-09-27。畳むと両方消えていた）。
                        進むはキー（Alt+→）とマウスのボタンで効く
                    -->
                    <StackPanel Orientation="Horizontal" Margin="16,2,10,6">
                        <Button Content="←" Command="{Binding GoBackCommand}" Style="{StaticResource RailSmallButton}"
                                ToolTip="{Binding BackTip}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="戻る" AutomationProperties.AutomationId="Nav.Back" />
                        <!-- 隠すだけ（Hidden）だと幅を取り続け、畳んだナビから右へはみ出す -->
                        <Border Margin="6,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Content="→" Command="{Binding GoForwardCommand}" Style="{StaticResource RailSmallButton}"
                                    ToolTip="{Binding ForwardTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="進む" AutomationProperties.AutomationId="Nav.Forward" />
                        </Border>
                    </StackPanel>
                    <Button Command="{Binding ToggleNavCommand}" Margin="10,0,10,2" AutomationProperties.AutomationId="Nav.Toggle">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Setter Property="views:Nav.Icon" Value="{StaticResource IconSidebarOpen}" />
                                <Setter Property="views:Nav.Label" Value="ナビを折りたたむ" />
                                <Style.Triggers>
                                    <!-- 畳んでいるときは、押すと戻る側の意味になる -->
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="views:Nav.Icon" Value="{StaticResource IconSidebarClosed}" />
                                        <Setter Property="views:Nav.Label" Value="ナビを開く" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--
                        区切りの見出しは、畳んでも高さを残し、名前の代わりに細い線を引く。
                        場所ごと消すと、下のアイコンが開閉のたびに上下へずれた（U2）
                    -->
                    <Grid>
                        <TextBlock Text="ライブラリ" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowSearchCommand}" AutomationProperties.AutomationId="Nav.Search"
                            views:Nav.Label="検索" views:Nav.Icon="{StaticResource IconSearch}"
                            views:Nav.IsActive="{Binding IsSearchActive}" />
                    <!-- 改変は item に対する検索のような関係なので、検索の隣に置く（ユーザ判断 2026-09-13） -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowModificationsCommand}" AutomationProperties.AutomationId="Nav.Modifications"
                            views:Nav.Label="改変" views:Nav.Icon="{StaticResource IconModifications}"
                            views:Nav.IsActive="{Binding IsModificationsActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowShopsCommand}" AutomationProperties.AutomationId="Nav.Shops"
                            views:Nav.Label="ショップ" views:Nav.Icon="{StaticResource IconShops}"
                            views:Nav.IsActive="{Binding IsShopsActive}" />
                    <!-- フォルダビュー（ユーザ指示 2026-09-13：「一旦ショップの下に置いてくれ」） -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowFoldersCommand}" AutomationProperties.AutomationId="Nav.Folders"
                            views:Nav.Label="フォルダ" views:Nav.Icon="{StaticResource IconFolders}"
                            views:Nav.IsActive="{Binding IsFoldersActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowStatsCommand}" AutomationProperties.AutomationId="Nav.Stats"
                            views:Nav.Label="統計" views:Nav.Icon="{StaticResource IconStats}"
                            views:Nav.IsActive="{Binding IsStatsActive}" />

                    <Grid>
                        <TextBlock Text="作業" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowImportCommand}" AutomationProperties.AutomationId="Nav.Import"
                            views:Nav.Label="取り込み" views:Nav.Icon="{StaticResource IconImport}"
                            views:Nav.IsActive="{Binding IsImportActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowResolveCommand}" AutomationProperties.AutomationId="Nav.Resolve"
                            views:Nav.Label="未確定" views:Nav.Icon="{StaticResource IconResolve}"
                            views:Nav.IsActive="{Binding IsResolveActive}"
                            views:Nav.Badge="{Binding UnresolvedCount}" views:Nav.BadgeBrush="{DynamicResource NeedsWorkFill}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowEditCommand}" AutomationProperties.AutomationId="Nav.Edit"
                            views:Nav.Label="編集" views:Nav.Icon="{StaticResource IconEdit}"
                            views:Nav.IsActive="{Binding IsEditActive}"
                            views:Nav.Badge="{Binding NeedsEditBadgeCount}" views:Nav.BadgeBrush="{DynamicResource NeedsWorkFill}" views:Nav.BadgePrefix="未:"
                            views:Nav.SubBadge="{Binding Drafts.Count}" views:Nav.SubBadgeBrush="{DynamicResource AccentFill}" views:Nav.SubBadgePrefix="編:" />

                    <Grid>
                        <TextBlock Text="管理" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <!--
                        要確認は「取り込んだ物を片付ける流れ」ではなく管理の側（U6・ユーザ判断）。
                        件数のバッジが付くのはここだけなので、先頭に置いて目に入るようにする
                    -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowInboxCommand}" AutomationProperties.AutomationId="Nav.Inbox"
                            views:Nav.Label="通知" views:Nav.Icon="{StaticResource IconInbox}"
                            views:Nav.IsActive="{Binding IsInboxActive}"
                            views:Nav.Badge="{Binding UnreadCount}" views:Nav.BadgeBrush="{DynamicResource UnreadFill}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAvatarsCommand}" AutomationProperties.AutomationId="Nav.Avatars"
                            views:Nav.Label="アバター" views:Nav.Icon="{StaticResource IconAvatars}"
                            views:Nav.IsActive="{Binding IsAvatarsActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowTagManageCommand}" AutomationProperties.AutomationId="Nav.TagManage"
                            views:Nav.Label="タグの管理" views:Nav.Icon="{StaticResource IconTags}"
                            views:Nav.IsActive="{Binding IsTagManageActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAttributeManageCommand}" AutomationProperties.AutomationId="Nav.AttributeManage"
                            views:Nav.Label="属性の管理" views:Nav.Icon="{StaticResource IconAttributes}"
                            views:Nav.IsActive="{Binding IsAttributeManageActive}" />
                </StackPanel>
            </ScrollViewer>

            <!--
                項目が入り切らないとき、まだ隠れている向きに出す帯（押すとその向きへ送る）。
                ナビの地の色から透けて消える帯の上に矢印を置き、項目の上に重ねる。畳んだ幅でも同じ。
                見える・見えないは NavScroller の送りの位置から決める（MainWindow.xaml.cs の NavScrollHint）
            -->
            <Button x:Name="NavMoreAbove" VerticalAlignment="Top" Height="26" Visibility="Collapsed" Focusable="False"
                    Template="{StaticResource NavMoreTemplate}" Tag="Up" Click="OnNavMoreClick"
                    AutomationProperties.AutomationId="Nav.MoreAbove" AutomationProperties.Name="上の項目を見る"
                    ToolTip="上にまだ項目があります。押すと上へ送ります。" />
            <Button x:Name="NavMoreBelow" VerticalAlignment="Bottom" Height="26" Visibility="Collapsed" Focusable="False"
                    Template="{StaticResource NavMoreTemplate}" Tag="Down" Click="OnNavMoreClick"
                    AutomationProperties.AutomationId="Nav.MoreBelow" AutomationProperties.Name="下の項目を見る"
                    ToolTip="下にまだ項目があります。押すと下へ送ります。" />
            </Grid>

                <!--
                    BOOTHから取れる情報の形が変わった疑い（ユーザ判断 2026-09-18）。商品1件ごとの話と
                    同列に並べると埋もれるので、要確認の束ではなくここに出す。アプリ全体の話なので設定の上。
                    設定と同じく送らずに見せておく
                -->
                <Button Grid.Row="1" Margin="10,0,10,10" Padding="9,8" FontSize="11.5"
                        Height="Auto" HorizontalContentAlignment="Left" Cursor="Hand"
                        Background="{DynamicResource RailNoticeBack}" BorderBrush="{DynamicResource RailNoticeFrame}"
                        Foreground="{DynamicResource RailNoticeText}"
                        Command="{Binding ShowStructureAlertCommand}"
                        AutomationProperties.AutomationId="StructureAlert"
                        AutomationProperties.Name="BOOTHの情報の形式が変わったかもしれません"
                        ToolTip="{Binding StructureAlert}"
                        Visibility="{Binding HasStructureAlert, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <!--
                        注意の色は縦線と文字だけに使う（枠と地はナビと同系の暗い色）。
                        畳んだナビ（56px）では文が入らないので、縦線と印だけにする
                    -->
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,1,8,1"
                                Background="{DynamicResource RailNoticeEdge}" />
                        <Grid>
                            <TextBlock Text="BOOTHの情報の形式が変わったかもしれません" Width="150" TextWrapping="Wrap" LineHeight="16"
                                       Foreground="{DynamicResource RailNoticeText}"
                                       Style="{StaticResource NavExpandedOnly}" />
                            <TextBlock Text="!" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource RailNoticeText}"
                                       Style="{StaticResource NavCollapsedOnly}" />
                        </Grid>
                    </DockPanel>
                </Button>

                <Button Grid.Row="2" Style="{StaticResource NavButton}" Margin="10,0,10,14"
                        Command="{Binding ShowSettingsCommand}" AutomationProperties.AutomationId="Nav.Settings"
                        views:Nav.Label="設定" views:Nav.Icon="{StaticResource IconSettings}"
                        views:Nav.IsActive="{Binding IsSettingsActive}" />
            </Grid>
        </Border>

        <DockPanel Grid.Column="1">
            <!--
                通信の常設表示。取得は直列なので、どの瞬間も起きていることは1つだけ。
                背景で画像を取りに行くこともあるので、黙って通信しないよう常に見える場所に置く。
                何もしていないときは畳む（高さを取らない）。
            -->
            <!--
                Unity へ送っている間の帯（ユーザ判断 2026-09-20）。**どの画面へ移っても止められるように**
                ここに置く。前は「中止」が送信を始めた画面にしか無く、移ると止める手立てが無くなっていた。
                通信の帯とは別に出す（押しても画面は移らない。ここは止めるための場所）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding IsSendingToUnity, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="30">
                    <Button DockPanel.Dock="Right" Content="中止" Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Command="{Binding StopUnityCommand}"
                            AutomationProperties.AutomationId="UnitySendStop"
                            AutomationProperties.Name="Unityへ送るのを中止"
                            ToolTip="送るのをやめます。Unityの取り込み画面は「Cancel」で閉じてください。" />
                    <TextBlock Text="{Binding UnitySendText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}"
                               AutomationProperties.AutomationId="UnitySendText"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!--
                分単位で掛かる作業（対応アバターの検出・未確定の候補を検索・保存先の移動・バックアップの書き出しと戻す）の帯。
                **どの画面でも進み具合と「中止」を出す**（ユーザ判断 2026-09-21・C1/C2）。
                始めた画面にしか止める手立てが無いと、画面を移った時点で止められなくなる。
                この間できなくなることも1行で言う（黙って押せなくしない）。帯は1本で、走っている間はほかの長い作業を始められない（2026-10-01）。
                進み具合の棒は一時展開の帯と同じ見た目で、件数が分かるまでは流れる棒にする（2026-10-02）。
                バックアップから戻すも「中止」を出す（止めると Core が戻す先へ展開した物を消す。2026-10-02）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding IsLongJobRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="30">
                    <Button DockPanel.Dock="Right" Content="中止" Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Command="{Binding StopLongJobCommand}"
                            Visibility="{Binding CanStopLongJob, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                            AutomationProperties.AutomationId="LongJobStop"
                            AutomationProperties.Name="作業を中止"
                            ToolTip="{Binding LongJobStopHint}" />
                    <!-- 棒の地は一時展開の帯と同じ理由で帯の線の色にする（既定の地は薄い青の帯の上でほぼ同じ色） -->
                    <ProgressBar Background="{DynamicResource AccentBorder}" DockPanel.Dock="Left" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1"
                                 AutomationProperties.AutomationId="LongJobProgress"
                                 Value="{Binding LongJobProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding HasLongJobProgress, Converter={x:Static vm:InverseBoolConverter.Instance}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LongJobNote}" Style="{StaticResource Caption}"
                               AutomationProperties.AutomationId="LongJobNote"
                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LongJobText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}"
                               AutomationProperties.AutomationId="LongJobText"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!--
                「一時的に展開して開く」の間の帯（大容量の確かめ #3・ユーザ判断 2026-09-30）。前は押してからエクスプローラが開くまで
                何も変わらず、遅いディスクでは数十秒「押したのに何も起きない」と見えた。待つ間に別の画面へ移れるので、
                Unity へ送る帯と同じ場所・同じ見た目で、進み具合と「中止」を出す。終われば畳んでエクスプローラを開く。
                「中止」は押した後に引っ込める（片付けが済むまで帯は「展開を中止しています…」で残る）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding IsUnpacking, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="30">
                    <Button DockPanel.Dock="Right" Content="中止" Style="{StaticResource SmallButton}"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Command="{Binding StopUnpackCommand}"
                            AutomationProperties.AutomationId="UnpackStop"
                            AutomationProperties.Name="展開を中止"
                            ToolTip="展開をやめます。元のzipはそのまま残ります。"
                            Visibility="{Binding CanStopUnpack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 棒の地は帯の線の色にする。既定（BarTrack）は薄い青の帯の上ではほぼ同じ色で、まだ進んでいない部分が見えなかった（画面の確かめ 2026-09-30） -->
                    <ProgressBar Background="{DynamicResource AccentBorder}" DockPanel.Dock="Left" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding UnpackProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding HasUnpackProgress, Converter={x:Static vm:InverseBoolConverter.Instance}}" />
                    <!-- 数字の文は切らない。長い zip の名前はその右で切る（名前が先だと、長い名前のときに進み具合が「…」に隠れる） -->
                    <TextBlock DockPanel.Dock="Left" Text="{Binding UnpackText}" Style="{StaticResource Caption}"
                               AutomationProperties.AutomationId="UnpackText"
                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UnpackTargetText}" Style="{StaticResource Caption}"
                               AutomationProperties.AutomationId="UnpackTargetText"
                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Opacity="0.75" TextTrimming="CharacterEllipsis" ToolTip="{Binding UnpackTargetText}" />
                </DockPanel>
            </Border>

            <!--
                前回の取り込みが途中で止まったままだと、どの画面からも分からず、再開の道も取り込み画面にしか無かった
                （ユーザ指摘 2026-09-22）。**帯は常設ではない**——続きが残っている間と、通信している間だけ出す。
                走っている間は下の通信の帯が同じ場所に出るので、こちらは引っ込む（2本並べない）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasInterruptedImport, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="34">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="続きから進む" Command="{Binding Import.ResumeCommand}"
                                AutomationProperties.AutomationId="InterruptedImportResume" />
                        <!-- 「やめる」では何が無くなるのか読めなかった（戻せない操作なので、押す前に窓でも聞く） -->
                        <Button Content="続きを捨てる" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding Import.DiscardInterruptedCommand}"
                                AutomationProperties.AutomationId="InterruptedImportDiscard"
                                ToolTip="{x:Static vm:ImportViewModel.DiscardInterruptedTip}" />
                    </StackPanel>
                    <TextBlock Text="{Binding InterruptedImportText}" Style="{StaticResource Caption}"
                               AutomationProperties.AutomationId="InterruptedImportText"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- 押すと取り込みの画面へ（U24）。通信の話を見に行く先は1つにしておく -->
            <!-- 押せる帯は Border のままだと読み上げ・自動操作から押せない。見た目はそのままで「押せるボタン」として出す（PressableBorder） -->
            <controls:PressableBorder DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Cursor="Hand" ToolTip="取り込みの画面を開く"
                    Command="{Binding ShowImportCommand}"
                    AutomationProperties.AutomationId="BoothActivityBar"
                    AutomationProperties.Name="取り込みの画面を開く"
                    Visibility="{Binding BoothActivity.IsActive, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowImportCommand}" />
                </Border.InputBindings>
                <Grid Height="26">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 長さの分かっている待ちはバーで、通信そのものは点滅で -->
                        <ProgressBar Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding BoothActivity.Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding BoothActivity.HasProgress,
                                                       Converter={x:Static vm:InverseBoolConverter.Instance}}" />
                        <TextBlock Text="{Binding BoothActivity.Text}" Style="{StaticResource Caption}"
                                   AutomationProperties.AutomationId="BoothActivityText"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <!--
                            閉じてよいことを、走っている間はどの画面でも見えるようにする（ユーザ判断 2026-09-21）。
                            取り込み画面まで行かないと読めなかった。人が押した取り直しだけのときは出さない（CanResumeLater）
                        -->
                        <TextBlock Text="閉じても続きから進みます" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.75"
                                   Visibility="{Binding BoothActivity.CanResumeLater,
                                                Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                    <TextBlock Text="混み合っています" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource Warn}"
                               ToolTip="BOOTHの指示で、問い合わせの間隔を広げています。"
                               Visibility="{Binding BoothActivity.IsThrottled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </Grid>
            </controls:PressableBorder>

            <!--
                落とした URL の商品を登録している間（洗い出し 12）。登録は BOOTH の順番を待つので、「はい」を押してから数秒かかる。
                窓を閉じた後は別の画面へ移れるので、どの画面でも見える所に出す。済んだら「登録しました」の帯に替わる
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding IsRegisteringDropped, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal" Height="26">
                    <ProgressBar Background="{DynamicResource AccentBorder}" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center" IsIndeterminate="True" />
                    <TextBlock Text="{Binding DroppedRegisteringText}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}"
                               AutomationProperties.AutomationId="DroppedRegisteringText"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!--
                登録し終えた商品への入口（ユーザ指示 2026-09-15）。前は登録が終わると商品ページへ移り、検索を進めていた画面が勝手に替わっていた。
                通信の帯のすぐ上に出し、開くかを選ばせる。通信が終わって通信の帯が畳まれても、押すか閉じるまでは残す。
                商品ページを離れた後に取り直しが済んだときも同じ帯で知らせる（画面を引き戻さない）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasRegisteredNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="32">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissRegisteredCommand}" AutomationProperties.Name="この知らせを閉じる"
                            AutomationProperties.AutomationId="RegisteredNoticeClose"
                            ToolTip="この知らせを閉じます。商品は検索から開けます。" />
                    <Button DockPanel.Dock="Right" Content="{Binding RegisteredNoticeAction}" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Command="{Binding OpenRegisteredCommand}" AutomationProperties.AutomationId="RegisteredNoticeOpen" />
                    <!-- 出ている間に来た別の知らせは待たせて、閉じたら次を出す（ユーザ判断 2026-09-23）。待っていると分かるように数を出す -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RegisteredNoticeWaitingText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="この知らせを押すか閉じると、次の知らせが表示されます。"
                               Visibility="{Binding HasRegisteredNoticeWaiting, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <TextBlock Text="{Binding RegisteredNoticeText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="RegisteredNoticeText"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                </DockPanel>
            </Border>

            <!--
                落とした物・フォルダビューから始めた取り込みの知らせ（点検 2026-09-23・動線の点検 A2・A3）。
                前は取り込み画面へ移り、見ていた画面が勝手に替わった。画面は移さず、進み具合と入口をここに出す（登録の帯と同じ場所・同じ見た目）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasImportNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="32">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissImportNoticeCommand}" AutomationProperties.Name="取り込みの知らせを閉じる"
                            AutomationProperties.AutomationId="ImportNoticeClose"
                            ToolTip="この知らせを閉じます。取り込みは止まりません。" />
                    <Button DockPanel.Dock="Right" Content="取り込み画面を開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Command="{Binding OpenImportFromNoticeCommand}" AutomationProperties.AutomationId="ImportNoticeOpen" />
                    <TextBlock Text="{Binding ImportNoticeText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ImportNoticeText"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding ImportNoticeText}" />
                </DockPanel>
            </Border>

            <!--
                バックアップの書き出し・戻すが、設定の画面を離れている間に終わった知らせ（公開前の点検 2026-10-01）。
                前は捨てた設定の画面に書かれ、どこにも出なかった。取り込みの帯と同じ形で、結果と設定の画面への入口を出す。押すか閉じるまで残す。
                書き出せたときだけ「エクスプローラで開く」も出す（書き出した後にすることは、たいてい zip を別の場所へ移すこと。ユーザ判断 2026-10-01）。
                zip の中ではなく、zip を選んだ状態で開く
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasStoreJobNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="32">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissStoreJobNoticeCommand}" AutomationProperties.Name="バックアップの知らせを閉じる"
                            AutomationProperties.AutomationId="StoreJobNoticeClose"
                            ToolTip="この知らせを閉じます。" />
                    <Button DockPanel.Dock="Right" Content="設定を開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Command="{Binding ShowSettingsCommand}" AutomationProperties.AutomationId="StoreJobNoticeOpen" />
                    <Button DockPanel.Dock="Right" Content="エクスプローラで開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Command="{Binding RevealStoreJobZipCommand}" AutomationProperties.AutomationId="StoreJobNoticeReveal"
                            Visibility="{Binding HasStoreJobNoticeZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                            ToolTip="書き出したzipを選んだ状態で、エクスプローラを開きます。" />
                    <TextBlock Text="{Binding StoreJobNoticeText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="StoreJobNoticeText"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding StoreJobNoticeText}" />
                </DockPanel>
            </Border>

            <!--
                カードの右クリックで非表示にした知らせ（点検 2026-09-23・動線の点検 B2）。戻せる操作なので窓では聞かず、
                戻す場所とその場の解除をここに出す（登録の帯と同じ場所・同じ見た目）。押すか閉じるまで残す
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasHiddenNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="32">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissHiddenCommand}" AutomationProperties.Name="非表示の知らせを閉じる"
                            AutomationProperties.AutomationId="HiddenNoticeClose"
                            ToolTip="この知らせを閉じます。設定の「非表示にした商品」から戻せます。" />
                    <Button DockPanel.Dock="Right" Content="非表示を解除" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Command="{Binding UnhideRecentCommand}" AutomationProperties.AutomationId="HiddenNoticeUndo"
                            ToolTip="今非表示にした商品を、検索とショップにまた表示します。" />
                    <TextBlock Text="{Binding HiddenNoticeText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="HiddenNoticeText"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding HiddenNoticeText}" />
                </DockPanel>
            </Border>

            <!--
                取り込み元・監視フォルダを外した知らせ（ユーザ判断 2026-09-27・動線の洗い出し B4）。
                外すのは確かめずに行うので、外した直後にその場で戻せるようにする（非表示の帯と同じ場所・同じ見た目）
            -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Visibility="{Binding HasFolderRemovedNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel Height="32">
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissFolderRemovedCommand}" AutomationProperties.Name="外した知らせを閉じる"
                            AutomationProperties.AutomationId="FolderRemovedNoticeClose"
                            ToolTip="この知らせを閉じます。" />
                    <Button DockPanel.Dock="Right" Content="{Binding FolderRemovedUndoText}" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                            Command="{Binding UndoFolderRemovalCommand}" AutomationProperties.AutomationId="FolderRemovedNoticeUndo" />
                    <TextBlock Text="{Binding FolderRemovedText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="FolderRemovedNoticeText"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding FolderRemovedText}" />
                </DockPanel>
            </Border>

            <!-- 画面内検索（U20）の帯を今の画面の上に重ねるため、同じ枠に置く -->
            <Grid>
                <!--
                    窓が画面の中身の最小より狭いときは、横に送って届かせる（ユーザ判断 2026-09-23：窓の最小の幅は付けない）。
                    縦は画面ごとに自分で送るので、ここでは送らない。幅が足りていれば中身は前と同じ幅で並ぶ（ViewportFitHost）
                -->
                <ScrollViewer x:Name="ScreenScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True"
                              Focusable="False">
                    <controls:ViewportFitHost>
                        <!-- 画面の入れ物。止まっても何も起きないので Tab で止まらない（点検 2026-10-01：どの画面でもナビの後に名前の無い止まりが1つ入っていた） -->
                        <ContentControl x:Name="ScreenHost" Content="{Binding CurrentViewModel}" Focusable="False" />
                    </controls:ViewportFitHost>
                </ScrollViewer>
                <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,58,24,0" Padding="10,7" CornerRadius="8" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="220" Padding="6,3"
                                 TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown"
                                 AutomationProperties.Name="画面内検索"
                                 ToolTip="画面の中を探します。Enterで次、Shift+Enterで前へ移ります。" />
                        <TextBlock x:Name="FindCount" Style="{StaticResource Caption}" Margin="10,0,8,0" MinWidth="64"
                                   VerticalAlignment="Center" />
                        <Button Content="↑" Style="{StaticResource SmallButton}" Click="OnFindPrevious" ToolTip="前の一致" AutomationProperties.Name="前の一致" />
                        <Button Content="↓" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Click="OnFindNext" ToolTip="次の一致" AutomationProperties.Name="次の一致" />
                        <Button Content="×" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnFindClose" ToolTip="閉じる（Esc）" AutomationProperties.Name="画面内検索を閉じる" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
