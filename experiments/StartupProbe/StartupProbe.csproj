<Project Sdk="Microsoft.NET.Sdk">

  <!--
    起動の速さを外から測る見張り（docs/research/startup-dotnet10-2026-10-01.md）。
    AppPatch の2つはアプリの脇のビルドへ写して使う物で、ここではビルドしない
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StartupProbe</AssemblyName>
    <RootNamespace>StartupProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AppPatch\**" />
  </ItemGroup>

</Project>
