<Project Sdk="Microsoft.NET.Sdk">

  <!--
    zip を落とすと商品URLをクリップボードへ写す CLI。本体は BoothIdResolver（ライブラリ）。
    本体と同じ名前にすると、出力先で BoothIdResolver.dll が2つになり衝突する
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\BoothIdResolver\BoothIdResolver.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BoothIdResolverCli</AssemblyName>
  </PropertyGroup>

</Project>
