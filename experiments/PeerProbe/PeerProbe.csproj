<Project Sdk="Microsoft.NET.Sdk">

  <!--
    部品の UI Automation の木を、アプリを起動せずに書き出す道具（使い方は Program.cs の冒頭）。
    配る物ではない。アプリ（WinExe）を参照して、同じ XAML・同じ部品を見えない窓に載せる。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Chmonos.App\Chmonos.App.csproj" />
  </ItemGroup>

  <!-- 場面のファイル。実行ファイルの横へ写して、どこから呼んでも読めるようにする -->
  <ItemGroup>
    <None Include="probes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
