<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BoothZipInspector\BoothZipInspector.csproj" />
    <ProjectReference Include="..\BoothIdResolver\BoothIdResolver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!--
    同梱の辞書。無改変のまま出力へ配る（加工した辞書を配らないので継承条項に触れない）。
    索引は初回に手元で組んで保存先へ置く。
  -->
  <ItemGroup>
    <None Include="..\assets\JMdict_e.gz" Link="assets\JMdict_e.gz" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\assets\kanjidic2.xml.gz" Link="assets\kanjidic2.xml.gz" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\assets\booth-categories.json" Link="assets\booth-categories.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\assets\README.md" Link="assets\README.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    試験から内側の口を叩く（置き換えの失敗を作る・閉じたままにした門を開ける）。
    どれもアプリの全体に効く静的な状態か、ディスクの失敗を作らないと届かない道で、公開の口にすると画面から呼べてしまう
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="BoothAssetManager.Core.Tests" />
    <!--
      2つのプロセスから BOOTH の門を叩く確かめ（experiments/BoothGateProbe。相手は手元の作り物のサーバ）。
      門を選んで BoothClient を組む口は外に出していない（本物の BOOTH を相手に別の門を渡す作り方を残さないため）ので、ここにだけ見せる
    -->
    <InternalsVisibleTo Include="BoothGateProbe" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
