<UserControl x:Class="BoothAssetManager.App.Controls.SearchSyntaxHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        タグの管理・属性の管理の商品の検索に付ける書き方の案内（ユーザ指示 2026-09-19：検索画面と同じ書き方を使う）。
        検索画面の見本の1行と同じ言葉で、詳しくはホバーで。探す所の前置きは、ここで効く物だけを挙げる
    -->
    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
               ToolTipService.InitialShowDelay="250"
               Text="スペースで両方、-で除く、&quot;&quot;でひとまとまり、OR でどちらか">
        <TextBlock.ToolTip>
            <TextBlock>
                検索画面と同じ書き方で探します。<LineBreak />
                スペースで区切ると、どちらも含むものを探します。<LineBreak />
                -黒 のように書くと、その語を含むものを除きます。<LineBreak />
                &quot;夏セット&quot; と囲むと、その並びのまま含むものだけを探します。<LineBreak />
                夏 OR 冬 はどちらか。衣装 (夏 OR 冬) のように括弧でまとめられます。<LineBreak />
                <LineBreak />
                商品は、商品名・ショップ名・メモを探します。<LineBreak />
                name: 商品名　shop: ショップ名　memo: メモ　のように前に付けると、その項目だけを探します。
            </TextBlock>
        </TextBlock.ToolTip>
    </TextBlock>
</UserControl>
