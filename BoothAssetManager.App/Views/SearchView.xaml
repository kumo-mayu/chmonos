<UserControl x:Class="BoothAssetManager.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 絞り込み -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <TextBlock Text="絞り込み" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="条件をクリア" Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ClearFiltersCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="カテゴリ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                                  SelectedValuePath="Name" SelectedValue="{Binding SelectedCategory}"
                                  Height="32" FontSize="13" />

                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <DockPanel LastChildFill="False">
                            <CheckBox DockPanel.Dock="Left" Content="ファイルを持っているものだけ"
                                      IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                                      FontSize="12.5" Foreground="{StaticResource Text}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OwnedCount}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!--
                            ギフトは所持とは別の軸。貰ったものは手元にあり、贈ったものは手元に無いので、
                            同じ札に入れると読み違える。記録が1件も無ければ行ごと出さない。
                        -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasGiftRecords, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="ギフト" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <DockPanel LastChildFill="False">
                                <CheckBox DockPanel.Dock="Left" Content="贈った" IsChecked="{Binding GivenOnly, Mode=TwoWay}"
                                          FontSize="12.5" Foreground="{StaticResource Text}"
                                          ToolTip="人に贈った商品。払っていますが、ファイルは手元に来ません。" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GivenCount}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,3,0,0">
                                <CheckBox DockPanel.Dock="Left" Content="貰った" IsChecked="{Binding ReceivedOnly, Mode=TwoWay}"
                                          FontSize="12.5" Foreground="{StaticResource Text}"
                                          ToolTip="人から貰った商品。手元にありますが、自分は払っていません。" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReceivedCount}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <!-- appTag：別のトップ同士はORで扱う -->
                        <TextBlock Text="appTag" Style="{StaticResource SectionLabel}" Margin="0,20,0,4" />
                        <TextBlock Text="複数選ぶと「どれかに当てはまるもの」を出します。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasTagFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <!--
                                            件数は「押したら何件になるか」。0件でも消さずに薄く出す
                                            （消えると「さっきあった項目が無い」と探すことになる）。
                                        -->
                                        <DockPanel LastChildFill="False">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <CheckBox DockPanel.Dock="Left" Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      FontSize="12.5" Foreground="{StaticResource Text}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <!-- サブはトップを選んでいる間だけ出す -->
                                        <ItemsControl ItemsSource="{Binding Subs}" Margin="20,5,0,4"
                                                      Visibility="{Binding IsSelected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}"
                                                                   FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="appTagがまだ登録されていません。編集画面から追加できます。" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTagFilters}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            属性：使う軸だけを候補から選んで積む。
                            マスタ全部を常に並べると、評価していない属性の欄まで居座って画面が伸びる。
                        -->
                        <TextBlock Text="属性" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                        <controls:SuggestBox Source="{Binding AttributeSuggestions}" AllowNew="False"
                                             CommitCommand="{Binding AddAttributeFilterCommand}"
                                             Placeholder="属性で絞り込む"
                                             Visibility="{Binding HasAttributeSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="条件に加えた属性は、評価済みのものだけが対象になります。0〜100なら評価済みの全件です。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,4"
                                   Visibility="{Binding HasAttributeFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding AttributeFilters}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <Button Content="外す" Style="{StaticResource SmallButton}"
                                                            Command="{Binding RemoveCommand}" />
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Min, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,5,0,0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Max, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="属性がまだ登録されていません。編集画面から追加できます。"
                                   TextWrapping="Wrap" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAttributeFilters}" Value="False" />
                                                <Condition Binding="{Binding HasAttributeSuggestions}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAlt}" Padding="11,9" Margin="0,4,0,10">
                            <TextBlock Text="対応アバターでの絞り込みは、アバターの管理から「この商品を検索で見る」で入ります。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </Border>

                        <!--
                            たまにしか使わない条件は常設にせず、ここから積む。
                            積んだ種類は次の起動にも残るが、値は残らない
                            （値まで戻すと「なぜか商品が少ない」状態で始まってしまう）。
                        -->
                        <TextBlock Text="条件を追加" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                        <controls:SuggestBox Source="{Binding AvailableExtraFilters}" AllowNew="False"
                                             CommitCommand="{Binding AddExtraFilterCommand}"
                                             Placeholder="条件を追加（公開日・価格・R-18 など）" />

                        <ItemsControl ItemsSource="{Binding ExtraFilters}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExtraFilter}">
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" ToolTip="{Binding Hint}" />
                                                <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource SmallButton}"
                                                        Command="{Binding RemoveCommand}" />
                                            </DockPanel>

                                            <!-- 範囲：下限だけ・上限だけでもよい -->
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                        Visibility="{Binding IsRange, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         Width="92" Height="26" FontSize="12" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                                <TextBlock Text="〜" VerticalAlignment="Center" Margin="6,0"
                                                           Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         Width="92" Height="26" FontSize="12" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                            </StackPanel>

                                            <CheckBox Content="この条件で絞る" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                      FontSize="12" Margin="0,7,0,0" Foreground="{StaticResource Text}"
                                                      Visibility="{Binding IsCheck, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                            <ItemsControl ItemsSource="{Binding Selected}" Margin="0,7,0,0"
                                                          Visibility="{Binding IsSuggest, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                                BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#28507f" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 結果 -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="78" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <StackPanel Margin="18,9,18,0">
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                            Height="34" HorizontalAlignment="Stretch" Background="White">
                        <Grid>
                            <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                     FontSize="13" Background="Transparent" />
                            <TextBlock Text="商品名・ショップ・メモ・タグから探す" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextFaint}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueryText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!--
                        書き方の見本と、探す範囲を広げるトグル。
                        2つのトグルはどちらも「既定より広げる」という同じ性質なので1行に並べる。
                    -->
                    <Grid Margin="2,5,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="衣装 -無料 &quot;夏セット&quot;" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="衣装 (夏 OR 冬)" />
                            <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" Foreground="{StaticResource TextFaint}"
                                       Text="スペースで両方、-で除く、&quot;&quot;でひとまとまり">
                                <TextBlock.ToolTip>
                                    <TextBlock>
                                        スペースで区切ると、どちらも含むものを探します。<LineBreak />
                                        -無料 のように書くと、その語を含むものを除きます。<LineBreak />
                                        &quot;夏セット&quot; と囲むと、その並びのまま含むものだけを探します。<LineBreak />
                                        <LineBreak />
                                        括弧が無いと 衣装 夏 OR 冬 は「衣装かつ夏」または「冬」と読まれます。<LineBreak />
                                        衣装 (夏 OR 冬) と書けば「衣装かつ、夏か冬」になります。
                                    </TextBlock>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="本文も探す" IsChecked="{Binding SearchBody, Mode=TwoWay}" FontSize="11"
                                      VerticalAlignment="Center"
                                      ToolTip="説明文とセクションの本文も対象にします。当たる件数が増えます。" />
                            <CheckBox Content="ファイルのパスも探す" IsChecked="{Binding SearchPaths, Mode=TwoWay}" FontSize="11"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      ToolTip="自分でリネームしたファイルは商品名と一致しないので、そのときに使います。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource Bg}">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,240,0">
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="読み込み中…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!-- なぜこの結果になったかを結果の隣で読めるようにする -->
                        <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasActiveFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <!-- 表示順は絞り込みと別の場所に置く -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="180" Height="28" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                選択中だけ出る操作バー。下端に重ねて出す。
                上に差し込むと結果の位置がずれて、選んでいる最中に操作が途切れる。
            -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource AccentBorder}" BorderThickness="0,1,0,0" Padding="18,10"
                    Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <TextBlock Text="{Binding SelectionText}" FontWeight="Bold" FontSize="12.5"
                               Foreground="#28507f" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="表示中を全て選択" Style="{StaticResource SmallButton}"
                                Command="{Binding SelectAllCommand}" />
                        <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                Command="{Binding ClearSelectionCommand}" />
                        <Button Content="まとめて編集する" Style="{StaticResource PrimaryButton}" Height="27" Margin="10,0,0,0"
                                Command="{Binding SendSelectionToEditCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid SizeChanged="OnResultsSizeChanged">
                <!--
                    行を仮想化の単位にする。WPFには仮想化するWrapPanelが無いので、
                    列数をViewModel側で決めて結果を行に切り、その行をListBoxに並べている。
                    画面外の行のカードは実体化されないので、サムネイルの復号も走らない。
                -->
                <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                         Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 高さを揃えて、行の下端が不揃いにならないようにする -->
                                <!--
                                    Tag に検索画面を入れておく。ContextMenu は視覚ツリーの外に出るので、
                                    PlacementTarget 経由でないと画面側のコマンドに届かない。
                                -->
                                <Border Style="{StaticResource Card}" Width="228" Height="336" Margin="0,0,14,14"
                                        Cursor="Hand" MouseLeftButtonUp="OnCardClick" MouseDown="OnCardMouseDown"
                                        ClipToBounds="True"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="BOOTHで開く" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.OpenBoothCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="ショップを開く" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.OpenShopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="編集に入る" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.EditItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="エクスプローラで開く" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <!-- 設定画面から戻せるので、確認は挟まない -->
                                            <MenuItem Header="非表示にする" CommandParameter="{Binding}"
                                                      Command="{Binding PlacementTarget.Tag.HideItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <!--
                                            マウスの横位置でギャラリー画像を切り替える（BOOTHのサイトと同じ操作感）。
                                            正方形の画像が多いので、枠は正方形寄りにして Uniform で全体を見せる（切り取らない）。
                                        -->
                                        <Grid DockPanel.Dock="Top" Height="200" Background="#e9edf4" Cursor="Hand"
                                              MouseMove="OnThumbnailMouseMove" MouseLeave="OnThumbnailMouseLeave">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />

                                            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom"
                                                          Margin="6,0,6,5" IsHitTestVisible="False"
                                                          Visibility="{Binding HasMultipleImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="3" CornerRadius="2" Margin="1,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#66ffffff" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#f2ffffff" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 区切りを絞っている場合でも、全体で何枚あるかが分かるようにする -->
                                            <Border Background="#99000000" CornerRadius="9" Padding="7,1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                    Visibility="{Binding IsHovering, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CounterText}" FontSize="10" Foreground="White" />
                                            </Border>

                                            <!--
                                                まとめて編集へ送るための選択。
                                                マウスが乗っているか、既に選んでいるときだけ出す。
                                            -->
                                            <Border Background="#d6ffffff" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="5" Padding="7"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                                <!-- カード全体でも切り替わるが、状態を示す印としても要る -->
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHovering}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <!-- 選択中は全カードに出して、今どの操作をしているのかを示す -->
                                                            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 選択中のとき、商品ページへの出口をここに置く -->
                                            <Border Background="#d6ffffff" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="5" Padding="8,4" Cursor="Hand"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"
                                                    MouseLeftButtonUp="OnOpenItemClick">
                                                <TextBlock Text="中を見る" FontSize="11" Foreground="{StaticResource Accent}" />
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelectionMode}" Value="True" />
                                                                    <Condition Binding="{Binding IsHovering}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                        </Grid>
                                        <!--
                                            下段は必ず下端に置く。カードの高さを固定しているので位置が揃う。
                                            状態はここに集める。サムネイルに重ねると写真によっては読めない。
                                        -->
                                        <Border DockPanel.Dock="Bottom" BorderBrush="#f0f1f4" BorderThickness="0,1,0,0"
                                                Margin="11,0,11,11" Padding="0,6,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Background="{StaticResource BadSoft}" BorderBrush="{StaticResource BadBorder}"
                                                            BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="4,0,0,0"
                                                            ToolTip="記録にあるファイルが、今その場所にありません"
                                                            Visibility="{Binding HasMissingFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="見つからない" FontSize="10" Foreground="{StaticResource Bad}" />
                                                    </Border>
                                                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                            BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="4,0,0,0"
                                                            ToolTip="まだ分類していません"
                                                            Visibility="{Binding NeedsEdit, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="未編集" FontSize="10" Foreground="{StaticResource Warn}" />
                                                    </Border>
                                                    <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                            BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="4,0,0,0"
                                                            Visibility="{Binding IsOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="所持" FontSize="10" Foreground="{StaticResource Good}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="11,10,11,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShopName}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                        BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4"
                                                        Visibility="{Binding HasAppTag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <!-- appTagが長くても2行に折り返さないよう、幅で切る -->
                                                    <TextBlock Text="{Binding AppTagText}" FontSize="10" Foreground="#28507f"
                                                               MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="該当するものがありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="「取り込み」からフォルダを読み込んでください" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
