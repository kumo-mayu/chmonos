<UserControl x:Class="BoothAssetManager.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 絞り込み -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <TextBlock Text="絞り込み" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="条件をクリア" Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ClearFiltersCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="カテゴリ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  Height="32" FontSize="13" />

                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <CheckBox Content="ファイルを持っているものだけ" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                                  FontSize="12.5" Foreground="{StaticResource Text}" />

                        <!-- appTag：別のトップ同士はORで扱う -->
                        <TextBlock Text="appTag" Style="{StaticResource SectionLabel}" Margin="0,20,0,4" />
                        <TextBlock Text="複数選ぶと「どれかに当てはまるもの」を出します。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasTagFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  FontSize="12.5" Foreground="{StaticResource Text}" />
                                        <!-- サブはトップを選んでいる間だけ出す -->
                                        <ItemsControl ItemsSource="{Binding Subs}" Margin="20,5,0,4"
                                                      Visibility="{Binding IsSelected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              FontSize="11.5" Margin="0,0,10,4"
                                                              Foreground="{StaticResource TextMuted}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="appTagがまだ登録されていません。編集画面から追加できます。" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTagFilters}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            属性：使う軸だけを候補から選んで積む。
                            マスタ全部を常に並べると、評価していない属性の欄まで居座って画面が伸びる。
                        -->
                        <TextBlock Text="属性" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                        <controls:SuggestBox Source="{Binding AttributeSuggestions}" AllowNew="False"
                                             CommitCommand="{Binding AddAttributeFilterCommand}"
                                             Placeholder="属性で絞り込む"
                                             Visibility="{Binding HasAttributeSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="条件に加えた属性は、評価済みのものだけが対象になります。0〜100なら評価済みの全件です。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,4"
                                   Visibility="{Binding HasAttributeFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding AttributeFilters}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <Button Content="外す" Style="{StaticResource SmallButton}"
                                                            Command="{Binding RemoveCommand}" />
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Min, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,5,0,0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Max, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="属性がまだ登録されていません。編集画面から追加できます。"
                                   TextWrapping="Wrap" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAttributeFilters}" Value="False" />
                                                <Condition Binding="{Binding HasAttributeSuggestions}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAlt}" Padding="11,9" Margin="0,4,0,10">
                            <TextBlock Text="対応アバターでの絞り込みは未実装です（アバターの検出がまだ動いていません）。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 結果 -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                            Height="34" HorizontalAlignment="Stretch" Margin="0,0,0,0" Background="White">
                        <Grid>
                            <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                     FontSize="13" Background="Transparent" />
                            <TextBlock Text="商品名・ショップ・メモ・説明文から探す" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextFaint}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueryText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource Bg}">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,240,0">
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="読み込み中…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!-- なぜこの結果になったかを結果の隣で読めるようにする -->
                        <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasActiveFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <!-- 表示順は絞り込みと別の場所に置く -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="180" Height="28" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 選択中だけ出る操作バー。複数まとめて編集へ送るための導線 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource AccentBorder}" BorderThickness="0,1,0,1" Padding="18,9"
                    Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <TextBlock Text="{Binding SelectionText}" FontWeight="Bold" FontSize="12.5"
                               Foreground="#28507f" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="表示中を全て選択" Style="{StaticResource SmallButton}"
                                Command="{Binding SelectAllCommand}" />
                        <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                Command="{Binding ClearSelectionCommand}" />
                        <Button Content="まとめて編集する" Style="{StaticResource PrimaryButton}" Height="27" Margin="10,0,0,0"
                                Command="{Binding SendSelectionToEditCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid SizeChanged="OnResultsSizeChanged">
                <!--
                    行を仮想化の単位にする。WPFには仮想化するWrapPanelが無いので、
                    列数をViewModel側で決めて結果を行に切り、その行をListBoxに並べている。
                    画面外の行のカードは実体化されないので、サムネイルの復号も走らない。
                -->
                <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                         Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 高さを揃えて、行の下端が不揃いにならないようにする -->
                                <Border Style="{StaticResource Card}" Width="228" Height="336" Margin="0,0,14,14"
                                        Cursor="Hand" MouseLeftButtonUp="OnCardClick" ClipToBounds="True">
                                    <DockPanel>
                                        <!--
                                            マウスの横位置でギャラリー画像を切り替える（BOOTHのサイトと同じ操作感）。
                                            正方形の画像が多いので、枠は正方形寄りにして Uniform で全体を見せる（切り取らない）。
                                        -->
                                        <Grid DockPanel.Dock="Top" Height="200" Background="#e9edf4" Cursor="Hand"
                                              MouseMove="OnThumbnailMouseMove" MouseLeave="OnThumbnailMouseLeave">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />

                                            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom"
                                                          Margin="6,0,6,5" IsHitTestVisible="False"
                                                          Visibility="{Binding HasMultipleImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="3" CornerRadius="2" Margin="1,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#66ffffff" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="#f2ffffff" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 区切りを絞っている場合でも、全体で何枚あるかが分かるようにする -->
                                            <Border Background="#99000000" CornerRadius="9" Padding="7,1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                                    Visibility="{Binding IsHovering, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CounterText}" FontSize="10" Foreground="White" />
                                            </Border>

                                            <!--
                                                まとめて編集へ送るための選択。
                                                マウスが乗っているか、既に選んでいるときだけ出す。
                                            -->
                                            <Border Background="#d6ffffff" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="5" Padding="7"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                                                <!-- 小さいと押し損ねて商品ページへ飛んでしまうので、当たり判定を広げる -->
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <CheckBox.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                                    </CheckBox.LayoutTransform>
                                                </CheckBox>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHovering}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                    Visibility="{Binding IsOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="所持" FontSize="10" Foreground="{StaticResource Good}" />
                                            </Border>
                                        </Grid>
                                        <!-- 容量は必ず下端に置く。カードの高さを固定しているので位置が揃う -->
                                        <Border DockPanel.Dock="Bottom" BorderBrush="#f0f1f4" BorderThickness="0,1,0,0"
                                                Margin="11,0,11,11" Padding="0,6,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11" />
                                        </Border>

                                        <StackPanel Margin="11,10,11,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShopName}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                        BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4"
                                                        Visibility="{Binding NeedsEdit, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="未編集" FontSize="10" Foreground="{StaticResource Warn}" />
                                                </Border>
                                                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                        BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4"
                                                        Visibility="{Binding HasAppTag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <!-- appTagが長くても2行に折り返さないよう、幅で切る -->
                                                    <TextBlock Text="{Binding AppTagText}" FontSize="10" Foreground="#28507f"
                                                               MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="該当するものがありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="「取り込み」からフォルダを読み込んでください" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
