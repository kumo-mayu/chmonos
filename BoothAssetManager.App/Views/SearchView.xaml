<UserControl x:Class="BoothAssetManager.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 商品のカード（フォルダビューの右側と共通。Views/ItemCardResources.xaml） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
        </ResourceDictionary.MergedDictionaries>
        <!--
            畳む・開くの小さなボタン。既定のボタンの見た目（枠と余白）だと
            「絞り込み」の見出しより目立ってしまうので、山形だけを置く。
        -->
        <!--
            履歴のスロット。枠は外側の Border が持つので、中身は素のまま出す。
            **テンプレートごと置き換える。**暗黙の Button スタイルは枠線と余白を
            持っていて setter では外せない（他の画面で同じ罠を踏んでいる）。
        -->
        <Style x:Key="HistorySlotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{TemplateBinding Content}" Fill="{x:Null}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{StaticResource TextMuted}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilterPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding FilterPane.MinWidth}" MaxWidth="{Binding FilterPane.MaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 絞り込み欄の幅を変える境目（ユーザ判断 2026-09-14）。畳んでいる間は出さない。開け閉めのつまみ（ZIndex 1）より下に置く -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="0"
                               ResetCommand="{Binding FilterPane.ResetCommand}"
                               Visibility="{Binding FilterPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            絞り込みを畳む／開くつまみ。パネルと結果の境の線に半分はみ出させて置く（U3・ユーザ判断）。
            見出しの行で「条件をクリア」の右隣にあった頃は押し間違えやすかった。
            開いても畳んでも同じ高さに残るので、開け閉めでつまみの場所が変わらない
        -->
        <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,-13,0"
                Width="26" Height="26" CornerRadius="13" Panel.ZIndex="1"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
            <Button Command="{Binding ToggleFilterPanelCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelToggle}">
                        <Setter Property="Content" Value="{StaticResource IconCollapse}" />
                        <Setter Property="ToolTip" Value="絞り込みを畳む" />
                        <Setter Property="AutomationProperties.Name" Value="絞り込みを畳む" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterPanelCollapsed}" Value="True">
                                <Setter Property="Content" Value="{StaticResource IconExpand}" />
                                <Setter Property="ToolTip" Value="絞り込みを開く" />
                                <Setter Property="AutomationProperties.Name" Value="絞り込みを開く" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

        <!-- 絞り込み -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
          <Grid>
            <!--
                畳んだ姿。条件は外れていないので、効いている数を出しておく。
                数が見えていないと「なぜか商品が少ない」の原因を探す場所が無くなる。
                開くつまみは境の線の上（上の Border）にあるので、その下から並べる
            -->
            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" CornerRadius="8" Padding="5,1"
                        Margin="0,48,0,0" HorizontalAlignment="Center" ToolTip="{Binding FilterSummary}"
                        Visibility="{Binding ActiveFilterCount, Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                    <TextBlock Text="{Binding ActiveFilterCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="絞り込み" Style="{StaticResource Caption}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </DockPanel>

            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <!-- 右の余白は、境の線に半分はみ出したつまみ（13px）から「条件をクリア」をはっきり離すため -->
                    <Grid Margin="16,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="絞り込み" FontWeight="Bold" VerticalAlignment="Center" />
                        <!-- 押す前の条件は検索の履歴に積むので、押し間違えても履歴から戻せる（U3・ユーザ判断） -->
                        <TextBlock Grid.Column="1" Text="条件をクリア" Foreground="{StaticResource Accent}" FontSize="12"
                                   VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ClearFiltersCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="カテゴリ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                                  SelectedValuePath="Name" SelectedValue="{Binding SelectedCategory}"
                                  Height="32" FontSize="13" />

                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <DockPanel LastChildFill="False">
                            <CheckBox DockPanel.Dock="Left" Content="ファイルを持っているものだけ"
                                      IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                                      FontSize="12.5" Foreground="{StaticResource Text}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OwnedCount}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <!--
                            ギフトは所持とは別の軸。貰ったものは手元にあり、贈ったものは手元に無いので、
                            同じ札に入れると読み違える。記録が1件も無ければ行ごと出さない。
                        -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasGiftRecords, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="ギフト" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <DockPanel LastChildFill="False">
                                <CheckBox DockPanel.Dock="Left" Content="贈った" IsChecked="{Binding GivenOnly, Mode=TwoWay}"
                                          FontSize="12.5" Foreground="{StaticResource Text}"
                                          ToolTip="人に贈った商品。払っていますが、ファイルは手元に来ません。" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GivenCount}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,3,0,0">
                                <CheckBox DockPanel.Dock="Left" Content="貰った" IsChecked="{Binding ReceivedOnly, Mode=TwoWay}"
                                          FontSize="12.5" Foreground="{StaticResource Text}"
                                          ToolTip="人から貰った商品。手元にありますが、自分は払っていません。" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReceivedCount}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <!-- userTag：別のトップ同士はORで扱う -->
                        <TextBlock Text="ユーザータグ" Style="{StaticResource SectionLabel}" Margin="0,20,0,4" />
                        <TextBlock Text="複数選ぶと「どれかに当てはまるもの」を出します。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasTagFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <!--
                                            件数は「押したら何件になるか」。0件でも消さずに薄く出す
                                            （消えると「さっきあった項目が無い」と探すことになる）。
                                        -->
                                        <DockPanel LastChildFill="False">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <!-- 名前は TextBlock で入れる（Content 直渡しだとアンダースコアが食われる） -->
                                            <CheckBox DockPanel.Dock="Left"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Name}">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           Foreground="{StaticResource Text}" />
                                            </CheckBox>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <!-- サブはトップを選んでいる間だけ出す -->
                                        <ItemsControl ItemsSource="{Binding Subs}" Margin="20,5,0,4"
                                                      Visibility="{Binding IsSelected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding Name}">
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}"
                                                                   FontSize="10.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ユーザータグがまだ登録されていません。編集画面から追加できます。" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTagFilters}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            BOOTHタグ：候補を並べずに入力欄から積む。
                            実データで15商品に対しタグは138種、うち80%が1商品にしか付いていない。
                            上位は VRChat・3Dモデル のような汎用語が独占するので、
                            「よく使う順」に並べても絞り込みの役に立たない。
                        -->
                        <TextBlock Text="BOOTHタグ" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                        <controls:SuggestBox Source="{Binding BoothTagSuggestions}" AllowNew="False"
                                             CommitCommand="{Binding AddBoothTagFilterCommand}"
                                             Placeholder="BOOTHタグで絞り込む"
                                             Visibility="{Binding HasBoothTagSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!--
                            見出しだけ出して黙らない。ユーザータグ・属性・対応アバターには
                            同じ場面の文があるのに、ここだけ空白だった。
                            BOOTHタグは人が付けるものではないので、次にやることは取り込み
                        -->
                        <TextBlock Text="BOOTHタグがまだありません。商品を取り込むと付いてきます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasBoothTagSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding BoothTagFilters}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,6" Margin="0,0,0,5">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,50,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}"
                                                           FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Content="外す" Style="{StaticResource SmallButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            属性：使う軸だけを候補から選んで積む。
                            マスタ全部を常に並べると、評価していない属性の欄まで居座って画面が伸びる。
                        -->
                        <TextBlock Text="属性" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
                        <controls:SuggestBox Source="{Binding AttributeSuggestions}" AllowNew="False"
                                             CommitCommand="{Binding AddAttributeFilterCommand}"
                                             Placeholder="属性で絞り込む"
                                             Visibility="{Binding HasAttributeSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="条件に加えた属性は、評価済みのものだけが対象になります。0〜100なら評価済みの全件です。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,4"
                                   Visibility="{Binding HasAttributeFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding AttributeFilters}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <Button Content="外す" Style="{StaticResource SmallButton}"
                                                            Command="{Binding RemoveCommand}" />
                                                </StackPanel>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Min, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,5,0,0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Max, Mode=TwoWay}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="属性がまだ登録されていません。編集画面から追加できます。"
                                   TextWrapping="Wrap" Margin="0,0,0,20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAttributeFilters}" Value="False" />
                                                <Condition Binding="{Binding HasAttributeSuggestions}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--
                            対応アバターは名前でもIDでも引ける。候補の1行に両方入れてあるため。
                            VRChatでは対応商品を探すのに商品IDを使う習慣があり、
                            名前を思い出せなくてもIDなら分かる場面がある。
                        -->
                        <TextBlock Text="対応アバター" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <controls:SuggestBox Source="{Binding AvatarSuggestions}" AllowNew="False"
                                             CommitCommand="{Binding SetAvatarFilterCommand}"
                                             IconSelector="{Binding AvatarIconSelector}"
                                             AutomationProperties.Name="対応アバターで絞り込む"
                                             Placeholder="アバター名か商品IDで絞り込む"
                                             Visibility="{Binding HasAvatarSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <StackPanel Margin="0,7,0,0"
                                    Visibility="{Binding HasAvatarFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding AvatarFilterName}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource SmallButton}"
                                                Command="{Binding ClearAvatarFilterCommand}" />
                                    </DockPanel>
                                    <!--
                                        素体経由は推定なので、含めるかを選べるようにする。
                                        出すのは素体に属しているアバターのときだけ。
                                        属していなければ経由する先が無く、どちらに倒しても結果が変わらない。
                                    -->
                                    <CheckBox Content="素体経由の対応も含める" IsChecked="{Binding IncludeViaBase, Mode=TwoWay}"
                                              FontSize="12" Margin="0,7,0,0" Foreground="{StaticResource Text}"
                                              Visibility="{Binding AvatarFilterHasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--
                            ショップで絞っているとき。入口はショップ画面の「検索でこのショップの商品を絞る」だけなので、
                            絞っている間だけ出す。出さないと、何で絞られているのかが見えなくなる
                        -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasShopFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="ショップ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ShopFilterName}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource SmallButton}"
                                            Command="{Binding ClearShopFilterCommand}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="アバターがまだ見つかっていません。アバターの管理から検出できます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasAvatarSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <!--
                            たまにしか使わない条件は常設にせず、ここから積む。
                            積んだ種類は次の起動にも残るが、値は残らない
                            （値まで戻すと「なぜか商品が少ない」状態で始まってしまう）。
                        -->
                        <!-- 押しても何も起きなかったように見えないよう、結果を出す -->
                        <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                Visibility="{Binding HasImportFolderNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding ImportFolderNotice}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource Good}" />
                        </Border>

                        <TextBlock Text="条件を追加" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                        <controls:SuggestBox Source="{Binding AvailableExtraFilters}" AllowNew="False"
                                             CommitCommand="{Binding AddExtraFilterCommand}"
                                             AutomationProperties.Name="条件を追加"
                                             Placeholder="条件を追加（公開日・価格・R-18 など）" />

                        <ItemsControl ItemsSource="{Binding ExtraFilters}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExtraFilter}">
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" ToolTip="{Binding Hint}" />
                                                <Button DockPanel.Dock="Right" Content="外す" Style="{StaticResource SmallButton}"
                                                        Command="{Binding RemoveCommand}" />
                                            </DockPanel>

                                            <!-- 範囲：下限だけ・上限だけでもよい -->
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                        Visibility="{Binding IsRange, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         Width="92" Height="26" FontSize="12" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                                <TextBlock Text="〜" VerticalAlignment="Center" Margin="6,0"
                                                           Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         Width="92" Height="26" FontSize="12" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                            </StackPanel>

                                            <!--
                                                日数を1つ。上下限にしないのは、聞きたいことが
                                                「何日以内か」の片側しかないから。
                                                「30〜」と出る欄に30を入れさせると、
                                                どちら側の意味か読めない
                                            -->
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                                        Visibility="{Binding IsDays, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         Width="64" Height="26" FontSize="12" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                                <TextBlock Text="日以内" VerticalAlignment="Center" Margin="7,0,0,0"
                                                           Style="{StaticResource Caption}" />
                                            </StackPanel>

                                            <CheckBox Content="この条件で絞る" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                      FontSize="12" Margin="0,7,0,0" Foreground="{StaticResource Text}"
                                                      Visibility="{Binding IsCheck, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                            <!--
                                                候補から積む条件

                                                **入力欄が無いと、条件を積んでも何も選べない。**
                                                チップだけを出していた間、この形の条件は
                                                常に「全部通る」ままだった
                                            -->
                                            <StackPanel Margin="0,7,0,0"
                                                        Visibility="{Binding IsSuggest, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                                     CommitCommand="{Binding AddSelectedCommand}"
                                                                     Placeholder="{Binding SuggestPlaceholder}"
                                                                     Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                                <TextBlock Text="{Binding SuggestEmptyText}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                                                <ItemsControl ItemsSource="{Binding Selected}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                                    BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#28507f"
                                                                               VerticalAlignment="Center" />
                                                                    <!--
                                                                        積んだものを外せないと、条件を作り直すしかなくなる。
                                                                        形は呼ばれ方の履歴のチップに揃える
                                                                        （幅を決め打つと暗黙のButtonスタイルの枠が丸く出る）
                                                                    -->
                                                                    <Button Content="×" FontSize="11" Margin="6,0,0,0" Padding="2,0"
                                                                            Cursor="Hand"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            Foreground="#28507f" ToolTip="この条件から外す"
                                                                            Command="{Binding DataContext.RemoveSelectedCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!--
                                                フォルダは1階層ずつ降りる。インデント付きの木にしないのは、
                                                286pxで長い名前にインデントを足すと横スクロールが避けられないため。
                                                チェックで選び、シェブロンで降りる（選択と移動は別の操作）。
                                            -->
                                            <StackPanel Margin="0,7,0,0"
                                                        Visibility="{Binding IsDrill, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl ItemsSource="{Binding Crumbs}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FolderCrumb}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="{Binding Label}" Command="{Binding GoCommand}"
                                                                        Background="Transparent" BorderThickness="0" Padding="0"
                                                                        Height="18" FontSize="11" Cursor="Hand"
                                                                        Foreground="{StaticResource Accent}" />
                                                                <TextBlock Text=" ＞ " FontSize="10" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextFaint}"
                                                                           Visibility="{Binding IsLast, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FolderRow}">
                                                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                                                <DockPanel.Style>
                                                                    <Style TargetType="DockPanel">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                <Setter Property="Opacity" Value="0.45" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </DockPanel.Style>
                                                                <!--
                                                                    名前は TextBlock で入れる。Content に直接文字列を渡すと
                                                                    WPFがアンダースコアをアクセスキーの印として食べてしまい、
                                                                    VRChat_model が VRChatmodel と表示される。
                                                                    フォルダ名にアンダースコアは普通に入っている。
                                                                -->
                                                                <CheckBox DockPanel.Dock="Left"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          FontSize="12" Foreground="{StaticResource Text}"
                                                                          ToolTip="{Binding Path}"
                                                                          AutomationProperties.Name="{Binding Name}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                                   Foreground="{StaticResource Text}" />
                                                                        <!-- 外付けのドライブ文字が変わって読み替えた物（ユーザ指示：読み替えた結果だと分かるように） -->
                                                                        <TextBlock Text="{Binding RemapText}" FontSize="10.5"
                                                                                   Foreground="{StaticResource TextMuted}" ToolTip="{Binding RemapTip}"
                                                                                   Visibility="{Binding IsRemapped, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    </StackPanel>
                                                                    <CheckBox.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="エクスプローラで開く" Command="{Binding OpenCommand}" />
                                                                            <MenuItem Header="取り込み元に足す" Command="{Binding AddToImportCommand}"
                                                                                      Visibility="{Binding CanAddToImport, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                        </ContextMenu>
                                                                    </CheckBox.ContextMenu>
                                                                </CheckBox>
                                                                <!-- 降りられないフォルダにはシェブロンを出さない -->
                                                                <Button DockPanel.Dock="Right" Content="＞" Command="{Binding DescendCommand}"
                                                                        Background="Transparent" BorderThickness="0" Padding="4,0"
                                                                        Height="20" FontSize="11" Cursor="Hand"
                                                                        Foreground="{StaticResource TextMuted}"
                                                                        Visibility="{Binding CanDescend, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                                           Margin="6,0,0,0" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <!-- 結果 -->
        <DockPanel Grid.Column="1">
            <!--
                検索の履歴

                **一番上に横のスロットで出す**（ユーザ指示）。絞り込みパネルは
                既に手狭で、足したい条件も控えているので幅を食わせない。

                横に溢れるので `ScrollViewer` に入れる。件数の上限は設定にある——
                増やすほど端まで送る手間が増えるので、好みで決められるようにした。

                入っているものが無いときは出さない。初回起動で空の帯が居座ると、
                何のための場所か分からない
            -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    Padding="18,7"
                    Visibility="{Binding HasHistory, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchHistorySlot}">
                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 押すとその条件に戻る -->
                                        <Button Style="{StaticResource HistorySlotButton}"
                                                Command="{Binding ApplyCommand}"
                                                ToolTip="{Binding Summary}">
                                            <StackPanel Orientation="Horizontal" Margin="10,4">
                                                <!-- 名前を付けたものは件数で落とさないので、印で区別する -->
                                                <TextBlock Text="★" FontSize="10" Margin="0,0,5,0"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNamed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- 要らない条件は個別に消せる。全部消すのは設定から -->
                                        <Button Style="{StaticResource HistorySlotButton}" Content="✕"
                                                FontSize="10" Padding="6,4" Command="{Binding RemoveCommand}"
                                                Foreground="{StaticResource TextMuted}"
                                                ToolTip="この履歴を消します。検索の条件は変わりません。" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border DockPanel.Dock="Top" Height="78" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <StackPanel Margin="18,9,18,0">
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                            Height="34" HorizontalAlignment="Stretch" Background="White">
                        <Grid>
                            <TextBox x:Name="QueryBox" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"
                                     FontSize="13" Background="Transparent" />
                            <TextBlock Text="商品名・ショップ・メモ・タグから探す" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextFaint}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueryText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!--
                        書き方の見本と、探す範囲を広げるトグル。
                        2つのトグルはどちらも「既定より広げる」という同じ性質なので1行に並べる。
                    -->
                    <!--
                        **列に分けてある。**1つのセルに左寄せと右寄せを重ねると、
                        窓を狭めたときに文字が重なって読めなくなる（1100pxで実測）。
                        見本は削れてよいので `*` 側に置き、はみ出した分は切る。
                        トグルは操作なので `Auto` で必ず残す
                    -->
                    <Grid Margin="2,5,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="衣装 -無料 &quot;夏セット&quot;" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="衣装 (夏 OR 冬)" />
                            <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" Foreground="{StaticResource TextFaint}"
                                       Text="スペースで両方、-で除く、&quot;&quot;でひとまとまり">
                                <TextBlock.ToolTip>
                                    <TextBlock>
                                        スペースで区切ると、どちらも含むものを探します。<LineBreak />
                                        -無料 のように書くと、その語を含むものを除きます。<LineBreak />
                                        &quot;夏セット&quot; と囲むと、その並びのまま含むものだけを探します。<LineBreak />
                                        <LineBreak />
                                        括弧が無いと 衣装 夏 OR 冬 は「衣装かつ夏」または「冬」と読まれます。<LineBreak />
                                        衣装 (夏 OR 冬) と書けば「衣装かつ、夏か冬」になります。
                                    </TextBlock>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="10,0,0,0">
                            <CheckBox Content="本文も探す" IsChecked="{Binding SearchBody, Mode=TwoWay}" FontSize="11"
                                      VerticalAlignment="Center"
                                      ToolTip="説明文とセクションの本文も対象にします。当たる件数が増えます。" />
                            <CheckBox Content="ファイルのパスも探す" IsChecked="{Binding SearchPaths, Mode=TwoWay}" FontSize="11"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      ToolTip="自分でリネームしたファイルは商品名と一致しないので、そのときに使います。" />
                            <!--
                                0件のときは切っていても自動で広げる。ここを入にすると、
                                当たっているときも一緒に広げる。
                            -->
                            <CheckBox Content="別の表記も探す" IsChecked="{Binding SearchAlternates, Mode=TwoWay}" FontSize="11"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      ToolTip="tori で「鳥」、shark で「サメ」のように、読みや英語からも探します。&#10;0件のときは、ここを切っていても自動で探します。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="38" Background="{StaticResource Bg}">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,240,0">
                        <TextBlock Text="{Binding ResultSummary}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="読み込み中…" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!-- なぜこの結果になったかを結果の隣で読めるようにする -->
                        <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasActiveFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!--
                            表記をまたいで探したときは、何で当たったかを必ず出す。
                            辞書は引いた結果を説明できるのが取り柄なので、説明を捨てない。
                        -->
                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasWidened, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding WidenedText}" FontSize="11" Foreground="#28507f"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </Border>
                    </StackPanel>

                    <!-- 表示順は絞り込みと別の場所に置く -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="180" Height="28" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                選択中だけ出る操作バー。下端に重ねて出す。
                上に差し込むと結果の位置がずれて、選んでいる最中に操作が途切れる。
            -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource AccentBorder}" BorderThickness="0,1,0,0" Padding="18,10"
                    Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionText}" FontWeight="Bold" FontSize="12.5"
                                   Foreground="#28507f" VerticalAlignment="Center" />
                        <!-- Unityへ順に送っている最中の進み具合（#69）。取り込み画面は Unity 側に出る -->
                        <TextBlock Text="{Binding UnityQueueText}" FontSize="12" Margin="14,0,0,0"
                                   Foreground="#28507f" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   Visibility="{Binding HasUnityQueueText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="表示中を全て選択" Style="{StaticResource SmallButton}"
                                Command="{Binding SelectAllCommand}" />
                        <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                Command="{Binding ClearSelectionCommand}" />
                        <!-- まとめて入れる先（#44）。どれも選んだ物だけに効く -->
                        <Button Content="お気に入りに入れる" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                Command="{Binding AddSelectionToFavoritesCommand}"
                                ToolTip="選んだ商品に星を付けます。付いている物はそのままです。" />
                        <Button Content="改変に足す…" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                Command="{Binding AddSelectionToModificationCommand}"
                                ToolTip="どの改変に足すかを選んでから、選んだ商品をまとめて足します。" />
                        <Button Content="Unityへ順に送る…" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                Command="{Binding SendSelectionToUnityCommand}"
                                ToolTip="選んだ商品の unitypackage を、開いているUnityへ1件ずつ送ります。取り込み画面を閉じると次の1件が出ます。" />
                        <Button Content="まとめて編集する" Style="{StaticResource PrimaryButton}" Height="27" Margin="10,0,0,0"
                                Command="{Binding SendSelectionToEditCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                取り込み中に増えたぶんは、押されるまで一覧へ入れない。
                読んでいる最中に足元が動くと、どこを見ていたか分からなくなる。
                件数とバッジは即座に動くので、増えたこと自体は隠していない。
            -->
            <Button DockPanel.Dock="Top" Margin="18,0,18,4" FontSize="12"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding Main.ApplyPendingCommand}"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <Grid SizeChanged="OnResultsSizeChanged">
                <!--
                    行を仮想化の単位にする。WPFには仮想化するWrapPanelが無いので、
                    列数をViewModel側で決めて結果を行に切り、その行をListBoxに並べている。
                    画面外の行のカードは実体化されないので、サムネイルの復号も走らない。
                -->
                <!--
                    リスト（ユーザ指示 2026-09-14）。1行ずつ、絵・星・名前・ショップ・札を並べる。
                    列の幅は見出しの境目をドラッグで変え、全部の行で共通（ListColumns）。行の操作はカードと同じ
                -->
                <ListView ItemsSource="{Binding ListItems}" View="{StaticResource ItemListGridView}"
                          ItemContainerStyle="{StaticResource ItemListRowStyle}"
                          ScrollViewer.ScrollChanged="OnResultsScrollChanged"
                          BorderThickness="0" Background="Transparent" Margin="18,4,18,18"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                         ScrollViewer.ScrollChanged="OnResultsScrollChanged"
                         Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ItemCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="該当するものがありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                    <!--
                        絞り込んで0件なのか、そもそも何も入っていないのかで、次にやることが違う。
                        「取り込んでください」は、条件で絞った結果が0件のときには的外れになる。
                    -->
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- カード／リストの切り替え。右下の空いた所に重ねる（ユーザ指示 2026-09-14） -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,18" Panel.ZIndex="3" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
