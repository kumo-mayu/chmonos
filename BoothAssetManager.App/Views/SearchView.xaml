<UserControl x:Class="BoothAssetManager.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
      <ResourceDictionary>
        <!-- 商品のカード（フォルダビューの右側と共通。Views/ItemCardResources.xaml） -->
        <ResourceDictionary.MergedDictionaries>
            <views:ItemCardResources />
            <!-- 並べ替えの繋がったボタン（タグ・属性の管理と同じ部品・M5） -->
            <ResourceDictionary Source="ManageResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!--
            畳む・開くの小さなボタン。既定のボタンの見た目（枠と余白）だと
            「絞り込み」の見出しより目立ってしまうので、山形だけを置く。
        -->
        <!--
            履歴のスロット。枠は外側の Border が持つので、中身は素のまま出す。
            **テンプレートごと置き換える。**暗黙の Button スタイルは枠線と余白を
            持っていて setter では外せない（他の画面で同じ罠を踏んでいる）。
        -->
        <Style x:Key="HistorySlotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            履歴の帯の端に出す「‹」「›」。続きのチップの上に重ねるので、外側へ向かって白く抜ける地を持たせ、
            切れたチップが「ここで終わり」ではなく「この先に続く」と読めるようにする
        -->
        <Style x:Key="HistoryScrollButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Fade">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00ffffff" Offset="0" />
                                        <GradientStop Color="#ffffffff" Offset="0.45" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="Face" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}" Margin="0,-3,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <!-- 左端の「‹」は向きを逆にする（地は右から白く、丸は左に寄せる） -->
                            <Trigger Property="HorizontalAlignment" Value="Left">
                                <Setter TargetName="Face" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="Fade" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Fade" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelToggle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{TemplateBinding Content}" Fill="{x:Null}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stroke="{StaticResource TextMuted}" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 条件を畳む・開く山形（ユーザ指示 2026-09-16。条件が増えるとパネルが縦に伸びる） -->
        <PathGeometry x:Key="IconChevronUp" Figures="M7,15 L12,10 L17,15" />
        <PathGeometry x:Key="IconChevronDown" Figures="M7,10 L12,15 L17,10" />

        <Style x:Key="ModuleCollapseToggle" TargetType="Button" BasedOn="{StaticResource PanelToggle}">
            <Setter Property="Content" Value="{StaticResource IconChevronUp}" />
            <Setter Property="ToolTip" Value="この条件を畳む（条件は効いたまま）" />
            <Setter Property="AutomationProperties.Name" Value="この条件を畳む" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="Content" Value="{StaticResource IconChevronDown}" />
                    <Setter Property="ToolTip" Value="この条件を開く" />
                    <Setter Property="AutomationProperties.Name" Value="この条件を開く" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 入力が残る欄を消す × （ユーザ指示 2026-09-16：消せることが分かるように） -->
        <Style x:Key="ClearFieldButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <controls:PaneGrid Background="{StaticResource Bg}" Pane="{Binding FilterPane}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilterPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding FilterPane.MinWidth}" MaxWidth="{Binding FilterPane.MaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 絞り込み欄の幅を変える境目（ユーザ判断 2026-09-14）。畳んでいる間は出さない。開け閉めのつまみ（ZIndex 1）より下に置く -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="0"
                               ResetCommand="{Binding FilterPane.ResetCommand}"
                               Visibility="{Binding FilterPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!--
            絞り込みを畳む／開くつまみ。パネルと結果の境の線に半分はみ出させて置く（U3・ユーザ判断）。
            見出しの行で「条件をクリア」の右隣にあった頃は押し間違えやすかった。
            開いても畳んでも同じ高さに残るので、開け閉めでつまみの場所が変わらない
        -->
        <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,-13,0"
                Width="26" Height="26" CornerRadius="13" Panel.ZIndex="1"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
            <Button Command="{Binding ToggleFilterPanelCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelToggle}">
                        <Setter Property="Content" Value="{StaticResource IconCollapse}" />
                        <Setter Property="ToolTip" Value="絞り込みを畳む" />
                        <Setter Property="AutomationProperties.Name" Value="絞り込みを畳む" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterPanelCollapsed}" Value="True">
                                <Setter Property="Content" Value="{StaticResource IconExpand}" />
                                <Setter Property="ToolTip" Value="絞り込みを開く" />
                                <Setter Property="AutomationProperties.Name" Value="絞り込みを開く" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

        <!-- 絞り込み -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
          <Grid>
            <!--
                畳んだ姿。条件は外れていないので、効いている数を出しておく。
                数が見えていないと「なぜか商品が少ない」の原因を探す場所が無くなる。
                開くつまみは境の線の上（上の Border）にあるので、その下から並べる
            -->
            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" CornerRadius="8" Padding="5,1"
                        Margin="0,48,0,0" HorizontalAlignment="Center" ToolTip="{Binding FilterSummary}"
                        Visibility="{Binding ActiveFilterCount, Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                    <TextBlock Text="{Binding ActiveFilterCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="絞り込み" Style="{StaticResource Caption}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </DockPanel>

            <DockPanel Visibility="{Binding IsFilterPanelCollapsed, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Height="52" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <!-- 右の余白は、境の線に半分はみ出したつまみ（13px）から「条件をクリア」をはっきり離すため -->
                    <Grid Margin="16,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="絞り込み" FontWeight="Bold" VerticalAlignment="Center" />
                        <!-- 押す前の条件は検索の履歴に積むので、押し間違えても履歴から戻せる（U3・ユーザ判断） -->
                        <!--
                            文字に押す動きを付けただけでは、キーボードと読み上げ・自動操作から押せない
                            （実際に押せていなかった）。見た目は同じまま、ボタンにする
                        -->
                        <Button Grid.Column="1" Content="条件をクリア" Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource HistorySlotButton}" Foreground="{StaticResource Accent}"
                                FontSize="12" VerticalAlignment="Center" Padding="4,2"
                                AutomationProperties.Name="条件をクリア"
                                ToolTip="入力と条件の値をクリアします。前の条件は検索の履歴から戻せます。" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <!--
                            条件はモジュールで足していく（ユーザ案 2026-09-15）。見出しはメニューの分け方で、同じ条件が
                            2つの見出しに出ることがある。足してある条件はどの見出しの下でもグレーになる（一度しか足せない）
                        -->
                        <Menu Background="Transparent" HorizontalAlignment="Left">
                            <MenuItem Header="＋ 条件を追加 ▾" ItemsSource="{Binding ModuleMenu}" Height="30" Padding="10,0"
                                      FontSize="12.5" Foreground="{StaticResource Accent}"
                                      AutomationProperties.Name="条件を追加"
                                      ToolTip="絞り込みに使う条件を追加します。追加済みの条件は選べません。">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding Title}" />
                                        <Setter Property="ItemsSource" Value="{Binding Entries}" />
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <Setter Property="ItemContainerStyle">
                                            <Setter.Value>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Label}" />
                                                    <Setter Property="Command" Value="{Binding AddCommand}" />
                                                    <Setter Property="ToolTip" Value="{Binding Hint}" />
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                    <!--
                                                        足してある条件はグレーにする（ユーザ案）。名前の文字は MenuItem の色を明示して継ぐ——
                                                        アプリ全体の TextBlock の既定の見た目が生成された文字にも当たり、押せないのに黒のまま出ていた
                                                    -->
                                                    <Setter Property="HeaderTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                        </Trigger>
                                                        <!--
                                                            意味のまとまりの間の区切り線（ユーザ判断 2026-09-16・案1）。項目の見た目を線に差し替え、
                                                            押せず・キーボードでも止まらないようにする。
                                                            （項目の種類で部品を作り分ける仕組み〔UsesItemContainerTemplate〕は、ここでは作り方が見つからず中身が空になった）
                                                        -->
                                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Focusable" Value="False" />
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                            <Setter Property="AutomationProperties.Name" Value="区切り" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="MenuItem">
                                                                        <Border Height="1" Margin="30,4,6,4" Background="{StaticResource Border}" />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>

                        <TextBlock Text="条件がありません。「＋ 条件を追加」から追加できます。" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasModules, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />

                        <!-- 順番はドラッグで変えられる（ユーザ指示 2026-09-16）。掴む所は見出しの左のつまみだけ -->
                        <controls:ContentItemsControl ItemsSource="{Binding Modules}" Margin="0,10,0,0" Focusable="False"
                                                      AllowDrop="True" DragOver="OnModulesDragOver"
                                                      DragLeave="OnModulesDragLeave" Drop="OnModulesDrop">
                            <ItemsControl.Resources>
                                <!-- 積んだ値1つ（チップ）。候補から積む条件と、ユーザータグの小分類で同じ形を使う -->
                                <DataTemplate x:Key="SearchChipTemplate" DataType="{x:Type vm:ListChip}">
                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                            BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="0,0,5,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#28507f"
                                                       MaxWidth="200" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" FontSize="10.5" Foreground="#28507f"
                                                       Opacity="0.7" Margin="5,0,0,0" VerticalAlignment="Center" />
                                            <!-- 形は呼ばれ方の履歴のチップに揃える（幅を決め打つと暗黙のButtonスタイルの枠が丸く出る） -->
                                            <Button Content="×" FontSize="11" Margin="6,0,0,0" Padding="2,0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" Foreground="#28507f"
                                                    ToolTip="この値を外す"
                                                    AutomationProperties.Name="{Binding Text, StringFormat={}{0}を外す}"
                                                    Command="{Binding RemoveCommand}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>

                                <!-- 選ぶ条件（ユーザ案「三項」）。件数は「選んだら何件になるか」 -->
                                <DataTemplate DataType="{x:Type vm:ChoiceModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Display" Height="28" FontSize="12.5"
                                                  AutomationProperties.Name="{Binding Label}" />
                                        <CheckBox IsChecked="{Binding Flag, Mode=TwoWay}" Margin="0,7,0,0"
                                                  AutomationProperties.Name="{Binding FlagLabel}"
                                                  Visibility="{Binding HasFlag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding FlagLabel}" FontSize="12" Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    候補から積む条件（ユーザ案「list」）。候補は必ず出し、全部を並べずに入力欄から1件ずつ積む
                                    （件数に比例して縦に伸びないように）。積んだ値の件数は「他の条件のもとで、この値に当てはまる件数」
                                -->
                                <DataTemplate DataType="{x:Type vm:ListModule}">
                                    <StackPanel>
                                      <!--
                                          選んだ値に照らす部分。対応アバターで「指定が無い商品だけ」を出すときは、選んだアバターが意味を持たないので薄くする
                                          （ユーザ判断 2026-09-16・案C）。ほかの条件では常に触れる（ShowMatched は既定で入）
                                      -->
                                      <StackPanel IsEnabled="{Binding ShowMatched}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowMatched}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}"
                                                             Placeholder="{Binding Placeholder}"
                                                             IconSelector="{Binding IconSelector}"
                                                             AutomationProperties.Name="{Binding Placeholder}"
                                                             Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,0" Focusable="False"
                                                                      ItemTemplate="{StaticResource SearchChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </controls:ContentItemsControl>
                                        <!--
                                            選んだ値に加えて当てるかたまり（ショップの「お気に入りのショップの商品」・ユーザ指示 2026-09-16）。
                                            入れると、お気に入りのショップを全部選んだのと同じに働く。件数は他の条件を当てたうえでの数
                                        -->
                                        <CheckBox IsChecked="{Binding IncludeOn, Mode=TwoWay}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="お気に入りのショップの商品を含める"
                                                  ToolTip="お気に入りのショップをすべて選んだのと同じに絞ります。"
                                                  Visibility="{Binding HasInclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock FontSize="12" Foreground="{StaticResource Text}">
                                                <Run Text="★" Foreground="#d99a00" /> <Run Text="{Binding IncludeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}" Margin="0,3,0,0"
                                                  AutomationProperties.Name="すべてに当てはまる商品だけ"
                                                  ToolTip="切っているときは、どれか1つに当てはまる商品（OR）を表示します。"
                                                  Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="すべてに当てはまる商品だけ（AND）" FontSize="12" Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Flag, Mode=TwoWay}" Margin="0,4,0,0"
                                                  AutomationProperties.Name="{Binding FlagLabel}"
                                                  Visibility="{Binding HasFlag, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding FlagLabel}" FontSize="12" Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                      </StackPanel>

                                      <!--
                                          出すもの（対応アバターだけ・ユーザ判断 2026-09-16・案C）。商品を「対応が書いてある」と「対応の指定が無い」に分け、
                                          どちらを出すかを印で選ぶ。BOOTH には対応アバターを書かずに「どのアバターでも使える」商品がある。
                                          件数は他の条件を当てたうえでの数。最後の1つは外せない
                                      -->
                                      <StackPanel Margin="0,8,0,0"
                                                  Visibility="{Binding HasGroups, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                          <TextBlock Text="表示するもの" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                          <CheckBox IsChecked="{Binding ShowMatched, Mode=TwoWay}"
                                                    AutomationProperties.Name="対応している商品を表示"
                                                    ToolTip="選んだアバターに対応している商品を表示します。">
                                              <TextBlock Text="{Binding MatchedLabel}" FontSize="12" Foreground="{StaticResource Text}" />
                                          </CheckBox>
                                          <CheckBox IsChecked="{Binding ShowUnspecified, Mode=TwoWay}" Margin="0,3,0,0"
                                                    AutomationProperties.Name="対応の指定が無い商品を表示"
                                                    ToolTip="対応アバターが書かれていない商品も表示します。">
                                              <TextBlock Text="{Binding UnspecifiedLabel}" FontSize="12" TextWrapping="Wrap"
                                                         Foreground="{StaticResource Text}" />
                                          </CheckBox>
                                      </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 数の範囲（ユーザ案「上下指定・数値・単品」）。空欄の側は制限しない -->
                                <DataTemplate DataType="{x:Type vm:RangeModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" Height="28" FontSize="12.5" Margin="0,0,0,6"
                                                  AutomationProperties.Name="何の数で絞るか"
                                                  Visibility="{Binding HasSources, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <!--
                                            外れ値を無視（価格だけ・ユーザ判断 2026-09-16）。支援用のバリエーションや販売を止めるための高値は値段ではなく目印なので、
                                            目盛と照合から外す。何円以上を何個外しているかを数で出す
                                        -->
                                        <CheckBox IsChecked="{Binding IgnoreOutliers, Mode=TwoWay}" Margin="0,0,0,6"
                                                  AutomationProperties.Name="外れ値を無視"
                                                  ToolTip="極端に高い価格を、目盛と絞り込みから外します。商品は外しません。"
                                                  Visibility="{Binding SupportsOutliers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding OutlierLabel}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                        <!--
                                            目盛を出す（ユーザ指示 2026-09-16：目盛が無いと指定しづらい）。
                                            つまみは割合（0〜100）で動かし、目盛の刻みだけでは数が読めないので両端の数を下に出す
                                        -->
                                        <!--
                                            分布の帯（ユーザ判断 2026-09-16・案5）。商品がどこに集まっているかが見えると範囲を決められる。
                                            つまみと同じ対数の配り方で数えているので、帯の位置とつまみの位置が合う。
                                            左の余白はトグルの幅ぶん（スライダの左端に揃える）
                                        -->
                                        <controls:ContentItemsControl ItemsSource="{Binding Histogram}" Height="22" Margin="24,0,0,1"
                                                                      Focusable="False" ToolTip="商品の数の分布"
                                                                      AutomationProperties.Name="商品の数の分布"
                                                                      Visibility="{Binding HasHistogram, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HistogramBar}">
                                                    <Rectangle Height="{Binding Height}" VerticalAlignment="Bottom" Margin="0.5,0"
                                                               Fill="{StaticResource AccentBorder}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>

                                        <!--
                                            端に寄せても効いたまま（ユーザ指示 2026-09-16）。片側を外すのは左のトグルで、既定は上下とも効く。
                                            前はつまみを端に置くと黙って「制限なし」になり、「0以上」と「下限なし」を言い分けられなかった
                                        -->
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding MinEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、下限で絞りません。"
                                                      AutomationProperties.Name="下限を効かせる" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding LowPosition, Mode=TwoWay}"
                                                    TickFrequency="10" TickPlacement="TopLeft" IsSnapToTickEnabled="False" LargeChange="10"
                                                    IsEnabled="{Binding MinEnabled}" ToolTip="{Binding MinHint}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="下限" />
                                        </DockPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding MaxEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、上限で絞りません。"
                                                      AutomationProperties.Name="上限を効かせる" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding HighPosition, Mode=TwoWay}"
                                                    TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="False" LargeChange="10"
                                                    IsEnabled="{Binding MaxEnabled}" ToolTip="{Binding MaxHint}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="上限" />
                                        </DockPanel>
                                        <DockPanel LastChildFill="False" Margin="24,2,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding MinimumLabel}" Style="{StaticResource Caption}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaximumLabel}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBox Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="62" Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding MinEnabled}" AutomationProperties.Name="下限"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MinHint}" />
                                            <Button Style="{StaticResource ClearFieldButton}" Command="{Binding ClearMinCommand}"
                                                    ToolTip="下限を消す" AutomationProperties.Name="下限を消す"
                                                    Visibility="{Binding HasMin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="〜" VerticalAlignment="Center" Margin="4,0" Style="{StaticResource Caption}" />
                                            <TextBox Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="62" Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding MaxEnabled}" AutomationProperties.Name="上限"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MaxHint}" />
                                            <Button Style="{StaticResource ClearFieldButton}" Command="{Binding ClearMaxCommand}"
                                                    ToolTip="上限を消す" AutomationProperties.Name="上限を消す"
                                                    Visibility="{Binding HasMax, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    日付の範囲（ユーザ案「カレンダー」）。欄に打つか、右のカレンダーで選ぶ。指定した日をまるまる含む。
                                    どう読んだかを下に添える（「9/1」を去年と読んだ、などが分かるように）
                                -->
                                <DataTemplate DataType="{x:Type vm:DateModule}">
                                    <StackPanel>
                                        <!--
                                            「から」は欄の後ろに置く（ユーザ指示 2026-09-16。日本語では値のあとに付く）。
                                            左のトグルで片側を切れる（同。空欄を「制限なし」と読ませるより、切ってあることが見える方が分かる）
                                        -->
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SinceEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、始まりの日で絞りません。"
                                                      AutomationProperties.Name="始まりの日を効かせる" />
                                            <ToggleButton x:Name="SinceCalendarButton" DockPanel.Dock="Right" Width="28" Height="26"
                                                          IsEnabled="{Binding SinceEnabled}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Margin="4,0,0,0" ToolTip="{Binding SinceHint}" AutomationProperties.Name="開始の日をカレンダーで選ぶ">
                                                <!-- 字形のアイコンは字体が無いと四角になる。ほかの画面と同じく線で描く -->
                                                <Path Data="M4,6 H20 V20 H4 Z M4,10 H20 M8,3.5 V7.5 M16,3.5 V7.5" Stroke="{StaticResource TextMuted}"
                                                      StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                            </ToggleButton>
                                            <TextBlock DockPanel.Dock="Right" Text="から" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearFieldButton}"
                                                    Command="{Binding ClearSinceCommand}" ToolTip="開始の日を消す"
                                                    AutomationProperties.Name="開始の日を消す"
                                                    Visibility="{Binding HasSince, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBox Text="{Binding SinceText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding SinceEnabled}" AutomationProperties.Name="開始の日"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding SinceHint}" />
                                        </DockPanel>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=SinceCalendarButton}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=SinceCalendarButton}" Placement="Bottom">
                                            <Calendar SelectedDate="{Binding SinceDate, Mode=TwoWay}" />
                                        </Popup>
                                        <TextBlock Text="{Binding SinceNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Margin="24,2,0,6" />
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding TillEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="チェックを外すと、終わりの日で絞りません。"
                                                      AutomationProperties.Name="終わりの日を効かせる" />
                                            <ToggleButton x:Name="TillCalendarButton" DockPanel.Dock="Right" Width="28" Height="26"
                                                          IsEnabled="{Binding TillEnabled}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Margin="4,0,0,0" ToolTip="{Binding TillHint}" AutomationProperties.Name="終わりの日をカレンダーで選ぶ">
                                                <Path Data="M4,6 H20 V20 H4 Z M4,10 H20 M8,3.5 V7.5 M16,3.5 V7.5" Stroke="{StaticResource TextMuted}"
                                                      StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                                            </ToggleButton>
                                            <TextBlock DockPanel.Dock="Right" Text="まで" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Style="{StaticResource Caption}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ClearFieldButton}"
                                                    Command="{Binding ClearTillCommand}" ToolTip="終わりの日を消す"
                                                    AutomationProperties.Name="終わりの日を消す"
                                                    Visibility="{Binding HasTill, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBox Text="{Binding TillText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding TillEnabled}" AutomationProperties.Name="終わりの日"
                                                     ToolTipService.ShowOnDisabled="True" ToolTip="{Binding TillHint}" />
                                        </DockPanel>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=TillCalendarButton}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=TillCalendarButton}" Placement="Bottom">
                                            <Calendar SelectedDate="{Binding TillDate, Mode=TwoWay}" />
                                        </Popup>
                                        <TextBlock Text="{Binding TillNote}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Margin="24,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>

                                <!--
                                    ユーザータグ（ユーザ指示 2026-09-28）。欄の候補は大分類だけで、選ぶと大分類の枠が1つ立つ。
                                    枠の中の欄から小分類と「小分類なし」を1件ずつ足す（全部並べると小分類の数だけ縦に伸びる）。
                                    小分類どうしの AND／OR は枠ごと、大分類どうしは下のチェック
                                -->
                                <DataTemplate DataType="{x:Type vm:UserTagModule}">
                                    <StackPanel>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}" Placeholder="大分類を選んで追加"
                                                             AutomationProperties.Name="大分類を選んで追加"
                                                             Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="ユーザータグがまだ登録されていません。編集画面から追加できます。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsMasterEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:UserTagTopRow}">
                                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5"
                                                            Padding="8,6" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <Button DockPanel.Dock="Right" Content="×" FontSize="11" Padding="4,0" Cursor="Hand"
                                                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                                        Foreground="{StaticResource TextMuted}" ToolTip="この大分類を外す"
                                                                        AutomationProperties.Name="{Binding Top, StringFormat={}{0}を外す}"
                                                                        Command="{Binding RemoveCommand}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                                           VerticalAlignment="Center" Margin="6,0,4,0" />
                                                                <TextBlock Text="{Binding Top}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Top}"
                                                                           VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False" Margin="0,5,0,0"
                                                                                 CommitCommand="{Binding AddCommand}" Placeholder="小分類を選んで追加"
                                                                                 AutomationProperties.Name="{Binding Top, StringFormat={}{0}の小分類を選んで追加}"
                                                                                 Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <controls:ContentItemsControl ItemsSource="{Binding Chips}" Margin="0,5,0,0" Focusable="False"
                                                                                          ItemTemplate="{StaticResource SearchChipTemplate}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </controls:ContentItemsControl>
                                                            <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Top, StringFormat={}{0}の小分類すべてに当てはまる商品だけ}"
                                                                      ToolTip="切っているときは、どれか1つに当てはまる商品（OR）を表示します。"
                                                                      Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="すべてに当てはまる商品だけ（AND）" FontSize="12" Foreground="{StaticResource Text}" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                  AutomationProperties.Name="すべての大分類に当てはまる商品だけ"
                                                  ToolTip="切っているときは、どれか1つの大分類に当てはまる商品（OR）を表示します。"
                                                  Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="すべての大分類に当てはまる商品だけ（AND）" FontSize="12" Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 属性（ユーザ案「上下指定・数値・AND OR」）。使う属性だけを候補から選んで積む -->
                                <DataTemplate DataType="{x:Type vm:AttributeModule}">
                                    <StackPanel>
                                        <controls:SuggestBox Source="{Binding Suggestions}" AllowNew="False"
                                                             CommitCommand="{Binding AddCommand}" Placeholder="属性を選んで追加"
                                                             AutomationProperties.Name="属性を選んで追加"
                                                             Visibility="{Binding HasSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="属性がまだ登録されていません。編集画面から追加できます。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasSuggestions, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <controls:ContentItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AttributeFilter}">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                            <Button DockPanel.Dock="Right" Content="×" FontSize="11" Padding="4,0" Cursor="Hand"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{StaticResource TextMuted}" ToolTip="この属性を外す"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0}を外す}"
                                                                    Command="{Binding RemoveCommand}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RangeText}"
                                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                                        </DockPanel>
                                                        <!--
                                                            キーの刻みは目盛り（10）に合わせる。既定の0.1だと目盛りへ吸い寄せられて、キーでは動かなかった（点検 2026-09-23）
                                                        -->
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding Min, Mode=TwoWay}"
                                                                TickFrequency="10" TickPlacement="TopLeft" IsSnapToTickEnabled="True"
                                                                SmallChange="10" LargeChange="20"
                                                                Margin="0,3,0,0"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の下限}" />
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding Max, Mode=TwoWay}"
                                                                TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                                                                SmallChange="10" LargeChange="20"
                                                                AutomationProperties.Name="{Binding Name, StringFormat={}{0}の上限}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </controls:ContentItemsControl>
                                        <CheckBox IsChecked="{Binding MatchAll, Mode=TwoWay}"
                                                  AutomationProperties.Name="すべての属性に当てはまる商品だけ"
                                                  ToolTip="切っているときは、どれか1つの属性に当てはまる商品（OR）を表示します。"
                                                  Visibility="{Binding ShowsMatchMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="すべてに当てはまる商品だけ（AND）" FontSize="12" Foreground="{StaticResource Text}" />
                                        </CheckBox>
                                        <TextBlock Text="追加した属性は、評価済みの商品だけが対象になります。" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>

                                <!-- 最近（ユーザ判断 Q1：プルダウンと日数）。上下限にしないのは、聞きたいことが「何日以内か」の片側しかないから -->
                                <DataTemplate DataType="{x:Type vm:RecentModule}">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="Label" Height="28" FontSize="12.5"
                                                  AutomationProperties.Name="何の記録で絞るか" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox Text="{Binding DaysText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                     Width="64" Height="26" FontSize="12" Padding="7,0" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="日数" />
                                            <Button Style="{StaticResource ClearFieldButton}" Command="{Binding ClearDaysCommand}"
                                                    ToolTip="日数を消す" AutomationProperties.Name="日数を消す"
                                                    Visibility="{Binding HasDays, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="日以内" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.Resources>

                            <!--
                                条件1つの枠。左のチェックで、値を残したまま効かせない（ユーザ案：追加状態を保ったまま無効化）。
                                右上の × で条件ごと外す
                            -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <!-- 落とし先の線。Adorner ではなく行のプロパティで出す（タグ・属性の並べ替えと同じ作り） -->
                                        <Border Height="2" Margin="0,0,0,2" Background="{StaticResource Accent}"
                                                Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,8" Background="{StaticResource Surface}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <!--
                                                        つまんで動かす所。カードのどこでも掴めるようにすると、
                                                        スライダを動かすたびに並べ替えが始まってしまう
                                                    -->
                                                    <TextBlock DockPanel.Dock="Left" Text="⋮⋮" FontSize="11" Margin="0,0,6,0"
                                                               Cursor="SizeAll" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextFaint}"
                                                               ToolTip="ドラッグで順番を変えられます"
                                                               AutomationProperties.Name="{Binding Label, StringFormat={}{0}の順番を変える}"
                                                               PreviewMouseLeftButtonDown="OnModuleHandlePress"
                                                               MouseMove="OnModuleHandleMove" />
                                                    <Button DockPanel.Dock="Right" Content="×" FontSize="13" Padding="4,0" Cursor="Hand"
                                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                                            Foreground="{StaticResource TextMuted}" ToolTip="この条件を外す"
                                                            AutomationProperties.Name="{Binding Label, StringFormat={}{0}の条件を外す}"
                                                            Command="{Binding RemoveCommand}" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource ModuleCollapseToggle}"
                                                            Command="{Binding ToggleCollapseCommand}" Margin="0,0,2,0" />
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                                              ToolTip="切ると、値を残したままこの条件を効かせません"
                                                              AutomationProperties.Name="{Binding Label, StringFormat={}{0}の条件を効かせる}">
                                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Text}" ToolTip="{Binding Hint}" />
                                                    </CheckBox>
                                                </DockPanel>
                                                <!-- 畳んでも条件は効いたままなので、何で絞っているかを1行で出す -->
                                                <TextBlock Text="{Binding CollapsedSummary}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="18,4,0,0"
                                                           Visibility="{Binding IsCollapsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                           Margin="0,6,0,0"
                                                           Visibility="{Binding HasDisabledReason, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <ContentControl Content="{Binding}" Focusable="False" Margin="0,7,0,0"
                                                                Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasDisabledReason}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Height="2" Margin="0,2,0,0" Background="{StaticResource Accent}"
                                                Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </controls:ContentItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <!-- 結果 -->
        <DockPanel Grid.Column="1">
            <!--
                検索の履歴

                **一番上に横のスロットで出す**（ユーザ指示）。絞り込みパネルは
                既に手狭で、足したい条件も控えているので幅を食わせない。

                横に溢れるので `ScrollViewer` に入れる。件数の上限は設定にある——
                増やすほど端まで送る手間が増えるので、好みで決められるようにした。

                入っているものが無いときは出さない。初回起動で空の帯が居座ると、
                何のための場所か分からない
            -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    Padding="18,7"
                    Visibility="{Binding HasHistory, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
              <DockPanel>
                <!--
                    帯の左端に見出し（ユーザ指示 2026-09-16：上に履歴が溜まっていることが分かりにくい）。
                    帯そのものが履歴のあるときだけ出るので、見出しも履歴のあるときだけ見える
                -->
                <TextBlock DockPanel.Dock="Left" Text="検索履歴" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <!--
                    横に送れるが、バーは出さない（ユーザ指示 2026-09-16）。バーが無いとつまめないので、ホイールで横に送る。
                    バーが無いと右端のチップが切れても続きがあると分からなかった（点検 2026-09-23）ので、
                    続きがある側の端にだけ「‹」「›」を出す（押すと1画面ぶん送る）。切れたチップの上に薄い地を重ねて、端だと分かるようにする
                -->
                <Grid>
                <ScrollViewer x:Name="HistoryStrip" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnHistoryMouseWheel" ScrollChanged="OnHistoryScrollChanged">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchHistorySlot}">
                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 押すとその条件に戻る -->
                                        <Button Style="{StaticResource HistorySlotButton}"
                                                Command="{Binding ApplyCommand}"
                                                ToolTip="{Binding Summary}">
                                            <StackPanel Orientation="Horizontal" Margin="10,4">
                                                <!-- 名前を付けたものは件数で落とさないので、印で区別する -->
                                                <TextBlock Text="★" FontSize="10" Margin="0,0,5,0"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNamed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <!-- 要らない条件は個別に消せる。全部消すのは設定から -->
                                        <Button Style="{StaticResource HistorySlotButton}" Content="✕"
                                                FontSize="10" Padding="6,4" Command="{Binding RemoveCommand}"
                                                Foreground="{StaticResource TextMuted}"
                                                ToolTip="この履歴を削除します。検索の条件は変わりません。" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="HistoryBack" Style="{StaticResource HistoryScrollButton}" HorizontalAlignment="Left" Content="‹"
                        Click="OnHistoryScrollBack" Visibility="Collapsed"
                        ToolTip="前の履歴へ送ります。ホイールでも送れます。" AutomationProperties.Name="前の検索履歴へ送る" />
                <Button x:Name="HistoryForward" Style="{StaticResource HistoryScrollButton}" HorizontalAlignment="Right" Content="›"
                        Click="OnHistoryScrollForward" Visibility="Collapsed"
                        ToolTip="続きの履歴へ送ります。ホイールでも送れます。" AutomationProperties.Name="続きの検索履歴へ送る" />
                </Grid>
              </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="78" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <StackPanel Margin="18,9,18,0">
                  <!-- 検索欄の右に「対象」と「オプション」（ユーザ案 2026-09-15）。どちらもトグルなので、開いたまま続けて切り替えられる -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6"
                            Height="34" HorizontalAlignment="Stretch" Background="White">
                        <Grid>
                            <TextBox x:Name="QueryBox" MaxLength="500" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0,34,0"
                                     FontSize="13" Background="Transparent" />
                            <!-- 打った文字を消す（ユーザ指示 2026-09-16）。絞り込みの条件は消さない -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                                    Style="{StaticResource ClearFieldButton}" Command="{Binding ClearQueryCommand}"
                                    ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                                    Visibility="{Binding HasQueryText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding QueryPlaceholder}" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextFaint}" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueryText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                        <MenuItem Header="対象 ▾" ItemsSource="{Binding TargetOptions}" Height="34" Padding="10,0"
                                  ToolTip="探す項目を選びます。name: などを付けた語は、その項目を探します。">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsOn, Mode=TwoWay}" />
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="オプション ▾" Height="34" Padding="10,0">
                            <MenuItem Header="大文字と小文字を区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding CaseSensitive, Mode=TwoWay}" />
                            <MenuItem Header="全角と半角を区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding WidthSensitive, Mode=TwoWay}" />
                            <MenuItem Header="ひらがなとカタカナを区別する" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding KanaSensitive, Mode=TwoWay}" />
                            <Separator />
                            <MenuItem Header="別表記でも検索" IsCheckable="True" StaysOpenOnClick="True"
                                      IsChecked="{Binding SearchAlternates, Mode=TwoWay}"
                                      ToolTip="読み・漢字・英語などの別の書き方でも探します。" />
                            <MenuItem Header="　ローマ字変換（tori → とり・トリ）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseRomaji, Mode=TwoWay}" />
                            <MenuItem Header="　漢字変換（とり → 鳥）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseKanji, Mode=TwoWay}" />
                            <MenuItem Header="　英日変換（shark → サメ）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseEnglishToJapanese, Mode=TwoWay}" />
                            <MenuItem Header="　日英変換（リボン → ribbon）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseJapaneseToEnglish, Mode=TwoWay}" />
                            <MenuItem Header="　造語変換（nadeoto → 撫で音）" IsCheckable="True" StaysOpenOnClick="True"
                                      IsEnabled="{Binding SearchAlternates}" IsChecked="{Binding UseCoined, Mode=TwoWay}"
                                      ToolTip="辞書に無い語は、商品名の漢字を1字ずつ読んで探します。" />
                        </MenuItem>
                    </Menu>
                  </Grid>

                    <!-- 書き方の見本。削れてよいので、はみ出した分は切る -->
                    <StackPanel Orientation="Horizontal" ClipToBounds="True" Margin="2,5,2,0">
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="衣装 -無料 &quot;夏セット&quot;" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="衣装 (夏 OR 冬)" />
                        <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="18,0,0,0" Text="path:ring" />
                        <TextBlock Style="{StaticResource Caption}" Margin="12,0,0,0" Foreground="{StaticResource TextFaint}"
                                   Text="スペースで両方、-で除く、&quot;&quot;でひとまとまり、name: で探す項目を絞る">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    スペースで区切ると、どちらも含むものを探します。<LineBreak />
                                    -無料 のように書くと、その語を含むものを除きます。<LineBreak />
                                    &quot;夏セット&quot; と囲むと、その並びのまま含むものだけを探します。<LineBreak />
                                    <LineBreak />
                                    括弧が無いと 衣装 夏 OR 冬 は「衣装かつ夏」または「冬」と読まれます。<LineBreak />
                                    衣装 (夏 OR 冬) と書けば「衣装かつ、夏か冬」になります。<LineBreak />
                                    <LineBreak />
                                    前に付けると、その項目だけを探します。「対象」で外していても探します。<LineBreak />
                                    name: 商品名　shop: ショップ名　memo: メモ　subdomain: サブドメイン　main: 本文<LineBreak />
                                    tag: BOOTHタグ　variation: バリエーション名　id: 商品ID<LineBreak />
                                    file: ファイル名　path: ファイルの場所　content: zipの中のファイル名<LineBreak />
                                    name:&quot;夏 セット&quot; や tag:(夏 OR 冬) のようにも書けます。&quot;…&quot; の中の name: はそのままの文字として探します。
                                </TextBlock>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                件数（左）と表示順・カード／リスト（右）の帯。**入り切らなければ右を次の行へ送る**（点検 2026-09-23）。
                前は右の塊を右寄せで重ね、左に決め打ちの余白を取っていたので、幅 900px の窓で件数の上に表示順が乗って読めなかった。
                カード／リストの切り替えも、一覧の右下に浮かせるのをやめてここに置く（狭い窓でカードの上に重なった）
            -->
            <Border DockPanel.Dock="Top" MinHeight="38" Background="{StaticResource Bg}" Padding="18,5">
                <controls:SplitRowPanel VerticalAlignment="Center" MinLeftWidth="200">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ResultSummary}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="読み込み中…" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <!--
                            表記をまたいで探したときは、何で当たったかを必ず出す。
                            辞書は引いた結果を説明できるのが取り柄なので、説明を捨てない。
                        -->
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasWidened, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding WidenedText}" FontSize="11" Foreground="#28507f"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </Border>
                        <!-- なぜこの結果になったかを結果の隣で読めるようにする。幅が足りなければ省略して縮む（全文は吹き出し） -->
                        <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FilterSummary}"
                                   Visibility="{Binding HasActiveFilters, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </DockPanel>

                    <!--
                        表示順は絞り込みと別の場所に置く。**使う項目と向きを分ける**（ユーザ指示 2026-09-20・M5）。
                        項目は多いのでプルダウン、向きは2つなので繋がったボタン（ui-rules.md の並べ替えの決め事）。
                        向きの言い方は項目で変わる（日付は「新しい順／古い順」、数は「多い順／少ない順」、額は「高い順／安い順」、
                        名前とショップは「あ→わ／わ→あ」、カテゴリは「BOOTHの並び／逆順」）
                    -->
                    <!-- 絞り込み欄を開いた幅 900px の窓では、送った先の1行にも入り切らない。表示順と切り替えの間でも折り返す -->
                    <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox ItemsSource="{Binding SortFields}" SelectedItem="{Binding SortField, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="150" Height="28" FontSize="12"
                                  AutomationProperties.Name="並べ替えに使う項目" />
                    </StackPanel>
                        <Grid Margin="0,2,16,2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="SearchSortOrder" Style="{StaticResource SegmentFirst}"
                                         Content="{Binding DescendingLabel}" MinWidth="82"
                                         IsChecked="{Binding SortsDescending, Mode=TwoWay}" />
                            <RadioButton Grid.Column="1" GroupName="SearchSortOrder" Style="{StaticResource SegmentLast}"
                                         Content="{Binding AscendingLabel}" MinWidth="82"
                                         IsChecked="{Binding SortsAscending, Mode=TwoWay}" />
                        </Grid>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                    VerticalAlignment="Center" Margin="0,2" />
                    </WrapPanel>
                </controls:SplitRowPanel>
            </Border>

            <!--
                選択中だけ出る操作バー。下端に重ねて出す。
                上に差し込むと結果の位置がずれて、選んでいる最中に操作が途切れる。
            -->
            <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSelectionBar}" Focusable="False"
                            Visibility="{Binding ShowsSelectionBar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!--
                取り込み中に増えたぶんは、押されるまで一覧へ入れない。
                読んでいる最中に足元が動くと、どこを見ていたか分からなくなる。
                件数とバッジは即座に動くので、増えたこと自体は隠していない。
            -->
            <Button DockPanel.Dock="Top" Margin="18,0,18,4" FontSize="12"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding Main.ApplyPendingCommand}"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <Grid SizeChanged="OnResultsSizeChanged">
                <!--
                    行を仮想化の単位にする。WPFには仮想化するWrapPanelが無いので、
                    列数をViewModel側で決めて結果を行に切り、その行をListBoxに並べている。
                    画面外の行のカードは実体化されないので、サムネイルの復号も走らない。
                -->
                <!--
                    リスト（ユーザ指示 2026-09-14）。1行ずつ、絵・星・名前・ショップ・札を並べる。
                    列の幅は見出しの境目をドラッグで変え、全部の行で共通（ListColumns）。行の操作はカードと同じ
                -->
                <ListView ItemsSource="{Binding ListItems}" View="{StaticResource ItemListGridView}"
                          ItemContainerStyle="{StaticResource ItemListRowStyle}"
                          ScrollViewer.ScrollChanged="OnResultsScrollChanged" Loaded="OnResultsLoaded"
                          BorderThickness="0" Background="Transparent" Margin="18,4,18,18"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!-- カードの行の一覧。Tab で1枚ずつ進めるよう、一覧に1回だけ止まる既定（Once）をやめる（点検 2026-09-23） -->
                <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue"
                         Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                         ScrollViewer.ScrollChanged="OnResultsScrollChanged" Loaded="OnResultsLoaded"
                         Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:ContentItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ItemCardTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </controls:ContentItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="該当するものがありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                    <!--
                        絞り込んで0件なのか、そもそも何も入っていないのかで、次にやることが違う。
                        「取り込んでください」は、条件で絞った結果が0件のときには的外れになる。
                    -->
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <!-- 0件でも自動では広げない（ユーザ判断 2026-09-16）。広げるかはここで選ばせる -->
                    <Button Content="別表記でも検索する" Style="{StaticResource SmallButton}" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Command="{Binding WidenCommand}"
                            ToolTip="読み・漢字・英語などの別の書き方でも探します。"
                            Visibility="{Binding ShowsWidenOffer, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </controls:PaneGrid>
</UserControl>
