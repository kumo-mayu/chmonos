<UserControl x:Class="BoothAssetManager.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="要確認" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="確認しても消えません" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="未読のみ" IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Text}" />
                    <Button Content="読み直す" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="すべて既読にする" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Command="{Binding MarkAllReadCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 空表示は一覧に重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <TextBlock Text="商品の更新、一覧との食い違い、BOOTH側の構造変化などがここに出ます。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!--
                この Grid は空表示を一覧へ重ねるためのもの。1行を足すときは
                DockPanel で包む（Grid の子のままだと一覧の上に重なって操作を塞ぐ）。
            -->
            <DockPanel>
                <!-- 検索と同じ理由。読んでいる最中に一覧を動かさない -->
                <Button DockPanel.Dock="Top" Margin="20,14,20,0" FontSize="12"
                        Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                        Content="{Binding Main.PendingItemText}"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <!-- 束の幅は中身の長さで変えない（畳むと札の幅が縮んで目が泳ぐ） -->
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
    
                        <!-- 種別ごとに束ねる。何が起きた話なのかで分けて読む -->
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <!--
                                                見出しごと畳めるようにする（ユーザ指示 2026-09-18）。見出しのどこを押しても開閉できるよう、
                                                ToggleButton を見出し全体にする。件数は畳んでいる間も出す（何件あるか見えないと開く判断ができない）
                                            -->
                                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand" Focusable="False"
                                                          AutomationProperties.Name="{Binding KindText}"
                                                          HorizontalContentAlignment="Stretch" Padding="0">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Back" Background="Transparent"
                                                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,13,18,13">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Back" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,250,0">
                                                        <Path Data="M0,0 L6,4.5 L0,9 Z" Fill="{StaticResource TextMuted}"
                                                              Width="6" Height="9" Stretch="Fill" VerticalAlignment="Top" Margin="0,4,10,0"
                                                              Visibility="{Binding IsExpanded, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                        <Path Data="M0,0 L9,0 L4.5,6 Z" Fill="{StaticResource TextMuted}"
                                                              Width="9" Height="6" Stretch="Fill" VerticalAlignment="Top" Margin="0,6,7,0"
                                                              Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding KindText}" FontWeight="Bold" FontSize="13"
                                                                       Foreground="{StaticResource Text}" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!--
                                                        件数は行の札と同じ色・同じ言葉で出す（ユーザ指示 2026-09-18）。
                                                        畳んでいる間もここだけで「何件あって、何を先に読むか」が分かるようにする
                                                    -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                                Visibility="{Binding HasStrong, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding StrongText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Warn}" />
                                                        </Border>
                                                        <Border Background="{StaticResource UnreadSoft}" BorderBrush="{StaticResource UnreadBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                                Visibility="{Binding HasUnread, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding UnreadText}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Unread}" />
                                                        </Border>
                                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                                Visibility="{Binding HasResolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="{Binding ResolvedText}" FontSize="12"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Mono}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>

                                            <ItemsControl ItemsSource="{Binding Rows}"
                                                          Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- 通知どうしの区切りが見えなかったので線を濃くし、上下の余白も広げる（ユーザ指摘 2026-09-18） -->
                                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,15">
                                                            <Border.Style>
                                                                <!-- 読んだ行は薄くする。未読が浮き上がって、どこまで読んだかが分かる -->
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.62" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowActions"
                                                                                                           Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowActions"
                                                                                                           Storyboard.TargetProperty="Visibility">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!--
                                                                    既読の印は「読んだ」という状態なので、右の「何かをする」ボタンとは分ける
                                                                    （ユーザ判断 2026-09-18）。タイトルの左に置き、押すと既読・もう一度押すと未読
                                                                -->
                                                                <ToggleButton Grid.Column="0" Width="16" Height="16" Margin="0,2,11,0"
                                                                              VerticalAlignment="Top" Cursor="Hand" Focusable="False"
                                                                              AutomationProperties.Name="{Binding ReadButtonText}"
                                                                              ToolTip="{Binding ReadButtonText}"
                                                                              IsChecked="{Binding IsRead, Mode=TwoWay}">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Grid Background="Transparent">
                                                                                <Ellipse x:Name="Ring" Width="14" Height="14"
                                                                                         Stroke="{StaticResource BorderStrong}" StrokeThickness="1.4"
                                                                                         Fill="Transparent" />
                                                                                <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed"
                                                                                         Fill="{StaticResource TextMuted}" />
                                                                            </Grid>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Border}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Unread}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>

                                                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <!-- 見落とすと困る側にだけ印を付ける -->
                                                                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                                                                Visibility="{Binding IsStrong, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                            <TextBlock Text="重要" FontSize="10" Foreground="{StaticResource Warn}" />
                                                                        </Border>
                                                                        <!-- 用が済んだもの。消さずに印を付ける（ユーザ判断 2026-09-18） -->
                                                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                                                                Visibility="{Binding IsResolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                            <TextBlock Text="解消済み" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                                                               Visibility="{Binding ShowsDetail, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
    
                                                                    <!-- 差分の要約。旧データは持たないので、取得時に書き出した分だけ -->
                                                                    <ItemsControl ItemsSource="{Binding Diffs}" Margin="0,7,0,0"
                                                                                  Visibility="{Binding HasDiffs, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="#f0f1f4"
                                                                                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Field}" FontSize="11.5" FontWeight="Medium" />
                                                                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}"
                                                                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
    
                                                                    <!--
                                                                        操作は本文のすぐ下に置く（ユーザ判断 2026-09-18：右端に置くと、
                                                                        行を読んでから押すまでに視線が900px往復する）。
                                                                        指した行にだけ出し、場所は空けたままにして行が動かないようにする
                                                                    -->
                                                                    <StackPanel x:Name="RowActions" Orientation="Horizontal" Margin="0,8,0,0"
                                                                                Visibility="Hidden">
                                                                        <!-- アプリの中で開くのか、BOOTHへ出るのかが分かるように名乗る（ユーザ指摘 2026-09-18） -->
                                                                        <Button Content="商品ページを開く" Style="{StaticResource SmallButton}"
                                                                                Command="{Binding OpenItemCommand}"
                                                                                ToolTip="このアプリの商品ページを開きます（BOOTHのページは開きません）。"
                                                                                Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                        <!-- 「確認した」では何も直らないので、直しに行ける道を種類ごとに1つ（ユーザ指示 2026-09-18） -->
                                                                        <Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}"
                                                                                Margin="8,0,0,0" Command="{Binding ActionCommand}"
                                                                                ToolTip="{Binding ActionTip}"
                                                                                Visibility="{Binding HasAction, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    </StackPanel>

                                                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}"
                                                                               FontSize="11" Margin="0,8,0,0" ToolTip="{Binding CreatedTip}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
