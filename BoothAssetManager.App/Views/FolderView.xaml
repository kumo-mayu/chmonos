<UserControl x:Class="BoothAssetManager.App.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderViewModel}">
    <!--
        フォルダビュー（ユーザ仕様 2026-09-13・設計詳細_フォルダビュー.md）。左はフォルダの木（ファイルまで・未確定も印付きで）、
        右は選んだ物の詳細（管理しているファイルは商品ページ、未確定は未確定の画面の右側、フォルダは場所と操作）。
    -->
    <UserControl.Resources>
        <!-- 畳む印。行を選ばずに開け閉めする -->
        <Style x:Key="FolderGlyph" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字だけのボタン -->
        <Style x:Key="FolderLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ［すべて／管理している物／未確定］の切り替え。改変の画面の見方の切り替えと同じ形 -->
        <Style x:Key="FolderSegment" TargetType="RadioButton">
            <Setter Property="GroupName" Value="FolderMode" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="SemiBold" Visibility="Hidden" />
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右：フォルダ -->
        <DataTemplate DataType="{x:Type vm:FolderViewDetail}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22" MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock Text="フォルダ" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                CornerRadius="9" Padding="7,0" Margin="8,0,0,0"
                                Visibility="{Binding IsOffline, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="取り外しているか、見つかりません" FontSize="11" Foreground="{StaticResource Warn}" />
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="このフォルダで絞り込んで検索" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                Command="{Binding DataContext.SearchHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="検索の画面へ移り、このフォルダの下にファイルを持つ商品だけで絞り込みます。" />
                        <Button Content="エクスプローラで開く" Margin="0,0,8,8" IsEnabled="{Binding IsOffline, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="取り込み元に足す" Margin="0,0,8,8" IsEnabled="{Binding CanAddImport}"
                                Command="{Binding DataContext.AddImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="次の取り込みから、このフォルダも見ます（既に足してあれば押せません）。" />
                        <Button Content="監視に足す" Margin="0,0,8,8" IsEnabled="{Binding CanAddWatch}"
                                Command="{Binding DataContext.AddWatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="起動したときに、このフォルダの中の新しいファイルを見ます（既に足してあれば押せません）。" />
                    </WrapPanel>

                    <!-- 未確定（ユーザ指示：未確定のフォルダには管理から外すボタンなども付ける） -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16"
                            Visibility="{Binding HasUnresolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="未確定" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding UnresolvedText}" FontSize="12" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="未確定として開く" Margin="0,0,8,0"
                                        Command="{Binding DataContext.OpenUnresolvedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="この下の未確定だけを、未確定の画面と同じ形で右に出します（確定・フォルダの登録・管理から外す）。" />
                                <Button Content="{Binding ExcludeText}"
                                        Command="{Binding DataContext.ExcludeUnresolvedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16"
                            Visibility="{Binding HasItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="この下の商品" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderViewItemRow}">
                                        <Button Style="{StaticResource FolderLink}" Margin="0,3" HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ShowItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="4" Margin="0,0,8,0"
                                                        Background="{StaticResource SurfaceAlt}" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding MoreItemsText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding HasMoreItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 右：管理しているファイル。商品ページをそのまま組み込む（戻るは隠す） -->
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView />
        </DataTemplate>

        <!-- 右：未確定のファイル。未確定の画面の右側をそのまま組み込む（上の帯と左の一覧は隠す） -->
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：絞り込みとフォルダの木 -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                    <Grid>
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" Height="30"
                                 VerticalContentAlignment="Center" Padding="7,0"
                                 AutomationProperties.Name="ファイル名・商品名・フォルダ名で絞り込む" />
                        <TextBlock Text="ファイル名・商品名・フォルダ名で絞り込む" IsHitTestVisible="False" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextFaint}"
                                   Visibility="{Binding HasFilter, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                    </Grid>
                    <Border HorizontalAlignment="Left" Margin="0,8,0,0" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="すべて" Style="{StaticResource FolderSegment}" IsChecked="{Binding IsAllMode, Mode=TwoWay}">
                                <RadioButton.Tag>
                                    <CornerRadius>5,0,0,5</CornerRadius>
                                </RadioButton.Tag>
                            </RadioButton>
                            <Border Width="1" Background="{StaticResource BorderStrong}" />
                            <RadioButton Content="管理している物" Style="{StaticResource FolderSegment}" IsChecked="{Binding IsManagedMode, Mode=TwoWay}">
                                <RadioButton.Tag>
                                    <CornerRadius>0</CornerRadius>
                                </RadioButton.Tag>
                            </RadioButton>
                            <Border Width="1" Background="{StaticResource BorderStrong}" />
                            <RadioButton Content="未確定" Style="{StaticResource FolderSegment}" IsChecked="{Binding IsUnresolvedMode, Mode=TwoWay}">
                                <RadioButton.Tag>
                                    <CornerRadius>0,5,5,0</CornerRadius>
                                </RadioButton.Tag>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 状態の1行は下に置く（改変の画面と同じ理由：文が出ても一覧が動かない） -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                        Background="{StaticResource Bg}" Padding="16,8"
                        Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="18,10,18,0"
                           Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <!-- 見えている行だけを平らに並べて仮想化する（1つのフォルダに1000本あっても重くしない） -->
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         Padding="6,0,6,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderViewRow}">
                            <DockPanel Margin="{Binding Indent}" MinHeight="26">
                                <Button DockPanel.Dock="Left" Style="{StaticResource FolderGlyph}" Content="{Binding Glyph}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />

                                <!-- 右の数と未確定の札 -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                            CornerRadius="8" Padding="6,0" Margin="0,0,6,0"
                                            Visibility="{Binding HasUnresolvedBadge, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding UnresolvedBadgeText}" FontSize="10" Foreground="{StaticResource Warn}" />
                                    </Border>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                               Visibility="{Binding IsFolderLike, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>

                                <!-- 絵：ファイルは商品の絵、未確定は「?」、フォルダは入れ物の印 -->
                                <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,2,7,2" VerticalAlignment="Top">
                                    <Border CornerRadius="4" Background="{StaticResource SurfaceAlt}" ClipToBounds="True"
                                            Visibility="{Binding IsItemFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="10" Foreground="{StaticResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Border CornerRadius="4" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                            Visibility="{Binding IsUnresolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="?" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Warn}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Path Data="M3,6 H9.5 L11.5,8 H21 V19 H3 Z" Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                                          Stretch="Uniform" Width="17" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsFolderLike, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </Grid>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDim}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Text}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSubText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding MissingText}" FontSize="10.5" Foreground="{StaticResource Warn}" Margin="0,0,8,0"
                                                   Visibility="{Binding HasMissingText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <Button Style="{StaticResource FolderLink}" Margin="0,0,8,0"
                                                Visibility="{Binding HasOthers, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding DataContext.ShowOtherCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="同じ中身のファイルが置いてある、もう1つの場所へ移ります">
                                            <TextBlock Text="{Binding OthersText}" FontSize="10.5" Foreground="{StaticResource Accent}" TextDecorations="Underline" />
                                        </Button>
                                        <!-- zip の横の展開したフォルダ（ユーザ判断：zip の下に薄く出す） -->
                                        <Button Style="{StaticResource FolderLink}"
                                                Visibility="{Binding HasExtracted, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding DataContext.RevealExtractedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="横にある、このzipを展開したフォルダをエクスプローラで開きます">
                                            <TextBlock Text="展開したフォルダあり" FontSize="10.5" Foreground="{StaticResource TextFaint}" TextDecorations="Underline" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右：選んだ物の詳細 -->
        <ContentControl Grid.Column="1" Content="{Binding Detail}" Focusable="False" />
        <TextBlock Grid.Column="1" Text="左の木から、フォルダかファイルを選ぶと、ここに出ます。"
                   Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasDetail, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
    </Grid>
</UserControl>
