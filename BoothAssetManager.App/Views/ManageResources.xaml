<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels">
    <!--
        タグの管理と属性の管理で共用する部品（ユーザ指示 2026-09-19：2つの画面の操作感を揃える）。
        片方だけ直して見た目がずれないよう、同じ物を同じ所から引く
    -->

    <!-- 文字だけのボタン（改変の一覧と同じ）。暗黙の Button スタイルは中央揃えと枠を持つので型ごと差し替える -->
    <Style x:Key="TagItemLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="4">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        畳む印。三角は文字ではなく図形で描く（文字だと小さい字形になる）。
        小さくて押しにくかったので丸で囲み、当たり判定も丸の大きさにした（ユーザ指摘 2026-09-18）
    -->
    <Style x:Key="TagToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Width="22" Height="22" Fill="{StaticResource SurfaceAlt}"
                                 Stroke="{StaticResource Border}" StrokeThickness="1" />
                        <Path x:Name="Mark" Data="M0,0 L8,6 L0,12 Z" Fill="{StaticResource TextMuted}"
                              Width="8" Height="12" Stretch="Fill" Margin="2,0,0,0"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Data" Value="M0,0 L12,0 L6,8 Z" />
                            <Setter TargetName="Mark" Property="Width" Value="12" />
                            <Setter TargetName="Mark" Property="Height" Value="8" />
                            <Setter TargetName="Mark" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="Mark" Property="Fill" Value="{StaticResource Accent}" />
                        </Trigger>
                        <!-- 中身の無い物。消さずに薄くして、押せないことを見せる（ユーザ指示 2026-09-19） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Mark" Property="Fill" Value="{StaticResource Border}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        つながったボタン（並べ方の切り替え）。ユーザ指示 2026-09-19：頭の右端のラジオボタンは、
        どの一覧の並びなのかが離れていて分かりにくい。並べる一覧のすぐ上に、1つの部品として置く。
        端のボタンだけ外側の角を丸め、間の線は1本にする（隣と枠を重ねる）
    -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                        </Trigger>
                        <!-- 選んでいる物は色で埋め、上に重ねて枠の色が隣に隠れないようにする -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentFirst" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>6,0,0,6</CornerRadius>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentMiddle" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>0</CornerRadius>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentLast" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="Tag">
            <Setter.Value>
                <CornerRadius>0,6,6,0</CornerRadius>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        中に入っている商品1件（小分類の中・属性を持つ商品）。押すと商品ページへ（改変の一覧と同じ）。
        大きな絵は左に出す（ユーザ指摘 2026-09-19：右に出すと、小さな絵に乗せたマウスから行の幅ぶん離れて遠い）。
        属性では値の札を名前の右に出す（どのくらいと評価したかが、並びの理由なので）
    -->
    <DataTemplate x:Key="ManageItemTemplate" DataType="{x:Type vm:TagItemRow}">
        <Button Style="{StaticResource TagItemLink}" Margin="0,0,10,8"
                Command="{Binding OpenCommand}"
                ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Left">
            <Button.ToolTip>
                <ToolTip Padding="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}">
                    <StackPanel Width="180">
                        <Border Width="180" Height="180" CornerRadius="6" Background="#edeff3" ClipToBounds="True" Margin="0,0,0,8"
                                Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="押すと、この商品のページを開きます" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </ToolTip>
            </Button.ToolTip>
            <StackPanel Orientation="Horizontal" Width="230">
                <Border Width="30" Height="30" CornerRadius="4" ClipToBounds="True"
                        Background="{StaticResource SurfaceAlt}">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <Grid Margin="8,0,0,0" VerticalAlignment="Center" Width="184">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ShopName}" Style="{StaticResource Caption}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="5,0"
                            Visibility="{Binding HasValue, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Mono}" FontSize="10.5" />
                    </Border>
                </Grid>
            </StackPanel>
        </Button>
    </DataTemplate>
</ResourceDictionary>
