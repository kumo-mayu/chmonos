<Window x:Class="BoothAssetManager.App.Views.ChangeItemIdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
        xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChangeItemIdDialogViewModel}"
        Title="商品のIDを変える"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <StackPanel Margin="22,20">

        <TextBlock Text="商品のIDを変える" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="{Binding HeadingText}" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,7,0,0" />

        <TextBlock Text="移し先の商品ID" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
        <Grid>
            <TextBox Text="{Binding IdInput, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="移し先の商品ID"
                     Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,110,0">
                <!--
                    打ち終えて Enter で調べられるように。下見が出た後は「調べる」が押せなくなるので、
                    この割り当ては働かず、Enter は既定のボタン（移す）へ抜ける（BOOTH へ二度聞かない）。
                    BOOTH につながらず確かめられなかった下見のときだけは、Enter でもう一度調べる
                -->
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CheckCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="調べる" HorizontalAlignment="Right" Width="100"
                    Command="{Binding CheckCommand}" />
        </Grid>
        <TextBlock Text="商品IDでも、BOOTHの商品ページのURLでも入れられます。"
                   Style="{StaticResource Caption}" Margin="0,5,0,0" />

        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <!-- 押す前に、何が移って何が移らないかを全部出す -->
        <StackPanel Visibility="{Binding HasPlan, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding TargetText}" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MovingText}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <!-- BOOTHで見つからなくても止めない。ただし黙って進めない -->
            <Border Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0"
                    Visibility="{Binding IsNotOnBooth, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding NotOnBoothText}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource Warn}" />
            </Border>

            <!-- 移せないものは名指しで出す。件数だけにしない -->
            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding HasDropped, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="移せないもの" Style="{StaticResource SectionLabel}" />
                <controls:ContentItemsControl ItemsSource="{Binding Dropped}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </controls:ContentItemsControl>
            </StackPanel>

            <!--
                同じ金額の購入記録。確かめようがないので、勝手に落とさず人に聞く。
                既定は「移す」——落とすと支出が黙って減る。
            -->
            <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,14,0,0"
                    Visibility="{Binding HasDuplicates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="同じ買い物かもしれない記録" FontWeight="Bold" FontSize="12.5"
                               Foreground="{DynamicResource AccentText}" />
                    <TextBlock Text="移し先に同じ金額の記録があります。同じ買い物なら印を付けてください。印を付けた記録は移しません。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8" />

                    <controls:ContentItemsControl ItemsSource="{Binding Duplicates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsDuplicate, Mode=TwoWay}" Margin="0,0,0,5"
                                          Foreground="{DynamicResource Text}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </controls:ContentItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="この商品には移すものがありません。IDだけを付け替えます。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding IsEmptySource, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

        <!--
            やめる側は右端・名前は「キャンセル」で揃える（`ui-rules.md`「窓の決まり」・D3）。
            Enter は、まだ下見が無いうちは入力欄の Enter が「調べる」を走らせ、
            下見が出てから「移す」に効く（`IsDefault`）。Esc は `IsCancel` で閉じる（D1・D2）
        -->
        <!-- 押せないときは理由を出す（E9）。ボタンの列に混ぜると窓の幅からはみ出すので、1行上に置く -->
        <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   TextAlignment="Right" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="この内容で移す" Style="{StaticResource PrimaryButton}" Width="140"
                    IsDefault="True" IsEnabled="{Binding HasPlan}" Click="OnMove" />
            <Button Content="キャンセル" Width="100" Margin="9,0,0,0" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
