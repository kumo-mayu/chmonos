<Window x:Class="BoothAssetManager.App.Views.RenameTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
        xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RenameTagDialogViewModel}"
        Title="名前を変更"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Surface}">
    <StackPanel Margin="22,20">

        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
        <TextBlock Text="{Binding HeadingText}" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,7,0,0" />

        <TextBlock Text="新しい名前" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />

        <!--
            既にある名前を選ぶと統合になる。打ち間違いで新しい分類が増えるのを防ぐため候補を出す。
            既にある名前と同じ綴りを打っただけでも統合先になる（RenameTagDialogViewModel.Input）。
            決めた名前は欄に残す——消すと、打った物が決まったのかが欄から読めない
        -->
        <controls:SuggestBox Source="{Binding Candidates}" CommitCommand="{Binding PickCommand}"
                             Text="{Binding Input, Mode=TwoWay}" KeepsCommittedText="True"
                             AllowNew="True" Placeholder="新しい名前" AutomationProperties.Name="新しい名前" />

        <TextBlock Text="{Binding TargetText}" Style="{StaticResource Mono}" FontSize="11.5" Margin="0,8,0,0" />
        <TextBlock Text="{Binding ImpactText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <!-- 取り返しがつくかは、属性の統合の窓と同じ置き場所・同じ見た目で出す（D4） -->
        <TextBlock Text="{Binding UndoText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <!-- 押せないときは理由を出す（E9）。ボタンの列に混ぜると窓の幅からはみ出すので、1行上に置く -->
        <TextBlock Text="{Binding CommitHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   TextAlignment="Right" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding CommitText}" Style="{StaticResource PrimaryButton}" Click="OnCommit"
                    IsDefault="True" IsEnabled="{Binding HasTarget}" />
            <Button Content="キャンセル" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
