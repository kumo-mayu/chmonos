<UserControl x:Class="BoothAssetManager.App.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ImportViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel Background="{StaticResource Bg}">
        <Border DockPanel.Dock="Top" Height="60" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="取り込み" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="フォルダをまとめて走査して、zipからBoothIDを特定します"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">

                <!-- 取り込み元 -->
                <Border BorderBrush="#b9c6dc" BorderThickness="2" CornerRadius="10" Background="#f7faff" Padding="24,22">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="フォルダをここにドロップ" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" />
                        <TextBlock Text="既に取り込み済みのファイルは自動でスキップされます"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="フォルダを選択" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddFolderCommand}" Height="34" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 対象フォルダ -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                            <TextBlock Text="対象フォルダ" FontWeight="Bold" FontSize="13" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="18,11">
                                        <Grid>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                            <Button Content="削除" Width="60" Height="27" HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Command="{Binding DataContext.RemoveFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="18,12">
                            <Button Content="取り込みを開始" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartCommand}" />
                            <Button Content="中断" Margin="9,0,0,0" Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 進捗 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16"
                        Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PhaseText}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- ProgressBar.Value は RangeBase 由来で既定が TwoWay。読み取り専用プロパティに繋ぐので明示的に OneWay にする -->
                        <ProgressBar Height="6" Margin="0,12,0,0" Minimum="0"
                                     Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Current, Mode=OneWay}"
                                     Foreground="{StaticResource Accent}" Background="#edeff3" BorderThickness="0"
                                     Visibility="{Binding HasTotal, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 黙って遅くなると原因が分からないので、減速中はその旨を出す -->
                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,10,0,0"
                                Visibility="{Binding IsThrottled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding ThrottleText}" FontSize="12" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- エラー -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14"
                        Background="#fbeaea" BorderBrush="#eecccc"
                        Visibility="{Binding HasError, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="#9a3232" TextWrapping="Wrap" />
                </Border>

                <!-- 結果 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16"
                        Visibility="{Binding HasSummary, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="結果" FontWeight="Bold" FontSize="13" Margin="0,0,0,12" />
                        <UniformGrid Columns="4" Rows="2">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="走査したファイル" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesScanned}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="ハッシュを計算" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesHashed}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="キャッシュ再利用" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesReusedFromCache}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="展開先として除外" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.FilesSkippedAsUnpacked}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="新規に取得" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ItemsAdded}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="取得済みだった" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ItemsAlreadyKnown}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="未確定" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.UnresolvedFiles}" FontSize="20" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="{StaticResource Warn}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="取得した画像" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Summary.ImagesDownloaded}" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 展開先フォルダ -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,24" Padding="18,16"
                        Visibility="{Binding HasUnpackedFolders, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="展開先とみなしたフォルダ" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="アーカイブを展開したものなので取り込んでいません。アーカイブを残すなら削除して容量を戻せます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <ItemsControl ItemsSource="{Binding UnpackedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="展開元:" />
                                                    <Run Text="{Binding ArchiveName}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FileCount, StringFormat={}{0} ファイル}"
                                                       Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{Binding UnpackedSelectionText}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,230,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="選択を切り替え" Command="{Binding SelectAllUnpackedCommand}" />
                                <!-- 破壊的な操作なので、押した先で必ず確認を挟む。実際の削除はごみ箱送り -->
                                <Button Content="ごみ箱へ移動" Margin="9,0,0,0" Command="{Binding RemoveUnpackedCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RemovalResults}" Margin="0,12,0,0"
                                      Visibility="{Binding HasRemovalResults, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
