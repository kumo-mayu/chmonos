<Window x:Class="BoothAssetManager.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chmonos" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Bg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Rail}" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Chmonos（クモノス）" Foreground="{DynamicResource RailTitle}" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="はじめに2つ決めてください。どちらも後から設定で変えられます。"
                           Foreground="{DynamicResource RailIntro}" FontSize="12" Margin="0,5,0,0" />
                <!--
                    非公式である旨（pixiv の登録商標のガイドライン：公式と混同されないよう、pixiv が作成・配布していない旨を書く。
                    docs/research/booth-terms.md §3）。設定画面にも同じ旨を出す
                -->
                <TextBlock Text="個人が作ったアプリです。ピクシブ株式会社（BOOTHの運営）が作成・配布しているものではありません。"
                           Foreground="{DynamicResource RailMuted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="26,14">
            <DockPanel LastChildFill="False">
                <!--
                    理由の文は折り返して全文を出す（点検 2026-09-23：「…ここからは変えられません。」が途中で切れ、
                    なぜ選び直せないのかが読めなかった）。行が増えた分は窓の高さを中身に合わせて伸ばす（SizeToContent）
                -->
                <TextBlock DockPanel.Dock="Left" x:Name="Notice" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                <!-- Enter で始められる（D2）。Esc は code-behind で受けて、×と同じに閉じる（D1） -->
                <!-- 主のボタンはアプリ共通の顔にする（V5）。ここだけ既定のボタンに太字を足した別物だった -->
                <Button DockPanel.Dock="Right" Content="はじめる" Click="OnStart" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Padding="22,6" />
            </DockPanel>
        </Border>

        <StackPanel Margin="26,20">
            <!--
                保存先を最初に聞くのは、取り込みを始めてから変えると引越しが要るため。
                Cドライブ以外に置きたい人は多い。
            -->
            <TextBlock Text="データの保存先" Style="{StaticResource SectionLabel}" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Text="商品の情報と画像を置く場所です。後から変えると、データを移すことになります。" />
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="12,9">
                <DockPanel>
                    <Button x:Name="PickButton" DockPanel.Dock="Right" Content="選び直す" Click="OnPickFolder" Margin="10,0,0,0" />
                    <TextBlock x:Name="RootText" Style="{StaticResource Mono}" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!--
                取得の76%が画像。切れば取り込みが4分の1で終わる。
                後から入れるのは足すだけで安いが、最初の体験が数十分変わる。
            -->
            <TextBlock Text="画像" Style="{StaticResource SectionLabel}" Margin="0,22,0,0" />
            <CheckBox x:Name="SaveImagesCheck" IsChecked="True" Margin="0,8,0,0"
                      Foreground="{DynamicResource Text}">
                <TextBlock Text="画像を取って保存する（おすすめ）" />
            </CheckBox>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,6,0,0"
                       Text="オフにすると取り込みがかなり速くなり、一覧とギャラリーは文字だけになります。" />
        </StackPanel>
    </DockPanel>
</Window>
