<UserControl x:Class="BoothAssetManager.App.Views.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderViewDetail}">
    <!--
        フォルダビューの右側（ユーザ指示 2026-09-14）。検索画面と同じカードで、そのフォルダの直下の商品を並べ、
        先頭に子フォルダのカード（商品のカードと同じ大きさ）を置く。文字で探せるが、絞り込みは付けない。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemCardResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- 商品：検索画面と同じカード（リンク・右クリック・中クリック・星・なぞる絵も同じ） -->
            <DataTemplate DataType="{x:Type vm:ItemCardViewModel}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False" />
            </DataTemplate>

            <!-- 子フォルダ：商品のカードと同じ大きさ・同じ間隔（並びと行の高さを揃える） -->
            <DataTemplate DataType="{x:Type vm:FolderBrowserFolderCard}">
                <Button Width="{DynamicResource CardWidth}" Height="{DynamicResource CardHeight}" Margin="0,0,14,14" Cursor="Hand"
                        AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Path}"
                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Style="{StaticResource Card}" ClipToBounds="True">
                                <DockPanel>
                                    <!-- パスはカードの下の空いた所に出す（名前は名前だけ・ユーザ指示 2026-09-14） -->
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}" Margin="11,0,11,11" TextWrapping="Wrap"
                                               MaxHeight="42" TextTrimming="CharacterEllipsis" />
                                    <Grid DockPanel.Dock="Top" Height="{DynamicResource CardImageHeight}" Background="#e9edf4">
                                        <Path Data="M3,6 H9.5 L11.5,8 H21 V19 H3 Z" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2"
                                              Fill="#f7f8fa" Stretch="Uniform" Width="96" Height="80"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Margin="11,10,11,0">
                                        <TextBlock Text="フォルダ" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSubText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <!-- 未確定を出していないとき：件数は出さず、あることだけ（ユーザ指示 2026-09-15） -->
                                            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                                    CornerRadius="9" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="この下に未確定のファイルがあります。左の「未確定」を入れると、件数と片付ける操作が出ます。"
                                                    Visibility="{Binding HasUnresolvedMark, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="未確定あり" FontSize="10" Foreground="{StaticResource Warn}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDim}" Value="True">
                                    <Setter TargetName="Face" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Bg}">
        <!-- フォルダの見出しと操作（今までの右側と同じ） -->
        <StackPanel DockPanel.Dock="Top" Margin="28,20,28,0">
            <TextBlock Text="フォルダ" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0"
                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <!-- 未確定を出していないとき：件数と案内は出さず、あることだけ（ユーザ指示 2026-09-15） -->
                <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="この下に未確定のファイルがあります。左の「未確定」を入れると、件数と片付ける操作が出ます。"
                        Visibility="{Binding HasUnresolvedMark, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="未確定あり" FontSize="10" Foreground="{StaticResource Warn}" />
                </Border>
                <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="7,0" Margin="8,0,0,0"
                        Visibility="{Binding IsOffline, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="取り外しているか、見つかりません" FontSize="11" Foreground="{StaticResource Warn}" />
                </Border>
            </StackPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button Content="このフォルダの商品を検索で開く" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                        Command="{Binding Owner.SearchHereCommand}" CommandParameter="{Binding}"
                        ToolTip="検索の画面へ移り、このフォルダの下にファイルを持つ商品だけで絞り込みます（分類・対応アバターなどでも絞れます）。" />
                <!-- エクスプローラを開くのは、どの画面でも小さいボタン（V1） -->
                <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}" Margin="0,0,8,8"
                        IsEnabled="{Binding IsOffline, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                        Command="{Binding Owner.RevealCommand}" CommandParameter="{Binding}" />
                <!-- 「取り込み元に足す」は何が起きるか分かりにくかった（ユーザ指示 2026-09-14）。押すと取り込みが始まる -->
                <Button Content="このフォルダの商品を取り込む" Margin="0,0,8,8"
                        IsEnabled="{Binding IsOffline, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                        Command="{Binding Owner.ImportHereCommand}" CommandParameter="{Binding}"
                        ToolTip="このフォルダを取り込みの対象に積んで、取り込みを始めます。新しいファイルを探して商品を決めます。画面はこのままで、進み具合は下の帯に出ます（取り込み画面へはそこから移れます）。" />

                <!-- 監視は状態を出し、足す・外すの両方をできるようにする（ユーザ指示 2026-09-14。前は足すだけで外せなかった） -->
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,0,4,0" Margin="0,0,8,8"
                        Background="{StaticResource Surface}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="監視：" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WatchStateText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{Binding WatchButtonText}" Style="{StaticResource SmallButton}" Margin="0,3"
                                Command="{Binding Owner.ToggleWatchCommand}" CommandParameter="{Binding}"
                                ToolTip="監視しているフォルダは、起動したときに新しいファイルが増えていないかを見ます（見つけた後に取り込むかは設定しだい）。外しても、取り込んだ物はそのまま残ります。" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 未確定（ユーザ指示：未確定のフォルダには「管理対象から除外する」ボタンなども付ける） -->
            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,4,0,0"
                    Visibility="{Binding HasUnresolved, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="未確定として開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                Command="{Binding Owner.OpenUnresolvedCommand}" CommandParameter="{Binding}"
                                ToolTip="この下の未確定だけを、未確定の画面と同じ形で右に出します（確定・フォルダの登録・管理対象から除外する）。" />
                        <Button Content="{Binding ExcludeText}" Style="{StaticResource SmallButton}"
                                Command="{Binding Owner.ExcludeUnresolvedCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding UnresolvedText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 文字で探す（絞り込みは付けない・ユーザ指示）。探すときは、この下の全部から -->
            <!--
                カード／リストの切り替えは探す欄の行の右に置く（点検 2026-09-23：一覧の右下に浮かせると、狭い窓でカードの上に重なった）。
                入り切らなければ次の行へ送る（検索の結果の上の帯と同じ部品）
            -->
            <controls:SplitRowPanel Margin="0,14,0,0" MinLeftWidth="320">
                <Grid MaxWidth="460" HorizontalAlignment="Left">
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" Height="30" MinWidth="320"
                             VerticalContentAlignment="Center" Padding="7,0"
                             AutomationProperties.Name="このフォルダの下を、商品名・ショップ名・ファイル名・フォルダ名で探す" />
                    <TextBlock Text="この下を、商品名・ショップ名・ファイル名・フォルダ名で探す" IsHitTestVisible="False" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextFaint}"
                               Visibility="{Binding HasQuery, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
            </controls:SplitRowPanel>
            <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasExcluded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </StackPanel>

        <!-- 選んでいる間と、Unity へ送っている間に出す、まとめて操作の帯（検索画面と同じ・ユーザ指示 2026-09-14） -->
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSelectionBar}" Focusable="False"
                        Visibility="{Binding ShowsSelectionBar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <Grid x:Name="ListArea" SizeChanged="OnListSizeChanged" Margin="10,10,0,0">
            <!-- 行を仮想化の単位にする（検索画面と同じ）。画面外の行のカードは作られないので、絵の読み込みも走らない -->
            <!-- リスト（ユーザ指示 2026-09-14）。列の幅は見出しの境目をドラッグで変え、全部の行で共通。フォルダの行も同じ列に並ぶ -->
            <ListView ItemsSource="{Binding ListItems}" View="{StaticResource ItemListGridView}"
                      ItemContainerStyle="{StaticResource ItemListRowStyle}"
                      BorderThickness="0" Background="Transparent" Margin="18,4,18,18"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!-- カードの行の一覧。Tab で1枚ずつ進めるよう、一覧に1回だけ止まる既定（Once）をやめる（点検 2026-09-23） -->
            <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue"
                     Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                     Padding="18,4,18,18" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="520"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" TextAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Grid>
    </DockPanel>
</UserControl>
