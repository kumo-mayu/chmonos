<UserControl x:Class="BoothAssetManager.App.Views.ItemAvatarsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemViewModel}">
    <!--
        対応アバターの欄（出品者の宣言の札・共通素体・手で足す・消したもの）。
        商品ページと編集画面で同じ部品を使う（ユーザ判断 2026-09-12：画像の追加などの編集は両方で同等にする）。
        DataContext は ItemViewModel（編集画面では、今開いている商品の分）
    -->
                    <!--
                        対応アバター。出品者の宣言（上）と、自分が着せている記録（下）を分ける。
                        混ぜると「誰が言っていることなのか」が分からなくなる。

                        **欄ごと畳める**（ユーザ指示 2026-09-12：200体を超える商品があり、多過ぎる）。
                        畳んだかどうかは商品ページと編集画面で共通で、商品を移っても保つ（アプリを閉じるまで）
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <Expander IsExpanded="{Binding IsAvatarsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock FontWeight="Bold"><Run Text="対応アバター" /><Run Text="{Binding AvatarsCountText, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource TextFaint}" /></TextBlock>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding AvatarSectionNote}" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!-- 札が多い商品だけ、アバター名で絞る欄を出す（U26） -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="{Binding ShowsAvatarFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <Grid Width="260">
                                        <TextBox x:Name="AvatarFilterBox" Padding="6,3"
                                                 Text="{Binding AvatarFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding AvatarFilterPlaceholder}" IsHitTestVisible="False"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaint}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=AvatarFilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding AvatarFilterResultText}" Style="{StaticResource Caption}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <!--
                                    札と、末尾の「＋ 追加」。足す入力欄を札の下に別に置いていたが、
                                    絞る欄と入力欄が上下に2つ並んで分かりにくかった（ユーザ指摘）。
                                    「＋ 追加」は画像の一覧の「足す」枠と同じく、並びの末尾に混ぜて折り返しても最後に付いてくる
                                -->
                                <ItemsControl ItemsSource="{Binding AvatarTiles}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AvatarRow}">
                                            <Grid>
                                                <!--
                                                    ここは閲覧が目的なので、全部が一度に見えることを優先する。
                                                    出所を常時出すとチップが横に長くなり、1行に1〜2個しか入らなくなる。
                                                    名前だけにして、出所はホバーへ回す。
                                                    押すとそのアバターを開く（U13）。「×」はボタンなので、押しても開かない。
                                                    持っているアバターは検索カードの「所持」と同じ緑（U25）
                                                -->
                                                <!--
                                                    ツールチップにアバターの絵を出す（R3）。名前だけでは見分けにくいアバターがある。
                                                    **絵の入った枠は乗せたときに作る**（ユーザ判断 2026-09-12）。札ごとに先に作ると、
                                                    244体の商品で開くのが150〜200ms遅れた。普段は短い文字だけを持たせておく
                                                -->
                                                <Border BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6" Cursor="Hand"
                                                        Visibility="{Binding IsChip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                        ToolTip="{Binding SourceTooltip}" ToolTipOpening="OnChipToolTipOpening">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoodBorder}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!--
                                                            推定を確定と同じ顔で出さない、は守る。
                                                            ただし語ではなく印にして、幅を取らない形にする
                                                        -->
                                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Fill="{StaticResource Warn}"
                                                                 Visibility="{Binding IsUnconfirmed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
                                                        <!--
                                                            検出の適合率は実測で89%。1割は誤りが出るので消せる必要がある。
                                                            乗せたときだけ出して、普段は宣言そのものを読ませる。
                                                        -->
                                                        <Button Content="×" Margin="7,0,0,0" Padding="3,0" FontSize="11"
                                                                Height="16" Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" Foreground="{StaticResource TextMuted}"
                                                                Command="{Binding RejectCommand}"
                                                                ToolTip="この対応は違う、として消します。次の検出でも復活しません。下の「消したもの」から戻せます。">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True"
                                                                                     Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>

                                                <!--
                                                    「残り n 体を表示」（ユーザ判断 2026-09-12）。多い商品は最初の一部だけ並べ、
                                                    押したらこの商品を開いている間だけ全部並べる
                                                -->
                                                <Button Content="{Binding Name}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                        Visibility="{Binding IsMoreTile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                                        Command="{Binding DataContext.ShowAllAvatarsCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="残りの対応アバターも並べます。多い商品は、開くのを速くするため最初は一部だけ並べています。" />

                                                <!--
                                                    末尾の「＋ 追加」（ユーザ指示）。押すとその場に候補付きの入力欄を出し、すぐ打てる。
                                                    出品者が書き漏らしている場合や、検出が拾えなかった場合の補い
                                                -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,6,6"
                                                            Visibility="{Binding IsAddTile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <Button Content="＋ 追加" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.StartAddAvatarCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            ToolTip="対応アバターを手で足します。出品者が書き漏らしている場合や、検出が拾えなかった場合に。"
                                                            Visibility="{Binding DataContext.IsAddingAvatar,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                    <controls:SuggestBox Width="240"
                                                                         Source="{Binding DataContext.SupportSuggestions,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         CommitCommand="{Binding DataContext.AddAvatarCommand,
                                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         IconSelector="{Binding DataContext.AvatarIconSelector,
                                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         AllowNew="False" Placeholder="足すアバターの名前"
                                                                         IsVisibleChanged="OnAddBoxVisibleChanged"
                                                                         Visibility="{Binding DataContext.IsAddingAvatar,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                                                                      Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    <Button Content="閉じる" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.StopAddAvatarCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Visibility="{Binding DataContext.IsAddingAvatar,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding AvatarBases}" Margin="0,4,0,0"
                                              Visibility="{Binding HasAvatarBases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                    BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center" />
                                                    <TextBlock Text="共通素体" FontSize="10" Margin="7,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    消したもの（ユーザ判断 2026-09-12）。以前は消すと画面のどこにも出ず、
                                    消したことも戻せることも分からなかった。普段は畳んで末尾に置き、1件ずつ戻せる
                                -->
                                <Expander Header="{Binding RejectedAvatarsHeader}" Margin="0,10,0,0"
                                          IsExpanded="{Binding IsRejectedAvatarsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding HasRejectedAvatars, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <ItemsControl ItemsSource="{Binding RejectedAvatars}" Margin="4,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RejectedAvatarRow}">
                                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                        BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                        <Button Content="戻す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                                Command="{Binding RestoreCommand}"
                                                                ToolTip="この対応を戻します。出どころは「手入力」になります（元の出どころには戻りません）。" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!--
                                    「着せているアバター」の入力欄はここから消した。

                                    着せた記録は**改変（着せ替え1つ）を単位に**持つことにしたので、
                                    商品1件にアバターを直接ぶら下げる形は要らなくなった。
                                    同じことを2箇所に持つと必ずずれる。
                                    足す先は「この商品を使った改変」のカード（右の列）。
                                -->
                            </StackPanel>
                        </Expander>
                    </Border>
</UserControl>
