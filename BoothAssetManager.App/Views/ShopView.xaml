<UserControl x:Class="BoothAssetManager.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShopViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Button Content="{Binding BackText}" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Command="{Binding BackCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RefreshStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRefreshStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 外部で更新を知ったときに、次の確認時期を待たずに取り直せるようにする -->
                    <Button Content="画像を取り直す" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshImagesCommand}"
                            ToolTip="このショップのアイコンとバナーを、普段と同じ手順で取り直します。" />
                    <Button Content="BOOTHのショップページを開く" Style="{StaticResource SmallButton}"
                            Command="{Binding OpenBoothCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            バナー。置いていないショップもあるので、無ければ帯ごと出さない。
            切り取らずに全体を出す（作者が作った絵なので、勝手に一部だけ見せない）。
            大きさはBOOTHの見せ方（960x320）に合わせ、縦横比が違うバナーは
            その枠に収まるところまで縮める。
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowBannerArea, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Height="320">
                <!--
                    有無が分からない間は、同じ高さの場所を空けて待つ。
                    空けておかないと、後からバナーが差し込まれて中身が下へずれる。
                -->
                <Border Background="{StaticResource SurfaceAlt}" Width="960"
                        Visibility="{Binding HasBanner, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding BannerPlaceholderText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Image Source="{Binding Banner}" Stretch="Uniform"
                       MaxWidth="960" MaxHeight="320" HorizontalAlignment="Center"
                       Visibility="{Binding HasBanner, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </Grid>
        </Border>

        <!-- ショップの見出しと集計 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" CornerRadius="12" ClipToBounds="True"
                            Background="{StaticResource AccentSoft}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                       Foreground="#4a5160"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInitial, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DomainText}" Style="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource TextFaint}" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding OwnedText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="購入総額" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SpentText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="容量" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最終購入" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LastAcquiredText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="24,14,24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="このショップの商品" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11.5"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <!-- 全商品ではないことを書いておく。件数の意味が変わってしまう -->
                    <TextBlock Text="BOOTHの全商品ではなく、ローカルに情報があるものだけです。"
                               Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <CheckBox Content="所持しているものだけ" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Foreground="{StaticResource Text}" />
            </Grid>
        </Border>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="表示する商品がありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,24,24">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="228" Height="300" Margin="0,0,14,14"
                                    Cursor="Hand" MouseLeftButtonUp="OnCardClick" ClipToBounds="True">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Height="180" Background="#e9edf4">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />

                                        <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="8,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                Visibility="{Binding IsOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="所持" FontSize="10" Foreground="{StaticResource Good}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap"
                                                   MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ShopName}" Style="{StaticResource Mono}"
                                                   FontSize="11" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0" />
                                        <Border Height="1" Background="#f0f1f4" Margin="0,8,0,7" />
                                        <Grid>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                                       FontSize="11" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Text="{Binding UserTagText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120" />
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
