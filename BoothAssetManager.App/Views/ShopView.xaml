<UserControl x:Class="BoothAssetManager.App.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShopViewModel}">
    <!--
        商品は検索画面と同じカードとリストで並べる（ユーザ指示 2026-09-15：ショップ画面の item 閲覧も検索同等に）。
        前はこの画面だけの小さなカードで、押して開く以外の操作（右クリック・星・リスト）が無かった
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ItemCardResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <!-- 戻るの見た目はどの画面でも同じ（枠なし・透明。V2）。ここだけ枠付きの小さいボタンだった -->
                <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                        BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{Binding ShowsBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RefreshStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRefreshStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 外部で更新を知ったときに、次の確認時期を待たずに取り直せるようにする -->
                    <Button Content="画像を取り直す" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshImagesCommand}"
                            ToolTip="このショップのアイコンとバナーを、普段と同じ手順で取り直します。" />
                    <!-- 絞り込みはショップ画面に作らず、検索の絞り込みをそのまま使う（#55） -->
                    <Button Content="このショップの商品を検索で開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            Command="{Binding ShowInSearchCommand}"
                            ToolTip="検索画面へ移り、このショップの商品だけを出します。分類・対応アバター・タグなどで続けて絞れます。" />
                    <Button Content="BOOTHのショップページを開く" Style="{StaticResource SmallButton}"
                            ToolTip="BOOTHのショップページをブラウザで開きます（アプリの外へ出ます）。"
                            Command="{Binding OpenShopPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            バナー。置いていないショップもあるので、無ければ帯ごと出さない。
            切り取らずに全体を出す（作者が作った絵なので、勝手に一部だけ見せない）。
            大きさはBOOTHの見せ方（960x320）に合わせ、縦横比が違うバナーは
            その枠に収まるところまで縮める。
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowBannerArea, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Height="320">
                <!--
                    有無が分からない間は、同じ高さの場所を空けて待つ。
                    空けておかないと、後からバナーが差し込まれて中身が下へずれる。
                -->
                <Border Background="{StaticResource SurfaceAlt}" Width="960"
                        Visibility="{Binding HasBanner, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding BannerPlaceholderText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Image Source="{Binding Banner}" Stretch="Uniform"
                       MaxWidth="960" MaxHeight="320" HorizontalAlignment="Center"
                       Visibility="{Binding HasBanner, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </Grid>
        </Border>

        <!-- ショップの見出しと集計 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" CornerRadius="12" ClipToBounds="True"
                            Background="{StaticResource AccentSoft}">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                       Foreground="#4a5160"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInitial, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                   Visibility="{Binding HasIcon, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <!--
                                お気に入りのショップ（ユーザ判断 2026-09-16）。キーボードと読み上げから押せるようボタンにし、
                                暗黙のボタンの枠と余白が付かないよう見た目は差し替える
                            -->
                            <Button Command="{Binding ToggleFavoriteCommand}" Margin="10,0,0,0" Cursor="Hand"
                                    VerticalAlignment="Center" ToolTip="{Binding FavoriteTip}"
                                    AutomationProperties.Name="{Binding FavoriteTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="2,0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding FavoriteGlyph}" FontSize="22">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="#d99a00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding DomainText}" Style="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource TextFaint}" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="所持" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding OwnedText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="購入総額" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SpentText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                        <TextBlock Text="容量" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最終購入" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding LastAcquiredText}" Style="{StaticResource Mono}"
                                   FontSize="22" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ショップのメモ（ユーザ判断 2026-09-16）。利用規約・問い合わせ先・作者の別名義など、ショップ単位でしか持てない知識。
            止まってから書く（打つたびには書かない）
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,10,24,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                <Grid>
                    <TextBox MaxLength="10000" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="40" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             FontSize="12.5" Padding="6,4" AutomationProperties.Name="ショップのメモ" />
                    <!-- 使い道を決めつけない（ユーザ指示 2026-09-16） -->
                    <TextBlock Text="このショップについてのメモ"
                               Margin="10,6,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Memo}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!--
            件数（左）と「所持しているものだけ」・カード／リスト（右）。入り切らなければ右を次の行へ送る（検索の結果の上の帯と同じ部品）。
            切り替えは一覧の右下に浮かせていたが、狭い窓でカードの上に重なった（点検 2026-09-23）
        -->
        <Border DockPanel.Dock="Top" Padding="24,14,24,0">
            <controls:SplitRowPanel MinLeftWidth="240">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="このショップの商品" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11.5"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <!-- 全商品ではないことを書いておく。件数の意味が変わってしまう。狭いときは省略して縮む -->
                    <TextBlock Text="BOOTHの全商品ではなく、ローカルに情報があるものだけです。" TextTrimming="CharacterEllipsis"
                               ToolTip="BOOTHの全商品ではなく、ローカルに情報があるものだけです。"
                               Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="所持しているものだけ" IsChecked="{Binding OwnedOnly, Mode=TwoWay}"
                              VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemViewModeSwitch}" Focusable="False"
                                    Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SplitRowPanel>
        </Border>

        <!-- 選んでいる間と、Unity へ送っている間に出す、まとめて操作の帯（検索・フォルダビューと同じ。動線の点検 C1） -->
        <ContentControl DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource ItemSelectionBar}" Focusable="False"
                        Visibility="{Binding ShowsSelectionBar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

        <Grid SizeChanged="OnListSizeChanged">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="表示する商品がありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <!-- なぜ無いのかと戻し方（動線の点検 D8）。空表示には次にやることを書く -->
                <TextBlock Text="{Binding EmptyReasonText}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,6,0,0" />
                <Button Content="設定を開く" Style="{StaticResource SmallButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Command="{Binding ShowSettingsCommand}"
                        Visibility="{Binding HasExcluded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>

            <!-- リスト。列の幅は見出しの境目をドラッグで変え、全部の行で共通（ショップ画面として覚える） -->
            <ListView ItemsSource="{Binding ListItems}" View="{StaticResource ItemListGridView}"
                      ItemContainerStyle="{StaticResource ItemListRowStyle}"
                      BorderThickness="0" Background="Transparent" Margin="24,10,24,18"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Visibility="{Binding IsListMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!--
                行を仮想化の単位にする（検索画面と同じ）。列数はViewModel側で幅から決める。
                画面外の行のカードは作られないので、サムネイルの読み込みも走らない
            -->
            <!-- カードの行の一覧。Tab で1枚ずつ進めるよう、一覧に1回だけ止まる既定（Once）をやめる（点検 2026-09-23） -->
            <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue"
                     Visibility="{Binding IsCardMode, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                     Padding="24,14,24,24" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <!-- 行そのものは選択対象ではない。見た目も当たり判定も持たせない -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ItemCardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
