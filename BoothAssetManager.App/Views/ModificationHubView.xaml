<UserControl x:Class="BoothAssetManager.App.Views.ModificationHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModificationHubViewModel}">
    <!--
        改変の画面（2026-09-13 ユーザ仕様「改変周りの刷新」）。
        左の上で「Unityプロジェクト」「アバター」「改変」の見方を切り替え、その下で探す。右は押したもののビュー。
        右のビューの中身はこれまでの画面から程よい量で作った（ユーザ：後から修正を指示する）。
    -->
    <UserControl.Resources>
        <!--
            文字だけのボタン。暗黙の Button スタイルは中央揃えと枠を持っていて上書きが効かないので、型ごと差し替える
        -->
        <Style x:Key="HubLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 畳む印。中身の無い行では印が空になる（ExpandGlyph） -->
        <Style x:Key="HubToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!--
                            三角は文字（▸▾）ではなく図形で描く。文字は小さく描かれる字形で、字を 11 → 14 に上げても見た目がほとんど変わらなかった
                            （ユーザ指摘 2026-09-13「折り畳みの三角が少し小さいかも」）。幅18の枠の真ん中に置くのは同じ（縦線を三角の真下に下ろしている）
                        -->
                        <Border Background="Transparent">
                            <Path x:Name="Mark" Data="M0,0 L6,4.5 L0,9 Z" Fill="{StaticResource TextMuted}"
                                  Width="6" Height="9" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding HasGlyph, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L9,0 L4.5,6 Z" />
                                <Setter TargetName="Mark" Property="Width" Value="9" />
                                <Setter TargetName="Mark" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            見方の切り替え（ユーザ指示 2026-09-13：「繋がった一つの四角で3つに分かれていて、それぞれの領域を押すとそれが選択される」）。
            選べるのは1つだけ、という意味は RadioButton のままで、見た目だけ区切りの付いた1つの枠にする。
            WPF の ClipToBounds は角丸で切らないので、塗りの角丸は両端の区画にだけ Tag で渡す。
            選んだ区画の字を太らせると幅が変わって隣が動くので、太字の幅を見えない字で先に取っておく
        -->
        <Style x:Key="HubSegment" TargetType="RadioButton">
            <Setter Property="GroupName" Value="HubLevel" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="SemiBold" Visibility="Hidden" />
                                <!-- 選んだ側の白字が暗黙の TextBlock の色に負けて黒く出ていた。中の文字に親の色を渡す（ItemViewModeSegment と同じ） -->
                                <ContentPresenter HorizontalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                            <!-- 白字を色地に載せると細い字画が沈むので、PrimaryButton と同じく少し太らせる -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>

        <!--
            押せる行（ユーザ指示 2026-09-20・B3）。行を押す意味は「選ぶ（右に出す）」と「開く」の2つだけにし、
            **この一覧は全部「選ぶ」**。以前は名前の文字だけが押せて、行のどこを押しても何も起きなかった。
            中のボタン（Unityで選択・Unityを開く・アバター・プロジェクト・三角）は自分で受け止めるので、ここまで上がってこない。
            押せることは、乗せたときの色と手の形で見せる
        -->
        <Style x:Key="HubPressableRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 見出しの行。地の色を持っているので、乗せたときだけ少し濃くする -->
        <Style x:Key="HubPressableHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,7,8,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 使ったもの1件（ファイル単位） -->
        <DataTemplate DataType="{x:Type vm:HubMemberRow}">
            <Border Style="{StaticResource HubPressableRow}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ShowMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <DockPanel Margin="0,3">
                <Button DockPanel.Dock="Right" Content="Unityで選択" Style="{StaticResource SmallButton}"
                        VerticalAlignment="Center" Margin="6,0,0,0"
                        Command="{Binding DataContext.SelectInUnityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="改変に紐付けたプロジェクトに入っていれば、Unity のプロジェクトタブの検索欄に入り先のフォルダ名を入れて示します。入っていなければ、取り込むか聞きます。" />
                <!-- 絵も名前と同じリンク（ユーザ指示 2026-09-13）。小さな名前だけを狙って押させない -->
                <Button DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Name}"
                        ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                        Command="{Binding DataContext.ShowMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <!-- ホバーで大きめの絵を出す（ユーザ指示 2026-09-13）。編集画面の上の帯と同じ形。
                         はじめ 240px にしたら「大きすぎるかも。少し小さくして」と言われて 180px にした -->

                    <Button.ToolTip>
                        <ToolTip Padding="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}">
                            <StackPanel Width="180">
                                <Border Width="180" Height="180" CornerRadius="6" Background="#edeff3" ClipToBounds="True"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <Border Width="34" Height="34" CornerRadius="4"
                            Background="{StaticResource SurfaceAlt}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource HubLink}" ToolTip="{Binding Name}"
                            Command="{Binding DataContext.ShowMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="手元にありません" FontSize="10.5" Margin="6,0,0,0"
                                   Foreground="{StaticResource Warn}"
                                   Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding FileText}" Style="{StaticResource Mono}" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileText}" />
                    </DockPanel>
                </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 改変1件。見方によって、アバター・プロジェクトへの繋がりを出し分ける -->
        <DataTemplate DataType="{x:Type vm:HubModificationRow}">
            <StackPanel Margin="0,4,0,2">
                <Border Style="{StaticResource HubPressableRow}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.ShowModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Style="{StaticResource HubToggle}" VerticalAlignment="Top"
                                  Margin="0,10,2,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,9,0" VerticalAlignment="Top"
                            AutomationProperties.Name="{Binding Name}"
                            ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                            Command="{Binding DataContext.ShowModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.ToolTip>
                            <ToolTip Padding="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}">
                                <StackPanel Width="180">
                                    <Border Width="180" Height="180" CornerRadius="6" Background="#edeff3" ClipToBounds="True"
                                            Margin="0,0,0,8"
                                            Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource Text}" />
                                    <TextBlock Text="押すと、この改変を右に表示します" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Border Width="38" Height="38" CornerRadius="5"
                                Background="{StaticResource AccentSoft}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Initial}" FontSize="13" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource HubLink}" ToolTip="この改変を右に表示します"
                                Command="{Binding DataContext.ShowModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <WrapPanel Margin="0,1,0,0">
                            <Button Style="{StaticResource HubLink}" Margin="0,0,8,0" ToolTip="このアバターを右に表示します"
                                    Visibility="{Binding ShowsAvatar, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    Command="{Binding DataContext.ShowAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding AvatarItemId}">
                                <TextBlock Text="{Binding AvatarName}" FontSize="11" Foreground="{StaticResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                            <Button Style="{StaticResource HubLink}" Margin="0,0,8,0" ToolTip="このUnityプロジェクトを右に表示します"
                                    Visibility="{Binding ShowsProjectLink, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                    Command="{Binding DataContext.ShowProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ProjectPath}">
                                <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{StaticResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding MemoText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   Visibility="{Binding HasMemo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </DockPanel>
                </Border>
                <!-- 畳んだ中身の字下げは、ユーザ指示（2026-09-13「少しだけ深く」）で見出しの下 14→22、改変の下 28→36 にした -->
                <!-- 縦線は改変の三角の真下（三角の幅 18 の半分 = 9）。中身の位置は線が無かったときと同じ 36 -->
                <Border Margin="9,4,0,4" Padding="26,0,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Members}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Unityプロジェクトの見出し -->
        <DataTemplate DataType="{x:Type vm:HubProjectGroup}">
            <StackPanel Margin="0,0,0,8">
                <Border Style="{StaticResource HubPressableHeader}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ShowProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding Path}" />
                    </Border.InputBindings>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource HubToggle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                        <!-- 文言はユーザ指摘（2026-09-13「「Unityで開く」は「Unityを開く」ですね」） -->
                        <Button DockPanel.Dock="Right" Content="Unityを開く" Style="{StaticResource SmallButton}"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                IsEnabled="{Binding CanOpen}"
                                Visibility="{Binding IsProject, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding OpenHint}" />
                        <StackPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource HubLink}"
                                    Command="{Binding DataContext.ShowProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <WrapPanel Margin="0,2,0,0">
                                <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                        BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,6,0"
                                        Visibility="{Binding IsOpen, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Text="開いている" FontSize="10" Foreground="{StaticResource Good}" />
                                </Border>
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!--
                    畳んだ中身の左に縦線を下ろし、どの見出しの中身かを分かりやすくする（ユーザ指示 2026-09-13）。
                    線は三角の真下（見出しの枠の左の余白 4 ＋ 三角の幅 18 の半分 = 13）。中身の位置は線が無かったときと同じ 22
                -->
                <Border Margin="13,2,0,0" Padding="8,0,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Modifications}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- アバターの見出し -->
        <DataTemplate DataType="{x:Type vm:HubAvatarGroup}">
            <StackPanel Margin="0,0,0,8">
                <Border Style="{StaticResource HubPressableHeader}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ShowAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding AvatarItemId}" />
                    </Border.InputBindings>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource HubToggle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource HubLink}" Margin="0,0,9,0"
                                AutomationProperties.Name="{Binding Title}"
                                ToolTipService.InitialShowDelay="300" ToolTipService.Placement="Right"
                                Command="{Binding DataContext.ShowAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding AvatarItemId}">
                            <Button.ToolTip>
                                <ToolTip Padding="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}">
                                    <StackPanel Width="180">
                                        <Border Width="180" Height="180" CornerRadius="6" Background="#edeff3" ClipToBounds="True"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding HasHoverImage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <Image Source="{Binding HoverImage}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Text}" />
                                        <TextBlock Text="押すと、このアバターを右に表示します" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource SurfaceAlt}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="改変を作る" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding DataContext.StartCreateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding AvatarItemId}" />
                            <Button Content="アバターの管理へ" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding DataContext.OpenAvatarManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding AvatarItemId}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource HubLink}" ToolTip="{Binding Title}"
                                    Command="{Binding DataContext.ShowAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding AvatarItemId}">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding OwnedText}" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!--
                    畳んだ中身の左に縦線を下ろし、どの見出しの中身かを分かりやすくする（ユーザ指示 2026-09-13）。
                    線は三角の真下（見出しの枠の左の余白 4 ＋ 三角の幅 18 の半分 = 13）。中身の位置は線が無かったときと同じ 22
                -->
                <Border Margin="13,2,0,0" Padding="8,0,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Modifications}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 右側：Unityプロジェクト -->
        <DataTemplate DataType="{x:Type vm:HubProjectDetail}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22" MaxWidth="{StaticResource ReadingMaxWidth}">
                    <TextBlock Text="Unityプロジェクト" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    <!--
                        「項目：値」の行で並べる（ユーザ指示 2026-09-14：版・開いているか・一覧の名前が、見出しの無い札で
                        「Unity 2022.3.22f1」「閉じています」「VCC の一覧」と内部の言い方のまま並んでいた）
                    -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style x:Key="ProjectInfoLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Margin" Value="0,3,16,3" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="ProjectInfoValue" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Margin" Value="0,3,0,3" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="状態" Style="{StaticResource ProjectInfoLabel}" />
                        <!-- 開いていれば緑、フォルダが無ければ注意の色 -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateValue}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ProjectInfoValue}">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="バージョン" Style="{StaticResource ProjectInfoLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionValue}" Style="{StaticResource ProjectInfoValue}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="情報元" Style="{StaticResource ProjectInfoLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SourceValue}" Style="{StaticResource ProjectInfoValue}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最後に触った日" Style="{StaticResource ProjectInfoLabel}"
                                   Visibility="{Binding HasLastWrite, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastWriteValue}" Style="{StaticResource ProjectInfoValue}"
                                   Visibility="{Binding HasLastWrite, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                    <!--
                        外のアプリ・エクスプローラを開くのは**どの画面でも小さいボタン**（ユーザ判断 2026-09-20・V1）。
                        主のボタン（青）は「その画面で今いちばんやってほしいこと」1つだけに使う
                    -->
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Unityを開く" Style="{StaticResource SmallButton}" IsEnabled="{Binding Exists}"
                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding OpenProjectHint}" />
                        <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}" Margin="8,0,0,0" IsEnabled="{Binding Exists}"
                                Command="{Binding DataContext.OpenProjectFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="このプロジェクトの改変" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding HasModifications, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                            <ItemsControl ItemsSource="{Binding Modifications}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 右側：アバター（改変に関係する所だけ） -->
        <DataTemplate DataType="{x:Type vm:HubAvatarDetail}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22" MaxWidth="{StaticResource ReadingMaxWidth}">
                    <TextBlock Text="アバター" Style="{StaticResource SectionLabel}" />
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="36" Margin="0,0,16,0"
                                Background="{StaticResource SurfaceAlt}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Initial}" FontSize="22" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BoothName}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding HasBoothName, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Border Style="{StaticResource HubBadge}">
                                    <TextBlock Text="{Binding OwnedText}" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource HubBadge}"
                                        Visibility="{Binding HasBase, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                    <TextBlock Text="{Binding BaseText}" FontSize="11" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="アバターの管理へ"
                                Command="{Binding DataContext.OpenAvatarManageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding AvatarItemId}"
                                ToolTip="名前・別名・共通素体などの設定は、アバターの管理で変えられます。" />
                        <Button Content="商品ページを開く" Margin="8,0,0,0"
                                Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                Command="{Binding DataContext.OpenItemPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding AvatarItemId}" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="このアバターの改変" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <TextBlock Text="まだありません。下で名前を付けて作れます。" Style="{StaticResource Caption}"
                                       Visibility="{Binding HasModifications, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                            <ItemsControl ItemsSource="{Binding Modifications}" />

                            <Border Height="1" Background="{StaticResource Border}" Margin="0,12" />
                            <TextBlock Text="新しい改変" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="改変を作る" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.CreateModificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                         VerticalContentAlignment="Center" Padding="7,0" />
                            </DockPanel>
                            <TextBlock Text="「普段着」「制服」のように、着せ替え1つにつき1つ作ります。同じアバターに何個でも作れます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 右側：使ったもの1件（商品の要約）。全部の操作は商品ページで -->
        <!--
            右側：使ったもの1件。手元にある商品は商品ページをそのまま組み込み（ユーザ指示 2026-09-14：ほかの画面と同じ商品ページを右に出す。
            3つの見方すべて）、この改変に固有の物は上の帯に出す。手元に無い商品は商品ページが無いので、下のこれまでの要約
        -->
        <DataTemplate DataType="{x:Type vm:HubItemDetail}">
            <Grid>
            <DockPanel Visibility="{Binding HasPage, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="0,0,0,1" Padding="20,10">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Unityで選択" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.SelectInUnityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding ProjectText}" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                <Run Text="「" /><Run Text="{Binding ModificationName, Mode=OneWay}" FontWeight="Bold" /><Run Text="」で使ったファイル：" />
                                <Run Text="{Binding FileText, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono" FontSize="12" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding VariationText}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Visibility="{Binding HasVariation, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding DestinationText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Expander Header="{Binding UsedInHeader}" Margin="0,6,0,0" FontSize="12">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding UsedIn}" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding Page}" Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:ItemView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasPage, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                <StackPanel Margin="28,22" MaxWidth="{StaticResource ReadingMaxWidth}">
                    <TextBlock Text="使ったもの" Style="{StaticResource SectionLabel}" />
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Left" Width="180" Height="180" CornerRadius="6" Margin="0,0,18,0"
                                Background="{StaticResource SurfaceAlt}" ClipToBounds="True" VerticalAlignment="Top">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ShopText}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Visibility="{Binding HasShop, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Style="{StaticResource HubBadge}" Background="{StaticResource WarnSoft}"
                                    BorderBrush="{StaticResource WarnBorder}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="手元にありません（記録は残っています）" FontSize="11" Foreground="{StaticResource Warn}" />
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="商品ページを開く" IsEnabled="{Binding CanOpenItem}"
                                        Command="{Binding DataContext.OpenItemPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding ItemId}" />
                                <Button Content="Unityで選択" Margin="8,0,0,0"
                                        Command="{Binding DataContext.SelectInUnityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ProjectText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,8">
                                <Run Text="「" /><Run Text="{Binding ModificationName, Mode=OneWay}" /><Run Text="」で使ったファイル" />
                            </TextBlock>
                            <TextBlock Text="{Binding FileText}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VariationText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding HasVariation, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding DestinationText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="この商品を使った改変" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding UsedIn}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </DataTemplate>

        <!-- 右側：改変。これまでの改変の画面をそのまま組み込む（戻るを隠し、消すを出す） -->
        <DataTemplate DataType="{x:Type vm:ModificationViewModel}">
            <views:ModificationView />
        </DataTemplate>
    </UserControl.Resources>

    <controls:PaneGrid Background="{StaticResource Bg}" Pane="{Binding ListPane}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                              MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
        <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                               ResetCommand="{Binding ListPane.ResetCommand}" />

        <!-- 左：見方の切り替え・探す・一覧 -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 今どの画面にいるかを、ほかの画面の上の帯と同じく太字の名前で出す（ユーザ指示 2026-09-14） -->
                <TextBlock DockPanel.Dock="Top" Text="改変" FontWeight="Bold" Margin="16,16,16,0" />
                <StackPanel DockPanel.Dock="Top" Margin="16,10,16,8">
                    <DockPanel>
                        <!--
                            VCC は起動するだけ（中身の管理はしない・ユーザ仕様）。Unityプロジェクトの見方の時だけ、
                            切り替えの右に出す（ユーザ指示 2026-09-13。検索欄の横に並べると、何に効くボタンか分かりにくかった）
                        -->
                        <Button DockPanel.Dock="Right" Content="VCCを開く" Style="{StaticResource SmallButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding OpenVccCommand}" IsEnabled="{Binding CanOpenVcc}"
                                ToolTip="{Binding VccHint}" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.HelpText="{Binding VccHint}"
                                Visibility="{Binding IsProjectLevel, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Unityプロジェクト" Style="{StaticResource HubSegment}"
                                             IsChecked="{Binding IsProjectLevel, Mode=TwoWay}">
                                    <RadioButton.Tag>
                                        <CornerRadius>5,0,0,5</CornerRadius>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <Border Width="1" Background="{StaticResource BorderStrong}" />
                                <RadioButton Content="アバター" Style="{StaticResource HubSegment}"
                                             IsChecked="{Binding IsAvatarLevel, Mode=TwoWay}">
                                    <RadioButton.Tag>
                                        <CornerRadius>0</CornerRadius>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <Border Width="1" Background="{StaticResource BorderStrong}" />
                                <RadioButton Content="改変" Style="{StaticResource HubSegment}"
                                             IsChecked="{Binding IsModificationLevel, Mode=TwoWay}">
                                    <RadioButton.Tag>
                                        <CornerRadius>0,5,5,0</CornerRadius>
                                    </RadioButton.Tag>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- 「読み直す」のボタンは置かない。窓が手前に戻るたびに読み直す（ユーザ判断 2026-09-13） -->
                    <DockPanel Margin="0,12,0,0">
                        <Grid>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" Height="30"
                                     VerticalContentAlignment="Center" Padding="7,0"
                                     AutomationProperties.Name="{Binding QueryPlaceholder}" />
                            <TextBlock Text="{Binding QueryPlaceholder}" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextFaint}"
                                       Visibility="{Binding HasQuery, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                        </Grid>
                    </DockPanel>

                </StackPanel>

                <!--
                    状態の1行は左の欄のいちばん下に置く（ユーザ指示 2026-09-13）。一覧の上に置いていたときは、
                    「Unityで選択」の「…の中を調べています」から結果の文（2〜3行）に変わるたびに一覧が押し下げられ、
                    押したボタンがカーソルの下から逃げた。下なら文が出ても消えても長さが変わっても、行は動かない
                -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                        Background="{StaticResource Bg}" Padding="16,8"
                        Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="18,10,18,0"
                           Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="12,0,12,12" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右：押したもののビュー -->
        <ContentControl Grid.Column="1" Content="{Binding Detail}" Focusable="False" />
        <TextBlock Grid.Column="1" Text="左の一覧から、プロジェクト・アバター・改変・使ったものを押すと、ここに表示されます。"
                   Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasDetail, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
    </controls:PaneGrid>
</UserControl>
