<UserControl x:Class="BoothAssetManager.App.Views.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <!-- 上部バー -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding BackText}" Command="{Binding BackCommand}" BorderThickness="0" Background="Transparent" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RefreshStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,10,0" MaxWidth="320" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasRefreshStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <!-- 外部で更新を知ったときに、次回更新予定を待たずに取り直せるようにする -->
                    <Button Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            ToolTip="商品名・価格・バリエーション・説明文・画像をBOOTHから取り直します。&#10;メモや分類など自分で入れたものは変わりません。" />
                    <Button Content="この商品を編集" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                    <Button Content="BOOTHで開く" Command="{Binding OpenBoothCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="660" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：ギャラリーと説明 -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <StackPanel>
                            <Grid Height="420" Background="#e9edf4">
                                <Image Source="{Binding SelectedImage}" Stretch="Uniform" />
                                <Border Background="#99000000" CornerRadius="9" Padding="8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                    <TextBlock Text="{Binding GalleryCounter}" Foreground="White" FontSize="11" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Images}" Margin="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            乗せて少し止めると切り替わる（設定 GallerySwitchOnHover / GalleryHoverDelayMs）。
                                            クリックなら待たずに即座に切り替わる。
                                        -->
                                        <Button Width="68" Height="54" Margin="0,0,8,8" Padding="0"
                                                Background="#eef0f2" Cursor="Hand"
                                                MouseEnter="OnThumbnailMouseEnter"
                                                MouseLeave="OnThumbnailMouseLeave"
                                                Command="{Binding DataContext.SelectImageCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                    <Setter Property="Opacity" Value="0.72" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                                <!-- BOOTH側から消えた画像は控えめに示す -->
                                                <Border Background="#66000000"
                                                        Visibility="{Binding IsOrphaned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="削除済" Foreground="White" FontSize="9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding OrphanedImageText}" Style="{StaticResource Caption}" Margin="12,0,12,12"
                                       Visibility="{Binding HasOrphanedImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!--
                                まだ取っていない画像があるときだけ出す。自動で「見えたものを優先」に
                                しないのは、勢いよくスクロールされると順番待ちが「もう見ていないもの」で
                                埋まるため。押した意思の方が、見えたという事実より確か。
                            -->
                            <StackPanel Orientation="Horizontal" Margin="12,0,12,12"
                                        Visibility="{Binding HasMissingImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding MissingImageText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="この商品の画像取得を優先" FontSize="12"
                                        Command="{Binding FetchImagesCommand}" />
                            </StackPanel>

                            <TextBlock Text="取得しています…" Style="{StaticResource Caption}" Margin="12,0,12,12"
                                       Visibility="{Binding IsFetchingImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!--
                                取れなかった枚数は出す。ギャラリーの枚数がBOOTHと合わない理由が、
                                それ以外に説明できないため。商品を取り直せば印は消え、この行も消える。
                            -->
                            <TextBlock Text="{Binding UnavailableImageText}" Style="{StaticResource Caption}" Margin="12,0,12,12"
                                       Visibility="{Binding HasUnavailableImages, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <TextBlock Text="{Binding ImageFetchNotice}" Style="{StaticResource Caption}" Margin="12,0,12,12"
                                       Visibility="{Binding HasImageFetchNotice, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!-- 説明文 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="商品説明" FontWeight="Bold" Margin="0,0,0,12" />

                            <!--
                                説明文とh2は選択可能にし、含まれるURLはリンクにする。
                                対応アバターのURLがh2に並ぶことがあり、そこから直接飛べると早い。
                            -->
                            <RichTextBox Style="{StaticResource SelectableBody}" Margin="-2,0,0,14"
                                         controls:SelectableText.Text="{Binding Description}"
                                         controls:SelectableText.Navigator="{Binding}"
                                         Visibility="{Binding HasDescription, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <Border BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Padding="9,0">
                                                <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                            </Border>
                                            <RichTextBox Style="{StaticResource SelectableBody}" Margin="-2,7,0,0"
                                                         controls:SelectableText.Text="{Binding Text}"
                                                         controls:SelectableText.Navigator="{Binding DataContext,
                                                                   RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右：情報 -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <!--
                                自分で付けたuserTagを先頭に置き、BOOTHのタグをすぐ下に続ける。
                                同じ「タグ」なのに離れていると見比べられない。
                            -->
                            <TextBlock Text="ユーザータグ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding UserTags}"
                                          Visibility="{Binding HasUserTags, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Top}" FontSize="12" Foreground="#28507f" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="未設定（編集画面で付けます）">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUserTags}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="BOOTHのタグ" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12"
                                                Padding="10,3" Margin="0,0,6,6" Background="White">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#454b57" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="#f0f1f4" Margin="0,10,0,14" />

                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <!-- 作者名からはアプリ内のショップ画面へ。外部BOOTHには飛ばさない -->
                            <TextBlock Margin="0,8,0,0">
                                <Hyperlink Command="{Binding OpenShopCommand}" TextDecorations="{x:Null}"
                                           Foreground="{StaticResource Accent}"
                                           ToolTip="このショップの商品を見る">
                                    <TextBlock Text="{Binding ShopName}" FontSize="13" />
                                </Hyperlink>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding IdText}" Style="{StaticResource Mono}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding PublishedText}" Style="{StaticResource Mono}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding WishText}" Style="{StaticResource Mono}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- バリエーション -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                                <TextBlock Text="バリエーション" FontWeight="Bold" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Variations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="18,12">
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsGone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="BOOTHに現存しない" FontSize="10" Foreground="{StaticResource TextFaint}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PriceText}" Style="{StaticResource Mono}" FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPurchased, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="購入済み" FontSize="12" Foreground="{StaticResource Good}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--
                        対応アバター。出品者の宣言（上）と、自分が着せている記録（下）を分ける。
                        混ぜると「誰が言っていることなのか」が分からなくなる。
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="対応アバター" FontWeight="Bold" />
                            <TextBlock Text="{Binding AvatarSectionNote}" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Avatars}" Margin="0,10,0,0"
                                          Visibility="{Binding HasAvatars, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AvatarRow}">
                                        <!--
                                            ここは閲覧が目的なので、全部が一度に見えることを優先する。
                                            出所を常時出すとチップが横に長くなり、1行に1〜2個しか入らなくなる。
                                            名前だけにして、出所はホバーへ回す。
                                        -->
                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6"
                                                ToolTip="{Binding SourceTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--
                                                    推定を確定と同じ顔で出さない、は守る。
                                                    ただし語ではなく印にして、幅を取らない形にする
                                                -->
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{StaticResource Warn}"
                                                         Visibility="{Binding IsUnconfirmed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
                                                <!--
                                                    検出の適合率は実測で89%。1割は誤りが出るので消せる必要がある。
                                                    乗せたときだけ出して、普段は宣言そのものを読ませる。
                                                -->
                                                <Button Content="×" Margin="7,0,0,0" Padding="3,0" FontSize="11"
                                                        Height="16" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Foreground="{StaticResource TextMuted}"
                                                        Command="{Binding RejectCommand}"
                                                        ToolTip="この対応は違う、として消します。次の検出でも復活しません。">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True"
                                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding AvatarBases}" Margin="0,4,0,0"
                                          Visibility="{Binding HasAvatarBases, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="11.5" VerticalAlignment="Center" />
                                                <TextBlock Text="共通素体" FontSize="10" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 出品者が書き漏らしている場合や、検出が拾えなかった場合の補い -->
                            <controls:SuggestBox Source="{Binding SupportSuggestions}"
                                                 CommitCommand="{Binding AddAvatarCommand}"
                                                 AllowNew="False" Margin="0,6,0,0"
                                                 Placeholder="対応アバターを足す" />

                            <Border Height="1" Background="#f0f1f4" Margin="0,12,0,12" />

                            <TextBlock Text="着せているアバター" FontWeight="Bold" FontSize="12.5" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Text="自分が実際に着せている記録です。出品者が対応と書いていなくても入れられます。" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextFaint}"
                                       Text="検出で消えることはありません。" />

                            <ItemsControl ItemsSource="{Binding UsedOn}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AvatarUsageRow}">
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,60,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding HasNote, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                            </StackPanel>
                                            <Button Content="外す" Style="{StaticResource SmallButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:SuggestBox Source="{Binding AvatarSuggestions}"
                                                 CommitCommand="{Binding AddUsedOnCommand}"
                                                 AllowNew="False" Margin="0,8,0,0"
                                                 Placeholder="着せているアバターを足す" />
                        </StackPanel>
                    </Border>

                    <!-- 属性 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16"
                            Visibility="{Binding HasAttributes, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="属性" FontWeight="Bold" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Attributes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextAlignment="Right" Margin="0,0,10,0" />
                                            <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#f0f1f4">
                                                <Border Height="8" CornerRadius="4" Background="{StaticResource Accent}"
                                                        Width="{Binding BarWidth}" HorizontalAlignment="Left" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Mono}"
                                                       FontSize="11" TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- メモ -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16"
                            Visibility="{Binding HasMemo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"
                                       Visibility="{Binding HasMemo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="#f0f1f4" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10"
                                    Visibility="{Binding HasMemo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <RichTextBox Style="{StaticResource SelectableBody}"
                                             controls:SelectableText.Text="{Binding Memo}"
                                             controls:SelectableText.Navigator="{Binding}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ローカルファイル -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,13">
                                <Grid>
                                    <TextBlock Text="ローカルファイル" FontWeight="Bold" />
                                    <TextBlock Text="{Binding FileSummary}" Style="{StaticResource Mono}" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <!-- フォルダとして所有しているもの。zipが残っていない展開済みの配布物 -->
                            <ItemsControl ItemsSource="{Binding LocalFolders}"
                                          Visibility="{Binding HasLocalFolders, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="18,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0">
                                                            <TextBlock Text="フォルダ" FontSize="10" Foreground="#28507f" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Mono}" FontSize="11"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsMissing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="見つかりません" FontSize="10" Foreground="{StaticResource Warn}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11"
                                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                    <!-- zipが入ったら教える。放っておくと容量が二重に数えられる -->
                                                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,7,0,0"
                                                            Visibility="{Binding HasArchive, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding ArchiveNoticeText}" FontSize="11.5"
                                                                   Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.OpenInExplorerCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Path}" />
                                                    <!-- zipを後から手に入れたら、二重計上になるので外せるようにする -->
                                                    <Button Content="登録を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                                            Command="{Binding DataContext.UnregisterFolderCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Path}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding LocalFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="18,12">
                                            <StackPanel>
                                              <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" />
                                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding HasVariationLabel, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding VariationLabel}" FontSize="10" Foreground="#28507f" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11" Margin="8,0,0,0" />
                                                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                            Visibility="{Binding HasMultiplePaths, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding DuplicateNote}" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                    </Border>
                                                </StackPanel>

                                                <!--
                                                    間違って紐付いたファイルを直す入口。1商品に複数ファイルがあり得るので、
                                                    商品単位ではなくファイル単位に置く（zipだけが誤りのことがある）
                                                -->
                                                <Button Grid.Column="1" Content="この商品から外す" Style="{StaticResource SmallButton}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="このファイルを未確定に戻します。ファイルは消しません。"
                                                        Command="{Binding DataContext.DetachFileCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                              </Grid>

                                                <!-- 保存場所ごとに開ける（削除も場所ごとに選べるようにする予定） -->
                                                <ItemsControl ItemsSource="{Binding Paths}" Margin="10,7,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#f0f1f4" BorderThickness="2,0,0,0" Padding="10,3" Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                                    <Button Grid.Column="1" Content="エクスプローラで開く" Style="{StaticResource SmallButton}"
                                                                            Command="{Binding DataContext.OpenInExplorerCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="18,10,18,14"
                                       Text="同じ中身のファイルは1件として数え、容量も1回だけ計上します（実際の占有量は統計で確認できます）。" />
                        </StackPanel>
                    </Border>

                    <!-- 更新情報 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,14">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="入手日" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding AcquiredText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="最終取得" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding LastFetchedText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="次回更新予定" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding NextFetchText}" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="更新通知" Style="{StaticResource SectionLabel}" />
                                <CheckBox IsChecked="{Binding NotifyOnUpdate, Mode=OneWay}" IsEnabled="False" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
