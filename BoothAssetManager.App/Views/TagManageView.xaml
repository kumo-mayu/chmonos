<UserControl x:Class="BoothAssetManager.App.Views.TagManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagManageViewModel}">
    <UserControl.Resources>
        <!-- 文字だけのボタン（改変の一覧と同じ）。暗黙の Button スタイルは中央揃えと枠を持つので型ごと差し替える -->
        <Style x:Key="TagItemLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 畳む印。改変の一覧・要確認と同じ形（三角は文字ではなく図形で描く） -->
        <Style x:Key="TagToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Mark" Data="M0,0 L6,4.5 L0,9 Z" Fill="{StaticResource TextMuted}"
                                  Width="6" Height="9" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L9,0 L4.5,6 Z" />
                                <Setter TargetName="Mark" Property="Width" Value="9" />
                                <Setter TargetName="Mark" Property="Height" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="タグの管理" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="商品は名前で参照しているので、名前の変更と削除は全商品の書き換えを伴います。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 並べ方（ユーザ指示 2026-09-18）。選ぶとファイルの並びも同じ順に書き換える -->
                    <TextBlock Text="並び" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <RadioButton Content="名前順" GroupName="TagSort" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Foreground="{StaticResource Text}" IsChecked="{Binding SortsByName, Mode=TwoWay}" />
                    <RadioButton Content="件数順" GroupName="TagSort" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Foreground="{StaticResource Text}" IsChecked="{Binding SortsByCount, Mode=TwoWay}" />
                    <RadioButton Content="手で並べた順" GroupName="TagSort" VerticalAlignment="Center" Margin="0,0,14,0"
                                 Foreground="{StaticResource Text}" IsChecked="{Binding SortsManually, Mode=TwoWay}"
                                 ToolTip="ドラッグで並べ替えると、自動でこれになります。" />
                    <Button Content="読み直す" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}" />

            <!-- 左：トップレベルの一覧。件数を並べるのは、消す前に影響が見えるように -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14" >
                        <TextBlock Text="タグを検索" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,6" BorderBrush="{StaticResource BorderStrong}" />

                        <controls:SuggestBox CommitCommand="{Binding AddTopCommand}" Margin="0,12,0,0"
                                             Placeholder="大分類を追加（例：衣装）" />
                    </StackPanel>

                    <!-- 並びは検索の絞り込みにも編集の候補にも出るので、ドラッグで変えられる -->
                    <ListBox ItemsSource="{Binding Tops}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnRowsPreviewMouseLeftButtonDown"
                             MouseMove="OnRowsMouseMove"
                             DragOver="OnRowsDragOver"
                             DragLeave="OnRowsDragLeave"
                             Drop="OnRowsDrop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent"
                                                    BorderBrush="#f0f1f4" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <!-- ドラッグ中に、どこへ落ちるかを示す線 -->
                                                    <Border Height="2" VerticalAlignment="Top" Background="{StaticResource Accent}"
                                                            Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource Accent}"
                                                            Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,13">
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SubCountText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Mono}" FontSize="11.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：選んだトップレベルの中身 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <!-- Leftにすると、状況表示の文の長さでカードの幅が動いてしまう -->
                <!-- 小分類を2列に流せるよう、右は幅いっぱいまで使う（ユーザ指示 2026-09-18） -->
                <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                    <!-- マスタに無い名前をitemが参照したまま。要確認は知らせるだけで、直せるのはここ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                            Visibility="{Binding HasOrphans, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Margin="18,15">
                            <TextBlock Text="一覧に無い分類" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Warn}" />
                            <!--
                                編集画面で打った分類はその場で一覧に入る（EditViewModel）。
                                ここに出るのは、JSONを直接直したか、一覧から消した後に商品側が残っている場合だけ。
                                通常の流れに手動追加の手順があるように読ませない。
                            -->
                            <TextBlock Text="編集画面で付けた分類は、その場で一覧に入ります。ここに出ているのは、JSONを直接直したか、一覧から消した後に商品側が残っている場合です。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="このままでは絞り込みに出てきません。名前が正しければ一覧に足し、変わったなら既存へ寄せ、もう使わないなら外してください。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />

                            <ItemsControl ItemsSource="{Binding Orphans}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource WarnBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- トップかサブかで直し方が変わるので、種別を出す -->
                                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindText}" FontSize="10"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="一覧に追加" Style="{StaticResource SmallButton}"
                                                                Command="{Binding AddToMasterCommand}" />
                                                        <Button Content="商品から外す" Style="{StaticResource SmallButton}"
                                                                Margin="6,0,0,0" Foreground="#9a3232"
                                                                Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                    <controls:SuggestBox Width="260" Margin="0,7,0,0" AllowNew="False"
                                                                         Placeholder="{Binding MergePlaceholder}"
                                                                         Source="{Binding MergeCandidates}"
                                                                         CommitCommand="{Binding MergeCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

                        <!-- トップレベルそのもの -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="20,18">
                                <Grid>
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="大分類" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="Bold"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding SelectedUsageText}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" />
                                            <!-- 件数だけでは消していいか統合していいか判断できないので、中身へ行けるようにする -->
                                            <Button Content="検索で開く" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                    Command="{Binding ShowItemsCommand}"
                                                    Visibility="{Binding SelectedIsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 大分類の削除は小分類も商品の付け替えも伴うので、色で重さを出す（ユーザ指摘 2026-09-18） -->
                                    <Button Content="この分類を削除" Style="{StaticResource SmallButton}"
                                            Foreground="#9a3232" BorderBrush="#e2bcbc"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding DeleteTopCommand}" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Border}" Margin="0,16" />

                                <TextBlock Text="名前を変更 / 統合" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding RenameImpactText}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,5,0,7" />
                                <controls:SuggestBox Source="{Binding OtherTopNames}" CommitCommand="{Binding RenameTopCommand}"
                                                     Placeholder="新しい名前（既存を選ぶと統合）" HorizontalAlignment="Left" Width="360" />

                                <Border Height="1" Background="{StaticResource Border}" Margin="0,16" />

                                <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="何をここに入れるかの基準。分け方に迷ったときに読み返す場所です。打ち終えると残ります。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,7" />
                                <TextBox Text="{Binding MemoDraft, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="10,8"
                                         VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource BorderStrong}" />
                            </StackPanel>
                        </Border>

                        <!-- サブレベル -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Margin="20,16,20,14">
                                    <TextBlock Text="小分類" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="トップに従属します。トップを外すとサブも一緒に外れます。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <controls:SuggestBox CommitCommand="{Binding AddSubCommand}" Margin="0,10,0,0"
                                                         Placeholder="小分類を追加" HorizontalAlignment="Left" Width="360" />
                                </StackPanel>

                                <!--
                                    幅が広いときは2列に流す（ユーザ指示 2026-09-18：縦に全部並ぶと、
                                    小分類の多い大分類で上の情報が画面の外へ出る）。1件の幅を決めて折り返す
                                -->
                                <ItemsControl ItemsSource="{Binding Subs}"
                                              AllowDrop="True"
                                              PreviewMouseLeftButtonDown="OnRowsPreviewMouseLeftButtonDown"
                                              MouseMove="OnRowsMouseMove"
                                              DragOver="OnRowsDragOver"
                                              DragLeave="OnRowsDragLeave"
                                              Drop="OnRowsDrop">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ColumnsPanel MinColumnWidth="460" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Backgroundが無いとヒットテストに乗らず、行の余白でドラッグが途切れる -->
                                            <Border BorderBrush="#f0f1f4" BorderThickness="0,1,0,0" Padding="20,13"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- ドラッグ中の落ち先。行の枠まで届くよう、Paddingの分だけ外へ出す -->
                                                    <Border Height="2" VerticalAlignment="Top" Margin="-20,-13,-20,0"
                                                            Grid.ColumnSpan="2" Panel.ZIndex="1" Background="{StaticResource Accent}"
                                                            Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    <Border Height="2" VerticalAlignment="Bottom" Margin="-20,0,-20,-13"
                                                            Grid.ColumnSpan="2" Panel.ZIndex="1" Background="{StaticResource Accent}"
                                                            Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!--
                                                                中の商品を見られるように畳む（ユーザ指示 2026-09-18：
                                                                改変とitemの関係と同じ形）。商品を持つ小分類にだけ印を出す
                                                            -->
                                                            <ToggleButton Style="{StaticResource TagToggle}" VerticalAlignment="Center"
                                                                          Margin="0,0,7,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                          Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Mono}"
                                                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- メモは書く場所が無かったので、欄そのものを置く（ユーザ指示 2026-09-18）。打ち終えると残る -->
                                                        <Grid Margin="0,6,0,0">
                                                            <TextBox Text="{Binding MemoDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                     Padding="8,5" FontSize="11.5"
                                                                     BorderBrush="{StaticResource Border}" />
                                                            <TextBlock Text="メモ（何をここに入れるかの基準）" Margin="10,0,0,0"
                                                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextFaint}" FontSize="11.5"
                                                                       Visibility="{Binding MemoDraft, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="検索で開く" Style="{StaticResource SmallButton}"
                                                                    Margin="0,0,6,0" Command="{Binding ShowItemsCommand}"
                                                                    Visibility="{Binding IsUsed, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                            <!-- 滅多に使わないので入力欄は常設せず、ここから開く -->
                                                            <!-- 押せないときは理由を出す（ユーザ指摘 2026-09-18：ほかに大分類が無いと押せない） -->
                                                            <Button Content="移す" Style="{StaticResource SmallButton}"
                                                                    Margin="0,0,6,0" Command="{Binding MoveCommand}"
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    ToolTip="この小分類を、別の大分類の下へ移します。移せる先が無いときは押せません（大分類がもう1つ要ります）。" />
                                                            <Button Content="削除" Style="{StaticResource SmallButton}"
                                                                    Foreground="#9a3232"
                                                                    Command="{Binding DeleteCommand}" />
                                                        </StackPanel>
                                                        <controls:SuggestBox Width="240" Margin="0,7,0,0"
                                                                             Placeholder="名前を変更 / 統合"
                                                                             Source="{Binding OtherNames}"
                                                                             CommitCommand="{Binding RenameCommand}" />
                                                    </StackPanel>

                                                    <!-- 畳みを開いたときの中身。押すと商品ページへ（改変の一覧と同じ） -->
                                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Items}"
                                                                  Margin="23,10,0,0"
                                                                  Visibility="{Binding IsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource TagItemLink}" Margin="0,0,10,8"
                                                                        Command="{Binding OpenCommand}" ToolTip="{Binding Name}">
                                                                    <StackPanel Orientation="Horizontal" Width="230">
                                                                        <Border Width="30" Height="30" CornerRadius="4" ClipToBounds="True"
                                                                                Background="{StaticResource SurfaceAlt}">
                                                                            <Grid>
                                                                                <TextBlock Text="{Binding Initial}" FontSize="11"
                                                                                           Foreground="{StaticResource TextMuted}"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="184">
                                                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding ShopName}" Style="{StaticResource Caption}"
                                                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="小分類はまだありません。" Style="{StaticResource Caption}" Margin="20,0,20,18"
                                           Visibility="{Binding HasSubs, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
