<UserControl x:Class="BoothAssetManager.App.Views.TagManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagManageViewModel}">
    <!-- 商品の行・畳む印・文字だけのボタンは属性の管理と共用（ユーザ指示 2026-09-19：操作感を揃える） -->
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ManageResources.xaml" />
            <!-- カード表示は検索と同じカード（ユーザ指示 2026-09-20・M4） -->
            <views:ItemCardResources />
        </ResourceDictionary.MergedDictionaries>

        <!--
            小分類1行。畳んだ小分類のまとまり（TagSubRunLine）と、開いた小分類の見出し（右の一覧に TagSubRow そのものを置く）の
            両方から使う。開いた小分類の中身は、右の一覧の段（ManageListLine・ManageCardLine）として続く（2026-09-24：中身を
            この中に並べていた頃は、すべて開くと見えていないカードまで全部作っていた）。開いた行では、下の余白を中身の上の間 10 にし、
            「この後ろ」の線は中身の下（TagSubFootLine）に出す
        -->
        <DataTemplate x:Key="TagSubTemplate" DataType="{x:Type vm:TagSubRow}">
        <!--
            Backgroundが無いとヒットテストに乗らず、行の余白でドラッグが途切れる。
            開いた行は幅いっぱいを使う（ユーザ指摘 2026-09-18：列の中で開くと並びが飛んで順番が読めない）
        -->
        <Border x:Name="Row" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="20,13"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ドラッグ中の落ち先。行の枠まで届くよう、Paddingの分だけ外へ出す -->
                <Border Height="2" VerticalAlignment="Top" Margin="-20,-13,-20,0"
                        Grid.ColumnSpan="2" Panel.ZIndex="1" Background="{DynamicResource Accent}"
                        Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Border x:Name="DropAfterLine" Height="2" VerticalAlignment="Bottom" Margin="-20,0,-20,-13"
                        Grid.ColumnSpan="2" Panel.ZIndex="1" Background="{DynamicResource Accent}"
                        Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!--
                            中の商品を見られるように畳む（ユーザ指示 2026-09-18：
                            改変とitemの関係と同じ形）。商品の無い小分類でも印は消さずに押せない形で置く
                            （ユーザ指示 2026-09-19：消すと名前の頭が行ごとにずれた）
                        -->
                        <!-- 行の左の余白（20）の中に出すので、名前とメモの位置は変わらない -->
                        <TextBlock Style="{StaticResource ReorderGrip}" Margin="-16,0,4,0" />
                        <ToggleButton Style="{StaticResource TagToggle}" VerticalAlignment="Center"
                                      Margin="0,0,7,0" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      IsEnabled="{Binding IsUsed}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{Binding ExpandToolTip}" />
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Mono}"
                                   FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>

                <!-- メモは書く場所が無かったので、欄そのものを置く（ユーザ指示 2026-09-18）。打ち終えると残る -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="23,7,0,0">
                        <TextBox MaxLength="10000" Text="{Binding MemoDraft, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" FontSize="11.5"
                                 BorderBrush="{DynamicResource Border}" />
                        <TextBlock Text="何をここに入れるかのメモ" Margin="10,0,0,0"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}" FontSize="11.5"
                                   Visibility="{Binding MemoDraft, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                </Grid>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!--
                            並びは「見る → 名前を変える → 移す → 消す」（ユーザ指示 2026-09-18）。
                            よく使う物から並べ、取り返しのつかない物を右端に置く
                        -->
                        <Button Content="検索で開く" Style="{StaticResource SmallButton}"
                                Margin="0,0,6,0" Command="{Binding ShowItemsCommand}"
                                IsEnabled="{Binding IsUsed}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding ShowItemsToolTip}" />
                        <Button Content="名前を変更" Style="{StaticResource SmallButton}"
                                Margin="0,0,6,0" Command="{Binding RenameCommand}"
                                ToolTip="名前を変えます。既にある名前を選ぶと、2つを1つに統合します。" />
                        <!-- 「移す」だけでは何が起きるか分からない（ユーザ指摘 2026-09-18） -->
                        <Button Content="別の大分類へ移す" Style="{StaticResource SmallButton}"
                                Margin="0,0,10,0" Command="{Binding MoveCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="この小分類を別の大分類の下へ移します。移すには大分類が2つ以上要ります。" />
                        <Button Content="削除" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"
                                ToolTip="この小分類を削除します。付いている商品からも外れます。" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Row" Property="Padding" Value="20,13,20,10" />
                    <Setter TargetName="DropAfterLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 戻る（V3）。要確認などから飛んで来られるのに、戻る道が無かった -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Main.CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding Main.BackButtonText}" Command="{Binding Main.GoBackCommand}"
                                BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="ユーザータグの管理" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="名前の変更と削除は、付いている商品もすべて書き換えます。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="読み直す" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:PaneGrid Pane="{Binding ListPane}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}" />

            <!-- 左：トップレベルの一覧。件数を並べるのは、消す前に影響が見えるように -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14" >
                        <TextBlock Text="ユーザータグを検索" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,6" BorderBrush="{DynamicResource BorderStrong}"
                                 ToolTip="小分類の名前と、商品名・ショップ名・メモでも探します。" />
                        <controls:SearchSyntaxHint Margin="2,5,0,0" />
                        <TextBlock Text="{Binding FilterResultText}" Style="{StaticResource Caption}" Margin="2,5,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!--
                            候補には**既にある大分類**を出す（ユーザ判断 2026-09-20・I7）。
                            候補付きの見た目なのに候補の元を結んでおらず、一度も候補が出ない欄だった
                            （既にある名前を打っても、押すまで気付けなかった）
                        -->
                        <controls:SuggestBox CommitCommand="{Binding AddTopCommand}" Margin="0,12,0,0"
                                             Source="{Binding AllTopNames}" MaxLength="60"
                                             Placeholder="大分類を追加（例：衣装）" AutomationProperties.Name="大分類を追加" />

                        <!--
                            並べ方は並べる一覧のすぐ上に、つながったボタンで置く（ユーザ指示 2026-09-19：頭の右端では
                            どの一覧の並びか分かりにくかった）。選ぶとファイルの並びも同じ順に書き換える（2026-09-18）
                        -->
                        <!-- 見出しは検索画面と同じ「表示順」に揃える（ユーザ指示 2026-09-20・M5） -->
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" Margin="2,12,0,4" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="名前順" GroupName="TagSort" Style="{StaticResource SegmentFirst}"
                                         IsChecked="{Binding SortsByName, Mode=TwoWay}" />
                            <RadioButton Grid.Column="1" Content="件数順" GroupName="TagSort" Style="{StaticResource SegmentMiddle}"
                                         IsChecked="{Binding SortsByCount, Mode=TwoWay}" />
                            <!-- 「手で並べた順」では何の順か・並べ替えられるかが伝わらなかった（ユーザ指示 2026-09-29） -->
                            <RadioButton Grid.Column="2" Content="候補の並べ替え" GroupName="TagSort" Style="{StaticResource SegmentLast}"
                                         IsChecked="{Binding SortsManually, Mode=TwoWay}"
                                         ToolTip="検索と編集の候補に表示する順です。行をドラッグして並べ替えます。" />
                        </Grid>
                    </StackPanel>

                    <!-- 並びは検索の絞り込みにも編集の候補にも出るので、ドラッグで変えられる -->
                    <Grid>
                    <!-- 0件のときに真っ白にしない（E1）。一覧の上に重ねて出す -->
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="18,26,18,0" VerticalAlignment="Top"
                               Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <ListBox ItemsSource="{Binding Tops}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnRowsPreviewMouseLeftButtonDown"
                             MouseMove="OnRowsMouseMove"
                             DragOver="OnRowsDragOver"
                             DragLeave="OnRowsDragLeave"
                             Drop="OnRowsDrop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <!-- ドラッグ中に、どこへ落ちるかを示す線 -->
                                                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource Accent}"
                                                            Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}"
                                                            Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="28,13,16,13">
                                    <TextBlock Style="{StaticResource ReorderGrip}" Margin="-18,0,0,0" />
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SubCountText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Mono}" FontSize="11.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!--
                右：選んだトップレベルの中身。平らな1本の一覧にして仮想化する（2026-09-24：小分類の中の商品を WrapPanel に
                全部並べていた頃は、すべて開くと見えていないカードまで全部作り、メモリが約300MB増えた）。並べる物は、
                頭（大分類の札・小分類の見出し）→ 畳んだ小分類のまとまり・開いた小分類と中の商品の段 → 下の枠。
                小分類を囲む札は行ごとに描き分け、見た目は前と同じ1枚の札のまま
            -->
            <controls:ContentItemsControl Grid.Column="1" ItemsSource="{Binding Lines}" Focusable="False"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.ScrollChanged="OnDetailScrollChanged"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="OnRowsPreviewMouseLeftButtonDown"
                                          MouseMove="OnRowsMouseMove"
                                          DragOver="OnRowsDragOver"
                                          DragLeave="OnRowsDragLeave"
                                          Drop="OnRowsDrop">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="20" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <!-- 頭：状況の文・一覧に無いユーザータグ・大分類の札・小分類の見出し（この画面そのものに結ぶ） -->
                    <DataTemplate DataType="{x:Type vm:TagManageViewModel}">
                <!-- Leftにすると、状況表示の文の長さでカードの幅が動いてしまう -->
                <!--
                    右は使える幅いっぱいを使う（ユーザ指示 2026-09-19）。上限を付けると広い画面で中央に寄り、
                    左の一覧との間に大きな空白ができていた。小分類はその分だけ列が増える
                -->
                <StackPanel HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                    <!-- マスタに無い名前をitemが参照したまま。要確認は知らせるだけで、直せるのはここ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                            Visibility="{Binding HasOrphans, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Margin="18,15">
                            <TextBlock Text="一覧に無いユーザータグ" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Warn}" />
                            <!--
                                編集画面で打った分類はその場で一覧に入る（EditViewModel）。
                                ここに出るのは、JSONを直接直したか、一覧から消した後に商品側が残っている場合だけ。
                                通常の流れに手動追加の手順があるように読ませない。
                            -->
                            <TextBlock Text="商品に付いていますが、一覧に無いユーザータグです。保存先のファイルを直接直したときなどに起きます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="このままでは絞り込みに表示されません。一覧に追加するか、既にあるユーザータグへ統合するか、外してください。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />

                            <ItemsControl ItemsSource="{Binding Orphans}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WarnBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- トップかサブかで直し方が変わるので、種別を出す -->
                                                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,7,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindText}" FontSize="10"
                                                                       Foreground="{DynamicResource TextMuted}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="一覧に追加" Style="{StaticResource SmallButton}"
                                                                Command="{Binding AddToMasterCommand}" />
                                                        <Button Content="商品から外す" Style="{StaticResource SmallButton}"
                                                                Margin="6,0,0,0" Foreground="{DynamicResource DangerText}"
                                                                Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                    <controls:SuggestBox Width="260" Margin="0,7,0,0" AllowNew="False"
                                                                         Placeholder="{Binding MergePlaceholder}"
                                                                         Source="{Binding MergeCandidates}"
                                                                         CommitCommand="{Binding MergeCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

                        <!-- トップレベルそのもの -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="20,18">
                                <Grid>
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="大分類" Style="{StaticResource SectionLabel}" />
                                        <!--
                                            名前の変更は名前の横に置く（ユーザ指示 2026-09-19）。専用の段を設けると、
                                            ボタン1つのために説明と区切り線が1段ずつ増えていた。何件が書き換わるかは窓が言う
                                        -->
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="Bold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Content="名前を変更" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                                                    Command="{Binding RenameTopCommand}"
                                                    ToolTip="名前を変えます。既にある名前を選ぶと統合します。" />
                                            <!--
                                                大分類を別の大分類の小分類にする（ユーザ要望 2026-09-29）。小分類を持つ大分類ではできないが、
                                                ボタンは消さずに押せない形で置き、理由を吹き出しで言う（タグの管理の決め事）
                                            -->
                                            <Button Content="別の大分類の小分類にする" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                                                    Margin="6,0,0,0" Command="{Binding NestTopCommand}"
                                                    IsEnabled="{Binding CanNestTop}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="{Binding NestTopToolTip}" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding SelectedUsageText}" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" />
                                            <!--
                                                件数だけでは消していいか統合していいか判断できないので、中身へ行けるようにする。
                                                使っていないときも消さずに押せない形で残す（ユーザ指示 2026-09-19：行ごとにボタンの有無が変わると揃わない）
                                            -->
                                            <Button Content="検索で開く" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                    Command="{Binding ShowItemsCommand}"
                                                    IsEnabled="{Binding SelectedIsUsed}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="{Binding ShowItemsToolTip}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 大分類の削除は小分類も商品の付け替えも伴うので、色で重さを出す（ユーザ指摘 2026-09-18） -->
                                    <Button Content="この大分類を削除" Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Command="{Binding DeleteTopCommand}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,16" />

                                <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="何をここに入れるかの基準。分け方に迷ったときに読み返す場所です。打ち終えると保存されます。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,7" />
                                <TextBox MaxLength="10000" Text="{Binding MemoDraft, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="10,8"
                                         VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource BorderStrong}" />
                            </StackPanel>
                        </Border>

                        <!-- サブレベル -->
                        <!-- 小分類を囲む札の上側。小分類の行と下の枠（ManageFoot）が続きを描く -->
                        <Border Margin="0,16,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                            <StackPanel Margin="20,16,20,14">
                                <DockPanel>
                                    <!-- 中の商品をカードで見るかリストで見るか（ユーザ指示 2026-09-20・M4）。ほかの画面と同じ形 -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CommandRadioButton Content="カード" GroupName="TagItemsView" Style="{StaticResource SegmentFirst}"
                                                     IsChecked="{Binding IsCardMode, Mode=OneWay}" Command="{Binding ShowCardsCommand}"
                                                     ToolTip="小分類を開いたとき、中の商品を絵の大きなカードで並べます" />
                                        <controls:CommandRadioButton Content="リスト" GroupName="TagItemsView" Style="{StaticResource SegmentLast}"
                                                     IsChecked="{Binding IsListMode, Mode=OneWay}" Command="{Binding ShowListCommand}"
                                                     ToolTip="名前が読める詰まった行で並べます" />
                                    </StackPanel>
                                    <TextBlock Text="小分類" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="大分類の下に入ります。商品から大分類を外すと、その下の小分類も一緒に外れます。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,0" />

                                <!--
                                    商品名で探す欄と、小分類を足すボタンは隣り合わせにする
                                    （ユーザ指摘 2026-09-18：右上に置くと遠い）。足す欄は押したときだけ出す
                                -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Grid Width="360">
                                    <TextBox Text="{Binding ItemFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9,6" BorderBrush="{DynamicResource BorderStrong}" />
                                    <TextBlock Text="この大分類の中を小分類名・商品で探す" Margin="11,0,0,0" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                               Visibility="{Binding ItemFilter, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                                </Grid>

                                    <!--
                                        丸い＋を押すと、そのまま右へ伸びて入力欄になる（ユーザ指示 2026-09-18）。
                                        隠れていた欄が別の場所に現れるより、押した物が育つ方が繋がりが分かる
                                    -->
                                    <Border Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="16" Height="32"
                                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="AddSubToggle" Width="30" Height="30" Cursor="Hand"
                                                          Focusable="False" IsChecked="{Binding IsAddingSub, Mode=TwoWay}"
                                                          AutomationProperties.Name="小分類を追加"
                                                          ToolTipService.InitialShowDelay="250"
                                                          ToolTip="小分類を追加">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid Background="Transparent">
                                                            <Ellipse x:Name="Ring" Width="26" Height="26"
                                                                     Fill="{DynamicResource SurfaceAlt}" Stroke="{DynamicResource Border}" />
                                                            <Path x:Name="Mark" Data="M7,0 L7,14 M0,7 L14,7" Stroke="{DynamicResource Text}"
                                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Width="14" Height="14" Stretch="Fill"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <!-- 開いている間は×（もう一度押すと閉じる、と分かるように） -->
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Mark" Property="Data" Value="M0,0 L14,14 M14,0 L0,14" />
                                                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentSoft}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <!--
                                                丸い枠そのものを入力欄に見せる（四角い欄が中で浮いていた。ユーザ指摘 2026-09-18）。
                                                伸び縮みは欄の側の Style で持つ。ボタンの側から名前で欄を指すと、開いたまま
                                                別の画面へ移ったときに合図だけが流れて欄が見つからず、例外で画面の切り替えが止まった（2026-09-19）
                                            -->
                                            <controls:SuggestBox Margin="2,0,10,0"
                                                                 IsFrameless="True"
                                                                 CommitCommand="{Binding AddSubCommand}"
                                                                 Source="{Binding DataContext.SubNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 MaxLength="60"
                                                                 Placeholder="小分類の名前" VerticalAlignment="Center">
                                                <controls:SuggestBox.Style>
                                                    <Style TargetType="controls:SuggestBox">
                                                        <Setter Property="Width" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAddingSub}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                                             To="260" Duration="0:0:0.14" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                                             To="0" Duration="0:0:0.12" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:SuggestBox.Style>
                                            </controls:SuggestBox>
                                        </StackPanel>
                                    </Border>

                                    <!--
                                        小分類をまとめて開く・畳む（ユーザ指示 2026-09-19）。全部開いている間は「すべて畳む」になる。
                                        開くのは中身のある小分類だけ（中身の無い物は三角も押せない）
                                    -->
                                    <Button Content="{Binding ToggleAllText}" Style="{StaticResource SmallButton}"
                                            Margin="16,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding ToggleAllCommand}"
                                            ToolTip="中身のある小分類を、まとめて開くか折りたたみます。" />
                                </StackPanel>

                                <controls:SearchSyntaxHint Margin="2,6,0,0" />
                                <TextBlock Text="{Binding ItemFilterResultText}" Style="{StaticResource Caption}" Margin="2,4,0,0"
                                           Visibility="{Binding HasItemFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                    </DataTemplate>

                    <!-- 畳んだ小分類のひと続き。前と同じく幅に応じて列に並べる -->
                    <DataTemplate DataType="{x:Type vm:TagSubRunLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <!--
                                幅が広いときは2列に流す（ユーザ指示 2026-09-18：縦に全部並ぶと、
                                小分類の多い大分類で上の情報が画面の外へ出る）。1件の幅を決めて折り返す
                            -->
                            <ItemsControl ItemsSource="{Binding Subs}" ItemTemplate="{StaticResource TagSubTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ColumnsPanel MinColumnWidth="540" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <!--
                                    開いた行は幅いっぱい（ユーザ指摘 2026-09-18：列の中で開くと並びが飛んで順番が読めない）。
                                    ItemsControl は項目を ContentPresenter で包むので、指定は容れ物側に付ける
                                -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="controls:ColumnsPanel.FullWidth" Value="{Binding IsExpanded}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>

                    <!-- 開いた小分類の見出し（中身は続く段） -->
                    <DataTemplate DataType="{x:Type vm:TagSubRow}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TagSubTemplate}" />
                        </Border>
                    </DataTemplate>

                    <!--
                        開いた小分類の中の商品の段。左の線は「開いている」印（ユーザ指示 2026-09-18）。
                        位置は前と同じ：小分類の行の余白 20 ＋ 字下げ 23 の所に線、線から 16 右に中身
                    -->
                    <DataTemplate DataType="{x:Type vm:ManageListLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <Border Margin="43,0,20,0" Padding="16,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0">
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ManageItemTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:ManageCardLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <Border Margin="43,0,20,0" Padding="16,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0">
                                <controls:ContentItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </Border>
                        </Border>
                    </DataTemplate>

                    <!-- 開いた小分類の下の余白（小分類の行の下の余白 13）。並べ替えで「この後ろ」に落とすときの線もここ -->
                    <DataTemplate DataType="{x:Type vm:TagSubFootLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <Grid Height="13">
                                <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}"
                                        Visibility="{Binding Sub.DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!-- 下の枠：小分類を囲む札の下側 -->
                    <DataTemplate DataType="{x:Type vm:ManageFoot}">
                        <Border DataContext="{Binding Owner}"
                                Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                        <TextBlock Text="小分類はまだありません。" Style="{StaticResource Caption}" Margin="20,0,20,18"
                                   Visibility="{Binding HasSubs, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>
            </controls:ContentItemsControl>
        </controls:PaneGrid>
    </DockPanel>
</UserControl>
