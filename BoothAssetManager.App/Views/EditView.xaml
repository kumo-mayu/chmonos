<UserControl x:Class="BoothAssetManager.App.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:models="clr-namespace:BoothAssetManager.Core.Models;assembly=BoothAssetManager.Core"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <!-- 上部バー：何件目かと、進み方の操作 -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="編集" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <ProgressBar Width="160" Height="5" Margin="12,0,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding StepProgress, Mode=OneWay}"
                                 Foreground="{StaticResource Accent}" Background="#edeff3" BorderThickness="0" />
                </StackPanel>

                <!--
                    続く商品を小さな絵で（ユーザ指示）。済んだ物は5件まで、これからの物は幅に収まるだけ。
                    はみ出た分は2行目へ折り返して枠の外に隠れるので、欠けた絵が端に出ない。
                    保存した物は右下に緑の印、保存せずに飛ばした物は薄く、いま開いている物は青い枠。
                    押すとその商品へ飛ぶ。キーボードの操作を奪わないよう、絵はフォーカスを取らない
                -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding QueueTiles}" Height="34" Margin="18,0"
                              VerticalAlignment="Center" ClipToBounds="True" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EditQueueTile}">
                            <Button Margin="0,0,6,0" Focusable="False" Cursor="Hand" ToolTip="{Binding ToolTip}"
                                    Command="{Binding DataContext.JumpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="34" Height="34" Background="Transparent">
                                            <Border x:Name="Frame" CornerRadius="6" BorderThickness="2"
                                                    BorderBrush="Transparent" Background="#edeff3">
                                                <Border CornerRadius="4" ClipToBounds="True">
                                                    <Image x:Name="Picture" Source="{Binding Image}" Stretch="UniformToFill" />
                                                </Border>
                                            </Border>
                                            <Border x:Name="SavedMark" Width="14" Height="14" CornerRadius="7"
                                                    Background="{StaticResource Good}" BorderBrush="{StaticResource Surface}"
                                                    BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="✓" FontSize="8.5" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                <Setter TargetName="Picture" Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter TargetName="SavedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Border}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="BOOTHで開く" Command="{Binding OpenBoothCommand}" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding OpenBoothTip}" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="4,0,12,0" />
                    <Button Content="← 前へ" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                    <Button Content="スキップ" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
                    <Button Content="保存して次へ" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndNextCommand}" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <Button Content="終える" Command="{Binding FinishCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 終了表示と編集本体は重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>

        <!-- キューを終えたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsFinished, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="編集するものがありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="ユーザータグが未設定の商品が対象です。" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />

            <!-- 自動で戻る。設定 ReturnToSearchWhenEditDone / ReturnToSearchDelaySeconds -->
            <TextBlock Text="{Binding ReturnNoticeText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Visibility="{Binding IsReturning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Content="検索へ戻る" Command="{Binding FinishCommand}" />
                <Button Content="ここに留まる" Margin="8,0,0,0" Command="{Binding StayCommand}"
                        Visibility="{Binding IsReturning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </StackPanel>

        <Grid Visibility="{Binding HasItem, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- 左：何を編集しているかが分かるだけの控えめな表示 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <StackPanel>
                            <Grid Height="300" Background="#e9edf4">
                                <Image Source="{Binding MainImage}" Stretch="Uniform" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Images}" Margin="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 押すとメインが切り替わる。属性を付けるには複数枚見たい -->
                                        <Button Command="{Binding DataContext.SelectImageCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Border Width="58" Height="46" Margin="0,0,6,6" Background="#eef0f2"
                                                    BorderThickness="2" CornerRadius="4" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,70,0" />
                                <Button Content="{Binding EditBasicsLabel}" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Right" Command="{Binding EditBasicsCommand}"
                                        ToolTip="商品名・ショップ・BOOTH分類名を直します。BOOTHから取れている商品は、普段は直す必要がありません。" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ShopName}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />

                            <!--
                                商品名・ショップ・BOOTH分類名。**普段は変える必要が無い**ので、
                                「編集」を押して初めて開く（ユーザ指示）。上の下見は打った内容を映すので、
                                開いている間も何になるかが見える。
                            -->
                            <StackPanel Margin="0,16,0,0" MaxWidth="480" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                        Visibility="{Binding IsEditingBasics, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <!--
                                    商品名。BOOTHから取れない商品はこれしか名前が無い。
                                    取れている商品でも変えられるようにしてある。
                                -->
                                <TextBlock Text="商品名" FontWeight="Bold" FontSize="13" />

                                <!--
                                    **空欄が何になるかは欄そのものに名乗らせる。**
                                    以前は下に「空欄にするとBOOTHの名前『〇〇』に戻ります」と
                                    常時出していたが、普段変えない欄なのに説明文で縦を食っていた。
                                    空欄は「入力を求めている」とも読まれる。
                                -->
                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="NameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding NamePlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{StaticResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=NameBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- これは注意なので消さない。空欄にすると仮IDが名前として出てしまう -->
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{StaticResource Warn}"
                                           Text="BOOTHに無い商品なので、空欄にすると仮のIDが名前の代わりに出ます。"
                                           Visibility="{Binding IsLocalOnly, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                                <Border Height="1" Background="#f0f1f4" Margin="0,16,0,16" />

                                <!--
                                    ショップ。**商品が非公開でもショップは見られる場合がある。**
                                    URLを貼れば本物のサブドメインが取れ、既にあるショップに正しく束ねられる。
                                    貼らなければ手元だけの鍵になる（本物のアイコンやバナーは出ない）。
                                -->
                                <TextBlock Text="ショップ" FontWeight="Bold" FontSize="13" />

                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="ShopBox" Text="{Binding ShopNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding ShopPlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{StaticResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=ShopBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!--
                                    **候補は触ったときだけ出す。**普段変えない欄なので、
                                    常時並べると縦を食うだけになる（手元のショップ名が6件並ぶ）。
                                    focusで出すのは、キーボードでもタッチでも届くから——
                                    ホバーのtipだけにすると届かない経路がある。
                                -->
                                <ItemsControl ItemsSource="{Binding ShopSuggestions}" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasShopSuggestions}" Value="True" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopBox}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.UseShopCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <TextBox x:Name="ShopUrlBox" Text="{Binding ShopUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <!-- URLの形は placeholder で見せる。ここは既定が無く、実際に入力を求めている -->
                                    <TextBlock Text="ショップのURL（https://〇〇.booth.pm/）" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{StaticResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=ShopUrlBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!--
                                    URLを貼るかどうかで結果が変わる（本物のショップに束ねられるか、
                                    手元だけの鍵になるか）。**押す前に知る必要がある注意なので消さない。**
                                    ただし触っているときだけ出す
                                -->
                                <TextBlock Text="{Binding ShopKeyNote}"
                                           TextWrapping="Wrap" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ShopUrlBox}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Height="1" Background="#f0f1f4" Margin="0,16,0,16" />

                                <!--
                                    BOOTHの分類名。**「分類」だけだとユーザータグと区別が付かない**
                                    ので、どこの分類かを名前に入れてある（ユーザ指示）。
                                    取れない商品には無いので、統計にも絞り込みにも出てこない。
                                    候補は同梱したBOOTHのカテゴリ表から出す。
                                -->
                                <TextBlock Text="BOOTH分類名" FontWeight="Bold" FontSize="13" />

                                <Grid Margin="0,7,0,0">
                                    <TextBox x:Name="CategoryBox" Text="{Binding CategoryInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30" VerticalContentAlignment="Center" Padding="8,0" />
                                    <TextBlock Text="{Binding CategoryPlaceholder}" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,10,0"
                                               Foreground="{StaticResource TextFaint}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Text, ElementName=CategoryBox,
                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- 候補は触ったときだけ。3Dモデルの子が12件並ぶので、常時出すと縦を食う -->
                                <ItemsControl ItemsSource="{Binding CategorySuggestions}" Margin="0,6,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasCategorySuggestions}" Value="True" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=CategoryBox}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.UseCategoryCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 「空欄にするとBOOTHの分類に戻ります」は placeholder に移した -->
                            </StackPanel>

                            <TextBlock Text="BOOTHのタグ" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
                            <ItemsControl ItemsSource="{Binding BoothTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12"
                                                Padding="10,3" Margin="0,0,6,6" Background="White">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#454b57" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="商品説明" FontWeight="Bold" Margin="0,0,0,10" />
                            <RichTextBox Style="{StaticResource SelectableBody}" MaxHeight="360"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         controls:SelectableText.Text="{Binding DescriptionPreview}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：入力 -->
            <Border Grid.Column="1" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel>

                        <!-- userTag：候補から選んで積む。マスタ全部は並べない -->
                        <TextBlock Text="ユーザータグ" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="入力すると候補が出ます。候補に無い語はそのまま新しい分類として追加されます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8" />

                        <controls:SuggestBox Source="{Binding TagSuggestions}" CommitCommand="{Binding AddTagCommand}"
                                             Placeholder="ユーザータグを追加（例：衣装）" />

                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                            Padding="11,9" Margin="0,0,0,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Top}" FontSize="13" FontWeight="Medium"
                                                           VerticalAlignment="Center" />
                                                <Button Content="外す" Style="{StaticResource SmallButton}"
                                                        HorizontalAlignment="Right" Command="{Binding RemoveCommand}" />
                                            </Grid>

                                            <!-- 付けたサブだけを並べる -->
                                            <ItemsControl ItemsSource="{Binding Subs}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasSubs, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                                                BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#28507f" />
                                                                <TextBlock Text="✕" FontSize="10" Margin="7,0,0,0" Cursor="Hand"
                                                                           Foreground="#7d8fa8" VerticalAlignment="Center">
                                                                    <TextBlock.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                      Command="{Binding DataContext.RemoveSubCommand,
                                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                      CommandParameter="{Binding}" />
                                                                    </TextBlock.InputBindings>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <controls:SuggestBox Source="{Binding SubCandidates}" CommitCommand="{Binding AddSubCommand}"
                                                                 Placeholder="サブを追加" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#f0f1f4" Margin="0,18,0,16" />

                        <!-- 属性：評価したものだけを積む。未評価は行が無いことで表す -->
                        <TextBlock Text="属性" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="追加した属性だけが評価済みになります。追加していないものは「未評価」で、0%とは区別されます。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,8" />

                        <controls:SuggestBox Source="{Binding AttributeSuggestions}" CommitCommand="{Binding AddAttributeCommand}"
                                             Placeholder="属性を追加（例：かっこいい）" />

                        <ItemsControl ItemsSource="{Binding Attributes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                Value="{Binding Value, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" />
                                        <!--
                                            並べてあるだけの行は値を出さない。
                                            50%と書いてあると、そう評価したように読める
                                        -->
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Mono}"
                                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSuggested, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="—" Style="{StaticResource Mono}"
                                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Visibility="{Binding IsSuggested, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        <Button Grid.Column="3" Content="外す" Style="{StaticResource SmallButton}"
                                                Margin="7,0,0,0" Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#f0f1f4" Margin="0,18,0,16" />

                        <!-- 購入記録 -->
                        <TextBlock Text="購入した種類" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="購入に印を付けるとBOOTHの現在価格が入ります。実際の支払額が違うときは書き換えてください。空欄は未入力（支出に数えない）、0は無料配布です。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <ItemsControl ItemsSource="{Binding Variations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#f0f1f4" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <!--
                                                    この種類のファイルを選ぶ（#40・ユーザ指示「バリエーションの選択の横」）。
                                                    付ける操作がどこにも無く、友人のデータで327件中0件だった。
                                                    種類が2つ以上ある商品で、手元にファイルがあるときだけ出す
                                                -->
                                                <Grid DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" VerticalAlignment="Center"
                                                      Visibility="{Binding CanLinkFiles, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                    <ComboBox x:Name="FileChoiceBox" ItemsSource="{Binding FileChoices}"
                                                              SelectedItem="{Binding SelectedFileChoice, Mode=TwoWay}"
                                                              DisplayMemberPath="Display" Height="26" FontSize="11.5"
                                                              ToolTip="この種類のファイルを選びます。同じ種類に複数付けられます。" />
                                                    <!-- 選んでいないときに何の欄かを名乗る（ComboBox は空欄の文字を持てない） -->
                                                    <TextBlock Text="ファイルを紐付ける…" IsHitTestVisible="False" FontSize="11.5"
                                                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="8,0,24,0"
                                                               Visibility="{Binding Text, ElementName=FileChoiceBox,
                                                                            Converter={x:Static vm:EmptyToVisibilityConverter.Instance}}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsPurchased, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                                            Visibility="{Binding IsGone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="BOOTHに現存しない" FontSize="10" Foreground="{StaticResource TextFaint}" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- この種類に付けたファイル。✕で外す（保存して次へで書く） -->
                                            <ItemsControl ItemsSource="{Binding LinkedFiles}" Margin="22,6,0,0"
                                                          Visibility="{Binding HasLinkedFiles, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                                BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Style="{StaticResource Mono}"
                                                                           MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="✕" FontSize="10" Margin="7,0,0,0" Cursor="Hand"
                                                                           Foreground="#7d8fa8" VerticalAlignment="Center" ToolTip="この種類から外す">
                                                                    <TextBlock.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding UnlinkCommand}" />
                                                                    </TextBlock.InputBindings>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="22,6,0,0"
                                                        Visibility="{Binding IsPurchased, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="¥" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="86"
                                                         Height="26" FontSize="12" Margin="4,0,0,0" Padding="7,0"
                                                         VerticalContentAlignment="Center" />
                                                <TextBlock Text="{Binding ListPriceText, StringFormat=現在 {0}}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <!--
                                                    「ギフト」のチェック1つでは、貰ったのか贈ったのかが書き分けられない。
                                                    貰い物は支出に数えず、贈答は支出に入るが所持には入らないので、
                                                    集計上まったく別の扱いになる。
                                                -->
                                                <ComboBox SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag"
                                                          Width="96" Height="26" FontSize="12" Margin="14,0,0,0"
                                                          VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="自分用" Tag="{x:Static models:PurchaseKind.ForSelf}" />
                                                    <ComboBoxItem Content="貰った" Tag="{x:Static models:PurchaseKind.Received}" />
                                                    <ComboBoxItem Content="贈った" Tag="{x:Static models:PurchaseKind.Given}" />
                                                </ComboBox>
                                            </StackPanel>
                                            <!--
                                                同じ版を2回買った記録。「自分用に1つ、ギフトに1つ」がこれ。
                                                買った1回が1レコードなので、行を増やす形で足す。
                                            -->
                                            <ItemsControl ItemsSource="{Binding Extras}" Margin="22,4,0,0"
                                                          Visibility="{Binding HasExtras, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="＋" Style="{StaticResource Caption}"
                                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="¥" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="86"
                                                                     Height="26" FontSize="12" Margin="4,0,0,0" Padding="7,0"
                                                                     VerticalContentAlignment="Center" />
                                                            <ComboBox SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Tag"
                                                                      Width="96" Height="26" FontSize="12" Margin="14,0,0,0"
                                                                      VerticalContentAlignment="Center">
                                                                <ComboBoxItem Content="自分用" Tag="{x:Static models:PurchaseKind.ForSelf}" />
                                                                <ComboBoxItem Content="貰った" Tag="{x:Static models:PurchaseKind.Received}" />
                                                                <ComboBoxItem Content="贈った" Tag="{x:Static models:PurchaseKind.Given}" />
                                                            </ComboBox>
                                                            <!-- 印を外すのではなく行ごと消す。「買った回数」を減らす操作なので -->
                                                            <Button Content="この記録を消す" Style="{StaticResource SmallButton}"
                                                                    Margin="10,0,0,0" Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="この版をもう1回買った" Style="{StaticResource SmallButton}"
                                                    HorizontalAlignment="Left" Margin="22,6,0,0"
                                                    Command="{Binding AddPurchaseCommand}"
                                                    Visibility="{Binding IsPurchased, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#f0f1f4" Margin="0,18,0,16" />

                        <!-- メモ・入手日・その他 -->
                        <TextBlock Text="メモ" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="72" Padding="9,7" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="入手日" FontWeight="Bold" FontSize="13" Margin="0,18,0,8" />
                        <Grid>
                            <TextBox Text="{Binding AcquiredAt, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                     VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,150,0" />
                            <TextBlock Text="{Binding AcquiredHintText}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="更新を通知する" IsChecked="{Binding NotifyOnUpdate, Mode=TwoWay}"
                                  Margin="0,18,0,0" Foreground="{StaticResource Text}" />
                        <CheckBox Content="非表示にする（統計には含めます）" IsChecked="{Binding IsHidden, Mode=TwoWay}"
                                  Margin="0,9,0,0" Foreground="{StaticResource Text}" />

                        <TextBlock Text="{Binding StatusText}" Foreground="#9a3232" TextWrapping="Wrap" Margin="0,14,0,20" />

                        <!--
                            **埋め終わった所にも進む道を置く。**上から下へ埋めていく画面なので、
                            埋め終わった時点で視線と手は下にある。そこから右上まで戻らせていた。

                            上部バーの分は消さない。あちらはキューの進捗と並んでいて、
                            途中で抜ける道（前へ・終える）も要る。
                            中身が短い商品では上下に2つ見えるが、それは害にならない
                        -->
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="スキップ" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
                                <Button Content="保存して次へ" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveAndNextCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        </Grid>
    </DockPanel>
</UserControl>
