<UserControl x:Class="BoothAssetManager.App.Views.AttributeManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:views="clr-namespace:BoothAssetManager.App.Views"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AttributeManageViewModel}">
    <!-- 商品の行・畳む印はタグの管理と共用（ユーザ指示 2026-09-19：操作感を揃える） -->
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ManageResources.xaml" />
            <!-- カード表示は検索と同じカード（ユーザ指示 2026-09-20・M4） -->
            <views:ItemCardResources />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 戻る（V3）。ほかの画面と同じ見た目・同じ出し方 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Main.CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding Main.BackButtonText}" Command="{Binding Main.GoBackCommand}"
                                BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="属性の管理" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="値は商品ごとに 0〜100 で付けます。名前の変更と削除は、この属性を持つ商品の書き換えを伴います。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <!-- 保存先のファイル名は出さない（内部の名前。タグの管理と揃える。ユーザ指示 2026-09-19） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="読み直す" Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:PaneGrid Pane="{Binding ListPane}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14） -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}" />

            <!-- 左：属性の一覧。件数を並べるのは、消す前に影響が見えるように -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14">
                        <TextBlock Text="属性を検索" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                        <TextBox MaxLength="500" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="属性を検索"
                                 Padding="9,6" BorderBrush="{DynamicResource BorderStrong}"
                                 ToolTip="この属性を持つ商品の商品名・ショップ名・メモでも探します。" />
                        <controls:SearchSyntaxHint Margin="2,5,0,0" />
                        <TextBlock Text="{Binding FilterResultText}" Style="{StaticResource Caption}" Margin="2,5,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                        <!-- 候補には既にある属性を出す（I7。候補の元を結んでいない欄だった） -->
                        <controls:SuggestBox CommitCommand="{Binding AddCommand}" Margin="0,12,0,0"
                                             Source="{Binding AllNames}" MaxLength="60"
                                             Placeholder="属性を追加（例：かっこいい）" AutomationProperties.Name="属性を追加" />

                        <!-- 並べ方は一覧のすぐ上に、つながったボタンで（タグの管理と同じ。ユーザ指示 2026-09-19） -->
                        <!-- 見出しは検索画面と同じ「表示順」に揃える（ユーザ指示 2026-09-20・M5） -->
                        <TextBlock Text="表示順" Style="{StaticResource Caption}" Margin="2,12,0,4" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="名前順" GroupName="AttributeSort" Style="{StaticResource SegmentFirst}"
                                         IsChecked="{Binding SortsByName, Mode=TwoWay}" />
                            <RadioButton Grid.Column="1" Content="件数順" GroupName="AttributeSort" Style="{StaticResource SegmentMiddle}"
                                         IsChecked="{Binding SortsByCount, Mode=TwoWay}" />
                            <!-- 「手で並べた順」では何の順か・並べ替えられるかが伝わらなかった（ユーザ指示 2026-09-29） -->
                            <RadioButton Grid.Column="2" Content="候補の並べ替え" GroupName="AttributeSort" Style="{StaticResource SegmentLast}"
                                         IsChecked="{Binding SortsManually, Mode=TwoWay}"
                                         ToolTip="検索と編集の候補に表示する順です。行をドラッグして並べ替えます。" />
                        </Grid>
                    </StackPanel>

                    <!-- 並びは検索の候補にも編集の候補にも出るので、ドラッグで変えられる -->
                    <Grid>
                    <!-- 0件のときに真っ白にしない（E1）。一覧の上に重ねて出す -->
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="18,26,18,0" VerticalAlignment="Top"
                               Visibility="{Binding IsEmpty, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnRowsPreviewMouseLeftButtonDown"
                             MouseMove="OnRowsMouseMove"
                             DragOver="OnRowsDragOver"
                             DragLeave="OnRowsDragLeave"
                             Drop="OnRowsDrop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource Accent}"
                                                            Visibility="{Binding DropBefore, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}"
                                                            Visibility="{Binding DropAfter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="28,13,16,13">
                                    <TextBlock Style="{StaticResource ReorderGrip}" Margin="-18,0,0,0" />
                                    <StackPanel Margin="0,0,50,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Mono}" FontSize="11.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!--
                右：選んだ属性の中身。平らな1本の一覧にして仮想化する（2026-09-24：この属性を持つ商品を WrapPanel に
                全部並べていた頃は、2000件の属性を開くと約8秒固まった）。並べる物は、頭（属性の札・商品の見出し）→
                商品の段（幅から数を決めて切る）→ 下の枠。商品を囲む枠は段ごとに描き分け、見た目は前と同じ1枚の札のまま
            -->
            <controls:ContentItemsControl Grid.Column="1" ItemsSource="{Binding Lines}" Focusable="False"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.ScrollChanged="OnDetailScrollChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="20" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <!-- 頭：状況の文・一覧に無い属性・属性の札・この属性を持つ商品の見出し（この画面そのものに結ぶ） -->
                    <DataTemplate DataType="{x:Type vm:AttributeManageViewModel}">
                <!-- 使える幅いっぱいを使う（タグの管理と揃える。ユーザ指示 2026-09-19） -->
                <StackPanel HorizontalAlignment="Stretch">

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                    <!-- マスタに無い名前をitemが参照したまま。要確認は知らせるだけで、直せるのはここ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBorder}"
                            Visibility="{Binding HasOrphans, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Margin="18,15">
                            <TextBlock Text="一覧に無い属性" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Warn}" />
                            <!-- 分類側と同じ理由。通常の流れに手動追加の手順があるように読ませない -->
                            <TextBlock Text="商品に付いていますが、一覧に無い属性です。保存先のファイルを直接直したときなどに起きます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="このままでは絞り込みに表示されません。名前が正しければ一覧に追加し、変わったなら既にある属性へ統合し、もう使わないなら外してください。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />

                            <controls:ContentItemsControl ItemsSource="{Binding Orphans}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource WarnBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="一覧に追加" Style="{StaticResource SmallButton}"
                                                                Command="{Binding AddToMasterCommand}" />
                                                        <Button Content="商品から外す" Style="{StaticResource SmallButton}"
                                                                Margin="6,0,0,0" Foreground="{DynamicResource DangerText}"
                                                                Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                    <controls:SuggestBox Width="260" Margin="0,7,0,0" AllowNew="False"
                                                                         Placeholder="既にある属性へ統合する"
                                                                         Source="{Binding DataContext.AllNames,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         CommitCommand="{Binding MergeCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </controls:ContentItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Margin="20,18">
                            <Grid>
                                <StackPanel Margin="0,0,120,0">
                                    <TextBlock Text="属性" Style="{StaticResource SectionLabel}" />
                                    <!-- 名前の変更は名前の横に置き、窓で聞く（タグの管理と揃える。ユーザ指示 2026-09-19） -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="Bold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Content="名前を変更" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                                                Command="{Binding AskRenameCommand}"
                                                ToolTip="名前を変えます。既にある名前を選ぶと統合します。" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding SelectedUsageText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                        <!-- 使っていないときも消さずに押せない形で残す（タグの管理と揃える） -->
                                        <Button Content="検索で開く" Style="{StaticResource SmallButton}" Margin="10,0,0,0"
                                                Command="{Binding ShowItemsCommand}"
                                                IsEnabled="{Binding SelectedIsUsed}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding ShowItemsToolTip}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="この属性を削除" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Command="{Binding DeleteCommand}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,16" />

                            <TextBlock Text="メモ" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="どのくらいで何%にするかの基準を書いておきます。打ち終えると保存されます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,7" />
                            <TextBox MaxLength="10000" Text="{Binding MemoDraft, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="メモ"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="10,8"
                                     VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource BorderStrong}" />
                        </StackPanel>
                    </Border>

                    <!--
                        この属性を持つ商品（ユーザ指示 2026-09-19：タグの管理の小分類の中身と揃える）。
                        同じ三角・同じ商品の行・同じ書き方の探す欄。値の高い順に並べ、値を札で出す
                    -->
                    <!-- 商品を囲む枠の上側。段と下の枠（ManageFoot）が続きを描く -->
                    <Border Margin="0,14,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1,1,1,0" CornerRadius="8,8,0,0"
                            Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Margin="20,16,20,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource TagToggle}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              IsChecked="{Binding IsItemsExpanded, Mode=TwoWay}"
                                              IsEnabled="{Binding SelectedIsUsed}"
                                              AutomationProperties.Name="この属性を持つ商品を開く"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="{Binding ExpandToolTip}" />
                                <TextBlock Text="{Binding ItemsHeaderText}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />

                                <!-- カードで見るかリストで見るか（ユーザ指示 2026-09-20・M4）。ほかの画面と同じ形 -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedIsUsed}">
                                    <controls:CommandRadioButton Content="カード" GroupName="AttributeItemsView" Style="{StaticResource SegmentFirst}"
                                                 IsChecked="{Binding IsCardMode, Mode=OneWay}" Command="{Binding ShowCardsCommand}"
                                                 ToolTip="絵の大きなカードで並べます" />
                                    <controls:CommandRadioButton Content="リスト" GroupName="AttributeItemsView" Style="{StaticResource SegmentLast}"
                                                 IsChecked="{Binding IsListMode, Mode=OneWay}" Command="{Binding ShowListCommand}"
                                                 ToolTip="名前が読める詰まった行で並べます" />
                                </StackPanel>

                                <!-- 値の向き（ユーザ指示 2026-09-19）。並べ方と同じつながったボタンで、見出しのすぐ横に -->
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedIsUsed}">
                                    <RadioButton Content="値の高い順" GroupName="AttributeItemsOrder" Style="{StaticResource SegmentFirst}"
                                                 IsChecked="{Binding ItemsDescending, Mode=TwoWay}" />
                                    <RadioButton Content="値の低い順" GroupName="AttributeItemsOrder" Style="{StaticResource SegmentLast}"
                                                 IsChecked="{Binding ItemsAscending, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- 並ぶ向き（ユーザ指示 2026-09-19：横固定だと縦に読む人には並びが追いにくい） -->
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedIsUsed}">
                                    <RadioButton Content="横に並べる" GroupName="AttributeItemsFlow" Style="{StaticResource SegmentFirst}"
                                                 IsChecked="{Binding ItemsFlowHorizontal, Mode=TwoWay}"
                                                 ToolTip="左から右へ並べ、端まで来たら次の段へ。" />
                                    <RadioButton Content="縦に並べる" GroupName="AttributeItemsFlow" Style="{StaticResource SegmentLast}"
                                                 IsChecked="{Binding ItemsFlowVertical, Mode=TwoWay}"
                                                 ToolTip="上から下へ並べ、下まで来たら次の列へ。" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 上の並べ方・向き・下の欄がまとめて押せなくなるので、その理由を1行で出す（E11） -->
                            <TextBlock Text="この属性はまだどの商品にも付いていないため、並べ方と絞り込みは使えません。編集画面で値を付けると使えます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="30,10,0,0"
                                       Visibility="{Binding ShowsUnusedReason, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <Grid Width="360" HorizontalAlignment="Left" Margin="30,10,0,0">
                                <TextBox MaxLength="500" Text="{Binding ItemFilter, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="この属性を持つ商品の中を探す"
                                         Padding="9,6" BorderBrush="{DynamicResource BorderStrong}"
                                         IsEnabled="{Binding SelectedIsUsed}" />
                                <TextBlock Text="この属性を持つ商品の中を探す" Margin="11,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                           Visibility="{Binding ItemFilter, Converter={x:Static vm:EmptyToVisibleConverter.Instance}}" />
                            </Grid>
                            <controls:SearchSyntaxHint Margin="32,6,0,0" />
                            <TextBlock Text="{Binding ItemFilterResultText}" Style="{StaticResource Caption}" Margin="32,4,0,0"
                                       Visibility="{Binding HasItemFilter, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 開いた中身の上の間（中身は段として続く） -->
                            <Border Height="12"
                                    Visibility="{Binding IsItemsExpanded, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                    </DataTemplate>

                    <!--
                        商品の段。左の線は「開いている」印（タグの管理と同じ）。段の左右の線は商品を囲む枠の続き。
                        リスト（詰まった行）とカードを選べる（ユーザ指示 2026-09-20・M4）
                    -->
                    <DataTemplate DataType="{x:Type vm:ManageListLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <Border Margin="31,0,20,0" Padding="19,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0">
                                <controls:ContentItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ManageItemTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </controls:ContentItemsControl>
                            </Border>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:ManageCardLine}">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,0">
                            <Border Margin="31,0,20,0" Padding="19,0,0,0" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1,0,0,0">
                                <controls:ContentItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        カードにも値を出す（ユーザ指摘 2026-09-20：リストに出ている情報を落とさない）。
                                        札の見た目はリストと同じ。カードの右上は空いている（選ぶ箱は左上、星は右下）
                                    -->
                                    <Grid>
                                        <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource ItemCardTemplate}" Focusable="False" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,21,0"
                                                Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,1"
                                                Visibility="{Binding HasValue, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Mono}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                </controls:ContentItemsControl>
                            </Border>
                        </Border>
                    </DataTemplate>

                    <!-- 下の枠：商品を囲む枠の下側と、編集画面での扱い -->
                    <DataTemplate DataType="{x:Type vm:ManageFoot}">
                        <StackPanel DataContext="{Binding Owner}"
                                    Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <Border Height="17" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" />

                <!--
                    編集画面に最初から並べる指定。

                    **並べるだけで保存はしない。**全itemに同じ値の行が並ぶと、
                    付けていないのかそう評価したのかが区別できなくなるので、
                    値を動かした行だけが書き出される。切り替える前にそう書いておく
                -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0"
                        Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="編集画面での扱い" FontWeight="Bold" />
                        <TextBlock Text="{Binding DefaultNote}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,5,0,7" />
                        <Button Content="{Binding ToggleDefaultText}" Style="{StaticResource SmallButton}"
                                HorizontalAlignment="Left" Command="{Binding ToggleDefaultCommand}" />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.Resources>
            </controls:ContentItemsControl>
        </controls:PaneGrid>
    </DockPanel>
</UserControl>
