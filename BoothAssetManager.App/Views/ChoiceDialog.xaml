<Window x:Class="BoothAssetManager.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}">
    <!--
        意図を聞く三択。MessageBox の「はい／いいえ」は、本文を読んで対応を覚えないと押せない。
        ボタンそのものに何が起きるかを名乗らせる（#18・ユーザ指摘）
    -->
    <StackPanel Margin="22,20">
        <TextBlock x:Name="QuestionText" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="キャンセル" IsCancel="True" MinWidth="90" Click="OnCancel" />
            <Button x:Name="FirstButton" MinWidth="110" Padding="14,0" Margin="8,0,0,0" Click="OnFirst" />
            <Button x:Name="SecondButton" MinWidth="110" Padding="14,0" Margin="8,0,0,0" Click="OnSecond" />
            <!-- 3つ目の選択肢。要るときだけ出す（外して空になった商品の「非表示・残す・完全に削除」） -->
            <Button x:Name="ThirdButton" MinWidth="110" Padding="14,0" Margin="8,0,0,0" Click="OnThird"
                    Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</Window>
