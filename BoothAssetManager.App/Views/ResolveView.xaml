<UserControl x:Class="BoothAssetManager.App.Views.ResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResolveViewModel}">
    <UserControl.Resources>
        <!-- 入力が残る欄を消す ×（検索画面の ClearFieldButton と同じ見た目）。暗黙のボタンの見た目（高さ32など）を当てないため明示する -->
        <Style x:Key="ClearFieldButton" TargetType="Button">
            <Setter Property="Content" Value="×" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <DockPanel Background="{StaticResource Bg}">

        <!-- フォルダビューに組み込んだときは上の帯と左の一覧を隠す（ShowsChrome・ListColumnWidth） -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 戻る（V3）。統計・取り込み・フォルダから飛んで来られるのに、戻る道が無かった -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Main.CanGoBack, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding Main.BackButtonText}" Command="{Binding Main.GoBackCommand}"
                                BorderThickness="0" Background="Transparent" />
                        <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    </StackPanel>
                    <TextBlock Text="未確定" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="商品IDが決まらなかったファイルです。商品のIDを登録するか、管理対象から除外します。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <!-- 元のzipが登録済みなので出していない中身。黙って減らさない（ユーザ判断 2026-09-17） -->
                    <TextBlock Text="{Binding HiddenByRegisteredZipText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                               ToolTip="元のzipを消すと、中身として一覧に戻ります。"
                               Visibility="{Binding HasHiddenByRegisteredZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 外した直後に戻す（ユーザ判断 2026-09-17：戻す場所が設定の「隠したもの」だけだった）。次に外すまで出す -->
                <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding UndoExcludeCommand}" ToolTip="直前に管理対象から除外したファイルを、未確定に戻します。"
                        Visibility="{Binding HasUndoExclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <!-- 確定分はここで溜めて、まとめて編集へ渡す（ID確定と入力を分ける設計）。画面を離れても残る -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding SettledText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- 正しく結び付いたかを、その場で商品ページで確かめる（動線の点検 D3） -->
                    <Button Content="最後に確定した商品を開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            VerticalAlignment="Center" Command="{Binding OpenLastSettledCommand}"
                            ToolTip="最後に確定した商品のページを開きます。" />
                    <Button Content="確定したものを編集する" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendSettledToEditCommand}" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 検索・要確認と同じ理由。読んでいる最中に一覧を動かさない -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Button Margin="20,12,20,0" FontSize="12"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding ReloadCommand}"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Border>

        <!-- 片付いた表示と一覧は重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>

        <!-- 全部片付いたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="未確定のファイルはありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="取り込みで手掛かりが得られなかったファイルがここに並びます。"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <!-- 次の一手（ユーザ判断 2026-09-17：空になったときに何をすればよいかが弱かった） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <!-- 外して空になった直後にも戻せるように（組み込んだ画面で1件だけを外すと、ここしか見えない） -->
                <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Command="{Binding UndoExcludeCommand}"
                        Visibility="{Binding HasUndoExclude, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button Content="確定したものを編集する" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding SendSettledToEditCommand}"
                        Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                <Button Content="取り込みを開く" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                        Command="{Binding OpenImportCommand}" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14）。組み込んだときは一覧が無いので出さない -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}"
                                   Visibility="{Binding ListPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!-- 左：未確定の一覧（フォルダごとにまとめる） -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                      <StackPanel>
                        <!-- 一覧を探す（ユーザ指示 2026-09-17）。「全て選択」は見えている行だけに効く -->
                        <Grid Margin="0,0,0,8">
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="9,5,26,5"
                                     BorderBrush="{StaticResource BorderStrong}" AutomationProperties.Name="未確定を探す" />
                            <TextBlock Text="ファイル名・フォルダ・zipの名前で探す" Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 打った文字を消す（検索画面と同じ ×） -->
                            <Button HorizontalAlignment="Right" Margin="0,0,6,0"
                                    Style="{StaticResource ClearFieldButton}" Command="{Binding ClearFilterCommand}"
                                    ToolTip="打った文字を消す" AutomationProperties.Name="打った文字を消す"
                                    Visibility="{Binding HasFilterText, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全て選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}" />
                            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                    Command="{Binding ClearChecksCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <ListBox x:Name="FilesList" ItemsSource="{Binding FilesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             PreviewMouseRightButtonDown="OnFileRowRightClick"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <!--
                            行の右クリック（ユーザ指示 2026-09-20・M2）。押した行を選んでから出すので（下の OnFileRowRightClick）、
                            右の詳細と同じ物に効く。中身は右の操作と同じ命令
                        -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="エクスプローラで開く"
                                          ToolTip="このファイルの場所を開きます。"
                                          ToolTipService.ShowOnDisabled="True"
                                          Command="{Binding PlacementTarget.DataContext.RevealCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="管理対象から除外する"
                                          ToolTip="未確定の一覧から外します。設定の「隠したもの」から戻せます。"
                                          ToolTipService.ShowOnDisabled="True"
                                          Command="{Binding PlacementTarget.DataContext.ExcludeCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <!--
                            束は元zip（分からなければフォルダ）。元zipの束は畳んで出し、zipを単位に扱う。
                            1件ずつ扱いたいときだけ開いて行を選ぶ。
                            束の見出しは GroupItem の DataContext（CollectionViewGroup）に結ぶので、
                            元zipかどうかは先頭の行（Items[0]）から読む
                        -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="{Binding Items[0].StartsExpanded, Mode=OneTime}"
                                                              Background="{StaticResource SurfaceAlt}"
                                                              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                                                              Padding="0">
                                                        <Expander.Header>
                                                            <!-- 見出しは中身に合わせて縮まないので、束の幅（左の列の幅）から開け閉めの印の分を引いた幅にする。前は270で固定で、列を広げても長いパスが切れたままだった（ユーザ指示 2026-09-17） -->
                                                            <StackPanel Margin="2,6,0,6" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GroupItem}, Converter={x:Static vm:SubtractConverter.Instance}, ConverterParameter=40}">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Items[0].HasOrigin}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <WrapPanel Margin="0,4,0,0">
                                                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="zipの中身" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                                    </Border>
                                                                    <!-- 展開元のzipが無いフォルダ。畳んでいても分かるように見出しに出す -->
                                                                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="zipが無い" FontSize="10" Foreground="{StaticResource Warn}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 件}"
                                                                               Style="{StaticResource Mono}" FontSize="11"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Content="まとめて扱う" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            Command="{Binding DataContext.SelectGroupCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    <!-- 元のzipが残っているなら、中身は外してzipで登録すればよい（ユーザ判断 2026-09-17） -->
                                                                    <Button Content="元zipとして扱う" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="6,0,0,0"
                                                                            Command="{Binding DataContext.TreatAsOriginZipCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            ToolTip="元のzipを選びます。zipを登録すると、中身は一覧から消えます。"
                                                                            Visibility="{Binding Items[0].HasOriginZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    <!-- 展開先の中身が固まって並ぶので、フォルダ単位で選べるようにする -->
                                                                    <Button Content="このフォルダを選択" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            Command="{Binding DataContext.SelectFolderCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <!-- 開いた中身は深く字下げし、左に線を引く。束と中身が同じ密度で並ぶと、どこを見ればよいか分からなかった（ユーザ指摘 2026-09-17） -->
                                                        <Border Background="{StaticResource Surface}">
                                                            <Border Margin="22,0,0,0" BorderBrush="{StaticResource BorderStrong}" BorderThickness="2,0,0,0">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </Border>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!--
                                            1件だけの束は畳まずに1行で出す。まとめる物が無いのに畳むと、全部が同じ見出しの並びになり、
                                            何がまとまりなのか分からなかった（ユーザ指摘 2026-09-17）。まとめるのはフォルダ・zipを展開した中身で2件以上のときだけ
                                        -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <!--
                                            上に確かな情報（ファイル名と大きさ・展開元）、その下に候補と操作（札・ボタン）（ユーザ指示 2026-09-17）。
                                            大きさは最長でも「1023.9 MB」で幅が小さいので名前の右に置く。札まで横に並べると、真ん中くらいの長さの名前でも切れる
                                        -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11"
                                                       Margin="8,0,4,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <!--
                                            zipを展開した中身が束にならず1行で出るとき（そのzipの中身が1件だけ）、どのzipの中身かが一覧で分からない。
                                            束の中では見出しに出ているので出さない（ユーザ判断 2026-09-17）
                                        -->
                                        <TextBlock Text="{Binding Origin.ArchiveName, StringFormat='展開元：{0}'}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Origin.ArchivePath}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpandedContent}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.ItemCount, RelativeSource={RelativeSource AncestorType=GroupItem}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,4,0,0">
                                            <!-- 取り込んだときに手掛かりから見つかった商品IDの数（自動検索の候補は数えない）。0件は出さない（ユーザ指示 2026-09-17：ほぼ全部の行に並んで目が滑る） -->
                                            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,5,0"
                                                    Visibility="{Binding HasCandidates, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding CandidateText}" FontSize="10" Foreground="{StaticResource Warn}" />
                                            </Border>
                                            <!-- 展開物の中身と判断したものは一覧でも分かるようにする -->
                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,5,0"
                                                    Visibility="{Binding IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="展開" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </WrapPanel>
                                        <!-- 1行で出ている中身にも「元zipとして扱う」（束の見出しと同じ動き） -->
                                        <Button Content="元zipとして扱う" HorizontalAlignment="Left" Height="23" FontSize="10.5" Margin="0,4,0,0"
                                                Command="{Binding DataContext.TreatAsOriginZipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="元のzipを選びます。zipを登録すると、中身は一覧から消えます。">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasOriginZip}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.ItemCount, RelativeSource={RelativeSource AncestorType=GroupItem}}" Value="1" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：手掛かりと決定 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20"
                          Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                    <!-- 組み込んだとき（上の帯が無い）だけ、外した直後に戻すボタンと出していない件数をここに出す -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding ShowsInlineUndo, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <Button Content="{Binding UndoExcludeText}" Style="{StaticResource SmallButton}"
                                Command="{Binding UndoExcludeCommand}" ToolTip="直前に管理対象から除外したファイルを、未確定に戻します。" />
                    </StackPanel>
                    <TextBlock Text="{Binding HiddenByRegisteredZipText}" Style="{StaticResource Caption}" Margin="0,0,0,12"
                               ToolTip="元のzipを消すと、中身として一覧に戻ります。"
                               Visibility="{Binding ShowsInlineHidden, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                    <!-- 元zipの束を選んでいるとき。下の確定・「管理対象から除外する」が全件に効くことを先に言う -->
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,13" Margin="0,0,0,14"
                            Visibility="{Binding HasActiveGroup, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveGroupText}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="#28507f" TextWrapping="Wrap" />
                            <TextBlock Text="下の「確定」と「管理対象から除外する」は、この中身すべてに効きます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 手掛かり -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="このファイルについて分かっていること" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />

                            <!-- 中身を見て判断したいときのために、場所を開ける（以前の動線の記録 C3） -->
                            <Grid>
                                <TextBlock Text="保存場所" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <Button Content="エクスプローラで開く" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                        Command="{Binding RevealCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedPaths}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ダウンロード元" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding ZoneText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 今もそこにあるとは限らない。消したzipや、別のPCで展開したzipでも記録は残る -->
                            <TextBlock Text="元のzip（展開したときの記録）" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding SelectedOriginText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <!--
                                展開した中身で、元のzipが今も残っているとき。zipで登録するのが一番きれい（配布された単位と一致し、
                                展開したフォルダは自動で対象から外れる）なので、zipへ移って普通に登録を進められるようにする（ユーザ指示 2026-09-17）
                            -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding CanUseOriginZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="元zipで登録" Style="{StaticResource SmallButton}"
                                            Command="{Binding UseOriginZipCommand}"
                                            ToolTip="元のzipを選びます。そのまま商品IDを決めて登録できます。" />
                                    <!-- 元のzipが未確定にあっても、フォルダのままの登録はできる（ユーザ判断 2026-09-17） -->
                                    <Button Content="{Binding RegisterFolderText}" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            Command="{Binding RegisterFolderOfCommand}" CommandParameter="{Binding Selected.GroupKey}"
                                            ToolTip="このzipの中身が入っているフォルダを、商品として登録します。先に「商品IDを決める」で商品IDを確認してから押します。" />
                                </StackPanel>
                                <TextBlock Text="zipが残っているので、zipで登録するのがおすすめです。"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding ContentsSummary}" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="#f0f1f4" BorderThickness="1"
                                    CornerRadius="6" Padding="11,9" MaxHeight="150"
                                    Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedContents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--
                        展開元のzipファイルが無いフォルダの片付け方。選んだファイルがそういうフォルダにあるときだけ出す。
                        前は左の束の中に出していたが、束ごとに大きな枠が並んでごちゃごちゃした（ユーザ指示 2026-09-17）。
                        色は付けない（広い面を黄色くすると違和感があった。見出しと重なる「zipが無い」の札も文言の見直しで外した）。
                        zipを取り込む形が一番きれい（配布単位と一致し、移動にも強く、展開先は自動で対象外になる）なので、まずそれを勧める
                    -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16"
                            Visibility="{Binding Selected.IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <!--
                                説明は1文にまとめ、補足はボタンのツールチップへ（ユーザ判断 2026-09-17 案A：枠が長かった）。
                                「どの商品か調べる」「ブラウザで検索」は下の「候補」の枠と同じ動きなので置かない。判断の根拠は見出しのツールチップ
                            -->
                            <TextBlock Text="展開元のzipファイルが無いフォルダ" FontWeight="Bold" FontSize="13"
                                       ToolTip="{Binding Selected.ContentReason}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="BOOTHからzipを落とし直すのがおすすめです（下の「候補」でどの商品か探せます）。落とし直せないときは、フォルダのまま登録するか、「その他」から管理対象から除外します。" />
                            <!--
                                対象は左の束・まとめて扱う単位と同じ展開物の根（ユーザ判断 2026-09-17 案A）。どこまで広いかを押す前に見せる。
                                外すは「その他」の「管理対象から除外する」が同じ対象に効くので、ここには置かない
                            -->
                            <TextBlock Text="{Binding RegisterTargetSummary}" Style="{StaticResource Mono}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{Binding RegisterFolderText}" Style="{StaticResource SmallButton}"
                                        Command="{Binding RegisterFolderOfCommand}" CommandParameter="{Binding Selected.GroupKey}"
                                        ToolTip="先に「商品IDを決める」で商品IDを確認してから押します。場所で覚えるので、フォルダを動かすとつながりが切れます。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        並びは「分かっていること → 商品IDを決める → 候補 → その他」（ユーザ指示 2026-09-17）。
                        前は候補が決める欄より上にあり、決める道が「確定」「管理対象から除外する」「BOOTHに無い商品」と1枚の中に混ざっていた
                    -->
                    <!-- 決定 -->
                    <Border Style="{StaticResource Card}" x:Name="DecisionCard" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="商品IDを決める" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDかURLを入れるか、BOOTHの商品ページをこの画面に落とすと、その商品が下に出ます。確認してから確定してください。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10" />
                            <!-- 元のzipが未確定にある中身は、zipで登録するよう止めている。押せない理由を出す。IDを入れる前（落とす前）から分かるよう欄の上に置く（ユーザ判断 2026-09-17） -->
                            <TextBlock Text="{Binding BlockedByZipText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Warn}" Margin="0,0,0,10"
                                       Visibility="{Binding IsBlockedByListedZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" PreviewDragOver="OnIdBoxPreviewDragOver" PreviewDrop="OnIdBoxPreviewDrop" Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,7,0">
                                    <!-- Enter で「このIDで確認」まで進む（I12）。確定は押して決める（取り返しがつかないので Enter では走らせない） -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PreviewCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="このIDで確認" Command="{Binding PreviewCommand}" />
                            </Grid>

                            <!-- プレビュー -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,12,0,0"
                                    Visibility="{Binding HasPreview, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="このIDの商品" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center" />
                                        <!-- 状態はチップにする。文で出すと「だから登録できない」に読める -->
                                        <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                Visibility="{Binding IsPreviewOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding PreviewOwnedNote}" FontSize="10"
                                                       Foreground="{StaticResource Good}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 押したら何が起きるかを、ボタンのすぐ上に必ず出す -->
                            <TextBlock Text="{Binding AssignOutcomeText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasAssignOutcome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="このIDで確定する" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AssignCommand}" />
                            </StackPanel>
                            <!-- 例外（1つのzipに複数の商品が入っているなど）のために、zipの単位にしない。選び直すと切れる（ユーザ判断 2026-09-17） -->
                            <CheckBox Content="このファイルだけを扱う" Margin="0,9,0,0" IsChecked="{Binding SingleFileOnly, Mode=TwoWay}"
                                      ToolTip="1つのzipに複数の商品が入っているときなど。切っている間は、zipの中身をまとめて登録します。"
                                      Visibility="{Binding CanChooseSingleFile, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!--
                                選択中だけ出る一括操作。
                                展開先の中身が10件以上並ぶことがあり、1件ずつでは捌けない。
                            -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,14,0,0"
                                    Visibility="{Binding HasChecked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CheckedText}" FontWeight="Bold" FontSize="12.5" Foreground="#28507f" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="{Binding AssignCheckedText}" Command="{Binding AssignCheckedCommand}" />
                                        <Button Content="{Binding ExcludeCheckedText}" Margin="9,0,0,0"
                                                Command="{Binding ExcludeCheckedCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="まとめて確定するには、先に上で商品IDを確認してください。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasPreview, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 候補 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="候補" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="自動検索" Style="{StaticResource SmallButton}"
                                            Command="{Binding ProposeCommand}" />
                                    <Button Content="ブラウザで検索" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            ToolTip="このファイル名でBOOTHを検索します（アプリの外へ出ます）。"
                                            Command="{Binding OpenBoothCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SearchTargetText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!--
                                自動検索は1件ずつ間隔を空けて取りに行くので十数秒かかる。
                                何をどこまでやっているかを出さないと、止まったように見える。
                            -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsSearching, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SearchProgressText}" Style="{StaticResource Caption}" />
                                <!-- 件数が分かる段階だけ実際の進み具合を出し、それ以外は動いていることだけ示す -->
                                <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0"
                                             Maximum="{Binding SearchTotal, Mode=OneWay}"
                                             Value="{Binding SearchCurrent, Mode=OneWay}"
                                             IsIndeterminate="{Binding HasSearchTotal, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                             Foreground="{StaticResource Accent}" Background="#edeff3" BorderThickness="0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel Margin="0,0,200,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- 候補を出す以上、それが目当てのものか確かめる手段が要る -->
                                                    <Button Content="BOOTHで開く" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                            ToolTip="この候補の商品ページをブラウザで開いて、目当ての物か確かめます（アプリの外へ出ます）。"
                                                            Command="{Binding OpenBoothCommand}" />
                                                    <Button Content="これで確認" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.UseCandidateCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding CandidatesEmptyText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- 探す前から「無い」と言わない（ユーザ指示 2026-09-17） -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Candidates.Count}" Value="0" />
                                                    <Condition Binding="{Binding HasSearched}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- その他：商品IDで確定できないときの出口（ユーザ指示 2026-09-17：確定の欄から分けた） -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="その他" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDで確定できないときに使います。" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />

                            <!--
                                第三の出口。確定でも除外でもないものが実在する——
                                非公開・削除済みになった商品を買っていた場合。
                                除外は「これはBOOTH商品ではない」に使う語なので、
                                入れると統計からも検索からも消えてしまう。
                            -->
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="BOOTHに無い商品として登録する" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="非公開・削除済みで商品IDが分からないもの。名前を付けて手元の商品として登録します。" />

                                    <TextBox Margin="0,10,0,0"
                                             Text="{Binding LocalNameInput, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--
                                        名前の候補は自動で入れず、押したら入る形にする。
                                        登録簿の名前は他商品の記述から拾った推定を含むので、
                                        黙って入れると観測か推定かが後から分からなくなる。
                                    -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding HasLocalNameSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="手元の記録にあった名前（押すと入ります）" Style="{StaticResource Caption}" />
                                        <ItemsControl ItemsSource="{Binding LocalNameSuggestions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.UseLocalNameCommand,
                                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <Run Text="仮のID（" /><Run Text="{Binding LocalIdPreview, Mode=OneWay}" FontFamily="Consolas" /><Run Text="）として登録します。" />
                                    </TextBlock>

                                    <!-- 押す前に言う。商品ページにも常設で出す（半年後に理由を思い出せるように） -->
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{StaticResource Warn}"
                                               Text="BOOTHから情報を取り直さないので、名前も画像も増えません。" />

                                    <Button Content="この名前で登録する" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding RegisterLocalCommand}" />
                                    <TextBlock Text="元のzipが未確定にあるので、zipで登録してください（「商品IDを決める」の「このファイルだけを扱う」で1件だけにもできます）。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,6,0,0"
                                               Visibility="{Binding IsBlockedByListedZip, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <!-- 除外。取り返しがつくことを押す前に書く（押した後の確認の窓にも同じ旨） -->
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="管理しないファイルを一覧から外します。ファイル自体は消しません。設定の「隠したもの」から戻せます。" />
                                    <Button Content="管理対象から除外する" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding ExcludeCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        </Grid>
    </DockPanel>
</UserControl>
