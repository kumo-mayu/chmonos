<UserControl x:Class="BoothAssetManager.App.Views.ResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResolveViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="未確定" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="BoothIDが決まらなかったファイルです。IDを決めるか、管理から外します。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <!-- 確定分はここで溜めて、まとめて編集へ渡す（ID確定と入力を分ける設計） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding SettledText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="確定した分を編集へ送る" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendSettledToEditCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全部片付いたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="未確定のファイルはありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="取り込みで手掛かりが得られなかったファイルがここに並びます。"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：未確定の一覧（フォルダごとにまとめる） -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全て選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}" />
                            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                    Command="{Binding ClearChecksCommand}" />
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding FilesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                                BorderThickness="0,0,0,1" Padding="10,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 件}"
                                                               Style="{StaticResource Mono}" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <!-- 展開先の中身が固まって並ぶので、フォルダ単位で選べるようにする -->
                                                    <Button Content="このフォルダを選択" Style="{StaticResource SmallButton}"
                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.SelectFolderCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11" />
                                            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CandidateText}" FontSize="10" Foreground="{StaticResource Warn}" />
                                            </Border>
                                            <!-- 展開物の中身と判断したものは一覧でも分かるようにする -->
                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="5,0,0,0"
                                                    Visibility="{Binding IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="展開物の中身" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：手掛かりと決定 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20"
                          Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                    <!--
                        展開物の中身と判断できたものは、先にまとめて片付けられるようにする。
                        勝手には外さず、根拠を見せて選択肢として出す。
                    -->
                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,13" Margin="0,0,0,14"
                            Visibility="{Binding HasArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ArchiveContentText}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ArchiveContentReason}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />

                            <!--
                                外すだけだと、zipが残っていない商品はライブラリから消えてしまう。
                                まずzipを落とし直す道を勧め、それが無理な場合の受け皿を並べて出す。
                            -->
                            <!--
                                zipを取り込む形が一番きれい（配布単位と一致し、移動にも強く、
                                展開先は自動で対象外になる）。まずこれを勧める。
                            -->
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="2" CornerRadius="8" Padding="15,13" Margin="0,11,0,0">
                                <StackPanel>
                                    <TextBlock Text="まずはこちら：BOOTHからzipを落とし直す" FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="zipで持っておくのが一番きれいです。配布された単位と一致し、フォルダを移動しても追跡でき、展開先は自動で対象から外れます。まず「自動検索」でどの商品か調べ、BOOTHで開いて再ダウンロードしてください。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                        <Button Content="自動検索でこの商品を調べる" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ProposeCommand}" />
                                        <Button Content="ブラウザで検索" Margin="8,0,0,0"
                                                Command="{Binding OpenBoothCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="どうしても落とし直せない場合（非公開になった商品など）だけ、下を使ってください。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding RegisterFolderText}" Style="{StaticResource SmallButton}"
                                        Command="{Binding RegisterFolderCommand}" />
                                <Button Content="まとめて選択して外す" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                        Command="{Binding SelectArchiveContentCommand}" />
                            </StackPanel>
                            <TextBlock Text="フォルダ登録は場所で覚えるので、フォルダを移動するとリンクが切れます（先に商品IDを確認してください）。管理から外すと、その商品はライブラリに残りません。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 手掛かり -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="このファイルについて分かっていること" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />

                            <TextBlock Text="保存場所" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding SelectedPaths}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ダウンロード元" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding ZoneText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <TextBlock Text="{Binding ContentsSummary}" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="#f0f1f4" BorderThickness="1"
                                    CornerRadius="6" Padding="11,9" MaxHeight="150"
                                    Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedContents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 候補 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="候補" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="自動検索" Style="{StaticResource SmallButton}"
                                            Command="{Binding ProposeCommand}" />
                                    <Button Content="ブラウザで検索" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            Command="{Binding OpenBoothCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SearchTargetText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!--
                                自動検索は1件ずつ間隔を空けて取りに行くので十数秒かかる。
                                何をどこまでやっているかを出さないと、止まったように見える。
                            -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsSearching, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SearchProgressText}" Style="{StaticResource Caption}" />
                                <!-- 件数が分かる段階だけ実際の進み具合を出し、それ以外は動いていることだけ示す -->
                                <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0"
                                             Maximum="{Binding SearchTotal, Mode=OneWay}"
                                             Value="{Binding SearchCurrent, Mode=OneWay}"
                                             IsIndeterminate="{Binding HasSearchTotal, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                             Foreground="{StaticResource Accent}" Background="#edeff3" BorderThickness="0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel Margin="0,0,110,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Content="これで確認" Style="{StaticResource SmallButton}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.UseCandidateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="候補がありません。上のボタンで検索するか、商品IDを直接入れてください。" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 決定 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="商品IDを決める" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDを入れて「このIDで確認」を押すと、そのIDが何の商品かを取得して下に出します。確かめてから確定してください。画像までは取りに行きません（名前とショップで判断できるため）。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,7,0" />
                                <Button Grid.Column="1" Content="このIDで確認" Command="{Binding PreviewCommand}" />
                            </Grid>

                            <!-- プレビュー -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,12,0,0"
                                    Visibility="{Binding HasPreview, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="このIDの商品" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding PreviewOwnedNote}" Style="{StaticResource Caption}"
                                               Foreground="{StaticResource Good}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Visibility="{Binding IsPreviewOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="このIDで確定する" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AssignCommand}" />
                                <Button Content="管理から外す" Margin="9,0,0,0" Command="{Binding ExcludeCommand}" />
                            </StackPanel>

                            <!--
                                選択中だけ出る一括操作。
                                展開先の中身が10件以上並ぶことがあり、1件ずつでは捌けない。
                            -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,14,0,0"
                                    Visibility="{Binding HasChecked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CheckedText}" FontWeight="Bold" FontSize="12.5" Foreground="#28507f" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="{Binding AssignCheckedText}" Command="{Binding AssignCheckedCommand}" />
                                        <Button Content="{Binding ExcludeCheckedText}" Margin="9,0,0,0"
                                                Command="{Binding ExcludeCheckedCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="まとめて確定するには、先に上で商品IDを確認してください。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasPreview, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
