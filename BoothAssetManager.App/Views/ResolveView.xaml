<UserControl x:Class="BoothAssetManager.App.Views.ResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
             xmlns:controls="clr-namespace:BoothAssetManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResolveViewModel}">
    <DockPanel Background="{StaticResource Bg}">

        <!-- フォルダビューに組み込んだときは上の帯と左の一覧を隠す（ShowsChrome・ListColumnWidth） -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="未確定" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="12,0" />
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    <TextBlock Text="商品IDが決まらなかったファイルです。商品のIDを登録するか、管理対象から外します。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <!-- 確定分はここで溜めて、まとめて編集へ渡す（ID確定と入力を分ける設計） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasSettled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding SettledText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <!-- 正しく結び付いたかを、その場で商品ページで確かめる（動線の点検 D3） -->
                    <Button Content="最後に確定した商品を開く" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                            VerticalAlignment="Center" Command="{Binding OpenLastSettledCommand}"
                            ToolTip="最後に確定した商品のページを開きます。「確定した分を編集へ送る」の対象は、この画面を離れると消えます（未編集のまま残るので、編集の順番には出てきます）。" />
                    <Button Content="確定した分を編集へ送る" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendSettledToEditCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 検索・要確認と同じ理由。読んでいる最中に一覧を動かさない -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <Button Margin="20,12,20,0" FontSize="12"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                    Content="{Binding Main.PendingItemText}"
                    Command="{Binding ReloadCommand}"
                    Visibility="{Binding Main.HasPendingItems, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </Border>

        <!-- 片付いた表示と一覧は重ねる。DockPanelの兄弟にすると横幅を食って中央に来ない -->
        <Grid>

        <!-- 全部片付いたとき -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="未確定のファイルはありません" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="取り込みで手掛かりが得られなかったファイルがここに並びます。"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RemainingCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListPane.Width, Mode=TwoWay}"
                                  MinWidth="{Binding ListPane.MinWidth}" MaxWidth="{Binding ListPane.MaxWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左の一覧の幅を変える境目（ユーザ判断 2026-09-14）。組み込んだときは一覧が無いので出さない -->
            <controls:PaneSplitter Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="2"
                                   ResetCommand="{Binding ListPane.ResetCommand}"
                                   Visibility="{Binding ListPane.CanResize, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

            <!-- 左：未確定の一覧（フォルダごとにまとめる） -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowsChrome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全て選択" Style="{StaticResource SmallButton}" Command="{Binding SelectAllCommand}" />
                            <Button Content="選択を解除" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                    Command="{Binding ClearChecksCommand}" />
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding FilesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <!--
                            束は元zip（分からなければフォルダ）。元zipの束は畳んで出し、zipを単位に扱う。
                            1件ずつ扱いたいときだけ開いて行を選ぶ。
                            束の見出しは GroupItem の DataContext（CollectionViewGroup）に結ぶので、
                            元zipかどうかは先頭の行（Items[0]）から読む
                        -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="{Binding Items[0].StartsExpanded, Mode=OneTime}"
                                                              Background="{StaticResource SurfaceAlt}"
                                                              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                                                              Padding="0">
                                                        <Expander.Header>
                                                            <!-- 列の幅は330で固定。見出しは伸びないので、長い名前は幅を決めて省略させる -->
                                                            <StackPanel Margin="2,6,0,6" Width="270">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Items[0].HasOrigin}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="元zip" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                                    </Border>
                                                                    <!-- 展開元のzipが無いフォルダ。畳んでいても分かるように見出しに出す -->
                                                                    <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                            BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,7,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Items[0].IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                        <TextBlock Text="zipが無い" FontSize="10" Foreground="{StaticResource Warn}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 件}"
                                                                               Style="{StaticResource Mono}" FontSize="11"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Content="このzipを選ぶ" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            Command="{Binding DataContext.SelectGroupCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                                                                    <!-- 展開先の中身が固まって並ぶので、フォルダ単位で選べるようにする -->
                                                                    <Button Content="このフォルダを選択" Style="{StaticResource SmallButton}"
                                                                            Height="23" FontSize="10.5" Margin="8,0,0,0"
                                                                            Command="{Binding DataContext.SelectFolderCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Visibility="{Binding Items[0].HasOrigin, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Background="{StaticResource Surface}">
                                                            <!--
                                                                展開元のzipファイルが無いフォルダの片付け方（ユーザ指示 2026-09-17：右側から、この操作が要るフォルダの所へ移した）。
                                                                何に使う枠かを先に書く。勝手には外さず、根拠を見せて選ばせる。
                                                                zipを取り込む形が一番きれい（配布単位と一致し、移動にも強く、展開先は自動で対象外になる）なので、まずそれを勧める
                                                            -->
                                                            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="10,9" Margin="8,6,8,6"
                                                                    Visibility="{Binding Items[0].IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="展開元のzipファイルが無いフォルダ" FontWeight="Bold" FontSize="12"
                                                                               Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                               Text="zipを展開した中身だけが残り、元のzipファイルが手元に無いときの片付け方です。" />
                                                                    <TextBlock Text="{Binding Items[0].ContentReason}" Style="{StaticResource Caption}"
                                                                               TextWrapping="Wrap" Margin="0,4,0,0" />

                                                                    <TextBlock Text="まずはBOOTHからzipを落とし直す" FontWeight="Bold" FontSize="11.5" Margin="0,9,0,0" />
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               Text="zipで持つのが一番きれいです。配布された単位と一致し、フォルダを動かしても追えて、展開したフォルダは自動で対象から外れます。" />
                                                                    <WrapPanel Margin="0,6,0,0">
                                                                        <Button Content="どの商品か調べる" Style="{StaticResource SmallButton}" Margin="0,0,6,4"
                                                                                Command="{Binding DataContext.InvestigateFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Name}" />
                                                                        <Button Content="ブラウザで検索" Style="{StaticResource SmallButton}" Margin="0,0,6,4"
                                                                                Command="{Binding DataContext.SearchFolderInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Name}" />
                                                                    </WrapPanel>

                                                                    <TextBlock Text="落とし直せないとき（非公開になった商品など）" FontWeight="Bold" FontSize="11.5" Margin="0,8,0,0" />
                                                                    <WrapPanel Margin="0,5,0,0">
                                                                        <Button Content="このフォルダを商品として登録" Style="{StaticResource SmallButton}" Margin="0,0,6,4"
                                                                                Command="{Binding DataContext.RegisterFolderOfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Name}"
                                                                                ToolTip="先に右の「商品IDを決める」で、このフォルダの商品IDを確かめてから押します。" />
                                                                        <Button Content="このフォルダを管理対象から外す" Style="{StaticResource SmallButton}" Margin="0,0,6,4"
                                                                                Command="{Binding DataContext.ExcludeFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding Name}" />
                                                                    </WrapPanel>
                                                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                               Text="商品として登録すると場所で覚えるので、フォルダを動かすとつながりが切れます。管理対象から外すと、その商品はライブラリに残りません（ファイル自体は消しません）。" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}" FontSize="11" />
                                            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnBorder}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CandidateText}" FontSize="10" Foreground="{StaticResource Warn}" />
                                            </Border>
                                            <!-- 展開物の中身と判断したものは一覧でも分かるようにする -->
                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderStrong}"
                                                    BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="5,0,0,0"
                                                    Visibility="{Binding IsArchiveContent, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="展開物の中身" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：手掛かりと決定 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20"
                          Visibility="{Binding HasSelection, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                    <!-- 元zipの束を選んでいるとき。下の確定・管理対象から外すが全件に効くことを先に言う -->
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16,13" Margin="0,0,0,14"
                            Visibility="{Binding HasActiveGroup, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveGroupText}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="#28507f" TextWrapping="Wrap" />
                            <TextBlock Text="展開したときに Windows が残した記録から、このzipの中身と分かったファイルです。下の「このIDで確定する」と「管理対象から外す」は、この全件に効きます。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <Button Content="1件ずつ扱う" Style="{StaticResource SmallButton}" Margin="0,9,0,0"
                                    HorizontalAlignment="Left" Command="{Binding ClearGroupCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- 手掛かり -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="このファイルについて分かっていること" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />

                            <TextBlock Text="保存場所" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding SelectedPaths}" Margin="0,5,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ダウンロード元" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding ZoneText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasZone, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 今もそこにあるとは限らない。消したzipや、別のPCで展開したzipでも記録は残る -->
                            <TextBlock Text="元のzip（展開したときの記録）" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding SelectedOriginText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding HasSelectedOrigin, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <TextBlock Text="{Binding ContentsSummary}" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"
                                       Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="#f0f1f4" BorderThickness="1"
                                    CornerRadius="6" Padding="11,9" MaxHeight="150"
                                    Visibility="{Binding HasContents, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedContents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--
                        並びは「分かっていること → 商品IDを決める → 候補 → その他」（ユーザ指示 2026-09-17）。
                        前は候補が決める欄より上にあり、決める道が「確定」「管理から外す」「BOOTHに無い商品」と1枚の中に混ざっていた
                    -->
                    <!-- 決定 -->
                    <Border Style="{StaticResource Card}" x:Name="DecisionCard" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="商品IDを決める" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDか商品ページのURLを入れて「このIDで確認」を押すと、そのIDが何の商品かを取得して下に出します。BOOTHの商品ページ（アドレス欄やリンク）をこの画面のどこに落としても入ります。確かめてから確定してください。画像までは取りに行きません（名前とショップで判断できるため）。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" PreviewDragOver="OnIdBoxPreviewDragOver" PreviewDrop="OnIdBoxPreviewDrop" Text="{Binding ItemIdInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,7,0" />
                                <Button Grid.Column="1" Content="このIDで確認" Command="{Binding PreviewCommand}" />
                            </Grid>

                            <!-- プレビュー -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,12,0,0"
                                    Visibility="{Binding HasPreview, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="このIDの商品" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center" />
                                        <!-- 状態はチップにする。文で出すと「だから登録できない」に読める -->
                                        <Border Background="{StaticResource GoodSoft}" BorderBrush="{StaticResource GoodBorder}"
                                                BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                Visibility="{Binding IsPreviewOwned, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding PreviewOwnedNote}" FontSize="10"
                                                       Foreground="{StaticResource Good}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewDetail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasStatus, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <!-- 押したら何が起きるかを、ボタンのすぐ上に必ず出す -->
                            <TextBlock Text="{Binding AssignOutcomeText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,14,0,0"
                                       Visibility="{Binding HasAssignOutcome, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="このIDで確定する" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AssignCommand}" />
                            </StackPanel>

                            <!--
                                選択中だけ出る一括操作。
                                展開先の中身が10件以上並ぶことがあり、1件ずつでは捌けない。
                            -->
                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,14,0,0"
                                    Visibility="{Binding HasChecked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CheckedText}" FontWeight="Bold" FontSize="12.5" Foreground="#28507f" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Button Content="{Binding AssignCheckedText}" Command="{Binding AssignCheckedCommand}" />
                                        <Button Content="{Binding ExcludeCheckedText}" Margin="9,0,0,0"
                                                Command="{Binding ExcludeCheckedCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="まとめて確定するには、先に上で商品IDを確認してください。"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasPreview, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 候補 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="候補" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="自動検索" Style="{StaticResource SmallButton}"
                                            Command="{Binding ProposeCommand}" />
                                    <Button Content="ブラウザで検索" Style="{StaticResource SmallButton}" Margin="7,0,0,0"
                                            Command="{Binding OpenBoothCommand}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SearchTargetText}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!--
                                自動検索は1件ずつ間隔を空けて取りに行くので十数秒かかる。
                                何をどこまでやっているかを出さないと、止まったように見える。
                            -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsSearching, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SearchProgressText}" Style="{StaticResource Caption}" />
                                <!-- 件数が分かる段階だけ実際の進み具合を出し、それ以外は動いていることだけ示す -->
                                <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0"
                                             Maximum="{Binding SearchTotal, Mode=OneWay}"
                                             Value="{Binding SearchCurrent, Mode=OneWay}"
                                             IsIndeterminate="{Binding HasSearchTotal, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                             Foreground="{StaticResource Accent}" Background="#edeff3" BorderThickness="0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6"
                                                Padding="12,10" Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel Margin="0,0,200,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- 候補を出す以上、それが目当てのものか確かめる手段が要る -->
                                                    <Button Content="BOOTHで見る" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                            Command="{Binding OpenBoothCommand}" />
                                                    <Button Content="これで確認" Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.UseCandidateCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="候補がありません。上のボタンで検索するか、「商品IDを決める」に商品IDを直接入れてください。" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- その他：商品IDで確定できないときの出口（ユーザ指示 2026-09-17：確定の欄から分けた） -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,20" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="その他" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="商品IDで確定できないときに使います。" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />

                            <!--
                                第三の出口。確定でも除外でもないものが実在する——
                                非公開・削除済みになった商品を買っていた場合。
                                除外は「これはBOOTH商品ではない」に使う語なので、
                                入れると統計からも検索からも消えてしまう。
                            -->
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="BOOTHに無い商品として登録する" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="非公開・削除済みで商品IDが分からないもの。名前を付けて手元の商品として登録します。" />

                                    <TextBox Margin="0,10,0,0"
                                             Text="{Binding LocalNameInput, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--
                                        名前の候補は自動で入れず、押したら入る形にする。
                                        登録簿の名前は他商品の記述から拾った推定を含むので、
                                        黙って入れると観測か推定かが後から分からなくなる。
                                    -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding HasLocalNameSuggestions, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="手元の記録にあった名前（押すと入ります）" Style="{StaticResource Caption}" />
                                        <ItemsControl ItemsSource="{Binding LocalNameSuggestions}" Margin="0,5,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.UseLocalNameCommand,
                                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <Run Text="仮のID（" /><Run Text="{Binding LocalIdPreview, Mode=OneWay}" FontFamily="Consolas" /><Run Text="）として登録します。" />
                                    </TextBlock>

                                    <!-- 押す前に言う。商品ページにも常設で出す（半年後に理由を思い出せるように） -->
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{StaticResource Warn}"
                                               Text="この商品はBOOTHから情報を取り直しません。名前も画像も増えません。" />

                                    <Button Content="この名前で登録する" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding RegisterLocalCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- 除外。取り返しがつくことを押す前に書く（押した後の確認の窓にも同じ旨） -->
                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="13,11" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="管理対象から外す" FontWeight="Bold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                                               Text="BOOTHの商品ではないファイル（自分で作った物など）に使います。ファイル自体は消しません。設定の「隠したもの」から戻せます。" />
                                    <Button Content="管理対象から外す" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Command="{Binding ExcludeCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        </Grid>
    </DockPanel>
</UserControl>
