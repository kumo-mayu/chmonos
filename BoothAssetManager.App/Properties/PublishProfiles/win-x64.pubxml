<?xml version="1.0" encoding="utf-8"?>
<!--
  渡す用のビルド。dotnet publish -p:PublishProfile=win-x64

  ここに書く（csproj の PropertyGroup には書かない）のは、RuntimeIdentifier を
  csproj へ足すと dotnet build まで RID 付きの出力になり、開発用の exe が
  bin\Debug\net9.0-windows\win-x64\ へ移って ui-check の起動が壊れるため。
  publish のときだけ効かせる。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      自己完結。.NET 9 は RuntimeIdentifier を指定しても既定は false なので、明示する。
      渡す相手に「先に .NET 9 デスクトップランタイムを入れて」と頼まずに済ませるため
      （入れてもらう手順が1つ増えるほど、起動する前に詰まる）。
    -->
    <SelfContained>true</SelfContained>

    <!--
      1ファイルにまとめない。起動のたびに一時フォルダへ展開する形になり、
      セキュリティソフトの誤検知が増える（docs/research/antivirus.md A の「参考」）。
      署名が無い間は、誤検知の要因を足さない。
    -->
    <PublishSingleFile>false</PublishSingleFile>

    <PublishDir>..\publish\Chmonos-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
