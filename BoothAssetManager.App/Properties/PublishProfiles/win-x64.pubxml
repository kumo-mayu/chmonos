<?xml version="1.0" encoding="utf-8"?>
<!--
  渡す用のビルド。dotnet publish -p:PublishProfile=win-x64

  ここに書く（csproj の PropertyGroup には書かない）のは、RuntimeIdentifier を
  csproj へ足すと dotnet build まで RID 付きの出力になり、開発用の exe が
  bin\Debug\net9.0-windows\win-x64\ へ移って ui-check の起動が壊れるため。
  publish のときだけ効かせる。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      自己完結。.NET 9 は RuntimeIdentifier を指定しても既定は false なので、明示する。
      渡す相手に「先に .NET 9 デスクトップランタイムを入れて」と頼まずに済ませるため
      （入れてもらう手順が1つ増えるほど、起動する前に詰まる）。
    -->
    <SelfContained>true</SelfContained>

    <!--
      1ファイルにまとめる（2026-09-21 ユーザ判断）。405ファイルのフォルダごと渡すより、
      受け取った側が何を起動すればよいか分かる形を優先した。

      代償は測ってある：初回の起動が 1315ms（2回目以降は 689/700ms。まとめない形は 701/685/624ms）。
      ネイティブDLL 5つ・7.8MB が %TEMP%\.net\ へ展開され、以降は使い回される。
      一時フォルダへの展開は docs/research/antivirus.md A の「参考」が懸念していた動きそのもので、
      署名が無い間は誤検知の要因が1つ増える。詰まったらここを false に戻す。

      圧縮（EnableCompressionInSingleFile）は掛けない。起動が更に遅くなる上に、
      圧縮された実行ファイルは誤検知の要因として別に数えられる。
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      ネイティブDLL（wpfgfx_cor3 など5つ）も exe に入れる。付けないと exe の隣に残り、
      1ファイルにした意味が薄れる。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      pdb は別ファイルにせず DLL へ埋め込む。別ファイルのままだと exe の隣に4つ並ぶし、
      単に落とすと logs\app.log のスタックトレースからファイル名と行番号が消えて、
      渡した先で起きた不具合を追えなくなる。
    -->
    <DebugType>embedded</DebugType>

    <PublishDir>..\publish\Chmonos-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
