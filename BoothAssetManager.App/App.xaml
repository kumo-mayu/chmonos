<Application x:Class="BoothAssetManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels">
    <Application.Resources>
        <!--
            畳む・開くの山形。ナビと検索の絞り込みパネルで同じものを使うので、
            どちらか一方の画面ではなくここに置く。24×24の座標系。
        -->
        <PathGeometry x:Key="IconCollapse" Figures="M14,7 L9,12 L14,17" />
        <PathGeometry x:Key="IconExpand" Figures="M10,7 L15,12 L10,17" />

        <!-- モックで決めた配色をそのまま持ち込む -->
        <SolidColorBrush x:Key="Bg" Color="#f2f3f5" />
        <SolidColorBrush x:Key="Surface" Color="#ffffff" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#fafafb" />
        <SolidColorBrush x:Key="Border" Color="#e2e4e9" />
        <SolidColorBrush x:Key="BorderStrong" Color="#cdd0d8" />
        <SolidColorBrush x:Key="Text" Color="#1c1f26" />
        <SolidColorBrush x:Key="TextMuted" Color="#6a7180" />
        <SolidColorBrush x:Key="TextFaint" Color="#9aa1ae" />
        <SolidColorBrush x:Key="Accent" Color="#3767a6" />
        <SolidColorBrush x:Key="AccentSoft" Color="#eaf0f9" />
        <SolidColorBrush x:Key="AccentBorder" Color="#c6d6ec" />
        <!-- 重要なボタンに乗せたときの青。Accent より一段濃くして、白い文字が読めるままにする -->
        <SolidColorBrush x:Key="AccentHover" Color="#2b5487" />
        <SolidColorBrush x:Key="Rail" Color="#22262e" />
        <SolidColorBrush x:Key="RailActive" Color="#313745" />
        <SolidColorBrush x:Key="RailText" Color="#cfd4dd" />
        <SolidColorBrush x:Key="RailLabel" Color="#5d6675" />
        <SolidColorBrush x:Key="Good" Color="#2f7d5a" />
        <SolidColorBrush x:Key="GoodSoft" Color="#e7f2ec" />
        <SolidColorBrush x:Key="GoodBorder" Color="#c9e2d5" />
        <SolidColorBrush x:Key="Warn" Color="#8a5f1a" />
        <SolidColorBrush x:Key="WarnSoft" Color="#fbf1de" />
        <SolidColorBrush x:Key="WarnBorder" Color="#eddcbb" />
        <!-- 「見つからない」のような、注意ではなく異常を示す色。Good/Warn と同じ彩度に揃える -->
        <SolidColorBrush x:Key="Bad" Color="#a33c3c" />
        <SolidColorBrush x:Key="BadSoft" Color="#fbeaea" />
        <SolidColorBrush x:Key="BadBorder" Color="#eec9c9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!--
            選択できる本文。見た目はTextBlockに寄せ、枠も背景も出さない。
            スクロールを内側で持たせない（Disabled）ことで、中身の高さに合わせて伸び、
            ページ全体のスクロールもそのまま効く。
        -->
        <Style x:Key="SelectableBody" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="-2,0,0,0" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#454b57" />
            <Setter Property="Cursor" Value="IBeam" />
            <!-- 本文なのでTabの行き先にはしない（選択とリンクはマウスで足りる） -->
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 角丸・枠線つきのカード -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <!--
                                ボタンの文字はボタンの Foreground に従わせる。アプリ全体の暗黙の TextBlock スタイル（色 Text）が
                                ボタンの作る文字にも効き、重要なボタンの白が濃い色に上書きされていた（ユーザ指摘 2026-09-14「青地に黒文字」）。
                                ContentPresenter の中に置くと、それが作る文字だけに効く
                            -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                            <!--
                                無効の表現は薄さだけに頼らない。0.45まで落とすと何のボタンか読めなくなる。
                                文字と枠の色を弱めたうえで、透過は控えめにする。
                            -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <!-- 白文字を色地に載せると細い字画が沈むので、少し太らせる -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <!--
                乗せたときは青を濃くする。土台のボタンは乗せると地を薄い灰にするので、そのままだと青が消えて
                白い文字が読めなくなっていた（ユーザ指摘 2026-09-14）。文字の決まり・押せないときの見た目は土台と同じ
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAlt}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Border}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            狭い場所に置く小さいボタン。
            既定のボタンは Padding 14,0 を ContentPresenter の Margin にしているので、
            幅を固定すると左右28px分だけ文字の使える幅が減って途中で切れる。
            こちらは余白を詰め、幅は内容任せ（固定しない）で使う。
        -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!--
            札の並び（BOOTHのタグ・対応アバター）に混ぜる札。商品ページと編集画面で同じ見た目にするのでここに置く。
            作った札は隠すだけで捨てない（ChipStrip・ユーザ判断 2026-09-12）ので、見えるかどうかは札の IsShown で決める
        -->
        <DataTemplate DataType="{x:Type vm:TagTile}">
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12"
                    Padding="10,3" Margin="0,0,6,6" Background="White"
                    Visibility="{Binding IsShown, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#454b57" />
            </Border>
        </DataTemplate>
        <!-- 「残り n を表示」⇔「最初の 40 だけにする」（ユーザ指示：可逆にする）。1枚のまま文字だけ変わる -->
        <DataTemplate DataType="{x:Type vm:ChipToggle}">
            <Button Content="{Binding Text}" Style="{StaticResource SmallButton}" Margin="0,0,6,6"
                    Command="{Binding Command}" ToolTip="{Binding Hint}"
                    Visibility="{Binding IsShown, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
        </DataTemplate>
    </Application.Resources>
</Application>
