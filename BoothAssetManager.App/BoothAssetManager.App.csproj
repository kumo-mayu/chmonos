<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BoothAssetManager.Core\BoothAssetManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    自己完結で publish すると、.NET はプロセスのメモリを書き出す道具 createdump.exe を同梱する。
    アプリはこれを使わない。用途の分からない exe、とくにメモリを書き出す道具は
    セキュリティソフトに怪しまれやすいので、配布物から落とす（#46、2026-09-11 ユーザ判断）
  -->
  <Target Name="DropCreatedump" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'createdump.exe'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      第2世代の空きが多くなったら、GCに詰め直させる（0〜9、大きいほど早めに詰める）。
      2000件の保存先では起動直後に第2世代の37%が空きのまま握られていた（#71）。
      裏で動くGCは詰め直しをしないので、放っておくと穴ごと持ち続ける。
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
