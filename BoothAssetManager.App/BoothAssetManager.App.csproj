<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BoothAssetManager.Core\BoothAssetManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!--
      人に渡す形（自己完結・RID指定）で publish すると NETSDK1152 で止まる。

      Core が参照している BoothZipInspector と BoothIdResolver は
      **ライブラリとして使っている**のに OutputType が Exe（実験用のCLIも
      持っているため）。Exe の参照は apphost・deps.json・runtimeconfig.json を
      発行物に持ち込み、RIDを指定すると RID有り／無しの2組が出て衝突する。

      アプリはこの2つを別プロセスとして起動しないので、どちらが残っても動く。
      本筋の直し方は2つをライブラリにしてCLIを experiments/ へ移すことだが、
      配布物を作るためだけにプロジェクトの構成は変えない。
    -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <!--
      第2世代の空きが多くなったら、GCに詰め直させる（0〜9、大きいほど早めに詰める）。
      2000件の保存先では起動直後に第2世代の37%が空きのまま握られていた（#71）。
      裏で動くGCは詰め直しをしないので、放っておくと穴ごと持ち続ける。
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
