<!--
    暗い色の表。明るい色の表（Light.xaml）と同じ鍵を持つ（docs/spec/ui-colors.md）。

    決め方：
    - 文字と地のコントラストは WCAG の AA（本文 4.5:1、大きい文字と部品 3:1）を満たす。比は ui-colors.md の表
    - 面は3段（地 Bg → カード Surface → 乗せた・一段上げた SurfaceAlt）。暗い側では上の段ほど明るくする
    - 面の上に置く色（Accent・Good・Warn・Bad・Unread の文字）は、暗い地で読めるよう明るく寄せる。
      白い文字を載せる地（〜Fill）は逆に、白が読める濃さのまま残す
    - 絵の上の物（OnImage・Image〜）は、絵が表で変わらないので明るい表とほぼ同じ
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面：画面の地・カード・枠 ===== -->
    <SolidColorBrush x:Key="Bg" Color="#15171c" />
    <SolidColorBrush x:Key="Surface" Color="#1e2127" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#272b32" />
    <SolidColorBrush x:Key="Border" Color="#343943" />
    <SolidColorBrush x:Key="BorderStrong" Color="#4b515d" />
    <SolidColorBrush x:Key="Divider" Color="#2a2e36" />
    <SolidColorBrush x:Key="BarTrack" Color="#30353e" />
    <!-- 入力欄はカードより一段沈める（明るい表では白で、カードと同じ） -->
    <SolidColorBrush x:Key="InputBack" Color="#17191e" />

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="Text" Color="#e6e8ec" />
    <SolidColorBrush x:Key="TextBody" Color="#c9cdd4" />
    <SolidColorBrush x:Key="TextMuted" Color="#a3aab6" />
    <!-- 明るい表の TextFaint は白地で 2.6:1 と弱いが、暗い表では AA（4.5:1）に届く所まで上げた -->
    <SolidColorBrush x:Key="TextFaint" Color="#868e9b" />

    <!-- ===== 強調（青） ===== -->
    <!-- 面の上の青は明るく寄せる（明るい表の #3767a6 のままだと暗い地で 2.9:1 しかない） -->
    <SolidColorBrush x:Key="Accent" Color="#6fa5ee" />
    <SolidColorBrush x:Key="AccentText" Color="#9dc2f4" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1f2e44" />
    <SolidColorBrush x:Key="AccentBorder" Color="#36507a" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#c6d3e6" />
    <!-- 白い文字を載せる青は濃いまま。乗せたときは一段明るくするが、白が 4.5:1 を切らない所で止める -->
    <SolidColorBrush x:Key="AccentFill" Color="#35699f" />
    <SolidColorBrush x:Key="AccentHover" Color="#3f76b0" />
    <SolidColorBrush x:Key="OnAccent" Color="#ffffff" />
    <SolidColorBrush x:Key="AccentOverlay" Color="#cc3767a6" />

    <!-- ===== 状態の色 ===== -->
    <SolidColorBrush x:Key="Good" Color="#5cc497" />
    <SolidColorBrush x:Key="GoodSoft" Color="#17342a" />
    <SolidColorBrush x:Key="GoodBorder" Color="#2a5c47" />
    <SolidColorBrush x:Key="GoodFill" Color="#2f7d5a" />
    <SolidColorBrush x:Key="Warn" Color="#e3b36b" />
    <SolidColorBrush x:Key="WarnSoft" Color="#3a2f1a" />
    <SolidColorBrush x:Key="WarnBorder" Color="#5f4b27" />
    <SolidColorBrush x:Key="Bad" Color="#f08d8d" />
    <SolidColorBrush x:Key="BadSoft" Color="#3d2024" />
    <SolidColorBrush x:Key="BadBorder" Color="#6b363a" />
    <SolidColorBrush x:Key="BadFill" Color="#a33c3c" />
    <SolidColorBrush x:Key="DangerText" Color="#f29a9a" />
    <SolidColorBrush x:Key="DangerBorder" Color="#6b363a" />
    <SolidColorBrush x:Key="Unread" Color="#e694c3" />
    <SolidColorBrush x:Key="UnreadSoft" Color="#392233" />
    <SolidColorBrush x:Key="UnreadBorder" Color="#633c56" />
    <SolidColorBrush x:Key="UnreadFill" Color="#8a3f6b" />
    <SolidColorBrush x:Key="NeedsWorkFill" Color="#8a5f1a" />
    <SolidColorBrush x:Key="Star" Color="#f2b53a" />

    <!-- ===== 札 ===== -->
    <SolidColorBrush x:Key="ChipBack" Color="#262a31" />
    <SolidColorBrush x:Key="ChipText" Color="#c9cdd4" />
    <SolidColorBrush x:Key="ChipBorder" Color="#3a3f4a" />
    <SolidColorBrush x:Key="ChipRemove" Color="#8e9db5" />

    <!-- ===== ナビ。暗い表では地（Bg）より一段沈める ===== -->
    <SolidColorBrush x:Key="Rail" Color="#101216" />
    <SolidColorBrush x:Key="RailActive" Color="#272c37" />
    <SolidColorBrush x:Key="RailHover" Color="#1c2028" />
    <SolidColorBrush x:Key="RailText" Color="#cfd4dd" />
    <SolidColorBrush x:Key="RailTextActive" Color="#ffffff" />
    <SolidColorBrush x:Key="RailLabel" Color="#6b7483" />
    <SolidColorBrush x:Key="RailTitle" Color="#ffffff" />
    <SolidColorBrush x:Key="RailSubtitle" Color="#8f98a8" />
    <SolidColorBrush x:Key="RailMuted" Color="#848d9c" />
    <SolidColorBrush x:Key="RailIntro" Color="#a8b0be" />
    <SolidColorBrush x:Key="RailButtonDimBorder" Color="#232730" />
    <SolidColorBrush x:Key="RailNoticeBack" Color="#1d2129" />
    <SolidColorBrush x:Key="RailNoticeFrame" Color="#363d4b" />
    <SolidColorBrush x:Key="RailNoticeEdge" Color="#c39a55" />
    <SolidColorBrush x:Key="RailNoticeText" Color="#e2bd83" />

    <!-- ===== 絵の周り ===== -->
    <SolidColorBrush x:Key="ImageBack" Color="#2a2e36" />
    <SolidColorBrush x:Key="ThumbBack" Color="#292d34" />
    <SolidColorBrush x:Key="PlaceholderGlyph" Color="#525a68" />
    <SolidColorBrush x:Key="FolderIconFill" Color="#343943" />
    <!-- 頭文字のタイルは淡い色のまま（名前から決まる色は表で変えない）なので、文字も明るい表と同じ濃さ -->
    <SolidColorBrush x:Key="TileText" Color="#4a5160" />
    <SolidColorBrush x:Key="OnImage" Color="#ffffff" />
    <SolidColorBrush x:Key="ImageScrim" Color="#99000000" />
    <SolidColorBrush x:Key="ImageScrimLight" Color="#66000000" />
    <SolidColorBrush x:Key="ImageHoverShade" Color="#2b000000" />
    <SolidColorBrush x:Key="ImageDotIdle" Color="#66ffffff" />
    <SolidColorBrush x:Key="ImageDotActive" Color="#f2ffffff" />
    <!-- 絵の上の選ぶ印・「中を見る」。白い地のままだと、上に載せる明るい文字（Accent）が読めない -->
    <SolidColorBrush x:Key="ImagePill" Color="#e01e2127" />
    <Color x:Key="GlyphShadowColor">#ff000000</Color>

    <!-- ===== その他 ===== -->
    <SolidColorBrush x:Key="DropZoneBack" Color="#1a2230" />
    <SolidColorBrush x:Key="DropZoneBorder" Color="#3d557c" />
    <LinearGradientBrush x:Key="SurfaceFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#001e2127" Offset="0" />
        <GradientStop Color="#ff1e2127" Offset="0.45" />
    </LinearGradientBrush>
    <!-- 暗い地では薄い影は見えないので濃くする -->
    <Color x:Key="PopupShadowColor">#66000000</Color>
    <!-- 明るい黄色を暗い地に薄く敷くと濁った緑に見えるので、色を濃くして重ねる量を減らす -->
    <SolidColorBrush x:Key="FindMatch" Color="#5cc7a431" />
    <SolidColorBrush x:Key="FindCurrent" Color="#8ce0892e" />
    <!-- ===== 標準の部品（Themes/Controls.xaml が描く） ===== -->
    <!-- 入力欄の枠は、欄の地に対して部品の 3:1 を満たす -->
    <SolidColorBrush x:Key="InputBorder" Color="#666d7a" />
    <SolidColorBrush x:Key="InputBorderHover" Color="#838b98" />
    <SolidColorBrush x:Key="InputBorderFocus" Color="#6fa5ee" />
    <SolidColorBrush x:Key="SelectionBack" Color="#4a8fe0" />
    <SolidColorBrush x:Key="Caret" Color="#e6e8ec" />
    <SolidColorBrush x:Key="CheckBack" Color="#17191e" />
    <SolidColorBrush x:Key="CheckBackHover" Color="#212836" />
    <SolidColorBrush x:Key="CheckBackPressed" Color="#29344a" />
    <SolidColorBrush x:Key="CheckBorder" Color="#8a919d" />
    <SolidColorBrush x:Key="CheckBorderHover" Color="#6fa5ee" />
    <SolidColorBrush x:Key="CheckMark" Color="#e6e8ec" />
    <SolidColorBrush x:Key="ComboBack" Color="#2a2e36" />
    <SolidColorBrush x:Key="ComboBackHover" Color="#323845" />
    <SolidColorBrush x:Key="ComboBorder" Color="#666d7a" />
    <SolidColorBrush x:Key="ComboBorderHover" Color="#838b98" />
    <SolidColorBrush x:Key="ComboArrow" Color="#b4bac4" />
    <!-- メニューは面より一段上げる（地と同じ暗さだと、どこまでがメニューか分からない） -->
    <SolidColorBrush x:Key="MenuBack" Color="#262a31" />
    <SolidColorBrush x:Key="MenuBorder" Color="#454b56" />
    <SolidColorBrush x:Key="MenuHover" Color="#2f3e53" />
    <SolidColorBrush x:Key="MenuHoverBorder" Color="#3f5a7e" />
    <SolidColorBrush x:Key="MenuText" Color="#e6e8ec" />
    <SolidColorBrush x:Key="MenuTextDisabled" Color="#858d9a" />
    <SolidColorBrush x:Key="MenuSeparator" Color="#3a3f4a" />
    <SolidColorBrush x:Key="MenuGlyph" Color="#d5d9e0" />
    <SolidColorBrush x:Key="ToolTipBack" Color="#2b2f37" />
    <SolidColorBrush x:Key="ToolTipBorder" Color="#4b515d" />
    <SolidColorBrush x:Key="ToolTipText" Color="#e6e8ec" />
    <SolidColorBrush x:Key="ListHoverBack" Color="#262f3c" />
    <SolidColorBrush x:Key="ListHoverBorder" Color="#34445a" />
    <SolidColorBrush x:Key="ListSelectedBack" Color="#1f3a5c" />
    <SolidColorBrush x:Key="ListSelectedBorder" Color="#3f6ea8" />
    <SolidColorBrush x:Key="ListSelectedInactiveBack" Color="#2c313a" />
    <SolidColorBrush x:Key="ListSelectedInactiveBorder" Color="#3a404b" />
    <!-- つまみは溝に対して部品の 3:1 を満たす -->
    <SolidColorBrush x:Key="ScrollTrack" Color="#1b1e23" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#666d79" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#7f8793" />
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#9aa1ad" />
    <SolidColorBrush x:Key="ScrollArrow" Color="#a3aab6" />
    <SolidColorBrush x:Key="ScrollArrowHoverBack" Color="#30343c" />
    <SolidColorBrush x:Key="SliderTrack" Color="#30353e" />
    <SolidColorBrush x:Key="SliderTrackBorder" Color="#454b56" />
    <SolidColorBrush x:Key="SliderThumb" Color="#aab1bc" />
    <SolidColorBrush x:Key="SliderThumbBorder" Color="#d0d4db" />
    <SolidColorBrush x:Key="SliderThumbHover" Color="#c3cad4" />
    <SolidColorBrush x:Key="SliderThumbHoverBorder" Color="#6fa5ee" />
    <SolidColorBrush x:Key="SliderTick" Color="#5d6471" />
    <SolidColorBrush x:Key="ColumnHeaderBack" Color="#1e2127" />
    <SolidColorBrush x:Key="ColumnHeaderHover" Color="#272c35" />
    <SolidColorBrush x:Key="ColumnHeaderBorder" Color="#343943" />

    <!-- Windows の色（SystemColors）の置き換え。自前の見た目を持たない所が読む -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1e2127" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#e6e8ec" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1b1e23" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#e6e8ec" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#868e9b" />
</ResourceDictionary>