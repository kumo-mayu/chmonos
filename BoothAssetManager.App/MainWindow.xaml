<Window x:Class="BoothAssetManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
        xmlns:views="clr-namespace:BoothAssetManager.App.Views"
        Title="BOOTH Asset Manager"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InboxViewModel}">
            <views:InboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagManageViewModel}">
            <views:TagManageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttributeManageViewModel}">
            <views:AttributeManageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopsViewModel}">
            <views:ShopsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AvatarsViewModel}">
            <views:AvatarsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModificationViewModel}">
            <views:ModificationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- NavButton のテンプレートから引くので、必ずその前に置く（StaticResourceは前方参照できない） -->
        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            ナビのアイコン。モックのSVGを24×24の座標系のまま持ち込み、Viewboxで16pxへ縮める。
            線の太さも一緒に縮むので、どのアイコンも同じ太さで揃う。
        -->
        <PathGeometry x:Key="IconSearch" Figures="M4,11 A7,7 0 1 1 18,11 A7,7 0 1 1 4,11 M20,20 L16.5,16.5" />
        <PathGeometry x:Key="IconShops" Figures="M4,9 H20 V20 H4 Z M4,9 L5.5,4 H18.5 L20,9" />
        <PathGeometry x:Key="IconStats" Figures="M5,19 V11 M12,19 V5 M19,19 V14" />
        <PathGeometry x:Key="IconImport" Figures="M12,4 V15 M8,11 L12,15 L16,11 M5,19 H19" />
        <PathGeometry x:Key="IconResolve" Figures="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M9.6,9.6 A2.5,2.5 0 1 1 13.6,11.6 C12.8,12.2 12,12.6 12,13.6 M12,17.2 V17.3" />
        <PathGeometry x:Key="IconInbox" Figures="M18,15 V11 A6,6 0 1 0 6,11 V15 L4,18 H20 Z M10,21 H14" />
        <PathGeometry x:Key="IconEdit" Figures="M4,20 H8 L18,10 L14,6 L4,16 Z" />
        <PathGeometry x:Key="IconAvatars" Figures="M8.6,8 A3.4,3.4 0 1 1 15.4,8 A3.4,3.4 0 1 1 8.6,8 M5,20 C6,16.4 8.7,14.6 12,14.6 S18,16.4 19,20" />
        <PathGeometry x:Key="IconTags" Figures="M4,12 V5 H11 L19,13 L12,20 L4,12 Z M7.2,8.5 A1.3,1.3 0 1 1 9.8,8.5 A1.3,1.3 0 1 1 7.2,8.5" />
        <PathGeometry x:Key="IconAttributes" Figures="M5,7 H19 M5,12 H19 M5,17 H19" />
        <PathGeometry x:Key="IconSettings" Figures="M8.8,12 A3.2,3.2 0 1 1 15.2,12 A3.2,3.2 0 1 1 8.8,12 M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.7,7.7 M16.3,16.3 L18.4,18.4 M18.4,5.6 L16.3,7.7 M7.7,16.3 L5.6,18.4" />

        <!--
            ナビの1項目。11項目とも「アイコン・名前・件数」で同じ形なので、
            並べ方はここだけに書き、項目ごとの違いは views:Nav の添付プロパティで渡す。
            畳んだときに名前を消す、という変更も1箇所で済む。
        -->
        <Style x:Key="NavButton" TargetType="Button">
            <!--
                名前はテンプレートの中のTextBlockに入るので、ボタン自体には文字が無い。
                読み上げと自動化には名前が見えなくなるので、ここで明示する。
            -->
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource RailText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding Path=(views:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                              Fill="{x:Null}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{Binding Path=(views:Nav.IsActive), RelativeSource={RelativeSource TemplatedParent},
                                                               Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                                    </Canvas>
                                </Viewbox>

                                <TextBlock x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{Binding Path=(views:Nav.IsActive), RelativeSource={RelativeSource TemplatedParent},
                                                                Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />

                                <!--
                                    0件のときは出さない。残っている作業を示すものなので、
                                    0が並ぶと数字そのものが目に入ってしまう。
                                -->
                                <Border x:Name="Badge" Grid.Column="2" Style="{StaticResource NavBadge}" Margin="6,0,0,0"
                                        Background="{Binding Path=(views:Nav.BadgeBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                        Visibility="{Binding Path=(views:Nav.Badge), RelativeSource={RelativeSource TemplatedParent},
                                                             Converter={x:Static vm:ZeroToCollapsedConverter.Instance}}">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding Path=(views:Nav.Badge), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="White" FontSize="11" FontWeight="Bold"
                                               FontFamily="Yu Gothic UI, Meiryo, Segoe UI" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2b303a" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <!--
                                畳んだときは名前を消し、件数は数字ごと落として点だけ残す。
                                アイコンだけになっても「ここに残作業がある」ことは見えるようにする。

                                点はアイコンの角へ重ねる。畳んだ幅では内容領域がアイコン16pxちょうどで、
                                バッジを別の列に置くと幅が残らず消えてしまうため。
                                レール色の縁を巻いて、線画に重なっても輪郭が潰れないようにする。
                            -->
                            <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Badge" Property="Grid.Column" Value="0" />
                                <Setter TargetName="Badge" Property="Width" Value="10" />
                                <Setter TargetName="Badge" Property="Height" Value="10" />
                                <Setter TargetName="Badge" Property="Padding" Value="0" />
                                <!-- 行の高さ34に対しアイコンは中央の16px。その上端より少し上に置く -->
                                <Setter TargetName="Badge" Property="Margin" Value="0,6,-5,0" />
                                <Setter TargetName="Badge" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Badge" Property="VerticalAlignment" Value="Top" />
                                <Setter TargetName="Badge" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Rail}" />
                                <Setter Property="ToolTip"
                                        Value="{Binding Path=(views:Nav.Label), RelativeSource={RelativeSource Self}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            区切りの見出し。畳んでも場所は残す（Hidden）。場所ごと消すと、下のアイコンが
            開閉のたびに上下へずれた（U2）。畳んだときは同じ高さに細い線（NavGroupRule）を出す
        -->
        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RailLabel}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="22,12,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 線の左右はナビのアイコン（左から20・幅16）にそろえる -->
        <Style x:Key="NavGroupRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="20,4,0,0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource RailLabel}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 開いたときだけ見せる。畳んでも場所は残す -->
        <Style x:Key="NavExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavCollapsedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- アプリの印（箱）。畳んだときに見出しの代わりに置く。ほかのアイコンと同じ 24 の座標で描く -->
        <PathGeometry x:Key="IconApp" Figures="M4,8 L12,4 L20,8 V16 L12,20 L4,16 Z M4,8 L12,12 L20,8 M12,12 V20" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ナビゲーション -->
        <Border Grid.Column="0" Background="{StaticResource Rail}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <!--
                        畳んだ幅ではタイトルが入らないので、同じ高さにアプリの印を置く。
                        場所ごと消すと、畳むボタンと下のアイコンが開閉のたびに上へ詰まってずれた（U2）。
                        印の位置と描き方はナビのアイコン（左から20・16px・線の太さ1.8）にそろえる
                    -->
                    <Grid Margin="10,0,10,14">
                        <StackPanel Margin="8,0" Style="{StaticResource NavExpandedOnly}">
                            <TextBlock Text="BOOTH Asset Manager" Foreground="White" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding LibrarySummary}" Foreground="#767f8e" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <Viewbox Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Style="{StaticResource NavCollapsedOnly}" ToolTip="BOOTH Asset Manager">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconApp}" Fill="{x:Null}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{StaticResource RailText}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <Button Command="{Binding ToggleNavCommand}" Margin="10,0,10,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Setter Property="views:Nav.Icon" Value="{StaticResource IconCollapse}" />
                                <Setter Property="views:Nav.Label" Value="ナビを畳む" />
                                <Style.Triggers>
                                    <!-- 畳んでいるときは、押すと戻る側の意味になる -->
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="views:Nav.Icon" Value="{StaticResource IconExpand}" />
                                        <Setter Property="views:Nav.Label" Value="ナビを開く" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--
                        区切りの見出しは、畳んでも高さを残し、名前の代わりに細い線を引く。
                        場所ごと消すと、下のアイコンが開閉のたびに上下へずれた（U2）
                    -->
                    <Grid>
                        <TextBlock Text="ライブラリ" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowSearchCommand}"
                            views:Nav.Label="検索" views:Nav.Icon="{StaticResource IconSearch}"
                            views:Nav.IsActive="{Binding IsSearchActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowShopsCommand}"
                            views:Nav.Label="ショップ" views:Nav.Icon="{StaticResource IconShops}"
                            views:Nav.IsActive="{Binding IsShopsActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowStatsCommand}"
                            views:Nav.Label="統計" views:Nav.Icon="{StaticResource IconStats}"
                            views:Nav.IsActive="{Binding IsStatsActive}" />

                    <Grid>
                        <TextBlock Text="作業" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowImportCommand}"
                            views:Nav.Label="取り込み" views:Nav.Icon="{StaticResource IconImport}"
                            views:Nav.IsActive="{Binding IsImportActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowResolveCommand}"
                            views:Nav.Label="未確定" views:Nav.Icon="{StaticResource IconResolve}"
                            views:Nav.IsActive="{Binding IsResolveActive}"
                            views:Nav.Badge="{Binding UnresolvedCount}" views:Nav.BadgeBrush="#9a6b1f" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowEditCommand}"
                            views:Nav.Label="編集" views:Nav.Icon="{StaticResource IconEdit}"
                            views:Nav.IsActive="{Binding IsEditActive}"
                            views:Nav.Badge="{Binding NeedsEditCount}" views:Nav.BadgeBrush="#9a6b1f" />

                    <Grid>
                        <TextBlock Text="管理" Style="{StaticResource NavGroupLabel}" />
                        <Border Style="{StaticResource NavGroupRule}" />
                    </Grid>
                    <!--
                        要確認は「取り込んだ物を片付ける流れ」ではなく管理の側（U6・ユーザ判断）。
                        件数のバッジが付くのはここだけなので、先頭に置いて目に入るようにする
                    -->
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowInboxCommand}"
                            views:Nav.Label="要確認" views:Nav.Icon="{StaticResource IconInbox}"
                            views:Nav.IsActive="{Binding IsInboxActive}"
                            views:Nav.Badge="{Binding UnreadCount}" views:Nav.BadgeBrush="#8a3f6b" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAvatarsCommand}"
                            views:Nav.Label="アバター" views:Nav.Icon="{StaticResource IconAvatars}"
                            views:Nav.IsActive="{Binding IsAvatarsActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowTagManageCommand}"
                            views:Nav.Label="タグの管理" views:Nav.Icon="{StaticResource IconTags}"
                            views:Nav.IsActive="{Binding IsTagManageActive}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowAttributeManageCommand}"
                            views:Nav.Label="属性の管理" views:Nav.Icon="{StaticResource IconAttributes}"
                            views:Nav.IsActive="{Binding IsAttributeManageActive}" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Margin="10,0,10,14"
                        Command="{Binding ShowSettingsCommand}"
                        views:Nav.Label="設定" views:Nav.Icon="{StaticResource IconSettings}"
                        views:Nav.IsActive="{Binding IsSettingsActive}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!--
                通信の常設表示。取得は直列なので、どの瞬間も起きていることは1つだけ。
                背景で画像を取りに行くこともあるので、黙って通信しないよう常に見える場所に置く。
                何もしていないときは畳む（高さを取らない）。
            -->
            <!-- 押すと取り込みの画面へ（U24）。通信の話を見に行く先は1つにしておく -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,0"
                    Cursor="Hand" ToolTip="取り込みの画面を開く"
                    Visibility="{Binding BoothActivity.IsActive, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowImportCommand}" />
                </Border.InputBindings>
                <Grid Height="26">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 長さの分かっている待ちはバーで、通信そのものは点滅で -->
                        <ProgressBar Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding BoothActivity.Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding BoothActivity.HasProgress,
                                                       Converter={x:Static vm:InverseBoolConverter.Instance}}" />
                        <TextBlock Text="{Binding BoothActivity.Text}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="混み合っています" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource Warn}"
                               ToolTip="BOOTHから待つよう指示があったので、以降の間隔を広げています。"
                               Visibility="{Binding BoothActivity.IsThrottled, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                </Grid>
            </Border>

            <!-- 画面内検索（U20）の帯を今の画面の上に重ねるため、同じ枠に置く -->
            <Grid>
                <ContentControl x:Name="ScreenHost" Content="{Binding CurrentViewModel}" />
                <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,58,24,0" Padding="10,7" CornerRadius="8" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="220" Padding="6,3"
                                 TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown"
                                 ToolTip="この画面の中の文字を探します。Enterで次、Shift+Enterで前、Escで閉じます。" />
                        <TextBlock x:Name="FindCount" Style="{StaticResource Caption}" Margin="10,0,8,0" MinWidth="64"
                                   VerticalAlignment="Center" />
                        <Button Content="↑" Style="{StaticResource SmallButton}" Click="OnFindPrevious" ToolTip="前の一致" />
                        <Button Content="↓" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Click="OnFindNext" ToolTip="次の一致" />
                        <Button Content="×" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnFindClose" ToolTip="閉じる（Esc）" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
