<Window x:Class="BoothAssetManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BoothAssetManager.App.ViewModels"
        xmlns:views="clr-namespace:BoothAssetManager.App.Views"
        Title="BOOTH Asset Manager"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportViewModel}">
            <views:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <views:ItemView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditViewModel}">
            <views:EditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InboxViewModel}">
            <views:InboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagManageViewModel}">
            <views:TagManageView />
        </DataTemplate>

        <!-- ナビの1項目 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource RailText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,0">
                            <Border.Resources>
                                <!--
                                    アプリ全体の TextBlock スタイルが濃い文字色を指定しているため、
                                    暗いレールの上ではそのままだと文字が読めなくなる。
                                    ここで明示的に上書きする。
                                -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource RailText}" />
                                    <Setter Property="FontFamily" Value="Yu Gothic UI, Meiryo, Segoe UI" />
                                    <Setter Property="FontSize" Value="12.5" />
                                </Style>
                            </Border.Resources>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2b303a" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RailLabel}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="22,12,0,4" />
        </Style>

        <Style x:Key="NavBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ナビゲーション -->
        <Border Grid.Column="0" Background="{StaticResource Rail}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <StackPanel Margin="18,0,18,14">
                        <TextBlock Text="BOOTH Asset Manager" Foreground="White" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="{Binding LibrarySummary}" Foreground="#767f8e" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Text="ライブラリ" Style="{StaticResource NavGroupLabel}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowSearchCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="検索" Foreground="{Binding IsSearchActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <TextBlock Text="ショップ" Foreground="{StaticResource RailText}" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <TextBlock Text="統計" Foreground="{StaticResource RailText}" />
                    </Button>

                    <TextBlock Text="作業" Style="{StaticResource NavGroupLabel}" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowImportCommand}">
                        <TextBlock Text="取り込み" Foreground="{Binding IsImportActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowResolveCommand}">
                        <Grid Width="164">
                            <TextBlock Text="未確定" HorizontalAlignment="Left"
                                       Foreground="{Binding IsResolveActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                            <Border Style="{StaticResource NavBadge}" Background="#9a6b1f" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding UnresolvedCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowInboxCommand}">
                        <Grid Width="164">
                            <TextBlock Text="要確認" HorizontalAlignment="Left"
                                       Foreground="{Binding IsInboxActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                            <Border Style="{StaticResource NavBadge}" Background="#8a3f6b" HorizontalAlignment="Right"
                                    Visibility="{Binding HasUnread, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowEditCommand}">
                        <Grid Width="164">
                            <TextBlock Text="編集" HorizontalAlignment="Left"
                                       Foreground="{Binding IsEditActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                            <Border Style="{StaticResource NavBadge}" Background="#9a6b1f" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding NeedsEditCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Text="管理" Style="{StaticResource NavGroupLabel}" />
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <TextBlock Text="アバター" Foreground="{StaticResource RailText}" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowTagManageCommand}">
                        <TextBlock Text="タグの管理" HorizontalAlignment="Left"
                                   Foreground="{Binding IsTagManageActive, Converter={x:Static vm:BoolToRailBrushConverter.Instance}}" />
                    </Button>
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <TextBlock Text="属性の管理" Foreground="{StaticResource RailText}" />
                    </Button>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" IsEnabled="False" Margin="10,0,10,14">
                    <TextBlock Text="設定" Foreground="{StaticResource RailText}" />
                </Button>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
