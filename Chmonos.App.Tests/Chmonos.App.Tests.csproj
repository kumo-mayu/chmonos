<Project Sdk="Microsoft.NET.Sdk">

  <!--
    画面の側（Chmonos.App の ViewModel と Services）の試験。
    文言の出し分け・ボタンの出し分け・一覧の絞り込みのような「計算で決まる物」を、アプリを起動して撮らずに確かめる
    （ユーザ判断 2026-09-30）。窓は出さない。配置と見た目は今までどおり画像で見る。書き方は docs/dev/app-tests.md
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    試験はこのフォルダに全部置き、ファイル名の頭文字で3つのプロジェクトに分けて別々のプロセスで走らせる
    （A〜H はここ、I〜R は Chmonos.App.Tests.IR、S〜Z は Chmonos.App.Tests.SZ。Support/ と AssemblyInfo.cs は3つとも持つ）。
    1つのプロセスの中では並べられない（画面のスレッドと Application は1つ。AssemblyInfo.cs）ので、プロセスを分ける。
    2026-11-10 に測った：一式を1本で 53〜58秒、2本で約36秒、3本で約31秒、4本で約27秒。
    3本にしたのは、頭文字で切ると時間が A〜H 15・I〜R 19・S〜Z 19秒とそろい、4本だと S（検索の試験が固まる）だけで15秒になって割れないため。
    ここで外すのは他の2つが持つ頭文字。どれにも当たらない名前のファイルはここに残るので、試験が抜け落ちることはない
  -->
  <ItemGroup>
    <Compile Remove="I*.cs;J*.cs;K*.cs;L*.cs;M*.cs;N*.cs;O*.cs;P*.cs;Q*.cs;R*.cs" />
    <Compile Remove="S*.cs;T*.cs;U*.cs;V*.cs;W*.cs;X*.cs;Y*.cs;Z*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chmonos.App\Chmonos.App.csproj" />
  </ItemGroup>

</Project>
