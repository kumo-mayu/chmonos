<Project Sdk="Microsoft.NET.Sdk">

  <!--
    確かめ用の写し（サンドボックス）を、作り物のデータで組み立てる道具。
    ソリューションには入れていない（dotnet build・dotnet test の時間を増やさないため）。
    使うときに ui-check スキルの New-ChmonosSandbox -Recipe がビルドして呼ぶ。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Chmonos.Core\Chmonos.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
