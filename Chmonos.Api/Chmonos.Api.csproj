<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    外から使う API の実行ファイル（docs/spec/local-api.md）。中身は Chmonos.Query が作り、ここは HTTP の口と守りだけを持つ。
    配る形は .NET を同梱した1ファイルの exe（Properties/PublishProfiles/win-x64.pubxml。Native AOT にしない理由もそこ）。
    日本語の並べ方・かなの畳み方を使うので、言語の情報（ICU）は切らない（InvariantGlobalization を false のままにする）
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>Chmonos.Api</AssemblyName>
    <RootNamespace>Chmonos.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- IIS 向けの web.config と、静的なファイルの一覧を作らない（Kestrel だけで動き、静的なファイルも配らない） -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chmonos.Query\Chmonos.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chmonos.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!--
      Microsoft.AspNetCore.OpenApi が引く Microsoft.OpenApi 2.0.0 には、文書を読むときに循環した参照で止まる脆弱性がある（GHSA-v5pm-xwqc-g5wc・2.7.5 で直った）。
      API は仕様書を書くだけで読まないので通らない道だが、配る物に古い版を入れないよう、直った版を直接指定する（2026-10-12・点検30）
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

</Project>
