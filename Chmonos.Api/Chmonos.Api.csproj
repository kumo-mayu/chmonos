<Project Sdk="Microsoft.NET.Sdk">

  <!--
    外から使う API の HTTP の口と守り（docs/spec/local-api.md）。中身は Chmonos.Query が作る。
    アプリ（Chmonos.exe）と同じプロセスで動くライブラリ（2026-10-13。docs/history/headless-core-2026-10-13.md 段2）。
    前は .NET を同梱した別の実行ファイル（Chmonos.Api.exe）だった。Native AOT にしなかった理由は docs/spec/local-api.md
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chmonos.Api</AssemblyName>
    <RootNamespace>Chmonos.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Web 用の SDK が自動で足していた名前空間（ライブラリにしたので自分で足す） -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chmonos.Query\Chmonos.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chmonos.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!--
      Microsoft.AspNetCore.OpenApi が引く Microsoft.OpenApi 2.0.0 には、文書を読むときに循環した参照で止まる脆弱性がある（GHSA-v5pm-xwqc-g5wc・2.7.5 で直った）。
      API は仕様書を書くだけで読まないので通らない道だが、配る物に古い版を入れないよう、直った版を直接指定する（2026-10-12・点検30）
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

</Project>
