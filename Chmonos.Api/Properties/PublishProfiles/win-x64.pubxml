<?xml version="1.0" encoding="utf-8"?>
<!--
  渡す用のビルド。dotnet publish Chmonos.Api -p:PublishProfile=win-x64
  アプリ本体（Chmonos.App/Properties/PublishProfiles/win-x64.pubxml）と同じ形にそろえ、publish のときだけ効かせる。

  Native AOT にしない（2026-10-12）：Core の保存の JSON が実行時に型を組み立てるので、AOT の exe は商品を読む所で止まった
  （型を残す設定でも、組み合わせの型が入らない）。AOT にするには保存の読み書き全体を作り替える要があり、API のためだけには危うさが大きい。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 自己完結（使う人に .NET を入れてもらわない） -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      圧縮しない。圧縮すると中身をメモリの上で展開して抱えるので、空の保存先で作業セットが 66 → 124MB、専用が 19 → 57MB に増えた
      （2026-10-12 に測った。ユーザ判断「ランタイムの分メモリがもったいない」）。exe は 53 → 110MB になるが、配る zip で圧縮される
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      事前翻訳（ReadyToRun）はしない。アプリ本体は起動の速さのために入れたが、API は起動して待つだけなので、exe が大きくなる方を避ける
    -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PublishDir>..\publish\Chmonos.Api-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
